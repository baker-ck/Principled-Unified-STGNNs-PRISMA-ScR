  abstract = {In this paper, we present a deep learning system for short-term traffic flow forecasting on the New Zealand state highway network. We leveraged SpatioTemporal Graph Convolutional Network (STGCN) to capture the complex, non-linear spatial and temporal dependencies inherent in traffic data. The system is developed using a real-world dataset of traffic sensor readings from Wellington, the capital of New Zealand. We implemented and evaluated two distinct models: a univariate approach and a more complex multivariate approach that incorporates additional features to forecast traffic simultaneously. This study explains the data collection and preprocessing pipeline, the graph construction methodology, and the model architecture. We present a comparative analysis of the predictive accuracy of the univariate and multivariate models on a held-out test set, where our multivariate model achieves a $\mathbf\{1 5. 6 \%\}$ reduction in Mean Absolute Error (MAE) compared to the univariate baseline. Finally, we describe a proof-of-concept data streaming architecture using Apache Kafka, designed for real-time inference.},
  publisher = {IEEE},
  isbn = {979-8-3315-7790-2},
  issn = {2473-0130},
  keywords = {Traffic Forecasting;Spatio-Temporal Data;Graph Neural Networks;STGCN;Time Series Analysis;Multivariate Forecasting},
}

@article{predictingspatiotemporaldelays2026,
  author = {M. Sar; C. Pradhan},
  title = {{Predicting} {Spatiotemporal} {Delays} in {Aviation} {Networks} using {Graph} {Neural} {Networks}},
  journal = {2026 International Conference on Computing, Electronics \& Communications Engineering (ICCECE)},
  year = {2026},
  pages = {1--6},
  doi = {10.1109/ICCECE69715.2026.11492880},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11492880},
  abstract = {The cascading and spatiotemporal nature of aviation networks makes the accurate prediction of flight delays a challenge for airline planning. Traditional machine learning approaches operate primarily at individual flight or airport levels, falling short at capturing network-wide delay propagation. This paper presents a graph-based approach to flight delay prediction, modeling the aviation network as a spatiotemporally evolving graph. We implement and evaluate a Graph Attention Network (GAT) and GAT-LSTM architectures on thirty days of flight data from the US Department of Transportation (Bureau of Transportation Statistics) database. The models achieve overall classification accuracies of 87 and 84 per cent respectively, reinforcing the viability of graph neural networks for this task. However, performance analysis across delay severity categories reveals a critical limitation: both models struggle significantly with major and severe delays (>60 minutes), which represent only a small fraction of the dataset. These findings suggest that while graph-based approaches show promise for spatiotemporal modeling, standard architectures may be fundamentally limited by class imbalance when rare but operationally critical events are present in real-world data.},
  publisher = {IEEE},
  isbn = {979-8-3195-1700-5},
  issn = {2768-0576},
  keywords = {Flight delays;Graph attention network;Graph neural network;Graph representation;Spatiotemporal data},
}

@article{stvgnspatiotemporalvisibilityg2025,
  author = {Y. Zhang; X. Ren; T. Chen; W. K. V. Chan},
  title = {{STVGN:} {Spatiotemporal} {Visibility} {Graph} for {Short-Term} {Traffic} {Speed} {Prediction}},
  journal = {2025 International Joint Conference on Neural Networks (IJCNN)},
  year = {2025},
  pages = {1--8},
  doi = {10.1109/IJCNN64981.2025.11229377},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11229377},
  abstract = {Short-term traffic speed prediction under limited historical data is crucial for intelligent transportation systems, enabling real-time traffic management and congestion mitigation. However, existing methods relying on long lookback window to forecast struggle to capture scenarios where the current traffic state depends more on recent patterns than on distant historical data. To address this challenge, we propose the Spatiotemporal Visibility Graph Network (STVGN), a novel framework that combines visibility graph theory with Graph Neural Networks (GNN). The core of STVGN is the STVGN-Embedding layer, which is designed to enhance short-term spatiotemporal feature representation. This layer leverages the visibility graphâs ability to capture transient patterns and integrates GNNs to model intrinsic relationships within the visibility graph derived from time series data. In Combination with a transformer architecture, STVGN-Embedding extracts complex spatiotemporal features, while the transformer uncovers inherent relationships between temporal and spatial dimensions. To the best of our knowledge, this is the first study to introduce visibility graph theory as an embedding layer within a transformer framework. Experiments on three benchmark datasets, covering urban and freeway traffic scenarios, demonstrate STVGNâs effectiveness, achieving state-of-the-art performance with improvements of 4.8%â16.8% in RMSE and 8.4%â13.3% in MAE over existing SOTA methods. These results highlight the potential of visibility graph-based embeddings to address challenges posed by limited historical data and to capture intricate traffic patterns.},
  publisher = {IEEE},
  isbn = {979-8-3315-1042-8},
  issn = {2161-4407},
  keywords = {Spatiotemporal;visibility graph;Graph neural networks;traffic prediction},
}

@article{adeeplearningmethodforpredicti2025,
  author = {S. Li; D. Wang; S. Xu; Y. Wang; M. Zhao},
  title = {{A} {Deep} {Learning} {Method} for {Predicting} {Terminal} {Air} {Traffic} {Congestion} {Levels} {Based} on {Multimode} {Spatiotemporal} {Propagation} {Networks}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2025},
  volume = {26},
  number = {12},
  pages = {21891--21906},
  doi = {10.1109/TITS.2025.3610514},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11176855},
  abstract = {Air traffic congestion and the resulting flight delays have significantly impacted the travel experience of passengers and the development of aviation. Forecasting air traffic congestion is of great importance to intelligent air traffic management. In this study, we propose a novel method named the Three-mode Spatio-Temporal Dynamic Graph Convolutional Network (TSTD-GCN), which employs Graph Convolutional Networks (GCN), Temporal Convolutional Network (TCN), and Transformer to model the spatiotemporal propagation patterns of air traffic congestion in terminal areas. Specifically, we develop a construction method for three-mode time-evolving networks, namely the adjacency network, traffic flow network, and spatiotemporal correlation network. Our approach incorporates serial graph convolution operations across three-mode networks to progressively expand the spatial scope of feature learning. In addition, TSTD-GCN employs TCNâs proficiency in extracting local dependencies and the Transformerâs ability to capture global dependencies, thus improving the precision of prediction. Finally, we validate the proposed model using real-world trajectory data from the Beijing terminal, China. The experimental results indicate that the prediction accuracy reaches 0.92 for a time scale of 10 min. Additionally, prediction accuracy decreases with an increase in time scale or an increase in trajectory complexity.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Air traffic congestion;time-evolving graph network;traffic propagation;spatiotemporal features;graph convolutional neural network},
}

@article{dynamicmultiscalespatialtempor2025,
  author = {D. Liu; C. Wang},
  title = {{Dynamic} {Multi-Scale} {Spatial-Temporal} {Feature} {Network} for {Traffic} {Flow} {Forecasting}},
  journal = {2025 International Joint Conference on Neural Networks (IJCNN)},
  year = {2025},
  pages = {1--8},
  doi = {10.1109/IJCNN64981.2025.11228829},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11228829},
  abstract = {Traffic flow forecasting has always been one of the popular research topics in intelligent transportation, but challenges have been encountered in effectively capturing the intricate spatial-temporal dependencies in traffic flow data, and the graph structures utilized by existing methods fail to adequately account for the unique spatial-temporal patterns exhibited by each node due to time-varying spatiality. To address these issues, a Dynamic Multi-Scale Spatial-Temporal Feature Network (DMSTFN) is proposed for traffic flow forecasting. Specifically, a dynamic graph constructor is designed, which updates the graph structure based on real-time input traffic flow data during both training and testing phases, this approach allows the graph to not only reflect the static geographical proximity among nodes but also capture the dynamic spatial-temporal relationships caused by changes in traffic patterns. Moreover, long-term spatial-temporal features are extracted from long-input traffic flow data using a Spatial-Temporal Encoder-Decoder (STED) architecture, and short-term spatial-temporal features are extracted from short-input traffic flow data utilizing a Dynamic Graph Convolutional Network (DGCN). By efficiently fusing these two different scales of spatial-temporal features, our method addresses the complex issue of spatial-temporal dependencies. Finally, we evaluate our approach on four public traffic flow datasets, and the experimental results demonstrate that DMSTFN not only exhibits high computational efficiency but also outperforms 12 state-of-the-art baselines.},
  publisher = {IEEE},
  isbn = {979-8-3315-1042-8},
  issn = {2161-4407},
  keywords = {traffic flow forecasting;dynamic graph construction;multi-scale spatialâtemporal feature;spatial-temporal graph neural network},
}

@article{vehicularspeedpredictionmethod2025,
  author = {L. Li; B. An; D. Zhang; R. Gan; Z. Zhou; X. Qu; B. Ran},
  title = {{Vehicular} {Speed} {Prediction} {Method} for {Highway} {Scenarios} {Based} on {Spatiotemporal} {Graph} {Convolutional} {Networks} and {Potential} {Field} {Theory}},
  journal = {IEEE Internet of Things Journal},
  year = {2025},
  volume = {12},
  number = {3},
  pages = {3330--3349},
  doi = {10.1109/JIOT.2024.3479221},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10714460},
  abstract = {Traffic flow analysis largely depends on accurate predictions of microscopic speed. Due to the complexity and stochastic of real-world driving environments, traditional model-driven methods face significant challenges. In recent years, data-driven methods that combine advanced intelligent algorithms have emerged to address the issue of vehicle speed prediction. However, most existing studies primarily focus on the static spatiotemporal relationships between vehicles, with only a few exploring dynamic spatiotemporal correlations. In this study, a new graph structure, named the vehicle generalized-dynamic graph, is constructed to characterize the vehicle trajectory, emphasizing the spatial and temporal evolution of vehicles. In the spatial dimension, we employ the potential field theory to compute the field strength of vehicles in different motion states, enhancing the description of interdependencies among vehicles. In the temporal dimension, the movements of each vehicle at different time points are interrelated. Furthermore, we propose a novel neural network architecture, named the dynamic edge graph convolutional network (DEGCN), to address the vehicle speed prediction problem. The DEGCN model is evaluated through experiments on three real-world vehicle trajectory datasets. The experimental results demonstrate that the proposed model outperforms other baseline models in terms of prediction performance. Additionally, various ablation studies are conducted to evaluate the effectiveness of different components, the potential field theory, and the vehicle generalized-dynamic graph structure.},
  publisher = {IEEE},
  issn = {2327-4662},
  keywords = {Graph convolutional network (GCN);potential field theory;traffic flow;vehicle generalized-dynamic graph;vehicle speed prediction},
}

@article{mstfamultiscalelongtermspatiot2026,
  author = {J. Cao; X. Sheng; Z. Duan},
  title = {{MSTF:} {A} {Multiscale} {Long-Term} {Spatiotemporal} {Traffic} {Flow} {Forecasting} {Framework}},
  journal = {IEEE Internet of Things Journal},
  year = {2026},
  volume = {13},
  number = {15},
  pages = {34847--34864},
  doi = {10.1109/JIOT.2026.3695857},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11534227},
  abstract = {With the continuous growth of urban traffic demand, traffic flow prediction faces modeling challenges due to its highly nonlinear spatiotemporal coupling characteristics and the complexities of multiple periods. Existing methods are typically applied directly to the original traffic flow sequences, relying on implicit temporal accumulation or static spatial topology to capture long-term dependencies. This makes it difficult to explicitly characterize the simultaneous trend changes, periodic disturbances, and cross-node spatial diffusion patterns within the traffic flow, leading to performance degradation, especially in long-term prediction scenarios. To address this, this article proposes a multiscale spatiotemporal traffic flow (MSTF) prediction model, which explicitly and structurally exposes the multiscale spatiotemporal characteristics of traffic flow to improve the stability and accuracy of long-term predictions. For spatial modeling, a wavelet convolution-based multiscale feature extraction mechanism is introduced to expand the effective receptive field, and a graph convolutional network (GCN) is combined to model local topological relationships, thus achieving complementary spatial representations. For temporal modeling, an iTransformer encoder is used to globally model long-period temporal dependencies, and a trend-aware decomposition module explicitly separates long-term trends from periodic disturbances. Subsequently, a Mamba-based decoder utilizes a selective state-space mechanism to achieve efficient long-term dependency modeling and suppress redundant noise. Experimental results on four public benchmark datasets show that the proposed method significantly outperforms existing state-of-the-art models at different prediction step sizes while maintaining high prediction accuracy with low computational overhead, providing an efficient and interpretable modeling framework for long-term traffic flow prediction.},
  publisher = {IEEE},
  issn = {2327-4662},
  keywords = {Lightweight model;long-term traffic forecasting;multiscale feature extraction;spatiotemporal modeling;traffic flow prediction},
}

@article{stmomaspatiotemporaltrafficflo2025,
  author = {S. Guo; J. Li; H. Li; Z. Cheng},
  title = {{STMOM:} {A} {Spatiotemporal} {Traffic} {Flow} {Forecasting} {Model} {Based} on {Multi-Order} {Markov} {Chains}},
  journal = {2025 International Joint Conference on Neural Networks (IJCNN)},
  year = {2025},
  pages = {1--8},
  doi = {10.1109/IJCNN64981.2025.11229120},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11229120},
  abstract = {With the development of urban traffic, road networks are becoming increasingly complex and traffic congestion is getting worse. Accurately predicting traffic data is one of the most important means to keep urban roads smooth and is one of the key technologies to improve urban traffic management capabilities. Graph Convolutional Networks (GCNs) are a type of deep learning method used to analyze spatial information in traffic networks. There are two problems with traditional GCNs. First, GCNs can only solve first-order models that only consider the influence between adjacent nodesâ temporal data, and stacking multiple layers of graph neural networks can easily lead to over-smoothing phenomena. Second, as the number of layers increases, the number of trainable parameters in the model increases, so does leading to model overfitting. Therefore, this paper proposes a traffic flow prediction model based on multi-order Markov chains. The paper estimates the parameters of this model and refers to the urban road traffic operation evaluation index system. Through prediction experiments, it is proven that the prediction accuracy of this model is higher than other baseline models.},
  publisher = {IEEE},
  isbn = {979-8-3315-1042-8},
  issn = {2161-4407},
  keywords = {Intelligent Transportation Systems;Multi-Order Markov Chains;Traffic Flow Prediction;Spatiotemporal Features},
}

@article{multiscaletemporalfeaturesbase2025,
  author = {J. Wang; K. Liu; H. Li; Q. Gao; X. Wang; Y. Gong},
  title = {{Multiscale} {Temporal} {Features-Based} {Hybrid} {LSTM-GAT} for {Traffic} {Flow} {Prediction}},
  journal = {IEEE Internet of Things Journal},
  year = {2025},
  volume = {12},
  number = {21},
  pages = {44909--44926},
  doi = {10.1109/JIOT.2025.3599635},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11127181},
  abstract = {Traffic flow prediction (TFP) plays a crucial role in optimizing road resource allocation and alleviating traffic congestion. However, existing TFP methods have limitations in capturing the complex spatiotemporal dependencies from traffic data, resulting in low prediction accuracy. To solve this problem, we propose a hybrid long short-term memory (LSTM) and graph attention network (GAT) model based on multiscale temporal features (MSTF-LG) to predict traffic flow. First, we employ trigonometric functions (TF) to process timestamp information to extract its periodicity and continuity features. These features are then integrated with traffic data to construct a comprehensive input representation. We further extract recent traffic data as well as daily, weekly, and monthly periodic data from this representation. Second, we adopt the LSTM encoder to process recent traffic data to extract recent trend features, and apply LSTM encoders to handle daily, weekly and monthly periodic data to extract periodic features. Furthermore, we employ the GAT to process these LSTM-encoded multiscale temporal features of traffic data to capture dynamic spatial characteristics. The normalized GAT outputs are fed into the LSTM decoder to effectively capture the dynamic temporal changes of traffic data, and then a linear layer transforms the output of the LSTM decoder into TFP results. Finally, experimental results demonstrate that the proposed method outperforms existing TFP methods in terms of prediction accuracy, robustness and computational efficiency.},
  publisher = {IEEE},
  issn = {2327-4662},
  keywords = {graph attention network (GAT);long short-term memory (LSTM);multiscale temporal features;spatial features;traffic flow prediction (TFP)},
}

@article{diversefeaturespatialtemporalg2025,
  author = {W. Yang; Z. Xie; J. Chen; H. Liu},
  title = {{Diverse-Feature} {Spatial-Temporal} {Graph} {Attention} {Network} for {Long-Term} {Interference} {Prediction}},
  journal = {2025 IEEE Wireless Communications and Networking Conference (WCNC)},
  year = {2025},
  pages = {1--6},
  doi = {10.1109/WCNC61545.2025.10978752},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10978752},
  abstract = {With the explosive growth of communication networks, the unmet demand for spectrum has created escalating interference issues, necessitating high-precision multi-step interference prediction methods. However, collecting interference data can impose significant sensor overhead. To address this challenge, we propose a framework that leverages physical resource block (PRB) traffic for interference prediction. Given the intricate spatial-temporal characteristics of PRB traffic and interference intensity, capturing these intrinsic features accurately poses a considerable challenge. In response, we introduce a novel Diverse Spatial-Temporal Graph Attention Network (DSTGAT) designed to precisely predict interference intensity from PRB traffic. The DSTGAT comprises two main components: first, a multi-feature extraction module that integrates four adjacency matrices to characterize the spatial features of PRB traffic; second, a time-encoding temporal self-attention module crafted to uncover temporal correlations. Experimental results substantiate the superior performance of our proposed model, especially in managing multi-step prediction scenarios.},
  publisher = {IEEE},
  isbn = {979-8-3503-6836-9},
  issn = {1558-2612},
  keywords = {PRB traffic prediction;attention mechanism;graph attention network;multi-step prediction},
}

@article{mesigcnmultiscaleequidistantsp2025,
  author = {S. -W. Wei; D. -B. Hu; X. -Y. Xu; C. -Z. Wang},
  title = {{MESIGCN:} {Multi-Scale} {Equidistant} {Spatio-Temporal} {Graph} {Convolution} {Networks}},
