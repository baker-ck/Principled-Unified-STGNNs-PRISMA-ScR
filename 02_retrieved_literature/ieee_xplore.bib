@article{hybridgraphconstructionandspat2025,
  author = {Y. Yan; H. Wen; W. Zhao; L. Li; X. Kong; L. Hu},
  title = {{Hybrid} {Graph} {Construction} and {Spatiotemporal} {Modeling} for {PM2.5} {Forecasting} {Across} {Urban} {Networks}},
