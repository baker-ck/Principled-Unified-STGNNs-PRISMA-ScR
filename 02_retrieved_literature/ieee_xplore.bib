  title = {{Short-Term} {Vehicle} {Speed} {Prediction} {Based} on {Spatio-Temporal} {Traffic} {Graph} {Networks}},
  journal = {IEEE Access},
  year = {2025},
  volume = {13},
  pages = {43557--43571},
  doi = {10.1109/ACCESS.2025.3548130},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10910100},
  abstract = {Predictive information is an important research direction in vehicle energy management. As the most intuitive item among numerous predictive information, the accurate and real-time prediction of vehicle speed is significant for vehicle motion control and energy management optimization. However, traditional vehicle speed prediction methods generally predict future speed changes based on the experience of historical vehicle speed changes and current vehicle speed information, which belongs to prediction in the pure time dimension. The spatial information of traffic scenes that directly affects vehicle behaviors has not been widely applied. Aiming at the complex spatio-temporal correlation in the vehicle motion process, this paper proposes a spatio-temporal graph convolutional network (GCN-LSTM). This network combines graph convolutional network (GCN) and long short-term memory network (LSTM) and is used for vehicle speed prediction. Among them, the GCN can handle the complex topological structures in graph data to extract the spatial features of traffic scenes, and the LSTM can handle the time features of the dynamic changes in traffic scenes. Training and testing are carried out on two datasets of traffic congestion and smooth traffic. The simulation results show that compared with other benchmark models, the proposed model has the smallest prediction error. Meanwhile, based on the datasets, the impact of the expansion of the amount of spatial information on the prediction accuracy of the model in this paper is verified. The results indicate that abundant spatial dimension information can further improve the prediction accuracy.},
  publisher = {IEEE},
  issn = {2169-3536},
  keywords = {Graph convolutional networks;long short-term memory networks;vehicle speed prediction;spatio-temporal correlation},
}

@article{spatiotemporaltrafficspeedfore2026,
  author = {M. Khodayar; A. F. Bavil; M. Saffari},
  title = {{Spatiotemporal} {Traffic} {Speed} {Forecasting} via {Conditional} {Flow-Based} {Generative} {Deep} {Learning} {With} {Dynamic} {Graph} {Pooling}},
  journal = {IEEE Transactions on Emerging Topics in Computational Intelligence},
  year = {2026},
  volume = {10},
  number = {3},
  pages = {2301--2315},
  doi = {10.1109/TETCI.2026.3670662},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11456093},
  abstract = {Traffic speed forecasting is a crucial problem with significant real-world applications, including optimizingtraffic flow and reducing congestion. Current data-driven approaches struggle with high sample complexity, overfitting, and limited long-range temporal dependencies. To overcome these challenges, we introduce a Conditional Flow-based Generative (CFG) model with dynamic Graph Feature Extraction (GFE) and pooling for spatiotemporal traffic speed forecasting. First, traffic speed measurements are modeled as a dynamic graph, where nodes represent sensor readings and edges encode spatial correlations. A GFE network captures sparse spatial features of the dynamic graph through a hierarchical graph learning architecture, incorporating a graph pooling layer to reduce feature dimensions and a structure learning mechanism for refined graph topologies. These extracted features are fed into a peephole LSTM to capture both short- and long-term spatiotemporal dependencies. Finally, the CFG model predicts future traffic speeds of the sensors by learning the underlying data distribution, improving forecast accuracy by capturing complex patterns, and handling variability in traffic data through generative feature extraction. The proposed framework is tested using three real-world traffic datasets, PEMS-BAY, METR-LA, and PEMS07, and has demonstrated outstanding performance compared to state-of-the-art approaches. This exceptional performance is due to its ability to enhance generalization and prediction accuracy while mitigating overfitting, offering a significant advancement over recent traffic forecasting models.},
  publisher = {IEEE},
  issn = {2471-285X},
  keywords = {Traffic forecasting;dynamic graph pooling;structure learning;generative deep neural network},
}

@article{leagcnalearnablegraphconvoluti2025,
  author = {S. -M. Hosseini; S. M. Rahmatinia; S. -A. Hosseini-Seno},
  title = {{LeaGCN:} {A} {Learnable} {Graph} {Convolutional} {Network} with {Temporal} {Attention} for {Traffic} {Forecasting}},
  journal = {2025 9th International Conference on Internet of Things and Applications (IoT)},
  year = {2025},
  pages = {1--8},
  doi = {10.1109/IoT69654.2025.11297604},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11297604},
  abstract = {Accurate traffic flow prediction is critical for intelligent transportation systems but remains a significant challenge due to complex and dynamic spatio-temporal dependencies. While Graph Convolutional Networks (GCNs) are powerful tools for this task, their performance is often limited by a reliance on predefined, static adjacency matrices that fail to capture the dynamic nature of road networks. To address this limitation, we propose LeaGCN, a Learnable Graph Convolutional Network with temporal attention. The cornerstone of our model is an adaptive GCN layer that utilizes a learnable adjacency matrix, allowing it to discover hidden spatial relationships directly from data without prior structural knowledge. This spatial module is integrated with an LSTM network to model temporal patterns and a soft attention mechanism to focus on the most relevant historical information, enhancing long-term prediction accuracy. Extensive experiments on the real-world PEMSD4 and PEMSD8 datasets demonstrate that LeaGCN significantly outperforms state-of-the-art baseline models. For instance, our model reduces the Mean Absolute Error (MAE) by up to 23% on the PEMSD4 dataset compared to the strongest baseline, validating its effectiveness and superiority.},
  publisher = {IEEE},
  isbn = {979-8-3315-4982-4},
  keywords = {Traffic Forecasting;Spatio-Temporal Modeling;Graph Convolutional Networks;Adaptive Graph;Attention Mechanism},
}

@article{interpretabletrafficflowpredic2025,
  author = {S. Khader; A. Awajan},
  title = {{Interpretable} {Traffic} {Flow} {Prediction} {Using} {SHAP} and {STID-Recurrence} {Model}},
