}

@article{modelingandforecastingtraindel2025,
  author = {L. Coffie},
  title = {{Modeling} and {Forecasting} {Train} {Delays} {Using} {Spatiotemporal} {Graph} {Neural} {Networks}},
  journal = {2025 IEEE/ACIS 29th International Conference on Software Engineering, Artificial Intelligence, Networking and Parallel/Distributed Computing (SNPD)},
  year = {2025},
  pages = {754--761},
  doi = {10.1109/SNPD65828.2025.11253464},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11253464},
  abstract = {Effective forecasting of train delays is critical for improving the efficiency, reliability, and operational planning of national railway systems. While traditional time-series and machine learning models have been extensively used for delay prediction, they typically disregard the spatial dependencies between stations and are ill-suited to model the network-based propagation of delays. In this regard, we propose a spatiotemporal deep learning framework consisting of Graph Convolutional Networks (GCNs), which can better capture the topological structure of the railway network, and Long Short-Term Memory (LSTM) networks, which can capture the temporal behavior of train delays. We trained and tested our model using a true-to-life dataset from the French national railway system and utilizing previous data from 130 routes and 59 stations, in an effort to forecast monthly average arrival delays over a time horizon of six years. Direct comparisons with a temporal-only LSTM model indicate that while aggregate evaluations are similar, the hybrid GCN+LSTM model offers improved generalization across more complex routes as well as greater ability to discern structural delay hubs. Furthermore, embedding visualizations showed the model could encode roles of stations as well as capture the delay propagation across the network. Ultimately, this work illustrates the additional value of spatio-temporal modeling for railway operations and shows that not only does spatio-temporal, spatially-structured delay forecasting provide more robust predictive performance, but it also improves the interpretability of explanatory characteristics for decision support. We proposed a spatio-temporally relevant, scalable, and intelligent approach to delay management and infrastructure investment in modern},
  publisher = {IEEE},
  isbn = {979-8-3315-1258-3},
  issn = {2693-8421},
  keywords = {Railway Delay Forecasting;Spatiotemporal Modeling;Graph Neural Networks (GNN);Long Short-Term Memory (LSTM);Delay Propagation;Transport Networks;Deep Learning;Intelligent Transportation Systems;Graph-Based Learning;Time Series Prediction},
}

@article{spatiotemporalpredictionofwire2025,
  author = {Y. Li; B. Sun; T. Huang; X. Du; Y. Li; X. Sun},
  title = {{Spatiotemporal} {Prediction} of {Wireless} {Network} {Traffic} {Based} on {Multi-Task} {Deep} {Learning}},
  journal = {2025 IEEE 25th International Conference on Communication Technology (ICCT)},
  year = {2025},
  pages = {889--894},
  doi = {10.1109/ICCT67417.2025.11374032},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11374032},
  abstract = {Accurate wireless network traffic prediction has become an urgent need and major challenge in network management, driven by rapid technological advances and data-driven strategies. Currently, state-of-the-art algorithms typically neglect spatio-temporal feature extraction, resulting in limited accuracy. Therefore, this paper proposes a spatiotemporal and temporal sequence joint prediction framework based on multi-granularity feature sharing (MTSN). Rooted in multi-task learning, MTSN models traffic's spatio-temporal and multi-granularity temporal features to achieve effectively prediction. Specifically, we first construct a multi-granularity data partitioning layer that forms multi-scale data association matrices through temporal dimension decomposition, enabling collaborative optimization of cross-granularity traffic prediction tasks. Then, 3D Convolutional Networks (Conv3D) Conv3D extracts spatio-temporal correlations while Kolmogorov-Arnold Networks with Gated Recurrent Units (KAN-GRU) captures multi-granularity temporal dependencies. These features are fused to create a joint representation en-compassing both global trends and local details. Finally, fully connected networks extract granularity-specific unique features, enhancing overall prediction. Using a real Italian telecommunications dataset, MTSN demonstrates effectiveness through comparative analyses of prediction performance, trend fitting, statistical distribution, and spatial distribution consistency. Experimental results demonstrate that our model achieves significant performance improvements in key metrics such as RMSE and MAE compared to advanced models including STGCN and T-GCN.},
  publisher = {IEEE},
  isbn = {979-8-3315-8578-5},
  issn = {2576-7828},
  keywords = {Wireless network traffic prediction;spatiotemporal data mining;multi-task learning;deep learning},
}

@article{modunetamodulatedgraphtokennet2025,
  author = {T. Zhang; Y. Chen; D. Wu; K. Zhu},
  title = {{ModuNet:} {A} {Modulated} {Graph-Token} {Network} for {Spatio-Temporal} {Traffic} {Flow} {Forecasting}},
  journal = {IEEE Access},
  year = {2025},
  volume = {13},
  pages = {208067--208077},
  doi = {10.1109/ACCESS.2025.3632115},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11241207},
  abstract = {Traffic flow forecasting, a critical component of intelligent urban traffic management, faces challenges such as complex spatio-temporal dependencies and diverse road topologies. To overcome the limitations of existing methods that either struggle with graph structure modeling or lack explicit spatio-temporal relationship representation, this paper proposes a novel graph-aware spatio-temporal forecasting model named Modulated Graph Token Network (ModuNet). The model utilizes Graph Convolutional Networks (GCNs) to extract the topological features of nodes and constructs graph tokens to capture structural information. A modulation transformation matrix, shared across all time steps, is introduced to integrate graph tokens with sequential traffic flow data. Subsequently, a Transformer model with an encoder-decoder architecture is employed to explicitly model four core relationshipsânode to node, flow to flow, node to flow, and flow to nodeâwithin a unified attention mechanism. This design significantly enhances the modelâs capacity to capture both short-term and long-term dependencies. Experiments on three public traffic datasets, PeMSD7, PeMSD8 and METR-LA, show that ModuNet consistently outperforms mainstream methods across various prediction horizons, with particularly strong performance in long-term forecasting. The proposed method offers a clear structure, controllable parameters, and strong generalizability, making it well suited for a wide range of graph-based time series modeling tasks.},
  publisher = {IEEE},
  issn = {2169-3536},
  keywords = {Graph neural networks;graph token;spatio-temporal modeling;transformer;traffic flow forecasting},
}

@article{hicostepcausalityinformedhiera2026,
  author = {G. Zhang; L. Pei; Y. Cao; Y. Kang; J. Qin},
  title = {{HiCo-STEP:} {Causality} {Informed} {Hierarchical} {Spatiotemporal} {Network} for {Traffic} {Emission} {Prediction}},
  journal = {IEEE Transactions on Artificial Intelligence},
  year = {2026},
  volume = {7},
  number = {8},
  pages = {4541--4552},
  doi = {10.1109/TAI.2026.3665658},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11398362},
  abstract = {Traffic emission has emerged as a primary source of urban air pollution due to the rapid increase in vehicle ownership. Therefore, achieving fine-grained traffic emission prediction is crucial for the comprehensive supervision of mobile source emission and the formulation of targeted mitigation policies. Traffic emissions exhibit spatiotemporal heterogeneity and complex spatial interactions. Existing emission prediction methods utilize predefined graph structure to model spatiotemporal dependency, ignoring the complex interaction mechanism among road segments, which may introduce spurious correlations to interfere with spatio-temporal representation learning. In this article, we propose a hierarchical causality-informed spatiotemporal network to realize fine-grained traffic emission prediction (HiCo-STEP). Specifically, we train the model in a dual-stage manner and propose a contrastive spatiotemporal clustering (CSTC) module in hierarchical prediction stage, which generates macro emission semantics and forms hierarchical spatiotemporal graphs. Then we discover and optimize the causal relationship between road-segment level and region level in causal learning stage, realizing causal fusion of spatiotemporal representations from coarse to fine grained (CF2). The proposed method is evaluated on the Xiâan and Beijing emission datasets, and the experiments demonstrate the superiority of our method compared with the existing baselines.},
  publisher = {IEEE},
  issn = {2691-4581},
  keywords = {Causality learning;contrastive spatiotemporal clustering (CSTC);hierarchical spatiotemporal graph;traffic emission prediction},
}

@article{pastapeakawareaxisfactorizedsp2026,
  author = {J. Liu; J. Feng; Y. Zhang; J. Li; S. Du; Y. Zhou},
  title = {{PASTA:} {Peak-Aware} {Axis-Factorized} {Spatiotemporal} {Alignment} for {Traffic} {Forecasting}},
  journal = {2026 IEEE Intelligent Vehicles Symposium (IV)},
  year = {2026},
  pages = {915--922},
  doi = {10.1109/IV66570.2026.11624096},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11624096},
  abstract = {Traffic flow forecasting plays a crucial role in optimizing urban mobility and serves as a cornerstone of Intelligent Transportation Systems (ITS). However, accurate traffic prediction remains challenging due to nonlinear, dynamic, and asymmetric interactions between spatial and temporal patterns. To address these challenges, we propose Peak-Aware Axis-Factorized Spatiotemporal Alignment (PASTA), which factorizes temporal and spatial dependencies along separate axes and fuses them through cross-attention and low-rank bilinear integration to achieve adaptive spatiotemporal alignment. For the temporal dimension, PASTA utilizes a multi-head self-attention mechanism to capture long-range dependencies and periodic patterns, complemented by a lightweight LSTM to model short-term temporal features. For the spatial dimension, node-wise multi-head self-attention captures global correlations between distant but similar nodes, while a two-hop Graph Convolutional Network with learnable adjacency matrices encodes road network topology and enforces topology-constrained local diffusion. To achieve efficient spatiotemporal fusion, we propose a bidirectional cross-attention mechanism that facilitates mutual interaction and dynamic alignment between spatial and temporal representations. A low-rank bilinear fusion module compactly integrates the cross-attention outputs, reducing redundancy while preserving key feature interactions. Additionally, we design a peak-aware adaptive loss function that improves sensitivity to congestion peaks by emphasizing high-demand intervals. Extensive experiments on four real-world traffic datasets show that PASTA consistently outperforms state-of-the-art baselines in prediction accuracy, offering a scalable solution for real-time traffic forecasting.},
  publisher = {IEEE},
  isbn = {979-8-3315-4793-6},
  issn = {2642-7214},
  keywords = {Traffic prediction;Graph neural network;Transformer},
}

@article{urbantrafficinferenceusingspat2025,
  author = {M. Kumar; M. Gulati; A. N},
  title = {{Urban} {Traffic} {Inference} using {Spatial} {Temporal} {Frameworks}},
  journal = {2025 5th International Conference on Intelligent Technologies (CONIT)},
