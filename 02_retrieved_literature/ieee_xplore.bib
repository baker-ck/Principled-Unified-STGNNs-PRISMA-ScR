@article{servicetracpredictionformixedt2026,
  author = {Y. Zhi; L. Zhu; B. Li; J. B. Othman},
  title = {{Service} {Traï¬c} {Prediction} for {Mixed} {Traffic} {Scenario:} {Integrating} {Vehicular} {Mobility} and {Service} {Spatio-Temporal} {Attributes}},
  journal = {ICC 2026 - IEEE International Conference on Communications},
  year = {2026},
  pages = {1--6},
  doi = {10.1109/ICC59461.2026.11587295},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11587295},
  abstract = {The emergence of autonomous driving technology has ushered in an era of mixed traffic, characterized by the coexistence of connected vehicles (CVs), connected automated vehicles (CAVs), and human-driven vehicles (HDVs). Distinct from conventional vehicular networks, these scenarios exhibit fundamentally different driving behaviors and network service demands, thereby leading to the fact that making accurate service traffic prediction at the base station level is more difficult. However, existing research has often overlooked the influence of key factors like vehicle motion and diverse service characteristics, focusing predominantly on modeling the spatio-temporal correlations of service traffic. To address the issue, this study proposes the Dynamic Weighted Temporal Graph Convolutional Network (DWTGCN), which is a novel service traffic prediction model that combines vehicular mobility and the spatio-temporal attributes of service traffic for mixed traffic flow scenarios. Firstly, in order to consider vehicular mobility, the Capsule network and Long Short-Term Memory (LSTM) network are adopted to predict the trajectories of different vehicles. Then, combined with base station coverage, a transfer probability matrix is constructed to represent the handover behavior of vehicles between base stations. Subsequently, the Graph Convolutional Network (GCN) is employed to capture the spatial correlation of service traffic, and the Gated Recurrent Unit (GRU) is applied to capture the temporal dependency. In the end, a mixed traffic flow scenario simulation platform was constructed using SUMO, Veins, and OMNeT++. Simulation results show that the proposed method exhibits a reduction in error exceeding 15% for all service types over the baseline.},
  publisher = {IEEE},
  isbn = {979-8-3195-4209-0},
  issn = {1938-1883},
  keywords = {mixed traffic flow scenario;service traffic prediction;spatio-temporal mobility-aware modeling;T-GCN},
}

@article{twistanefficientspatialtempora2025,
  author = {P. Wang; L. Feng; W. Zhang; K. Hui},
  title = {{TWIST:} {An} {Efficient} {SpatialâTemporal} {Transformer} {With} {Temporal} {Window} and {Sparse} {Attention} for {Traffic} {Forecasting}},
  journal = {IEEE Internet of Things Journal},
  year = {2025},
  volume = {12},
  number = {14},
  pages = {26799--26815},
  doi = {10.1109/JIOT.2025.3561542},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10966151},
  abstract = {Accurate traffic prediction is crucial for intelligent transportation systems (ITS). However, recent advancements in deep learning have encountered significant challenges in effectively capturing long-range dependencies and modeling complex intervariable relationships, particularly under real-time processing constraints. These limitations primarily arise from the inherent tradeoff in current model architectures: while some are optimized for short-term forecasting with constrained receptive fields, others prioritize long-term prediction accuracy at the cost of computational efficiency. Moreover, the dynamic and intricate interactions among nodes present significant scalability challenges, increasingly hindering efficient modeling as the road network grows. To address these limitations, we propose temporal window and sparse spatial attention transformer (TWIST), a novel architecture specifically designed for traffic forecasting. The proposed framework incorporates two key innovations: 1) a trend-aware window attention mechanism in the temporal dimension that effectively and efficiently captures multiscale temporal dynamics and 2) a sparse attention mechanism in the spatial dimension that optimizes computational efficiency by selectively focusing on significant spatial nodes. Extensive experiments on eight real-world datasets demonstrate that TWIST consistently outperforms state-of-the-art methods across various scenarios, including regular, long-term, and large-scale traffic forecasting tasks, while maintaining competitive computational efficiency. Our code is publicly available at https://github.com/STGTraffic/TWIST.},
  publisher = {IEEE},
  issn = {2327-4662},
  keywords = {Attention mechanism;deep learning;spatial-temporal data;traffic forecasting},
}

@article{fddsgcnfractionaldecouplingdyn2025,
