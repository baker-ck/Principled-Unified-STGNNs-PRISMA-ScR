  isbn = {979-8-3315-6491-9},
  keywords = {Urban Drainage Network;Flood Risk Prediction;Graph Neural Network;St-Gnn Model;Multi-Source Data Fusion},
}

@article{qospredictionforcomponentservi2025,
  author = {H. Huang; Q. Wang; G. Min; M. Wang; D. O. Wu},
  title = {{QoS} {Prediction} for {Component} {Services} in {5G} via {Graph-Based} {Deep} {Reinforcement} {Learning}},
  journal = {IEEE Transactions on Mobile Computing},
  year = {2025},
  volume = {24},
  number = {12},
  pages = {13520--13534},
  doi = {10.1109/TMC.2025.3591783},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11091517},
  abstract = {The accurate prediction of Quality of Service (QoS) in terms of response time, packet loss rate, latency and throughput for component services is essential for 5G to fulfill specific Service Level Agreements (SLAs). However, most current efforts failed to fully exploit the time-varying mobility features of users and parallel iteration multi-rules to perform QoS prediction for component services, incurring poor prediction accuracy. Therefore, in this paper, we are devoted to accurate QoS Prediction of Component Services (QPCS) for 5G via Graph-based Deep Reinforcement Learning (GDRL) to tackle this issue. Towards this end, the QoS prediction is modeled as GDRL-based QoS tensor factorization by designing a Spatio-Temporal-Recurrent-based Graph Attention Network (STR-GAT) and introducing it into Deep Deterministic Policy Gradient (DDPG) to factorize QoS tensor with multiple available rules in parallel. Specifically, a low-rank QoS tensor and an adjacency tensor are established, which include partial QoS observations of component services in each Base Station (BS), along with some missing elements, and evolving spatial information of users across these BSs, respectively. Then, the novel STR-GAT is designed by introducing spatio-temporal relations into conventional GAT to fully derive the mobility features of users to explore potential actions, while the derivative DDPG is adopted to perform tensor factorization with multiple available rules in parallel. Furthermore, the action smoothing and hierarchical-based replay buffer with priority-based and random sampling are designed and introduced into DDPG to stabilize training process and accelerate model convergence. Experimental simulation results on real-world datasets validate the superiorities of QPCS compared with the state-of-the-art approaches in predicting the QoS of component services in 5G.},
  publisher = {IEEE},
  issn = {1558-0660},
  keywords = {Deep reinforcement learning;graph attention network;QoS prediction;tensor factorization},
}

@article{swiftsceneawaredualcrossattent2025,
  author = {J. Zhang; P. Chao; J. Fang; H. Peng; J. Xu},
  title = {{SWIFT:} {Scene-Aware} {Dual} {Cross-Attention} {Flight} {Trajectory} {Prediction}},
  journal = {2025 IEEE International Conference on Big Data (BigData)},
  year = {2025},
  pages = {1643--1648},
  doi = {10.1109/BigData66926.2025.11401796},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11401796},
  abstract = {Recently, the rapid growth of aviation activities poses great challenges to Air Traffic Management (ATM). To ensure safety and organized air traffic, tracking and predicting flight trajectory, known as Flight Trajectory Prediction (FTP), is a fundamental technique that helps identify abnormal flight behavior in real time. Most existing methods define FTP purely as time series forecasting tasks, neglecting the aircraft-specific features and the spatial relationships among trajectory points. In this paper, we present a novel approach known as Scene-Aware Dual Cross-Attention Flight Trajectory Prediction (SWIFT). Unlike on-road vehicles that frequently change driving patterns, an aircraft typically maintains a stable mode and changes only when necessary. Therefore, we aim to identify the distinct flight behaviors, which we define as flight scenes, to enhance our prediction. The proposed framework includes 1) a Static Information Layer capturing the geospatial features of the 3D flight trajectory (longitude, latitude, altitude) with flight scene identification, 2) a Dynamic Information Layer grasping the characteristics of multivariable patch sequences of coordinate and velocity within the temporal domain, and 3) an Enhanced Information Interaction Layer consisting of a dual cross-attention architecture that integrates scene and spatial-velocity information to generate future trajectories. Extensive experiments on two real-world flight trajectory datasets show that the proposed method outperforms the state-of-the-art models in this field.},
  publisher = {IEEE},
  isbn = {979-8-3315-9447-3},
  issn = {2573-2978},
  keywords = {spatial-temporal data mining;flight trajectory prediction;time series forecasting;graph representation learning},
}

@article{effintentgcnanefficientgraphco2025,
  author = {J. Shi; C. Liu; C. T. Ishi; H. Ishiguro},
  title = {{EffIntentGCN:} {An} {Efficient} {Graph} {Convolutional} {Network} for {Skeleton-Based} {Pedestrian} {Crossing} {Intention} {Prediction}},
