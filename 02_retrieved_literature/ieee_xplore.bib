@article{mapfreemultiagenttrajectorypre2025,
  author = {Z. Nan; J. Xiang; F. Luo; T. Xiang},
  title = {{Map-Free} {Multi-Agent} {Trajectory} {Prediction} in {Traffic} {Scenarios}},
  journal = {IEEE Transactions on Vehicular Technology},
