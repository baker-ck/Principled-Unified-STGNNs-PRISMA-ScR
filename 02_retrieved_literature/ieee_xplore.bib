  pages = {3458--3467},
  doi = {10.1109/TIV.2024.3454177},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10663848},
  abstract = {Traffic forecasting plays a pivotal role in intelligent transportation systems. To enhance forecasting accuracy, existing deep learning models often feature complex structures with large computational demands for deployment. To achieve seamless traffic system operations and prompt communication between vehicles and roadway infrastructure, the best solution is to deploy models on locally operating edge devices, which are limited in hardware resources. In this realm, we consider both efficiency and effectiveness in this paper with our newly proposed Lightweight Forecasting (LightCast) model. Specifically, we first design Spatio-temporal Global-local Former (STGLFormer) that introduces various self-attention mechanisms comprehensively considering both global and local spatio-temporal information in traffic data to offer state-of-the-art (SOTA) forecasting accuracy. Furthermore, LightCast involves a mix-granularity pruning strategy to remove redundant components in STGLFormer at different granularities and an automated layer-matching distillation scheme to effectively restore the forecasting accuracy after pruning. The automated layer-matching distillation scheme resolves the issues of layer mismatching in the traditional feature distillation approach. Extensive experiments conducted on four real-world public transportation datasets demonstrate that our approach can achieve near SOTA performance at a much higher computation efficiency.},
  publisher = {IEEE},
  issn = {2379-8904},
  keywords = {Traffic flow forecasting;efficient deep learning;lightweight neural networks},
}

@article{urbantransportmodesplitpredict2025,
  author = {J. Zhao; H. Yan; L. Sun; F. Zheng; X. Gao; F. Zhang; K. Ye; C. Xu},
  title = {{Urban} {Transport} {Mode} {Split} {Prediction:} {A} {Hybrid} {Deep} {Learning} {Framework} {Considering} {Spatiotemporal} {Dependency}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2025},
  volume = {26},
  number = {11},
  pages = {19626--19644},
  doi = {10.1109/TITS.2025.3614241},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11220907},
  abstract = {Transport Mode Split (TMS) represents the distribution of trips among transport modes between city regions. Accurate TMS prediction is crucial for urban planning and traffic management. Traditional methods, such as curve models and discrete choice models, often fail to capture user travel mode pReferences due to dataset limitations and inadequate spatiotemporal modeling. While deep learning models have been applied in related domains such as ride-sharing and traffic prediction, they typically focus on a single transport mode and do not model the competitive relationships between modes. We propose a novel Deep Learning-based Framework for Transport Mode Split Prediction (DMSP), integrating restricted-route (bus/subway) and free-route (taxi) data. It introduces two key innovations: 1) efficient extraction of TMS samples from sparse raw data, enriched with spatiotemporal context, and 2) a prediction model extending discrete choice theory via maximum utility principles. Mode utilities are estimated using CNNs for travel mode-specific effects and GNN for spatiotemporal dependencies. Experiments on six months of Shenzhen data show that DMSP reduces MAPE by over 4% compared to existing methods.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Transport mode split;deep learning framework;spatiotemporal dependency},
}

@article{coevolvingtrafficstateparamete2025,
  author = {H. Dong; H. Zhang; F. Ding; H. Tan},
  title = {{Co-Evolving} {Traffic} {State} {Parameters} {Prediction} {Based} on {Mechanism-Data} {Blending} {Driven} {Deep} {Learning}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2025},
  volume = {26},
  number = {3},
  pages = {3084--3100},
  doi = {10.1109/TITS.2024.3524582},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10844689},
  abstract = {Traffic state prediction, a classical task for traffic management, is a central component of intelligent transport systems to maintain safe and efficient operation. While extensive and intensive research has been conducted on traffic state prediction, most studies have concentrated on enhancing the accuracy of specific traffic state parameters. However, traffic state is a co-evolutionary multivariate time series with various parameters such as flow, velocity, occupancy, etc. At the same time, traffic state data will inevitably be lost during collection. So accurate traffic prediction still faces the following challenges: First, how to deal with the complex missing situations in observational data? Second, how to learn the co-evolutionary relationships between different traffic state parameters while mining the high-dimensional spatio-temporal traffic state patterns? In this paper, we propose a mechanism-data blending-driven co-evolving traffic state parameter prediction method: multi-parameter hybrid tensor deep learning networks (MHT-Net), which consists of a multi-parameter tensor graph convolutional network (MTGCN) and a tensor recurrent neural network (T-RNN). MTGCN implements knowledge embedding of synergistic mechanisms between traffic parameters, ensuring that the road network spatial dependency and the synergistic influence relationship of the parameters can be obtained simultaneously; T-RNN is used to learn high-dimensional temporal features of traffic states. Experiment results on a real-world dataset from Jiangsu province outperform the state-of-the-art baselines, demonstrating the efficacy of the proposed method and providing an effective tool for traffic state prediction with missing values. A mechanism-data blending driven co-evolving traffic state parameter prediction method, multi-parameters hybrid tensor deep learning networks (MHT-Net) is proposed, which implements knowledge embedding of synergistic mechanisms between traffic parameters and learn the road network spatial dependency and the synergistic influence relationship of the parameters simultaneously. Experiment results demonstrate the efficacy of the proposed method and provide an effective tool for traffic state prediction with missing values.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Traffic state prediction;co-evolving traffic state parameters;mechanism-data blending driven model;tensor deep learning;data missing},
}

@article{metaguidedgraphlightweighttime2026,
  author = {S. Li; L. Chen; W. Li; G. Chen; J. Kang; D. Niyato; H. Jiang},
  title = {{Meta-Guided} {Graph} {Lightweight} {TimesNet} for {Traffic} {Prediction} in {Internet} of {Vehicles}},
  journal = {IEEE Internet of Things Journal},
  year = {2026},
  volume = {13},
  number = {11},
  pages = {22756--22769},
  doi = {10.1109/JIOT.2026.3663375},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11389770},
  abstract = {Accurate and efficient traffic flow prediction is crucial for the increasingly prevalent autonomous driving, enabling more advanced intelligent transportation systems. For this purpose, we propose a novel model termed meta-guided graph lightweight TimesNet (MGGLTN) to accurately capture the spatiotemporal correlations within traffic flow data, thereby providing precise traffic flow predictions for connected vehicles (CVs). Our spatiotemporal information learning architecture features an encoderâdecoder backbone, wherein both the encoder and decoder comprise graph convolutional networks (GCNs) coupled with lightweight Times modules. More importantly, we propose a meta-guided graph library, aimed at providing memory queries for time-varying traffic patterns based on real-world physical spatial information. It efficiently guides the initialization direction of meta-guided graph prototypes, thereby accelerating the convergence speed of model training. Moreover, we introduce depthwise separable convolutions to replace the computationally intensive multikernel convolutions in the Times modules, thus significantly reducing computational costs and model parameters while maintaining accuracy. We perform extensive experiments on three public benchmark datasets (i.e., METR-LA, PEMS-BAY, and EXPY-TKY) and conduct comprehensive performance evaluations compared to both baseline models and state-of-the-art (SOTA) models. The findings demonstrate the superior performance of our model across all three datasets of varying spatial scales, highlighting the potential of this model to provide precise traffic guidance for CVs.},
  publisher = {IEEE},
  issn = {2327-4662},
  keywords = {Deep learning;Internet of Vehicles (IoV);lightweight;spatiotemporal;traffic prediction},
}

@article{socialinteractionawaremotionpr2026,
  author = {Y. Yoon; A. Jo},
  title = {{Social} {Interaction-Aware} {Motion} {Prediction} of {Surrounding} {Vehicles} {Based} on {Edge-Pruned} {Graph} {Convolutional} {Network} for {Autonomous} {Vehicles}},
  journal = {IEEE Sensors Journal},
  year = {2026},
  volume = {26},
  number = {8},
  pages = {11667--11678},
  doi = {10.1109/JSEN.2026.3670964},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11431153},
  abstract = {This article presents a method for predicting the motion of surrounding vehicles based on a deep neural network for autonomous vehicles. The proposed algorithm derives spatio-temporal information for the future motion of target vehicles, considering intervehicular interactions. Long short-term memories (LSTMs) are used to model the temporal dependencies of motion information. To effectively model intervehicular interactions, we construct the traffic scene as a graph with edge weights learned via a self-attention mechanism. We introduce an edge-pruned graph convolutional network (GCN). This utilizes a differentiable pruning mechanism to filter out low-importance edges and simplify the graph structure. This approach enhances the networkâs focus on critical social interactions. For evaluation, we collected an in-house driving dataset using a test vehicle and utilized the public NGSIM dataset. Experimental results demonstrate that the proposed edge-pruned network achieves higher prediction accuracy than nonpruned baselines. Furthermore, the model shows improved performance in proactively detecting safety-critical maneuvers. Computational efficiency analysis confirms the suitability of the model for real-time implementation in autonomous driving applications.},
  publisher = {IEEE},
  issn = {1558-1748},
  keywords = {Autonomous vehicle;edge pruning;graph convolutional network (GCN);long short-term memory (LSTM);self-attention;trajectory prediction},
}

@article{agraphneuralnetworkapproachfor2025,
  author = {G. Anuradha; M. B. Vasana; P. Yendluri},
  title = {{A} {Graph} {Neural} {Network} {Approach} for {Predicting} {Flight} {Delays} and {Inferring} {Delay} {Causes}},
  journal = {2025 5th International Conference on Intelligent Technologies (CONIT)},
  year = {2025},
  pages = {1--6},
  doi = {10.1109/CONIT65521.2025.11167359},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11167359},
  abstract = {Flight delays pose a critical problem in aviation, affecting passenger satisfaction, airline performance, and airport activities. Conventional delay forecasting models are inadequate because of the intricate interaction between weather, air traffic density, and airport-related factors. This project proposes an AIdriven flight delay forecasting system combining Graph Neural Networks (GNNs) and weather-informed modeling for improved forecasting accuracy. Flight routes and airports are modeled as a graph structure, preserving spatiotemporal relations among nearby flights. Dynamic weather conditions and past delay patterns are included in the model to enhance predictive performance. Through GraphSAGE-based feature aggregation, the system can effectively learn delay propagation patterns, allowing real-time adaptation to changing airport and weather conditions. This graph learning technique is improving the generalizability of models in various airports and making them reliable for various working conditions. This framework supports anticipatory decision-making by the airlines and airport administration, improving the efficiency of schedules and minimizing disturbance in air travel. The model can achieve test accuracy of 90.01% and exhibit excellent reliability and performance in the real world.},
  publisher = {IEEE},
  isbn = {979-8-3315-2233-9},
  keywords = {Flight Delay Prediction;Graph Neural Networks;Weather-Aware Modeling;Spatiotemporal Graphs;Air Traffic Forecasting},
}

@article{stamgedspatialtemporalattentio2026,
  author = {A. Baghbani; X. Zhou; N. Bouguila; Z. Patterson},
  title = {{STAM-GED:} {SpatialâTemporal} {Attention} {Masked} {Graph} {Neural} {Networks} for {Passenger} {Flow} {Prediction}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2026},
  volume = {27},
  number = {3},
  pages = {2970--2984},
  doi = {10.1109/TITS.2026.3652490},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11361218},
  abstract = {Accurate passenger flow prediction helps public transportation authorities optimize routes, reduce delays, and enhance travel experiences. Recently, Spatial-Temporal Graph Neural Networks (ST-GNNs) have emerged as powerful tools for predicting passenger flows in public transportation. While ST-GNNs can offer valuable insights, they usually assume a static network structure that may not fully consider the real-world dynamics of public transportation systems. With the increasing accessibility of real-time bus schedule data, passengers are adjusting their arrival times at stops according to the latest bus schedules, significantly impacting passenger flow patterns. To address these dynamics, it is critical to incorporate real-time data into ST-GNNs, making these models more dynamic and flexible in terms of both nodes and edges. This adjustment allows the models to better align with actual bus schedules. Current ST-GNN models primarily focus on the temporal evolution of edges, often overlooking the changing status of the nodes. This study introduces a novel dynamic spatial-temporal graph neural network framework, the first to account for the dynamic nature of nodes, providing a more comprehensive approach to predicting passenger flow in bus networks. In this framework, which is entitled Spatial-Temporal Attention Masked Graph Encoder-Decoder, through analysis of active stops - those where buses are scheduled to arrive based on the bus schedule - a more realistic representation of a networkâs spatial and temporal dynamics will be captured. The proposed model was evaluated on two real-world transit networksâLaval, Canada, and Ames, USAâand consistently outperformed both classical and recent state-of-the-art baselines across multiple forecasting horizons.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Passenger flow prediction;dynamic spatial-temporal graph neural network;artificial intelligence;data-based approaches;public transportation},
}

@article{anattentiondrivenspatiotempora2025,
  author = {A. Ali; I. Ullah; S. Ahmad; Z. Wu; J. Li; X. Bai},
  title = {{An} {Attention-Driven} {Spatio-Temporal} {Deep} {Hybrid} {Neural} {Networks} for {Traffic} {Flow} {Prediction} in {Transportation} {Systems}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2025},
  volume = {26},
  number = {9},
  pages = {14154--14168},
  doi = {10.1109/TITS.2025.3540852},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10906322},
  abstract = {In the context of rapidly growing city road networks, understanding complex traffic patterns and implementing effective safety monitoring through advanced Transportation Cyber-Physical Systems (T-CPS) has become increasingly challenging. This involves understanding spatial relationships and non-linear temporal associations. Accurately predicting traffic in such scenarios, particularly for long-term sequences, is challenging due to the complexity of the data. Traditional ways of predicting traffic flow use a single fixed graph structure based on location. This structure does not consider possible correlations and cannot fully capture long-term temporal relationships among traffic flow data, thereby limiting the system ability to ensure safety and reliability. To address this challenge, we propose a novel traffic prediction framework called Attention-based Spatio-temporal Multi-scale Graph Convolutional Recurrent Network (ASTMGCNet). This study introduces a novel framework designed to improve prediction accuracy in dynamic urban traffic systems by effectively capturing complex spatio-temporal correlations through multi-scale feature extraction and attention mechanisms. ASTMGCNet records changing features of space and time by combining Gated Recurrent Units (GRU) and Graph Convolutional Networks (GCN). Its design incorporates multi-scale feature extraction and dual attention mechanisms, effectively capturing informative patterns at different levels of detail. This strategic design allows ASTMGCNet to effectively capture complex spatio-temporal correlations within traffic sequences, enhancing prediction accuracy. We have tested this method on two different real-world datasets and found that ASTMGCNet predicts significantly better than other methods, demonstrating its potential to advance traffic flow prediction and improve safety and reliability in T-CPS applications.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Intelligent transportation systems;traffic prediction;transportation cyber-physical systems;attention mechanism;GCN;safety monitoring},
}

@article{mltauxtsppaunifiedbenchmarkfor2025,
  author = {Y. Zhou; X. Jiang; S. Sun; X. Zhang; Y. Mo; Z. Song},
  title = {{MltAuxTSPP:} {A} {Unified} {Benchmark} for {Deep} {Learning-Based} {Traffic} {State} {Prediction} with {Multi-Source} {Auxiliary} {Data}},
  journal = {Frontiers of Information Technology \& Electronic Engineering},
  year = {2025},
  volume = {26},
  number = {10},
  pages = {1984--1999},
  doi = {10.1631/FITEE.2500169},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11316577},
  abstract = {Deep learning has empowered traffic prediction models to integrate diverse auxiliary data sources, such as weather and temporal features, for enhanced forecasting accuracy. However, existing approaches often suffer from limited generality and scalability, and the field lacks a unified benchmark for fair model comparison. This absence hinders consistent performance evaluation, slows the development of robust and adaptable models, and makes it challenging to quantify the incremental benefits of different auxiliary data sources. To address these issues, we present MltAuxTSPP, a unified benchmark framework for deep learning-based traffic state prediction with multi-source auxiliary data. The framework features a standardized data container and a fusion embedding module, enabling consistent utilization of heterogeneous data and improving scalability. It produces unified hidden representations that can be seamlessly adopted by various downstream models, ensuring fair and reproducible comparisons under identical conditions. Extensive experiments on real-world datasets demonstrate that MltAuxTSPP effectively leverages weather and temporal features to improve long-term forecast performance and offers a practical and reproducible foundation for advancing research in traffic state prediction.},
  publisher = {ZUP},
  issn = {2095-9230},
  keywords = {Traffic prediction;Benchmark platform;Deep learning;Multi-source auxiliary data},
}

@article{asparsecrossattentionbasedgrap2025,
  author = {L. Chen; Q. Zhao; G. Li; M. Zhou; C. Dai; Y. Feng; X. Liu; J. Li},
  title = {{A} {Sparse} {Cross} {Attention-Based} {Graph} {Convolution} {Network} {With} {Auxiliary} {Information} {Awareness} for {Traffic} {Flow} {Prediction}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2025},
  volume = {26},
  number = {3},
  pages = {3210--3222},
  doi = {10.1109/TITS.2025.3533560},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10870873},
  abstract = {Deep graph convolutional networks (GCNs) have shown promising performance in traffic prediction tasks, but their practical deployment on resource-constrained devices faces challenges. First, few models consider the potential influence of historical and future auxiliary information, such as weather and holidays, on complex traffic patterns. Second, the computational complexity of dynamic graph convolution operations grows quadratically with the number of traffic nodes, limiting model scalability. To address these challenges, this study proposes a deep encoder-decoder model named AIMSAN, which comprises an auxiliary information-aware module (AIM) and a sparse cross-attention-based graph convolutional network (SAN). From historical or future perspectives, AIM prunes multi-attribute auxiliary data into diverse time frames, and embeds them into one tensor. SAN employs a cross-attention mechanism to merge traffic data with historical embedded data in each encoder layer, forming dynamic adjacency matrices. Subsequently, it applies diffusion GCN to capture rich spatial-temporal dynamics from the traffic data. Additionally, AIMSAN utilizes the spatial sparsity of traffic nodes as a mask to mitigate the quadratic computational complexity of SAN, thereby improving overall computational efficiency. In the decoder layer, future embedded data are fused with feed-forward traffic data to generate prediction results. Experimental evaluations on three public traffic datasets demonstrate that AIMSAN achieves competitive performance compared to state-of-the-art algorithms, while reducing GPU memory consumption by 41.24%, training time by 62.09%, and validation time by 65.17% on average.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Traffic flow prediction;auxiliary information;sparse cross attention;graph convolutional network},
}

@article{multilevelspatialtemporaljoint2025,
  author = {Z. Xu; S. Lu; Z. Qu},
  title = {{Multilevel} {SpatialâTemporal} {Joint} {Large} {Language} {Model} for {Traffic} {Prediction} in {Symbiotic} {IoT}},
  journal = {IEEE Internet of Things Journal},
  year = {2025},
  volume = {12},
  number = {20},
  pages = {41390--41399},
  doi = {10.1109/JIOT.2025.3589247},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11104850},
  abstract = {The Symbiotic Internet of Things (IoT) represents a collaborative framework wherein edge devices and AI models coordinate resource utilization and interact via 6G connectivity to optimize operational performance and system efficiency. Given the interdependent nature of this symbiotic relationshipâwhere the performance and efficiency of each participant are significantly enhanced by the othersâaccurate traffic prediction becomes crucial. Despite the ability of existing deep learning models to model spatialâtemporal dependencies, they face challenges in feature engineering and natural language feature fusion, particularly in few-shot learning scenarios. The recent advancement of pretrained large language models (LLMs) has demonstrated superior performance in time series analysis through their language comprehension and generalization capabilities. This work presents an innovative multilevel spatialâtemporal joint LLM (MSTJLLM) designed for traffic forecasting. The model incorporates multilevel embeddings of information flow, integrating historical features, dynamic spatialâtemporal features, and prompt text features to capture complex dependencies. This approach aids LLMs in better understanding information flow through prompt text. Fine-tuning strategies enable the LLM to maintain language comprehension while enhancing spatialâtemporal prediction accuracy. Tests on three real-world information flowsets demonstrate MSTJLLMâs robust prediction capability in both data-rich and data-scarce scenarios.},
  publisher = {IEEE},
  issn = {2327-4662},
  keywords = {large language model (LLM);symbiotic Internet of Things (IoT);traffic prediction},
}

@article{felxfmrforlargescaletrafficflo2025,
  author = {X. Song; Z. Guo; J. Rong},
  title = {{FEL-Xfmr:} {For} large-scale traffic flow prediction},
  journal = {2025 IEEE 8th International Electrical and Energy Conference (CIEEC)},
  year = {2025},
  pages = {1430--1435},
  doi = {10.1109/CIEEC64805.2025.11116656},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11116656},
  abstract = {Traffic flow prediction plays an important role in urban planning, traffic management and policy formulation. However, existing deep learning methods still face limitations in modelling complex spatio-temporal dependencies and handling large-scale networks. To this end, we propose a lightweight framework, FEL-Xfmr, for efficient large-scale traffic flow prediction, which consists of three core modules: MMFE, FEM, and AFFM. MMFE is based on the Transformer, which integrates monthly periodicity, weekly patterns, traffic variability, and weather features to comprehensively capture temporal correlations. The FEM module uses graph embedding to extract topological information of the traffic network and model the spatial dependency between sensors, while the AFFM module automatically learns key features through a weighting mechanism to improve the focus on important spatio-temporal information. The experimental results show that FEL-Xfmr outperforms existing methods in predicting multiple large-scale traffic datasets and exhibits significant advantages in modelling complex spatio-temporal dependencies and handling large-scale network tasks.},
  publisher = {IEEE},
  isbn = {979-8-3315-4297-9},
  keywords = {Transformer model;traffic flow forecast;graphic embedding;feature fusion},
}

@article{odmixerfinegrainedspatialtempo2025,
  author = {Y. Liu; B. Chen; Y. Zheng; L. Cheng; G. Li; L. Lin},
  title = {{ODMixer:} {Fine-Grained} {Spatial-Temporal} {MLP} for {Metro} {Origin-Destination} {Prediction}},
  journal = {IEEE Transactions on Knowledge and Data Engineering},
  year = {2025},
  volume = {37},
  number = {9},
  pages = {5508--5522},
  doi = {10.1109/TKDE.2025.3579370},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11033210},
  abstract = {Metro Origin-Destination (OD) prediction is a crucial yet challenging spatial-temporal prediction task in urban computing, which aims to accurately forecast cross-station ridership for optimizing metro scheduling and enhancing overall transport efficiency. Analyzing fine-grained and comprehensive relations among stations effectively is imperative for metro OD prediction. However, existing metro OD models either mix information from multiple OD pairs from the stationâs perspective or exclusively focus on a subset of OD pairs. These approaches may overlook fine-grained relations among OD pairs, leading to difficulties in predicting potential anomalous conditions. To address these challenges, we learn traffic evolution from the perspective of all OD pairs and propose a fine-grained spatial-temporal MLP architecture for metro OD prediction, namely ODMixer. Specifically, our ODMixer has double-branch structure and involves the Channel Mixer, the Multi-view Mixer, and the Bidirectional Trend Learner. The Channel Mixer aims to capture short-term temporal relations among OD pairs, the Multi-view Mixer concentrates on capturing spatial relations from both origin and destination perspectives. To model long-term temporal relations, we introduce the Bidirectional Trend Learner. Extensive experiments on two large-scale metro OD prediction datasets HZMOD and SHMO demonstrate the advantages of our ODMixer.},
  publisher = {IEEE},
  issn = {1558-2191},
  keywords = {Correlation learning;spatial-temporal learning;origin-destination prediction;metro system},
}

@article{dynamicloadbalancingroutingstr2025,
  author = {Y. Ju; J. Song; W. Li; Y. Zhang; C. He; F. Dong; C. Chen},
  title = {{Dynamic} {Load-Balancing} {Routing} {Strategy} for {LEO} {Satellite} {Networks} {Based} on {Spatio-Temporal} {Traffic} {Prediction}},
  journal = {IEEE Transactions on Aerospace and Electronic Systems},
  year = {2025},
  volume = {61},
  number = {5},
  pages = {11954--11970},
  doi = {10.1109/TAES.2025.3571400},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11007007},
  abstract = {Low Earth orbit (LEO) satellite networks have become increasingly important for providing global communication services. However, the highly dynamic topology and uneven load distribution in LEO satellite networks pose significant challenges for load-balancing routing techniques. We propose a dynamic load-balancing routing algorithm (DLBR) based on the multiagent dueling double deep Q-network, which adopts a fully distributed local decision-making mode to adapt to the highly dynamic satellite network topology effectively. The algorithm makes optimal routing decisions based on local load information combined with predictive traffic information. To more effectively obtain predictive traffic information and guide the load-balancing routing algorithm in making accurate decisions, we further propose a traffic prediction algorithm based on graph convolutional network, long short-term memory, and Attention mechanism, which fully utilizes the spatial and temporal features of the LEO satellite network traffic for spatio-temporal traffic prediction. Our results demonstrate that the proposed DLBR based on traffic prediction can effectively reduce the maximum and average bandwidth utilization of routing paths, thereby balancing the network load.},
  publisher = {IEEE},
  issn = {1557-9603},
  keywords = {Deep learning;deep reinforcement learning;dynamic load-balancing routing (DLBR);low Earth orbit (LEO) satellite network;spatio-temporal sequence prediction},
}

@article{dynamicgraphadaptivespatiotemp2025,
  author = {M. Maheswari; H. G M; A. Alzaidi; S. R. Surukanti; M. K},
  title = {{Dynamic} {Graph} {Adaptive} {Spatio-Temporal} {Network} for {Smart} {Traffic} {Systems}},
  journal = {2025 3rd International Conference on Data Science and Network Security (ICDSNS)},
  year = {2025},
  pages = {1--6},
  doi = {10.1109/ICDSNS65743.2025.11168722},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11168722},
  abstract = {Currently, the increasing complexity of urban traffic systems demands intelligent solutions capable of accurate and real-time traffic flow predictions. The Graph Neural Networks (GNNs) have shown strong potential by modeling spatial dependencies across road networks. However, the existing GNN-based models lack adaptability to dynamic traffic conditions, which limits their effectiveness in real-time scenarios. Hence, this study proposes a Dynamic Graph Adaptive Spatiotemporal Network (DGA-STNet) for real-time adaptability. Initially, the input data is collected from PeMSo4 dataset which contains large-scale urban traffic data. Then, the data were preprocessed with linear interpolation, z-score standardization, sliding window, and chronological order to handle missing data, normalize features, transform continuous time-series data, and avoid data leakage. Subsequently, traffic data are embedded into a high-dimensional feature space and enriched through adaptive graph construction by combining the static topology and dynamic feature similarity. Next, multi-scale gated temporal convolution and adaptive spatial attention were applied to extract the complex ST patterns. Finally, a $1 \times 1$ convolutional layer is employed to produce multi-step traffic flow predictions. The proposed DGA-STNet achieved better results in terms of the mean square error (9.87) than the existing ST Gated Graph Attention network (STGGAN) model.},
  publisher = {IEEE},
  isbn = {979-8-3315-3679-4},
  keywords = {graph neural networks;linear interpolation;smart traffic systems;spatio-temporal network;z-score standardization},
}

@article{trafficspeedpredictionbasedond2025,
  author = {W. Liu; L. Tian; R. Liu; Z. Lv; F. Wang; M. Wang},
  title = {{Traffic} {Speed} {Prediction} {Based} on {Dynamic} {Graph} {Convolution} and {Patch} {Attention} {Mechanism}},
  journal = {2025 IEEE 6th International Conference on Computer, Big Data, Artificial Intelligence (ICCBD+AI)},
  year = {2025},
  pages = {1--5},
  doi = {10.1109/ICCBDAI66607.2025.11388091},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11388091},
  abstract = {Accurate traffic speed prediction is essential for intelligent transportation systems, yet existing approaches often struggle with capturing dynamic spatio-temporal dependencies and balancing local and global temporal patterns. To address this, we propose DGCPAT, a novel framework integrating graph convolution with a Patch-Attention mechanism. The model utilizes dynamic graph convolution to learn adaptive spatial dependencies, while Intra and Inter Patch-Attention capture short-term local variations and long-term trends respectively. Evaluations on METR-LA and PEMS-BAY show that DGCPAT achieves state-of-the-art performance across MAE, RMSE, and MAPE over multiple time horizons.},
  publisher = {IEEE},
  isbn = {979-8-3503-8062-0},
  keywords = {Traffic Speed Prediction;ITS;GCN;Attention},
}

@article{dynamicgraphneuralnetworksfors2026,
  author = {K. B; J. G. K; R. M. Shiny},
  title = {{Dynamic} {Graph} {Neural} {Networks} for {Spatio-Temporal} {Traffic} {Forecasting}},
  journal = {2026 3rd International Conference on Integrated Intelligence and Communication Systems (ICIICS)},
  year = {2026},
  pages = {1--6},
  doi = {10.1109/ICIICS67880.2026.11483619},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11483619},
  abstract = {Urban traffic prediction is a very vital element of Intelligent Transportation System, where the correct acquisition of both spatial and temporal relationships at road networks is a persistent challenge. Graph Neural Networks have introduced the new paradigm of explicitly representing the structure of road network (graph representations). This survey is a systematized classification of modern traffic forecasting methods into graphbased models of architectures based on static, adaptive, and dynamic models. We explore these approaches based on fixed adjacency matrices, adaptive approaches based on learning global patterns, and dynamic architecture based on building time-varying relationships. By using a representative dynamic model, namely Generalized Dynamic Spatio-Temporal Graph Convolutional Network (GDSTGCN), we show that dynamic graph spatial-temporal coupling is performed better with the explicit modeling of short-term spatio-temporal dynamics. Full trials of the METR-LA benchmark data sets show that GDSTGCNTCN provides a mean absolute error of 3.48 which is 12 percentage points better than the none-movement methods. We pinpoint those challenges, such as computational scalability of large networks, degradation with long prediction horizons and in heterogeneous events, as well as new transformer-hybrid architectures as future directions of research.},
  publisher = {IEEE},
  isbn = {979-8-3315-8396-5},
  keywords = {Traffic Forecasting;Graph Neural Networks;Spatio-temporal modeling;Deep learning;Intelligent Transportation Systems},
}

@article{enhancinginfectiousdiseasefore2025,
  author = {M. Xu; Y. Liu; S. Guo; Y. Liu; C. Gao},
  title = {{Enhancing} {Infectious} {Disease} {Forecasting} via {Epidemiology-Informed} {Adaptive} {Spatio-Temporal} {Graph} {Neural} {Networks}},
  journal = {2025 IEEE International Conference on Bioinformatics and Biomedicine (BIBM)},
  year = {2025},
  pages = {1383--1390},
  doi = {10.1109/BIBM66473.2025.11356232},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11356232},
  abstract = {Accurate infectious disease forecasting is crucial for effective public health decision-making. Spatio-temporal graph neural networks (STGNNs) provide new insights and effective strategies for epidemic forecasting by modeling the spatio-temporal dynamics of disease transmission. However, most existing methods typically rely on fine-grained mobility and additional epidemiological information beyond reported infection cases, which are seldom accessible or practical to obtain in realworld scenarios. To address these limitations, we propose the Epidemiology-informed Adaptive Spatio-Temporal Graph neural network (EASTG), a novel forecasting framework requiring only reported infection cases. To model latent transmission dynamics, EASTG proposes an adaptive graph learning mechanism to capture both stable structural information and time-varying inter-regional dependencies directly from surveillance data. Then, a dual-stream temporal module is adopted to decompose and learn the trend and seasonal patterns inherent in epidemic time series. Furthermore, we introduce an epidemiology-informed next-generation matrix approach, which combines domain knowledge with an adaptive graph to model multi-regional epidemic transmission dynamics. Extensive experiments on three realworld datasets show that EASTG significantly outperforms state-of-the-art models. Our findings provide a practical solution for epidemic intelligence, offering reliable and meaningful forecasting even under data-constrained conditions.},
  publisher = {IEEE},
  isbn = {979-8-3315-1557-7},
  issn = {2156-1133},
  keywords = {Infectious disease forecasting;Epidemic transmission;Spatio-temporal graph neural networks;Deep learning;Time series},
}

@article{ametagraphlearningandtransform2025,
  author = {H. O. Rashid; C. Long; M. R. Hasan; F. Sultana},
  title = {{A} {Meta-Graph} {Learning} and {Transformer-Based} {Temporal} {Modeling} for {Dynamic} {City} {Traffic} {Flow} {Prediction}},
  journal = {2025 9th International Symposium on Multidisciplinary Studies and Innovative Technologies (ISMSIT)},
  year = {2025},
  pages = {1--7},
  doi = {10.1109/ISMSIT67332.2025.11268199},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11268199},
  abstract = {Urban traffic networks show significant spatial variation and complex time-based patterns, making precise traffic flow prediction essential for developing intelligent transportation systems. Traditional statistical and recurrent models often fail to effectively capture nonlinear relationships, long-term correlations, and sudden disruptions, leading to unreliable and suboptimal predictions. To address these challenges, we introduce a Meta-Graph-Transformer (MGT) framework that combines heterogeneous meta-graph learning with Transformer-based temporal modeling. The meta-graph represents various node types, including intersections, sensors, and signal controllers, and builds multidimensional edge weights based on geographic distance, flow correlation, and event impact. Multi-scale meta-path aggregation captures higher-order structural meanings, while a multi-head self-attention encoder efficiently models long-term dependencies and abrupt fluctuations. Experiments on a comprehensive urban traffic dataset reveal that MGT consistently outperforms ARIMA, LSTM, GCN, and spatio-temporal GCN models in terms of mean absolute error, mean squared error, and other metrics, particularly during multi-step forecasts and abnormal traffic conditions. These findings validate MGTâs robustness, fast convergence, and strong potential for real-world traffic management solutions.},
  publisher = {IEEE},
  isbn = {979-8-3315-9753-5},
  issn = {2770-7962},
  keywords = {Meta-Graph Transformer formatting;Meta-Path Aggregation;Intelligent Transportation Systems (ITS);Urban Traffic Flow Forecasting},
}

@article{anexploratorygraphtemporalfram2026,
  author = {J. Yuan; Y. Yang; M. Wang},
  title = {{An} {Exploratory} {Graph-Temporal} {Framework} for {Network} {Traffic} {Prediction}},
  journal = {2026 8th International Conference on Information Science, Electrical and Automation Engineering (ISEAE)},
  year = {2026},
  pages = {1174--1181},
  doi = {10.1109/ISEAE69422.2026.11544808},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11544808},
  abstract = {Network traffic prediction is important for bandwidth allocation, congestion control, and anomaly detection. Because traffic data exhibit both temporal dynamics and topology-related dependency, graph-temporal models have attracted increasing attention. This paper presents an integrated framework that combines graph convolution, LSTM-based temporal modeling, and explicit temporal feature fusion for network traffic prediction. In the proposed framework, graph convolution is used to capture structural dependency among nodes, LSTM is used to model temporal evolution, and time-related features are embedded to provide periodic context. Experiments are conducted on the Abilene dataset under a unified setting with LSTM, BiLSTM, and GCN-LSTM as baselines. The results show that conventional temporal models remain strong and stable under the current setting, while graph-based extensions are highly sensitive to topology construction and feature organization. These findings suggest that graph-temporal fusion is not guaranteed to improve prediction accuracy and should be carefully evaluated with respect to data characteristics and graph design.},
  publisher = {IEEE},
  isbn = {979-8-3315-7212-9},
  keywords = {Network traffic prediction;graph convolutional network;LSTM;temporal feature fusion;spatio-temporal learning},
}

@article{channelindependencefortrafficf2026,
  author = {Z. Wang; Y. Nie; Y. Liu; J. M. Mulvey; H. V. Poor; A. Boukerche; N. H. Nguyen; P. Sun},
  title = {{Channel-Independence} for {Traffic} {Forecasting:} {A} {Cascaded} {Spatio-Temporal} {MLP} {Framework}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2026},
  volume = {27},
  number = {6},
  pages = {6343--6355},
  doi = {10.1109/TITS.2026.3682251},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11494223},
  abstract = {The criticality of efficient traffic forecasting in Intelligent Transportation System (ITS) has garnered significant academic attention. This study addresses the prevalent issue of distribution shift in real-world datasets, which often degrades performance, and explores the effectiveness of the channel-independence (CI), a technique recently proposed to mitigate this issue. While Spatio-Temporal Graph Neural Networks (STGNNs) are noted for their flexibility to represent road structures, their designs typically lack the capability to integrate CI without disrupting the spatial relationships, potentially limiting the performance. We present a novel approach that successfully integrates CI into spatial-temporal forecasting by incorporating distinct temporal, spatial, and predefined graph structure information within each channel. Moreover, STGNNs frequently emphasize intricate designs, which result in increased computational demands while offering only marginal improvements in accuracy. This paper presents ST-MLP, a streamlined spatio-temporal model constructed exclusively from cascaded Multi-Layer Perceptron (MLP) modules and linear layers. Experimental results indicate that ST-MLP outperforms numerous existing STGNNs in both accuracy and computational efficiency. Our findings advocate for further investigation into more streamlined and effective neural network architectures within spatial-temporal forecasting research.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Traffic prediction;time series forecasting;multi-layer perceptron;intelligent transportation systems},
}

@article{ultrastfultracompactmodelforla2025,
  author = {C. -C. M. Yeh; X. Fan; Z. Jiang; Y. Fan; H. Chen; U. S. Saini; V. Lai; X. Dai; J. Wang; Z. Zhuang; L. Wang; Y. Zheng},
  title = {{UltraSTF:} {Ultra-Compact} {Model} for {Large-Scale} {Spatio-Temporal} {Forecasting}},
  journal = {2025 IEEE International Conference on Big Data (BigData)},
  year = {2025},
  pages = {1613--1618},
  doi = {10.1109/BigData66926.2025.11401591},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11401591},
  abstract = {Spatio-temporal data, prevalent in real-world applications such as traffic monitoring, financial transactions, and ride-share demands, represents a specialized case of multivariate time series characterized by high dimensionality. This high dimensionality necessitates computationally efficient models and benefits from applying univariate forecasting approaches through channel-independent strategies. SparseTSF, a recently proposed competitive univariate forecasting model, leverages periodicity to achieve compactness by focusing on cross-period dynamics, extending the Pareto frontier in terms of model size and predictive performance. However, it underperforms on spatiotemporal data due to limited capture of intra-period temporal dependencies. To address this limitation, we propose UltraSTF, which integrates a cross-period forecasting component with an ultra-compact shape bank component. Our model efficiently captures recurring patterns in time series using the attention mechanism of the shape bank component, significantly enhancing its capability to learn intra-period dynamics. UltraSTF achieves state-of-the-art performance on the LargeST benchmark while utilizing fewer than 0.2 % of the parameters required by the second-best methods, thereby further extending the Pareto frontier of existing approaches. The source code is available at: https://sites.google.com/view/ultrastf.},
  publisher = {IEEE},
  isbn = {979-8-3315-9447-3},
  issn = {2573-2978},
  keywords = {time series;forecasting;efficiency},
}

@article{highwayfreightlogisticsdemandf2026,
  author = {W. Wang; R. Li; Y. Song; H. Zhang},
  title = {{Highway} {Freight} {Logistics} {Demand} {Forecasting} in the {Core} {Yangtze} {River} {Delta} {Region} {Using} {Improved} {GCN-ATGRU} {Model}},
  journal = {2026 38th Chinese Control and Decision Conference (CCDC)},
  year = {2026},
  pages = {2726--2733},
  doi = {10.1109/CCDC69976.2026.11560147},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11560147},
  abstract = {Rapid growth in e-commerce and global trade has boosted highway freight demand. However, traditional forecasting models struggle to capture the spatio-temporal coupling characteristics of logistics networks, limiting prediction accuracy and transport capacity allocation efficiency. This paper proposes a novel GCN-ATGRU model, validated with 25 cities in Jiangsu Province, Zhejiang Province, and Shanghai Municipality in China. Key indicators (GDP, per capita disposable income, total import and export, etc) identified via Pearson correlation analysis are integrated with a city attractiveness model to construct a spatial relational graph. The model fuses Graph Convolutional Networks (GCN) for spatial dependencies and attention-augmented Gated Recurrent Units (ATGRU) for temporal dynamics, emphasizing critical time steps. Compared with TGCN, LSTM, and BP neural networks using MAE, RMSE, MAPE, and prediction accuracy, GCN-ATGRU outperforms all benchmarks. It maintains stability even for cities with low shipment volumes and high volatility, providing an effective technical solution for accurate freight demand forecasting and optimized logistics resource allocation.},
  publisher = {IEEE},
  isbn = {979-8-3315-5070-7},
  issn = {1948-9447},
  keywords = {Highway freight demand forecasting;Spatiotemporal modeling Graph;Convolutional Network;Attention mechanism;Logistics network},
}

@article{gatedtemporalgraphattentionnet2025,
  author = {M. B. Abboud; O. Baala; M. Drissi; S. Allio},
  title = {{Gated} {Temporal-Graph} {Attention} {Networks} for {Large-Scale} {Cellular} {Traffic} {Volume} {Prediction}},
  journal = {2025 International Wireless Communications and Mobile Computing (IWCMC)},
  year = {2025},
  pages = {985--990},
  doi = {10.1109/IWCMC65282.2025.11059477},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11059477},
  abstract = {With the exponential increase in data traffic, driven by the rapid growth of connected devices and high-bandwidth applications, precise prediction of network consumption becomes pivotal for optimizing telecommunications infrastructure. This challenge is intensified by the requirements of mobility prediction and Cellular Vehicle to Everything (C-V2X) applications, which necessitate high accuracy, low latency, and high reliability in network traffic prediction. In this paper, we propose a lightweight yet highly scalable Gated Temporal Graph Attention Network (Gated T-GAT) that forecasts network traffic volumes across complex environments, achieving state-of-the-art accuracy on critical short-horizon (15-minute) forecasts, an operationally critical window for telecom resource optimization. Our compact regression-based model, which integrates an MLP classifier with a Temporal-GAT, outperforms current multi-cell traffic models while eclipsing single-cell predictors. This work underscores the efficacy of coupling Temporal-GAT with an MLP classifier in managing large-scale network traffic, offering a scalable, efficient, and robust solution for high-demand forecasting scenarios.},
  publisher = {IEEE},
  isbn = {979-8-3315-0887-6},
