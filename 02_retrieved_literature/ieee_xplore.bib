  doi = {10.1109/B-HTC67770.2026.11502222},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11502222},
  abstract = {Developing economies face unique urban mobility challenges: 3.5 billion people rely on heterogeneous informal transit systems lacking real-time optimization, while infrastructure constraints prevent the deployment of conventional AI solutions. I present AdaptiMOD (Adaptive Multimodal Optimization with Deep Reinforcement Learning), a novel hybrid framework combining spatio-temporal Graph Neural Networks (ST-GNN) for demand prediction, federated Multi-Agent Reinforcement Learning (MARL) for distributed transit coordination, and diffusion-based generative models for scenario synthesis in data-scarce environments. My framework addresses three critical gaps: (1) transfer learning from data-rich to data-scarce cities achieving MAE of 3.18 with only 30% training data (comparable to 2.93 with full data within 8.5% performance gap), (2) edge-optimized models requiring <50 MB memory and <100 ms inference on ARM Cortex-M processors, and (3) privacypreserving federated learning maintaining 89.7% of centralized performance. Experimental validation using real-world datasets from three developing nation megacities, Bengaluru (India), Nairobi (Kenya), and SÃ£o Paulo (Brazil), demonstrated a 34.2% reduction in average commute time, 41.5% average decrease in carbon emissions (175,000 tons/year aggregate), and 26.7% average improvement in accessibility equity for underserved populations in simulation. The framework, datasets, and trained models were released as Digital Public Goods under the MIT license to accelerate sustainable mobility research globally.},
  publisher = {IEEE},
  isbn = {979-8-3315-8715-4},
  keywords = {sustainable transportation;multimodal optimization;deep reinforcement learning;graph neural networks;federated learning;developing economies;SDG 11},
}

@article{spectraltemporalgraphtransform2025,
  author = {A. Dayer; Akash; S. Soni; S. K. Singh},
  title = {{Spectral} {Temporal} {Graph} {Transformer} for {Massive} {MIMO} {CSI} {Prediction} in {5G} and {Beyond}},
  journal = {2025 2nd International Conference on Intelligent Algorithms for Computational Intelligence Systems (IACIS)},
