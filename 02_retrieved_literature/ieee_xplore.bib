  doi = {10.1109/ITSC60802.2025.11423457},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11423457},
  abstract = {Effective winter road maintenance (WRM) is critical for the safety and mobility of road users in cold regions. High spatial resolution predictions of road surface conditions greatly improve WRM efficiency. Previous studies have explored spatial modeling to achieve this; however, traditional statistical models, such as Kriging, face limitations in capturing complex spatial dependency. In this study, we utilized graph neural networks (GNNs) for spatial modeling to predict road surface temperature (RST), which an essential road weather parameter, at high spatial resolution. Furthermore, by integrating this approach with time-series prediction model at road weather observatories and weather mesh forecast data, we propose a framework that enables high spatial-resolution RST predictions over future horizons. Experiments using real-world data from Sapporo, Japan demonstrated that the proposed method could predict RST at approximately $\mathbf\{1 0 0\}$-meter intervals along road networks with an root mean square error below 2Â° C for future horizons up to $\mathbf\{2 4 h\}$. In conclusion, the study findings represent a significant improvement in accuracy over current operational methods, offering valuable support for decision-making in WRM planning to enhance road safety and mobility.},
  publisher = {IEEE},
  isbn = {979-8-3315-2418-0},
  issn = {2153-0017},
  keywords = {graph neural networks;road maintenance;road surface temperature;spatial modeling},
}

@article{mhcagatametahybridconvolutiona2025,
  author = {Y. Zhan; S. I. Fadilah; A. Rahman Mohd Shariff},
  title = {{MHCAGAT:} {A} {Meta} {Hybrid} {Convolution} {Attention} {Network} for {Urban} {Traffic} {Flow} {Prediction}},
  journal = {IEEE Access},
  year = {2025},
  volume = {13},
  pages = {101211--101223},
  doi = {10.1109/ACCESS.2025.3578030},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11028985},
  abstract = {Urban traffic flow prediction is a core task in intelligent transportation systems and plays a vital role in enabling real-time decision making and congestion management. However, increasingly strict privacy regulations and highly fragmented data collection environments such as VANETs have substantially reduced the amount of usable data, thereby making it significantly more challenging to build accurate and reliable models. To address these issues, a novel traffic prediction model is proposed, Meta Hybrid Convolution Attention Graph Attention Network (MHCAGAT). MHCAGAT integrates meta-learning with a base HCAGAT model, where the HCA block is responsible for extracting temporal dependencies and the GAT block captures spatial correlations within the traffic data. This architecture enables rapid convergence and stable performance in small-sample and resource-constrained settings. Experiments conducted on real-world traffic data from the Luohu District of Shenzhen demonstrate that MHCAGAT ranks within the top two across all five evaluation metrics while maintaining the lowest standard deviation, indicating exceptional stability and robustness. Further ablation analysis shows that even without incorporating meta-learning and recurrent structures, the HCAGAT model performs comparably to dedicated temporal models, highlighting the effectiveness and versatility of the architecture in time sequence modeling tasks. In conclusion, MHCAGAT achieves a well-balanced trade-off between accuracy and stability, offering a powerful solution for traffic prediction scenarios characterized by limited data and constrained computational resources.},
  publisher = {IEEE},
  issn = {2169-3536},
  keywords = {MHCAGAT;meta-learning;attention mechanism;few-shot learning;HCA block;urban traffic flow prediction},
}

@article{riskawarestochasticvehicletraj2025,
  author = {Y. Feng; Q. Ye; E. Candela; J. Javier Escribano-Macias; B. Hu; Y. Demiris; P. Angeloudis},
  title = {{Risk-Aware} {Stochastic} {Vehicle} {Trajectory} {Prediction} {With} {Spatial-Temporal} {Interaction} {Modeling}},
