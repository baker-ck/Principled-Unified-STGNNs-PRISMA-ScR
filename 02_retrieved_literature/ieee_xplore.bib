@article{aiepicastintelligentforecastin2026,
  author = {G. R. Sri; B. S. Reddy; R. S. Rupa; T. Jagadeshwar; M. Nadeem},
  title = {{AI-Epicast:} {Intelligent} {Forecasting} of {Epidemic} {Dynamics} using {Population} {Data}},
