@article{federatedspatialtemporalsynchr2026,
  author = {X. Yu; Y. Bao; W. Jiang; Q. Shi},
  title = {{Federated} {SpatialâTemporal} {Synchronous} {Graph} {Convolutional} {Network} for {Cross-City} {Traffic} {Prediction}},
  journal = {IEEE Transactions on Consumer Electronics},
  year = {2026},
  volume = {72},
