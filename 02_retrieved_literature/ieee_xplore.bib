@article{mhgnetmultiheterogeneousgraphn2025,
  author = {M. Wu; Y. Lin; T. Jiang; W. Weng},
  title = {{MHGNet:} {Multi-Heterogeneous} {Graph} {Neural} {Network} for {Traffic} {Prediction}},
