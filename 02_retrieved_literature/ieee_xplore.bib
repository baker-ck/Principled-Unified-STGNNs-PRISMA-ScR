  abstract = {Accurate short-term passenger flow forecasting in bus networks is vital for optimizing transit operations and improving service reliability. However, due to complex spatial-temporal dependencies and dynamic demand patterns, this task remains challenging. While several deep learning models have been applied to passenger flow prediction, the increasing availability of real-time data has led to the growing use of graph neural networks (GNNs) combined with temporal models that effectively capture spatial and temporal dependencies by modeling transit networks as graphs of nodes and links. Yet, like many deep learning models, GNN-based approaches suffer from limited explainability, restricting their practical use. To address this challenge, we propose BNConv-LSTMâan explainable spatiotemporal graph-based framework for forecasting short-term bus passenger flow. Our proposed model captures spatial and temporal dependencies on the bus network by integrating a graph convolutional LSTM architecture with learnable spatial and temporal soft masks. These masks help improve the interpretability of the modelâs predictions by highlighting the most influential bus stops and time steps contributing to each forecast. Evaluated on real-world data from the Ames Bus Network in Iowa, USA, BNConv-LSTM consistently demonstrates reliable performance in both prediction and explainability. The modelâs learnable spatial and temporal soft masks offer interpretable insights into the spatial and temporal patterns influencing passenger demand, making it a powerful tool for both effective forecasting and well-informed transit planning.},
  publisher = {IEEE},
  isbn = {979-8-3315-4748-6},
  issn = {2472-9671},
  keywords = {passenger flow forecasting;bus networks;graph neural networks;graph explainability;spatial and temporal masks},
}

@article{ageographicaldistanceenhanceds2025,
  author = {Y. Luo; J. Chen; X. Jiang; Y. Liu; L. Zhang},
  title = {{A} {Geographical} {Distance-Enhanced} {Spatial-Temporal} {Graph} {Neural} {Network} for {Bike} {Demand} {Prediction}},
  journal = {2025 IEEE International Conference on Big Data (BigData)},
  year = {2025},
  pages = {1462--1467},
  doi = {10.1109/BigData66926.2025.11401744},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11401744},
  abstract = {Bike-sharing systems have become integral components of sustainable urban mobility. Accurate demand prediction is essential for balancing supply and ensuring service quality. However, existing spatial-temporal prediction models often ignore geographical distance and lack effective extraction of local and global information, limiting their ability to capture complex multi-scale features. To address these challenges, we propose the Geographical Distance-Enhanced Spatial-Temporal Graph Neural Network (GestGNN), a dual-branch framework to integrate local and global spatial-temporal information. In the local branch, the raw inter-station distance matrix is transformed into multi-scale distance matrices using gaussian kernel functions, then a Geographical Distance-based Graph Attention Network (GeoGAT) is applied to learn fine-grained spatial dependencies. In the global branch, dynamic spatial-temporal patterns are modeled to enable comprehensive extraction of global spa-tial-temporal features. Extensive experiments are conducted on three classic datasets, demonstrating that GestGNN consistently outperforms baseline methods across all datasets. Compared to state-of-the-art methods, GestGNN achieves up to a 6.50% reduction in MSE over the 60-minute interval. Additionally, ablation studies and parameter analysis are performed to confirm the necessity of each component in the architecture. Our code is publicly available at https://github.com/BUPT-ANTlab/GestGNN.},
  publisher = {IEEE},
  isbn = {979-8-3315-9447-3},
  issn = {2573-2978},
  keywords = {Bike Demand Prediction;Spatial-Temporal Data;Graph Neural Network;Geographical Enhancement},
}

