  abstract = {Water quality monitoring is vital for environmental protection and public health, but it is often hindered by high costs and delays in laboratory testing. This paper presents a near-real-time Water Quality Index (WQI) estimation method designed for an autonomous sensing platform that measures a subset of parameters needed for traditional WQI calculation. The system collects eleven in situ parameters, including pH, dissolved oxygen, turbidity, conductivity, temperature, total dissolved solids, salinity, oxidationâreduction potential, depth, chlorophyll, and fluorescence, along with GPS-based spatial data. We propose a Spatio-Temporal Graph Neural Network (ST-GNN) that combines graph and temporal convolutions with attention mechanisms to capture spatial relationships and temporal patterns across monitoring sites, enabling indirect, data-driven WQI estimation without the need for laboratory tests on coliform bacteria, biochemical oxygen demand, nutrients, and waste indicators. The model was tested on a dataset of 1,268 samples from 56 monitoring stations, which include both sensor and lab measurements, achieving an RMSE of 3.45 WQI units, an MAE of 2.67 units, and an R2 of 0.947. It outperformed benchmarks such as LSTM, Random Forest, Support Vector Regression, and linear regression. The approach offers a promising pathway for affordable and scalable water quality monitoring in large aquatic environments, although predictions are inherently limited to the correlations observed within the training data.},
  publisher = {IEEE},
  issn = {2169-3536},
  keywords = {Water quality index (WQI);spatio-temporal graph neural networks;environmental monitoring;autonomous sensing systems;deep learning;sensor networks},
}

@article{graphneuralnetworkbasedinterne2025,
