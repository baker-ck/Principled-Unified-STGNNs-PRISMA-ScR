  doi = {10.1109/ICOIICS67115.2025.11390354},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11390354},
  abstract = {This paper proposes a robust architecture for dynamic high-dimensional communication network traffic prediction that combines the Multi-Objective Rime Optimization Algorithm (MO-RIME) with Hierarchical Deep Reinforcement Learning (H-DDPG). This framework deeply integrates a physics-inspired multi-objective swarm intelligence optimization mechanism with an adaptive policy learning mechanism. This innovation enables a multi-layered optimization process of âglobal search-local refinement-dynamic equilibrium.â MORIME leverages the condensation nucleus formation, particle growth, and heat diffusion mechanisms of rime to initialize the solution space, perform local refinement search, and perform global information diffusion. H-DDPG dynamically adjusts multi-objective weights based on real-time prediction performance and network state feedback. The model enhances prediction robustness by combining constrained distribution similarity (Jensen-Shannon divergence) and sparsity metrics. Experiments were conducted on Abilene, GÃANT, MAWI, and high-dimensional synthetic datasets $(\mathrm\{N\}=500, \mathrm\{D\}=5, ~\mathrm\{K\}=10)$. The framework also covers standard scenarios, bursty traffic, topology changes, and noise/encryption interference. The results show that on the Abilene dataset, the RMSE, MAE, and MAPE of MO-RIME + H-DDPG are reduced by more than 60 % compared to ARIMA. This result is about 30 % lower than that of LSTM and ST-GCN. On the high-dimensional synthetic dataset, the RMSE is 36.8 and the MAPE is 9.7. This result is more than 40 % lower than that of LSTM, ST-GCN, and MOEA/D+DNN. The multi-objective adaptive mechanism reduces the sparsity ratio to 34 %. Experimental results show that the framework has high accuracy and strong robustness in the complex highdimensional dynamic environments.},
  publisher = {IEEE},
  isbn = {979-8-3315-9897-6},
  keywords = {Multi-Objective Optimization;Deep Reinforcement Learning;Communication Network Traffic Prediction;Dynamic High-Dimensional Modeling;Rime Optimization Algorithm},
}

