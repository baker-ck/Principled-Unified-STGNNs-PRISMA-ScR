  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11605606},
  abstract = {In Virtual Machine (VM) workload prediction in cloud data center, the existing methods have the problems of unclear spatio-temporal feature fusion and low prediction accuracy. To address these issues, we propose a GST-Transformer hybrid prediction model. Firstly, the feature alignment module was used to standardize the CPU utilization rate, memory occupancy rate and network traffic sequence of VMS to generate feature tensors. Then, a dynamic adaptive graph construction strategy is designed to integrate physical location co-location and network similarity, generating a smoothly evolving adjacency matrix via exponential moving average, to adapt to workload changes, and accurately characterize the time dependence between VMS. Then, GCN and LSTM were used to encode spatial dependent and temporal dependent features respectively, and the learnable attention mechanism was combined to realize the deep fusion of spatio-temporal features. Finally, the Transformer decoder is used to capture the global time dependence and output the end-to-end multi-VM workload prediction results. Experiments are based on the Google Cluster Trace dataset. Compared with LSTM and CNN-LSTM models, the RMSE of the proposed model is reduced by 8.3% â¼ 17.9%, and the MAE is reduced by 11.5% â¼ 20.0%, which effectively boosts the precision and stability of multi-VM workload forecasting..},
  publisher = {IEEE},
  isbn = {979-8-3315-4648-9},
  keywords = {Load prediction;Spatio-temporal features;Graph Neural Network;Transformer},
}

