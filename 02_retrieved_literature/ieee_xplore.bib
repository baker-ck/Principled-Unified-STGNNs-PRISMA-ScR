  doi = {10.1109/IC-AIDA68291.2026.11564474},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11564474},
  abstract = {As population, traffic, and industrial activity rise, cities are under pressure to manage air pollution. In order to overcome this impediment, we require systems that are capable of not only analysing detailed environmental patterns but also offering solutions that are appropriate. To meet this demand, we propose CHROMA-ER, a novel optimization framework based on how biological chromosomes organize and manage information. CHROMA-ER links emission prediction and emission management by representing each chromosomal component as a major pollutant source, such as transportation, power generation, industrial activities, or waste disposal. Individual genes are responsible for recording decisions that pertain to sensory perception, behavioural modeling, and the intensity or timing of potential interventions within these segments. This paradigm is based on the concept that biological evolution covers enormous territories fast. CHROMA-ER leverages natural chromosome-like mechanisms to alter this method. The processes are recombination, inversion, duplication, deletion, and context-dependent masking. These operations overhaul candidate approaches. Because of this, the system may assess different emission control methods while retaining sector-level data structure and relevance. By capturing pollutant behavior over time and location, graph neural networks and temporal models predict each strategyâs outcome. CHROMA-ER regularly provided correct estimates throughout the study. The model performed well with $90 \%$ accuracy, precision, recall, and $F 1$-score. This suggests that chromosome-based representation improves efficient learning and balanced judgment. CHROMA-ER demonstrated its ability to build adaptive environmental intelligence systems to assist urban planners and authorities in city cleanup.},
  publisher = {IEEE},
  isbn = {979-8-3315-9158-8},
  keywords = {Chromosome-Inspired Optimization;Emission Reduction;Environmental AI;Multi-Objective Evolution;Pollution Forecasting},
}

@article{adaptimodahybriddeeplearningan2026,
  author = {M. Chandrasekaran},
  title = {{AdaptiMOD:} {A} {Hybrid} {Deep} {Learning} and {Multi-Agent} {Reinforcement} {Learning} {Framework} for {Sustainable} {Multimodal} {Transportation} in {Developing} {Economies}},
  journal = {2026 IEEE Bangalore Humanitarian Technology Conference (B-HTC)},
  year = {2026},
