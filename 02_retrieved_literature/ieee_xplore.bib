  abstract = {Existing traffic flow prediction models generally suffer from three limitations: reliance on static graph structures makes them ill-suited to adapt to dynamic topological changes caused by sudden accidents, construction, etc.; lack of effective semantic alignment and deep fusion mechanisms for multimodal heterogeneous data such as weather and event text; and insufficient long-range dependency capture capabilities in temporal modeling modules. To address these issues, this paper proposes a Dynamic Multimodal Spatio-Temporal Graph Neural Network (DM-STGNN). Its core innovations include: 1) designing a topology sensor that integrates real-time traffic flow gradients with event semantics to dynamically generate time-varying adjacency matrices; 2) introducing a hierarchical cross-modal fusion mechanism to achieve semantic alignment and dynamically weighted integration of meteorological, event, and traffic flow data; 3) Introducing a gated spatio-temporal Transformer and pulse perturbation injection mechanism to enhance long-range dependency modeling and rapid response to sudden events. Experiments on the PeMS08 dataset demonstrate that DM-STGNN reduces prediction errors by over 35% compared to the best static baseline model in long-term forecasting tasks, while exhibiting exceptional robustness and foresight in complex scenarios such as sudden congestion, heavy rainfall, and road construction.},
  publisher = {IEEE},
  isbn = {979-8-3315-5490-3},
  keywords = {traffic flow prediction;dynamic graph neural network;multimodal fusion;topology awareness;cross-modal alignment},
}

@article{wavelettransformbasedgraphneur2025,
