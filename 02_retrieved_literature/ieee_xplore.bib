  doi = {10.1109/ICCA66035.2025.11431075},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11431075},
  abstract = {Achieving human-like reasoning in autonomous driving systems remains a critical challenge, necessitating a balance between the interpretability of rule-based logic and the adaptability of end-to-end deep learning. This paper introduces GraphDrive, a novel decision-making framework that integrates Graph Attention Networks (GATs) to model dynamic relational dependencies within driving scenes. Unlike traditional black-box architectures, the proposed method constructs a semantic graph where nodes represent key environmental elementsâsuch as vehicles, pedestrians, and traffic signalsâderived through auxiliary supervision tasks. A relational attention mechanism dynamically weighs these nodes, mimicking human cognitive focus to prioritize high-risk interactions effectively. The system is trained using a multi-task learning approach, where intermediate outputs serve as semantic scaffolding to guide the network toward robust control command generation, including steering, speed, and waypoints. Extensive evaluations on the DriveCoT benchmark demonstrate that GraphDrive achieves a 11% gain in control speed F1 score and a 8.14% improvement in trajectory precision compared to state-of-the-art baselines. These results validate the efficacy of graph-based relational reasoning in enhancing both the performance and transparency of autonomous driving policies.},
  publisher = {IEEE},
  isbn = {979-8-3315-9953-9},
  keywords = {Autonomous Driving;Graph Neural Networks;Relational Reasoning;End-to-End Learning;Interpretability;Multi-Task Learning},
}

@article{spatiotemporaldualattentiontra2026,
  author = {X. Song; Q. Lai; D. He},
  title = {{Spatiotemporal} {Dual} {Attention} {Trajectory} {Prediction} with {Topological} {Attention} {Enhancement} and {Conservatism} {Constraint}},
