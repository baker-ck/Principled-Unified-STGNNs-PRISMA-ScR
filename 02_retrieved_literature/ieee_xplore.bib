  pages = {11453--11464},
  doi = {10.1109/TCE.2025.3627965},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11224396},
  abstract = {The growing integration of IoT consumer electronics into urban infrastructure has led to the generation of vast amounts of real-time data from traffic sensors, weather stations, and connected devices. By combining traffic flow information with weather conditions and their holographic digital twin counterparts, cities can improve congestion management under varying environmental scenarios. However, most existing traffic flow prediction models overlook the latent spatial relationships within transportation networks and fail to address prediction errors caused by external factors such as weather, reducing forecast accuracy. To overcome these limitations, this paper introduces the Holographic Digital Twin Graph Convolutional Network (HDT-GCN), a dual-graph convolution framework built on Temporal Convolutional Networks (TCNs) to fuse traffic flow and weather features into an augmented representation. This approach jointly models temporal dependencies, spatial correlations, and dynamic inter-regional interactions, while mitigating the negative impact of complex weather patterns on prediction outcomes. The incorporation of holographic digital twins enhances system visualization, real-time decision-making, and interactive accessibility through IoT consumer devices. Extensive experiments on the real-world TaxiBJ and PeMSD4 datasets demonstrate that HDT-GCN achieves superior prediction accuracy and robustness compared to state-of-the-art methods.},
  publisher = {IEEE},
  issn = {1558-4127},
  keywords = {Holographic digital twin;graph convolutional network;traffic flow prediction;temporal convolutional networks;IoT consumer electronics;smart transportation systems},
}

@article{stgcnformerspatiotemporalduals2025,
  author = {C. Yang; H. Pan; J. Wang},
  title = {{STGCNFormer:} {Spatio-Temporal} {Dual-Stream} {Graph} {Convolutional} {Networks} and {Transformers} for {Traffic} {Forecasting}},
  journal = {IEEE Transactions on Vehicular Technology},
  year = {2025},
  volume = {74},
  number = {10},
  pages = {15254--15263},
  doi = {10.1109/TVT.2025.3572622},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11010912},
  abstract = {In intelligent transportation systems, traffic prediction constitutes the fundamental component of traffic optimization, aiming to precisely forecast traffic flow. Modeling spatio-temporal interactions is a crucial step in achieving long-term and accurate predictions. Traditional methods are mostly based on single-stream networks, which alternately extract spatio-temporal features through sequential iterations. However, time and space are inherently two different modalities. Employing a single-stream network to address multi-modal tasks is suboptimal. In this paper, we propose Spatio-Temporal Dual-Stream Graph Convolutional Networks and Transformers (STGCNFormer), a dual-stream network for traffic forecasting, decoupling spatio-temporal features in parallel through a temporal stream and a spatial stream. The core of STGCNFormer is a STGCNFormer block, comprising three components. The first component is a GCN block, which restricts the kernel of graph convolution and adopts Chebyshev polynomials of the first kind to approximate the convolutional kernel, capturing spatial interactions and achieving localized convolution. Secondly, we present a Transformer block, designed as a simplified version of vanilla Transformers, which captures temporal interactions and significantly reduces computational complexity. Thirdly, we propose a cross attention mechanism, consisting of a temporal attention mechanism and a spatial attention mechanism, which serves as a bidirectional bridge for sharing information between the dual streams. Experimental results demonstrate that STGCNFormer achieves superior prediction accuracy with reduced computational complexity compared with previous state-of-the-art methods.},
  publisher = {IEEE},
  issn = {1939-9359},
  keywords = {Traffic forecasting;dual-stream networks;graph convolutional networks;Transformers;attention mechanism},
}

@article{spatiotemporaltrafficanalysisd2025,
