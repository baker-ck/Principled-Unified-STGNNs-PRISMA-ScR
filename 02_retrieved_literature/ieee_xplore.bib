  abstract = {Large-scale networks play a pivotal role in modern urban engineering systems, driving economic growth, social connectivity, and environmental sustainability. However, traditional analytical methods struggle to address their inherent complexity and dynamic interdependencies, particularly under disruptions such as failures or evolving demands. Graph Convolutional Networks (GCNs), with their ability to model spatial-temporal relationships and propagate dynamic impacts across interconnected nodes, offer a transformative approach to these challenges. This study proposes a multi-model framework integrating GCNs, clustering algorithms, and genetic algorithms to optimize Baltimore's network. A GCN-based prediction model analyzes the cascading effects of the Francis Scott Key Bridge collapse, revealing a 31.3 % improvement in global network efficiency (E_âglobalâ) post-reconstruction and a 29.6% reduction in community segregation (I_c) in West Baltimore. For pedestrian facilities, a hybrid queueing model dynamically adjusts pedestrian-vehicle signals, reducing average detour distances by 40 % near the US-40 highway and increasing pedestrian coverage by 56 %. A genetic algorithm optimizes bus stop distribution, achieving $\mathbf\{7 0 - 1 0 0 \%\}$ coverage in underserved residential clusters and reducing commuter travel times by 20 %. These data-driven solutions demonstrate how advanced graphbased learning and optimization techniques can mitigate urban mobility challenges, enhance stakeholder equity, and foster resilient systems.},
  publisher = {IEEE},
  isbn = {979-8-3315-2689-4},
  issn = {2770-663X},
  keywords = {Network flow;Graph Convolutional Networks;Engineering Systems;Dynamic Impact},
