  title = {{Disentangling} {Spatio-Temporal} {Dependencies} for {Traffic} {Forecasting} via a {Serial} {Encoder} and {Hierarchical} {Attention}},
  journal = {2025 International Conference on New Trends in Computational Intelligence (NTCI)},
  year = {2025},
  pages = {1--5},
  doi = {10.1109/NTCI67886.2025.11308297},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11308297},
  abstract = {Accurately forecasting spatio-temporal traffic data is crucial for intelligent transportation systems, yet it remains a significant challenge due to complex and hierarchical spatial dependencies. Existing methods often rely on tightly coupled architectures that confound temporal and spatial feature learning, and their simple mechanisms for fusing multi-scale spatial information fail to capture these hierarchical relationships effectively. To address these limitations, we propose the Hierarchical Multi-Scale Graph Neural Network (H-MSGNN), a novel framework for traffic forecasting. Our model introduces a serial encoder architecture that disentangles spatio-temporal modeling by first employing a Transformer-based temporal encoder to capture node-specific time-series patterns. Subsequently, our spatial encoder introduces two key innovations: an adaptive fusion mechanism to integrate robust static graphs with dynamic semantic graphs, and a novel hierarchical attention mechanism that replaces simple aggregation with a top-down recursive fusion of multi-hop graph features. Extensive experiments on benchmark datasets including PEMS04, PEMS07, and PEMS08 demonstrate that H-MSGNN significantly outperforms a wide range of state-of-the-art baselines, validating the superiority of our architectural and methodological advancements.},
  publisher = {IEEE},
  isbn = {979-8-3315-5614-3},
  keywords = {Intelligent transportation systems (ITS);traffic forecasting;graph neural networks (GNN);Transformer;hierarchical attention;multiscale graph representation},
}

@article{distributedphotovoltaicpowerfo2026,
