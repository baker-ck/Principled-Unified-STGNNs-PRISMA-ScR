  journal = {2026 11th International Conference on Computer and Communication Systems (ICCCS)},
  year = {2026},
  pages = {1314--1318},
  doi = {10.1109/ICCCS69761.2026.11613270},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11613270},
  abstract = {Graph neural networks demonstrate excellent performance in traffic flow prediction, but their high computational cost limits real-time deployment. Knowledge distillation techniques, such as LightST, achieve efficient prediction by transferring knowledge from complex GNN teachers to lightweight MLP students. However, existing methods rely on a single teacher model, making it difficult to fully decouple and capture complex spatio-temporal coupling features, and static distillation strategies cannot adapt to traffic dynamics. We tackle these limitations by a lightweight traffic prediction framework based on fusion teacher distillation. This framework pre-trains dual teachers, one spatial and one temporal, to independently capture graph structures and temporal dynamics, and introduces a lightweight scene-aware fusion module. This module dynamically learns fusion weights. The proposed method comprehensively improves prediction accuracy while maintaining inference speeds comparable to LightST.},
  publisher = {IEEE},
  isbn = {979-8-3195-0734-1},
  issn = {2995-3251},
  keywords = {Traffic flow prediction;Knowledge distillation;Fusion teacher;Lightweight neural network},
}

@article{residualspatiotemporalgraphnet2026,
  author = {Y. Zhou; W. Li; J. Liu; K. Zhao},
  title = {{Residual} {Spatio-Temporal} {Graph} {Network} with {Weighted} {Loss} for {Traffic} {Prediction} in {Unbalanced} {Load} {Satellite} {Networks}},
  journal = {2026 11th International Conference on Computer and Communication Systems (ICCCS)},
  year = {2026},
  pages = {365--370},
  doi = {10.1109/ICCCS69761.2026.11613412},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11613412},
  abstract = {Low Earth Orbit satellite constellations are fundamental to integrated networks, yet their traffic exhibits significant spatio-temporal heterogeneity and long-tail distributions. Existing spatio-temporal graph neural networks often suffer from over-smoothing at low-traffic edge nodes, leading to performance degradation. To address this, we propose Res-GCN-LSTM, a residual STGN with a region-aware weighting mechanism. The model utilizes a dual-path architecture: it couples GCN with LSTM to capture spatio-temporal dependencies while employing input-level residual connections to model traffic increments, thereby suppressing heterogeneous noise. Furthermore, a region-aware weighted loss function is designed to prioritize low-traffic samples, improving accuracy for challenging edge nodes. Simulation results show that our method significantly enhances prediction in lowload regions while maintaining high-load precision. Notably, Res-GCN-LSTM reduces the Root Mean Square Error by 3.10%, 65.19%, and 68.23% compared to ARIMA, Pure LSTM, and standard GCN-LSTM, respectively. This demonstrates its superior robustness and generalization under unbalanced load conditions.},
  publisher = {IEEE},
  isbn = {979-8-3195-0734-1},
  issn = {2995-3251},
  keywords = {LEO Satellite Constellations;Traffic Prediction;Residual Connection;Graph Neural Network},
}

@article{dstanetatrajectorydistribution2025,
  author = {T. Li; X. Sun; Q. Dong; G. Guo},
  title = {{DSTAnet:} {A} {Trajectory} {Distribution-Aware} {Spatio-Temporal} {Attention} {Network} for {Vehicle} {Trajectory} {Prediction}},
  journal = {IEEE Transactions on Vehicular Technology},
  year = {2025},
  volume = {74},
  number = {7},
  pages = {10187--10197},
  doi = {10.1109/TVT.2025.3548019},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10912789},
  abstract = {Trajectory prediction is a crucial task of autonomous driving and benefits vehicles travel safely in complex traffic environments. However, most existing trajectory prediction methods suffer from low accuracy issue due to the highly complex and dynamic interactions between vehicles, as well as the uncertainty of driver intentions in real-world scenarios. To address these challenges, we propose a trajectory Distribution-aware Spatio-Temporal Attention network (DSTAnet) for vehicle trajectory prediction. The proposed DSTAnet begins with a temporal feature extractor that combines Transformer Encoder Layers (TEL) and Gated Recurrent Units (GRU), extracting both long-term teporal dependencies and short-term variations in vehicle trajectories. Next, Graph Attention Networks (GAT) are introduced to extract spatial features in dynamically changing interactions, and focus on the most noteworthy vehicles, which are beneficial for modeling interactions between vehicles. Meanwhile, Mixed Density Network (MDN) is used to learn potential trajectory distributions from spatiotemporal features, which enriches the features related to driver intentions, providing a probabilistic understanding of possible future trajectories. By predicting multiple trajectories through random sampling, DSTAnet captures the inherent uncertainty of driver intentions. Finally, the INTERACTION dataset is adopted to estimate the model performance and results indicate that the proposed method outperforms others.},
  publisher = {IEEE},
  issn = {1939-9359},
  keywords = {Trajectory prediction;transformer encoder;graph attention networks;trajectory distribution},
}

@article{grapeefficientspatiotemporalpr2025,
  author = {L. Zeng; Y. Liu; S. Ye; M. Yuan; D. Duan; X. Chen; G. Xing},
  title = {{Grape:} {Efficient} {Spatiotemporal} {Prediction} {Services} with {Stale} {Sensing} {Streams}},
  journal = {2025 IEEE Real-Time Systems Symposium (RTSS)},
  year = {2025},
  pages = {229--243},
  doi = {10.1109/RTSS66672.2025.00027},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11315101},
  abstract = {Emerging cyber-physical systems have embraced a large number of IoT devices spanning geo-distributed, which generate and consume massive volumes of data continuously. Accurate and timely spatiotemporal predictions (STP) over these streaming sensor data are critical and, in growing demand, ubiquitous across various edge scenarios such as traffic flow forecasting. Towards that, recent advanced systems have developed sophisticated optimizations among STP pipelines, aiming at optimal prediction performance. However, based on our empirical studies in real-world settings, we identify a previously overlooked bottleneck of end-to-end STP performance: data staleness. To mitigate this issue, in this work, we investigate a new task, namely stream interception, which deliberately terminates the acceptance of incoming sensor data and anticipates model execution with imputed missing features. We propose a novel dynamic interception strategy to determine the time slot to exit waiting and present Grape, an STP system that implements it with practical system designs. Extensive evaluations on real-world traces show that Grape can strike a superior tradeoff between prediction accuracy and serving latency, achieving 1.69-1.90Ã speedup against traditional all-waiting baselines across various STP services with high prediction accuracy on par with offline optimal cases.},
  publisher = {IEEE},
  isbn = {979-8-3315-9642-2},
  issn = {2576-3172},
  keywords = {Spatiotemporal prediction;model inference;edge intelligence;data staleness},
}

@article{impactofblinkitspatiotemporalg2025,
  author = {N. U. Prakash; R. Veluchamy; M. G. Alias Kanagaraj; K. Sathiyamurthi; K. K. Karthick; V. Vimalnath},
  title = {{Impact} of {Blinkit:} {Spatio-Temporal} {GNN} {Framework} for {Sustainable} {Demand} {Forecasting} in {Q-Commerce}},
  journal = {2025 IEEE 5th International Conference on ICT in Business Industry \& Government (ICTBIG)},
  year = {2025},
  pages = {1--7},
  doi = {10.1109/ICTBIG68706.2025.11323845},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11323845},
  abstract = {The rapid commerce platforms have transformed city retailing through the delivery of groceries and other necessities within a few minutes, which requires highly accurate demand forecasting and last-mile logistics. To overcome the drawbacks of the previous models, which could not describe the complicated spatial and time interactions, a graph-based predictive model of Blinkit, which is one of the leading Q-commerce providers, was developed. Spatio-temporal graphs of large-scale transactional records and real-time rider mobility data were modelled as a multi-layer and analyzed as a Graph Neural Network with predictive analytics. The efficiency of transportation was determined by using SUMO-based urban network simulation. The proposed system attained an absolute error in the demand forecasting mean of 2.7 %, an F1-score of 0.93 on surge detection, and an average error on delivery time of 3.5 minutes. The simulation outcomes also showed that it will utilize 86 % of its fleet, a maximum congestion index of 0.48, and the emission of carbon per delivery is 24 % less. These results prove the capability of the framework to contribute to the efficiency of quick-commerce and enable sustainable consumer-oriented operations.},
  publisher = {IEEE},
  isbn = {979-8-3315-7981-4},
  keywords = {Spatio-Temporal Graph Neural Network;Stock Keeping Unit;Traffic Control Interface;Model-View-Controller;Uniform Resource Identifier},
}

@article{ataskorientedspatialgraphstruc2025,
  author = {T. Wang; S. Zhao; W. Jia; D. Shi},
  title = {{A} {Task-Oriented} {Spatial} {Graph} {Structure} {Learning} {Method} for {Traffic} {Forecasting}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2025},
  volume = {26},
  number = {4},
  pages = {4770--4779},
  doi = {10.1109/TITS.2025.3537637},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10887397},
  abstract = {Traffic forecasting is the foundation of intelligent transportation systems (ITS). In recent, graph neural networks (GNNs) have successfully captured spatial-temporal dependencies to forecast traffic conditions by transforming traffic data in the graph domain. Nevertheless, the existing methods focus only on learning informative graph representations and fail to model informative graph structures, which hinders the capture of dynamic spatial-temporal dependencies caused by dynamic factors such as weather, accidents, and special events. In this paper, we propose a novel task-oriented Spatial Graph Structure Learning (SGSL) method, which aims to capture dynamic dependencies by jointly learning graph structures and graph representations. Compared to methods that use spectral graph representations, we exploit a learnable spatial graph to effectively model dynamic dependencies in traffic data. Moreover, we directly define graph convolutions on spatial relations to specify different edge weights when aggregating the information of spatial neighbours. Thus, the graph structure alterations, i.e., the relation changes, and the time-varying weights of relations can be encapsulated, thereby effectively representing dynamic dependencies. The gradient descent strategy is introduced to periodically learn a spatial graph through joint optimization with a newly designed deep graph learning model named GAT-nLSTM. In this manner, the intrinsic behaviours of nodes are learned to capture correlations across periods. Notably, the optimization process is performed under the traffic forecasting constraint to ensure that the learned spatial graph is specific to this task. Compared with those of state-of-the-art baselines, the experimental results obtained on real-world traffic datasets show significant improvement, which verifies the superiority of the proposed SGSL.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Graph structure learning;traffic forecasting;spatial-temporal dependencies;spatial graph;graph representation},
}

@article{cvlsstacrossviewlongshortframe2026,
  author = {Y. Yuan; X. Chen; Z. Peng; M. Li; Z. Yu; Y. Wu; T. Baker},
  title = {{CVLS-ST:} {A} {Cross-View} {Long-Short} {Framework} for {Traffic} {Risk} {Prediction} in {Intelligent} {Urban} {Transportation} {Systems}},
  journal = {IEEE Transactions on Consumer Electronics},
  year = {2026},
  volume = {72},
  number = {2},
  pages = {2930--2942},
  doi = {10.1109/TCE.2026.3681333},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11475507},
  abstract = {As a cornerstone of smart city consumer ecosystems, accurate traffic accident risk prediction is vital for proactive safety services in intelligent transportation systems. However, current solutions often fail to integrate heterogeneous relational features (e.g., historical risk correlations) or effectively balance long-term periodic patterns with transient dynamics. To address these issues, we introduce a Cross-View Long-Short Spatial-Temporal Framework (CVLS-ST) for traffic risk prediction, which innovatively decouples long- and short-term dependencies to achieve more precise urban traffic risk prediction. Specifically, we design a cross-view attention graph network to effectively capture complex and diverse interactions across multiple relational graphs. Besides, we develop a Mamba block that incorporates state-space modeling into LSTMâs gating architecture to effectively capture global spatial semantics and temporal dependencies. Moreover, we introduce a state-inherited strategy to jointly and accurately model the long-term trends and short-term dynamics of traffic risk. Extensive experiments on two real-world datasets show that the F1-score of CVLS-ST outperforms the state-of-the-art by 20.37% on CHI and 5.83% on NYC, validating its effectiveness in complex urban environments.},
  publisher = {IEEE},
  issn = {1558-4127},
  keywords = {Intelligent urban transportation system;traffic accident risk prediction;long-short spatio-temporal modeling;cross-view attention},
}

@article{machinelearningbaseddynamicspa2025,
  author = {C. Nagesh; M. Kumar},
  title = {{Machine} {Learning} {Based} {Dynamic} {Spatiotemporal} {Networks} and {Bioinspired} {Optimization} for {Adaptive} {Data} {Modelling} and {Data} {Analysis}},
  journal = {2025 6th International Conference on Mobile Computing and Sustainable Informatics (ICMCSI)},
  year = {2025},
  pages = {1725--1732},
  doi = {10.1109/ICMCSI64620.2025.10883589},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10883589},
  abstract = {This spatiotemporal complexity presents a very big challenge in effectively modeling and predicting patterns across domains that include climate systems, traffic networks, and disaster progression. Currently, the methods often tend to fail in capturing the time-varying dynamics, optimizing spatial paths, and managing the high dimensionality of such datasets. This leads to suboptimal performance and increased computational overhead. In response to the aforementioned limitations, three new methods of innovative encoding, learning, and optimization are proposed to significantly boost the spatiotemporal analysis of data in this work. First, a dynamic spatiotemporal network called DeepSTNet with adaptive temporal encoding and graph-based spatial attention for capturing region-wise interactions achieved 5-10% higher accuracy and reduced computation by 20-30%. Second, ReinforceSTPath uses a multi-agent reinforcement learning framework to optimize spatial path predictions with temporal feedback, allowing for collaborative learning and achieving a 15-20% reduction in path prediction error while increasing efficiency by 30% compared to deterministic models. Lastly, inspired by the dynamics of an ant colony, BioST-Optimizer introduces a bioinspired swarm intelligence algorithm for feature selection in high-dimensional datasets, reducing dimensions by 30-50% and preserving 98% predictive accuracy while reducing training times by 40%. Collectively, these methodologies advance the state-of-the-art modeling of spatiotemporal data in dynamical alignment of temporal and spatial characteristics, optimization of path prediction, and efficient feature selections. This framework deals with the major shortcomings of previous approaches. Robust, scalable, and efficient solutions with wide applicability and transformative potential for spatiotemporal data analysis are provided in process.},
  publisher = {IEEE},
  isbn = {979-8-3315-2266-7},
  keywords = {Spatiotemporal Modeling;Adaptive Temporal Encoding;Reinforcement Learning;Swarm Intelligence;Feature Optimizations},
}

@article{stcnozoneagraphbasedspatiotemp2025,
  author = {S. Khan; M. A. Lor; S. -C. Chen; M. -L. Shyu; A. Christiansen},
  title = {{STCN-Ozone:} {A} {Graph-Based} {Spatiotemporal} {Forecasting} {Framework} for {Modeling} {Tropospheric} {Ozone}},
  journal = {2025 IEEE International Conference on Information Reuse and Integration and Data Science (IRI)},
  year = {2025},
  pages = {37--42},
  doi = {10.1109/IRI66576.2025.00015},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11153093},
  abstract = {Timely and precise forecasting of ground-level ozone $\left(\mathrm\{O\}_\{3\}\right)$ remains a critical challenge in atmospheric science due to the compound influences of spatial heterogeneity and temporal variability. This paper introduces STCN-Ozone, a novel graph-based spatiotemporal framework specifically designed to model ozone dynamics by jointly learning spatial interactions and temporal evolution from real-world pollutant data. The model constructs geospatial graphs based on monitoring station proximity and applies spatial encoding through a Graph Convolutional Network (GCN). These spatial representations are temporally unfolded and modeled using a dilated Temporal Convolutional Network (TCN) to capture long-range temporal dependencies with high resolution. STCN-Ozone is trained on five years of ozone concentration data (1999-2003) across 451 unique locations, using 30-day sequences to predict the subsequent day's ozone level. We use the model to estimate 95 % confidence intervals to support uncertainty-aware forecasting. STCN-Ozone has been shown to be a scalable and domain-adaptive solution for operational atmospheric prediction systems.},
  publisher = {IEEE},
  isbn = {979-8-3315-9944-7},
  issn = {2835-5776},
  keywords = {Deep Learning;Spatio-temporal Forecasting;Surface Ozone Prediction;Data-Driven Atmospheric Modeling},
}

@article{pedestrianrealtimedetectionand2025,
  author = {H. Chen; V. Balasubramaniam; S. Liu},
  title = {{Pedestrian} {Real-Time} {Detection} and {Flow} {Forecasting} in {Complex} {Urban} {Scenarios} via {Multi-Source} {Spatio-Temporal} {Data} {Fusion:} {A} {Unified} {Model}},
