  abstract = {To evaluate the energy savings of electric vehicles (EVs) in transportation-distribution networks (T-DNs), this article proposes a trilevel EV collaborative charging scheduling framework (Tri-CCSF) based on EVâs spatiotemporal flexibility, integrating their spatial flexibility before charging requests and charging flexibility at charging stations (CSs). Tri-CCSF is designed to deliver an integrated optimization of economic charging navigation and scheduling, considering the implications of charging load on the main power grid (MPG) and the inherent uncertainties associated with renewable energy (RE). The first level utilizes aggregated EV charging flexibility to minimize power exchange between CS and MPG. The second level develops low-cost charging plans for each EV user based on energy attributes, which helps avoiding the âcurse of dimensionalityâ caused by large-scale EVs. The third level proposes an EV spatiotemporal dynamic energy consumption estimation model based on macroscopic traffic flow speed prediction, which informs economical charging navigation. Furthermore, the proximal policy optimization-alternating direction method of multipliers (PPO-ADMMs) algorithm is proposed to enhance the solution efficiency of the quadratic programming (QP) problem. Based on real-world map experiments, Tri-CCSF benefits T-DNs and increases RE utilization by 4.5%â36.2% and EV energy consumption estimation accuracy by 5%â7.5%.},
  publisher = {IEEE},
  issn = {2332-7782},
  keywords = {Charge scheduling;charging flexibility;electric vehicle (EV);energy consumption;transportation-distribution networks (T-DNs)},
}

@article{gatedrecurrentunitandproximalp2025,
  author = {X. Jing; A. Chen},
  title = {{Gated} {Recurrent} {Unit} and {Proximal} {Policy} {Optimization} {Based} {Railway} {Traffic} {Electronic} {Sandbox} {Simulation} {System}},
  journal = {2025 International Conference on Communication, Computer, and Information Technology (IC3IT)},
  year = {2025},
  pages = {1--6},
  doi = {10.1109/IC3IT66137.2025.11341742},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11341742},
  abstract = {In modern era, railway traffic electronic sandbox simulation systems have gained significant attention in modern railway training and operational planning to enable safe and cost-effective experimentation in virtual environments. These systems facilitate realistic simulation of train movement, signal operations and dispatch conditions, providing improved knowledge and skill acquisition for operators. However, the existing YOLOv5 based sandbox system employs rule based static control strategy but faced challenges in adaptability, real time decision making and predictive capability in complex or dynamic traffic scenarios. In this research a Gated Recurrent Unit and Proximal Policy Optimization (GRU-PPO) based simulation system is proposed. This research begins with acquisition of multi-source with additional time series inputs simulated from sandbox. Data preprocessing is performed on the collected data through time stamp synchronization and resampling, windowing and z score normalization. In prediction layer, Gated Recurrent Unit (GRU) is employed to capture temporal traffic patterns to predict delays and occupancy probabilities. The output from the prediction layer form input to the control optimization layer where Proximal Policy Optimization (PPO) agent learns optimal signal timing and dispatch strategies through sandbox interaction. Results states that the proposed GRU-PPO achieved higher knowledge mastery (91.2 %), operational skill (89.5 %) and learning satisfaction (93.1 %) with enhanced intelligence and adaptive railway traffic simulation.},
  publisher = {IEEE},
  isbn = {979-8-3315-2483-8},
  keywords = {gated recurrent unit;proximal policy optimization;railway traffic;sandbox simulation systems;train movement},
}

@article{agftnetlearningreliablespatiot2026,
  author = {W. Su; E. Fan; Q. Li; Z. Fang; Y. Huang; Y. Chen},
  title = {{AGFTNet:} {Learning} {Reliable} {Spatio-Temporal} {Risk} {Patterns} {From} {Sparse} {Data} for {Urban} {Traffic} {Accident} {Early} {Warning} {Systems}},
  journal = {2026 IEEE 22nd International Conference on Factory Communication Systems (WFCS)},
  year = {2026},
  pages = {1--5},
  doi = {10.1109/WFCS67029.2026.11511602},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11511602},
  abstract = {As a cornerstone of Industrial Cyber-Physical Systems (ICPS) for smart cities, Traffic Accident Early Warning Systems (EWS) are pivotal for maintaining urban resilience. However, reliable accident risk assessment remains elusive due to the extreme âzero-inflatedâ sparsity of accident data and the complex coupling of heterogeneous urban factors. Conventional methods, often reliant on Recurrent Neural Networks (RNNs) and static graph fusion, struggle with global temporal dependencies and exhibit significant time lags. To address these, this paper proposes AGFTNet (Attention Graph Fusion Spatio-Temporal Network). We introduce a Transformer-based temporal encoder to achieve zero-lag risk perception, overcoming the memory bottlenecks of RNNs. Furthermore, an Adaptive Graph Fusion (AGF) module dynamically learns non-linear interaction weights among Risk, Road Network, and POI graphs, while a risk-sensitive Focal-MSE loss is employed to mitigate bias in sparse data. Extensive experiments on NYC and Chicago datasets demonstrate that AGFTNet significantly outperforms nine state-of-the-art baselines, including GSNet, Graph WaveNet, and STGCN. Specifically, it reduces RMSE by 6.9% and 10.4%, respectively, while maintaining superior recall in high-risk scenarios. The framework offers a robust, low-latency solution for industrial-grade accident risk management.},
  publisher = {IEEE},
  isbn = {979-8-3315-7831-2},
  issn = {2835-8414},
  keywords = {Traffic Accident Prediction;Industrial Cyber-Physical Systems (ICPS);Spatio-Temporal Data Mining;Transformer},
}

@article{mgbtmultiregionshorttermelectr2026,
  author = {S. Zhou; Z. Dong; J. Wang; X. Ji; Y. Yuan; C. S. Lai},
