  year = {2025},
  pages = {1--5},
  doi = {10.1109/VTC2025-Spring65109.2025.11174481},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11174481},
  abstract = {Accurate traffic congestion prediction is essential for optimizing urban traffic management and mitigating congestion and its consequences. However, conventional prediction models often struggle to simultaneously capture long-term periodic patterns and short-term fluctuations, leading to low prediction accuracy and computational inefficiencies. To overcome this limitation, we propose a knowledge distillation-based framework for enhanced long and short term road traffic prediction. The framework employs a teacher-student architecture, where the teacher model utilizes long-term historical data and a dynamic adjacency matrix to extract periodic traffic patterns, while the student model captures short-term variations and integrates distilled long-term knowledge to enhance responsiveness to sudden congestion changes. To resolve the dimensional mismatch between long-term and short-term feature representations, we introduce a feature alignment mechanism that reduces the dimensionality of high-dimensional intermediate outputs from the teacher model. Experimental evaluations demonstrate that our approach significantly outperforms baseline models, such as Graph Convolutional Gated Recurrent Units, Spatio- Temporal Graph Convolutional Networks and Long Short-Term Memory, in terms of Mean Squared Error, Mean Absolute Error, and Root Mean Squared Error. Moreover, the proposed framework maintains high prediction accuracy even in scenarios with severe traffic fluctuations, offering an efficient and robust solution for traffic congestion forecasting.},
  publisher = {IEEE},
  isbn = {979-8-3315-3147-8},
  issn = {2577-2465},
  keywords = {knowledge distillation;congestion prediction;long-term periodicity;spatiotemporal modeling},
}

@article{mmstflownetatransportationhubo2025,
  author = {R. Zhang; W. Xing; M. Li; Z. Wang; J. Chen; X. Ma; Z. Liu; Z. He},
  title = {{MM-STFlowNet:} {A} {Transportation} {Hub-Oriented} {Multi-Mode} {Passenger} {Flow} {Prediction} {Method} via {Spatial-Temporal} {Dynamic} {Graph} {Modeling}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2025},
  volume = {26},
  number = {11},
  pages = {20450--20463},
  doi = {10.1109/TITS.2025.3588867},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11099533},
  abstract = {Accurate and refined passenger flow prediction is essential for optimizing the collaborative management of multiple collection and distribution modes in large-scale transportation hubs. Traditional methods often focus only on the overall passenger volume, neglecting the interdependence between different modes within the hub. To address this limitation, we propose MM-STFlowNet, a comprehensive multi-mode prediction framework grounded in dynamic spatial-temporal graph modeling. Initially, an integrated temporal feature processing strategy is implemented using signal decomposition and convolution techniques to address data spikes and high volatility. Subsequently, we introduce the Spatial-Temporal Dynamic Graph Convolutional Recurrent Network (STDGCRN) to capture detailed spatial-temporal dependencies across multiple traffic modes, enhanced by an adaptive channel attention mechanism. Finally, the self-attention mechanism is applied to incorporate various external factors, further enhancing prediction accuracy. Experiments on a real-world dataset from Guangzhounan Railway Station in China demonstrate that MM-STFlowNet achieves state-of-the-art performance, with an average improvement of 52.56% in MSE and 36.38% in MAE. Especially during peak hours, it demonstrates excellent forecasting performance, providing valuable insights for transportation hub management. Our model is also demonstrated strong generalization in low-resource scenarios and different traffic scenarios. Our code is available at https://github.com/BMRETURN/MM-STFlowNet},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Transportation hubs;collection and distribution;multi-mode passenger flow prediction;spatial-temporal modeling},
}

@article{anattentionaugmentedspatiotemp2025,
  author = {Q. You; D. Zhao; B. Song; L. Liu; Y. Wang},
  title = {{An} {Attention-Augmented} {Spatio-Temporal} {Learning} {Method} for {Dynamic} {Traffic} {Prediction} in {LEO} {Satellite} {Networks}},
  journal = {2025 3rd International Conference on Ubiquitous Communication (Ucom)},
  year = {2025},
  pages = {299--304},
  doi = {10.1109/Ucom67224.2025.11336829},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11336829},
  abstract = {The rapid deployment of Low Earth Orbit (LEO) satellite constellations has enabled seamless global communication networks. However, the dynamic connectivity between LEO satellites and ground stations, coupled with complex traffic patterns in satellite-terrestrial networks, presents significant challenges for accurate traffic prediction. To overcome these problems, this paper proposes a Spatio-Temporal Dynamic Traffic Prediction (ST-DTP) model that integrates Graph Attention Networks (GAT) and Gated Recurrent Units (GRU). Specifically, our framework employs satellite orbital parameters and ground station visibility data to construct dynamic bipartite graphs that continuously model real-time satellite-ground connectivity. Spatially, the architecture leverages GAT layers to extract dynamic graph structural features, effectively capturing the interactive dependencies between terrestrial stations and orbital satellites. Temporally, a GRU-based module analyzes the evolutionary patterns of traffic sequences, which are then fused with spatial features from GAT for comprehensive traffic prediction. Extensive validation using real-world datasets from the Iridium constellation and ground station traffic records demonstrates the performance improvements. Compared to existing temporal models and static graph models, the proposed method significantly reduces metrics such as RMSE and achieves higher accuracy for traffic prediction, showing a better adaptation to dynamic network topologies inherent in LEO satellite networks.},
  publisher = {IEEE},
  isbn = {979-8-3315-6831-3},
  keywords = {Dynamic graphs;LEO satellite networks;spatiotemporal modeling;traffic prediction},
}

@article{stgatmodelingdynamicspatialtem2025,
  author = {N. Chen},
  title = {{STGAT:} {Modeling} {Dynamic} {Spatial-Temporal} {Graphs} with {Attention} and {Dilated} {Convolutions}},
  journal = {2025 International Conference on Computers, Information Processing and Advanced Education (CIPAE)},
  year = {2025},
  pages = {179--186},
  doi = {10.1109/CIPAE66821.2025.00037},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11226055},
  abstract = {Spatial-temporal graph modeling is crucial for analyzing spatial relationships and temporal dynamics of system components. Existing methods rely on fixed graph structures, treating spatial connections as static and ignoring that genuine spatial correlations are often driven by node feature patterns (e.g., correlated states between non-adjacent but functionally related nodes) rather than predefined links, which may miss hidden connections. Additionally, they struggle to capture long-range temporal sequences. To address these, this paper proposes Spatial- Temporal Graph Attention Network (STGAT), integrating graph attention networks (GAT) with stacked dilated causal convolutions. For spatial modeling, STGAT leverages GAT's self-attention to break fixed structures: it calculates node feature similarity scores and dynamically adjusts spatial dependency weights based on these scores, enabling capture of both explicit topological dependencies and hidden feature-driven spatial associations. For temporal modeling, stacked dilated causal convolutions, with exponentially growing temporal receptive fields, handle long-range sequences. Integrated into an end-to-end framework, STGAT outperforms baselines on the METR-LA traffic dataset, validating the efficacy of its dynamic spatial weight adjustment based on node feature similarities.},
  publisher = {IEEE},
  isbn = {979-8-3315-3840-8},
  keywords = {Spatial-temporal graph modeling;Graph Attention Networks (GAT);Dilated causal convolutions;Traffic forecasting},
}

@article{intelligenttrafficmanagementin2025,
  author = {K. Maswadi},
  title = {{Intelligent} {Traffic} {Management} in {Information} {System:} {A} {Dual-Graph} {Convolutional} {Approach} {With} {Holographic} {Digital} {Twins} and {IoT} {Integration}},
  journal = {IEEE Transactions on Consumer Electronics},
  year = {2025},
  volume = {71},
