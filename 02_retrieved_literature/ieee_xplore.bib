  abstract = {This paper aims to capture the nonlinear characteristics of traffic flow and improve the real-time accuracy of traffic flow prediction when the dataset is inaccurate and the prediction results exhibit significant fluctuations. In this study, a hybrid prediction model was constructed in MATLAB, which integrated variational mode decomposition (VMD), Newton- Raphson-based optimization technique (NRBO), and bidirectional long short-term memory network (BiLSTM). The experiment used the VMD algorithm to normalize the traffic flow data collected from French highways and decompose it into different modal components. Different modal components were connected in series through multiple BiLSTM prediction models. At the same time, the NRBO algorithm used the second-order derivative data to accurately identify the optimal solution and automatically adjust the BiLSTM parameters. Compared with the prediction results of VMD-BiLSTM and NRBO-BiLSTM, the VMD-NRBO- BiLSTM model showed the best performance, with R2 values of 0.850-0.877, MAPE values of 7.27%-8.51%, and MSE values of 23.92-25.77. The experimental results showed that the VMD- NRBO-BiLSTM model could improve the efficiency of traffic flow prediction and provide a method for optimizing transportation and planning efficiency in the future.},
  publisher = {IEEE},
  isbn = {979-8-3315-5270-1},
  keywords = {traffic flow prediction;optimization algorithm;neural network model;VMD-NRBO-BiLSTM},
}

@article{anoveltrafficpredictionmethodf2025,
