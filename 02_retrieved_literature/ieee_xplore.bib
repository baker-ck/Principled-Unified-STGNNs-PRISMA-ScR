@article{temporalgraphneuralnetworkfors2026,
  author = {N. Islam; M. N. Uddin; M. H. Anas},
  title = {{Temporal} {Graph} {Neural} {Network} for {Semantic} {Context-Aware} {Mobility} {Prediction} in {6G} {Networks}},
  journal = {2026 23rd International Joint Conference on Computer Science and Software Engineering (JCSSE)},
  year = {2026},
  pages = {918--923},
  doi = {10.1109/JCSSE68839.2026.11597006},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11597006},
  abstract = {Modeling complex user mobility patterns remains a key challenge for enabling intelligent and adaptive operations in next-generation 6G networks. However, existing approaches often fail to jointly capture spatial interactions, temporal dynamics, and semantic context, limiting their effectiveness. This paper presents a semantic context-aware mobility prediction framework based on Temporal Graph Neural Networks (TGNN), where user mobility is modeled as dynamic graphs. The proposed approach integrates graph-based spatial learning with semantic-aware temporal attention and an importance-weighted loss function to prioritize critical mobility patterns. Experiments on a real-world trajectory dataset demonstrate that the proposed model consistently outperforms state-of-the-art methods across multiple evaluation metrics. The results highlight the effectiveness of incorporating semantic context and graph-based modeling for improving prediction accuracy and enabling intelligent mobility management in 6G systems.},
  publisher = {IEEE},
  isbn = {979-8-3315-8200-5},
  issn = {2642-6579},
  keywords = {Mobility prediction;Temporal Graph Neural Networks;6G networks;semantic context;spatio-temporal modeling;graph neural networks},
}

