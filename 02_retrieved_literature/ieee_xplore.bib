  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11554783},
  abstract = {Accurate prediction of traffic flow is essential for effective transportation management in modern smart cities, where increasing vehicle density leads to congestion and delays. Traditional forecasting approaches often struggle to model the complex temporal variations and dependencies present in real traffic data. To address this issue, this paper proposes an attention-guided deep learning model that improves prediction performance by emphasizing the most relevant features influencing traffic patterns. The proposed approach combines sequence learning with an attention mechanism to capture temporal dependencies more effectively. By assigning adaptive importance to critical input features, the model is able to represent dynamic traffic behavior with greater precision. The framework is trained and evaluated using real-world traffic datasets, with appropriate preprocessing techniques applied to enhance data quality and learning efficiency. The performance of the proposed model is assessed using standard evaluation metrics such as RMSE and MAE, and is compared with existing machine learning and deep learning methods. The results show that the model achieves better prediction accuracy and reduced error values across different traffic conditions. The proposed system can support real-time traffic monitoring and management, making it suitable for intelligent transportation applications in smart city environments.},
  publisher = {IEEE},
  isbn = {979-8-3195-2947-3},
  keywords = {Traffic Flow Prediction;Spatio-Temporal Modeling;Graph Convolutional Networks;Multi-Head Attention;LSTM;Intelligent Transportation Systems;Smart Cities},
}

@article{stentpalongshortperiodawarenet2025,
  author = {L. Li; K. Kim},
  title = {{STE-NTP:} {A} {Long-Short} {Period} {Aware} {Network} {Traffic} {Prediction} {Model}},
  journal = {IEEE Access},
  year = {2025},
  volume = {13},
  pages = {35574--35587},
  doi = {10.1109/ACCESS.2025.3545117},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10902161},
  abstract = {As the scale of network rapidly expands, the density and complexity of network connections have reached unprecedented levels, increasing the complexity of network management. Software-Defined Networking (SDN) enables efficient network modeling techniques by providing a controller interface, thereby implementing Network Traffic Prediction (NTP) and directly controlling underlying network hardware. However, existing NTP methods face challenges in handling the highly nonlinear and frequently bursty characteristics of network traffic, particularly in capturing and analyzing the spatiotemporal features of the traffic. To address this issue, this paper proposes an innovative NTP model, STE-NTP:Time-Space Encoding Based Network Traffic Prediction Model. This model utilizes advanced spatial and temporal encoding techniques to comprehensively process both spatial and temporal information, thereby improving prediction accuracy and efficiency. Additionally, an LTST-Extraction Block(long-term and short-term Extraction Block) is designed to enhance the modelâs ability to predict long-term and short-term events in network traffic data through Long-term and Short-term feature extraction techniques.To further validate the modelâs performance, 50,000 time units covering 200 routing schemes were simulated on the NSFNET and Geant2 network topologies using OMNeT++. The proposed STE-NTP model was then compared against other advanced prediction models in both short-term and long-term forecasting tasks.The results demonstrate that proposed STE-NTP exhibits significant advantages across multiple key performance metrics. These experiments not only validate the effectiveness of the STE-NTP model in predicting complex network traffic but also highlight its potential value in practical applications.},
  publisher = {IEEE},
  issn = {2169-3536},
  keywords = {Network management;time series analysis;deep learning;attention},
}

@article{generaldecoupledgraphconvoluti2025,
  author = {S. Yang; Z. Huang; Q. Wu; Z. Zhuo},
  title = {{General} {Decoupled} {Graph} {Convolutional} {Recurrent} {Network} for {Traffic} {Prediction}},
  journal = {IEEE Sensors Journal},
  year = {2025},
  volume = {25},
  number = {18},
  pages = {35460--35478},
  doi = {10.1109/JSEN.2025.3580440},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11048409},
  abstract = {Accurate traffic prediction plays a pivotal role in the development of intelligent transportation systems (ITSs). However, traffic data often exhibits multiscale temporal dependencies, spatiotemporal heterogeneity, and highly nonlinear characteristics, which pose significant challenges to existing prediction models. To address these challenges, we propose a general decoupled graph convolutional recurrent network (GDGCRN). At the core of the GDGCRN is its ability to handle multiscale temporal dynamics. By learning temporal embeddings for daily and weekly cycles, the model adaptively captures short-term fluctuations as well as long-term patterns. On the spatial side, the GDGCRN incorporates a sensor-specific mechanism that adapts to the unique behavior of individual traffic sensors, allowing the model to capture complex spatial dependencies across diverse and heterogeneous traffic environments. Moreover, the GDGCRN introduces a signal decoupling mechanism that separates steady-state and nonsteady-state signals, enabling the model to robustly handle both predictable traffic trends and sudden disruptions. Through comprehensive experiments on multiple benchmark datasets, including traffic flow prediction on PeMS04 and PeMS08, demand prediction on the NYCBike dataset, and speed prediction on PeMSD7(M), we demonstrate that the GDGCRN achieves highly competitive performance across these datasets. Notably, on the PeMS08 dataset, the GDGCRN reduces the mean absolute error (MAE) metric by 9.92% compared to the MVSTT model.},
  publisher = {IEEE},
  issn = {1558-1748},
  keywords = {Graph convolution;signal decoupling;traffic prediction},
}

@article{spatiotemporalheritableneuraln2026,
  author = {W. Ding; Q. Yu; T. Zhang; Y. Gu; C. Chen; H. Zhang; A. T. Azar; H. Gao},
  title = {{Spatio-Temporal} {Heritable} {Neural} {Networks} for {Traffic} {Flow} {Prediction}},
  journal = {IEEE Transactions on Network Science and Engineering},
  year = {2026},
  volume = {13},
  pages = {7914--7930},
  doi = {10.1109/TNSE.2026.3674916},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11437526},
  abstract = {Traffic flow prediction is crucial for supporting transportation authorities in effective road management and assisting individuals in efficiently planning their journeys. The structure of real-world traffic networks often exhibits complex configurations and topological relationships, including ring roads and highway intersections. Traditional Euclidean spaces primarily consider geometric distances and fail to fully capture the intricate features of these networks. By employing non-Euclidean spaces, we can incorporate the topological structure and spatial relationships of actual road networks into our modeling, providing a more accurate representation of traffic conditions. Currently, graph neural networks have gained significant popularity in this field; however, achieving high predictive accuracy remains a challenge. On one hand, dynamic spatial correlations result in abrupt changes in the spatio-temporal relationships among nodes, complicating the model's ability to accurately capture these features. On the other hand, traffic flow can exhibit distinct patterns of variation across different time periods, leading to changes in spatial correlations among nodes. To adapt the spatial network structure to these temporal changes, it is essential to adjust spatial correlations adaptively, thereby enhancing the precision of spatio-temporal feature extraction. To address these challenges, we propose a novel method called Spatio-temporal Heritable Neural Networks (STHNN), aimed at improving the accuracy of traffic flow prediction. Our method integrates features of varying resolutions through an encoder-decoder architecture to learn long-term global spatio-temporal correlations. Additionally, we introduce a new spatial hidden state within each Gate Recurrent Unit cell, which encapsulates historical local spatial features, effectively capturing short-term dynamics. A dedicated Update Graph module aggregates historical features with current features at each time step, ensuring that the updated spatio-temporal hidden states closely align with real traffic conditions. Extensive experiments conducted on four real-world public datasets demonstrate that our method significantly outperforms state-of-the-art baseline approaches, achieving average improvements of 6.4% in Mean Absolute Error (MAE) and 4.2% in Root Mean Square Error (RMSE).},
  publisher = {IEEE},
  issn = {2327-4697},
  keywords = {Traffic prediction;spatio-temporal features;deep learning;Graph convolutional networks},
}

@article{socialspatiotemporalgraphconvo2025,
  author = {J. Hu; Y. Xu; Y. Zhang; Y. Wu; J. Zhou},
  title = {{Social} {Spatio-Temporal} {Graph} {Convolutional} {Neural} {Network} for {Pedestrian} {Trajectory} {Prediction}},
  journal = {2025 8th International Conference on Transportation Information and Safety (ICTIS)},
  year = {2025},
  pages = {1165--1171},
  doi = {10.1109/ICTIS68762.2025.11215068},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11215068},
  abstract = {Pedestrian trajectory prediction serves as a critical component in autonomous vehicle perception technology, playing a vital role in safe navigation path planning. The complex interaction behaviors among surrounding traffic participants significantly influence pedestrian movement patterns, making accurate trajectory prediction particularly challenging. We propose a Social Spatial-Temporal Graph Convolutional Neural Network (Social-STGCNN) that models crowd interactions through graph structural representations rather than conventional aggregation approaches. Experimental evaluation on an urban intersection dataset from Nanjing demonstrates our model achieves a final displacement error (FDE) of 0.52 and an average displacement error (ADE) of 0.33.Quantitative analysis shows that the accuracy of the model has been improved. In addition, this model has data efficiency and surpasses the advanced level of previous ADE metrics with only 20% of training data. The model also includes a kernel function that embeds social interactions between pedestrians into the adjacency matrix.},
  publisher = {IEEE},
  isbn = {979-8-3315-9248-6},
