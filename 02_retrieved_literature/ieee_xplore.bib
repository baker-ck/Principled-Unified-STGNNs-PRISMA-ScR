  pages = {6437--6450},
  doi = {10.1109/TCE.2024.3415615},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10560034},
  abstract = {The proliferation of Internet of Things (IoT) and the adoption of Edge Computing paradigms have led to a substantial increase in data volume. Data imbalance is inevitable in distributed environment composed of edge nodes, due to inherent diversity in processing capabilities, network connectivity, and geographical distribution. In specific highway domain, such edge derived data makes predictive precision of crucial traffic flow hard to guarantee. First, data imbalance would deteriorate the predictive performance at certain locations. Second, various spatial dependencies existed in highway network have not been sufficiently explored. To address these challenges in highway domain, we propose a novel method for daily traffic flow prediction on imbalanced data. On the one hand, a pre-processing strategy is presented to normalize traffic flow data in long-tail distribution. The data is collected from highway electronics through edge nodes. On the other hand, a multi-graph convolution model is designed to capture spatio-temporal features in distinct physical, statistical and latent perspectives. Incorporating external characteristics like meteorological and calendar features, prediction can be achieved precisely. Through extensive experiments and case studies conducted on a Chinese provincial highway, our method demonstrates a significant improvement of predictive accuracy than baselines and outstanding effects in a practical project.},
  publisher = {IEEE},
  issn = {1558-4127},
  keywords = {Traffic flow prediction;data imbalance;spatio-temporal features;multi-graph fusion;graph convolutional network},
}

@article{exploringspatialtemporalcorrel2026,
  author = {N. S. Chauhan; N. Kumar},
  title = {{Exploring} {SpatialâTemporal} {Correlations} {With} {Dual} {Stream} {Conv-GRU} and {Fuzzy-Inspired} {Attention} {Mechanism} for {Traffic} {Flow} {Prediction}},
  journal = {IEEE Transactions on Computational Social Systems},
  year = {2026},
  volume = {13},
  number = {2},
  pages = {1680--1692},
  doi = {10.1109/TCSS.2025.3608812},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11220923},
  abstract = {Intelligent transportation systems (ITS) have witnessed significant advancements, particularly with the emergence of deep hybrid neural networks in artificial intelligence. Accurate traffic flow prediction is essential for optimizing ITS and mitigating urban congestion. While deep learning models have advanced traffic prediction, effectively capturing the intricate relationship between spatial, temporal, and periodic traffic patterns remains challenging. Additionally, the existing methods often lack the ability to focus on critical input segments, hindering prediction accuracy. To address these limitations, we propose a dual-stream convolutional gated recurrent unit (conv-GRU) model augmented with a fuzzy-inspired attention mechanism. Here, one stream is used to capture the temporal characteristics, whereas another stream is employed to extract the periodic features in the entire network. The convolution layers mine the spatial correlations in both streams. Further, selective emphasis on the crucial input segments through a fuzzy-inspired attention mechanism significantly improves the prediction. External factors like the day of the week and holidays are also incorporated to enhance the modelâs adaptability and forecasting capabilities. Rigorous evaluation on a publicly available dataset from PeMS demonstrated the modelâs superior performance, with significant reductions in mean absolute error (MAE), mean absolute percentage error (MAPE), and root mean squared error (RMSE) ranging from 4.4%â59.1%, 2.8%â64.9%, and 2.6%â54%, respectively, compared with state-of-the-art models.},
  publisher = {IEEE},
  issn = {2329-924X},
  keywords = {Attention mechanism;convolutional gated recurrent unit (Conv-GRU);deep neural networks;hybrid models;spatioâtemporal;traffic flow},
}

@article{mfignetmapfreemultiagenttrajec2026,
  author = {W. Wang; Z. Ma; X. Liu; S. Yang; Y. Yang; H. Xia},
  title = {{MFIG-Net:} {Map-Free} {Multiagent} {Trajectory} {Prediction} for {Signalized} {Intersection} {Scenarios}},
  journal = {IEEE Internet of Things Journal},
  year = {2026},
  volume = {13},
  number = {5},
  pages = {8913--8927},
  doi = {10.1109/JIOT.2025.3641921},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11298439},
  abstract = {Signalized intersections are among the most crash-prone elements of urban traffic networks. Their complex layouts and heterogeneous road users pose substantial challenges for accurate trajectory prediction. Although high-definition (HD) maps are widely used to boost prediction performance, their high construction and maintenance costs and limited update frequency hinder practical deployment. Meanwhile, existing map-free models still struggle to reach the accuracy required in such complex settings. To address these issues, we propose a map-free intersection graph network (MFIG-Net), a map-free, multiagent trajectory prediction framework tailored to signalized intersections. MFIG-Net comprises three components. First, a multisource feature encoder (MSFE) builds per-agent node embeddings by jointly encoding motion histories and static attributes together with traffic-signal phase semantics; the latter are represented using remaining-time sinusoidal positional encodings passed through a multilayer perceptron (MLP) to capture phase transitions. Second, the interaction layer combines a conflict-aware graph attention (CAGA) moduleâmodeling dense spatial interactions via physically grounded, directed edge features and enhanced multihead attentionâwith a Mamba-based temporal block that captures long-range dependencies through linear-time selective state-space dynamics. Third, a Laplace mixture density network (MDN) decoder produces  $K$  multimodal future trajectories per agent with per-timestep scale parameters and mode probabilities, yielding accurate and calibrated uncertainty. Experiments on the SinD dataset from two-phase signalized intersections in Tianjin and Xiâan validate the effectiveness of the proposed model. Additional evaluations on the Argoverse dataset further demonstrate its applicability across diverse urban scenarios, where it outperforms most existing map-free approaches.},
  publisher = {IEEE},
  issn = {2327-4662},
  keywords = {Autonomous driving;graph attention network (GAT);map-free scenes;signalized intersections;trajectory prediction},
}

@article{researchontrafficflowpredictio2025,
  author = {Z. Zhuang; W. Cai},
  title = {{Research} on {Traffic} {Flow} {Prediction} {Model} for {Smart} {Cities}},
  journal = {2025 IEEE 3rd International Conference on Electrical, Automation and Computer Engineering (ICEACE)},
  year = {2025},
  pages = {535--541},
  doi = {10.1109/ICEACE67491.2025.11439705},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11439705},
  abstract = {This study proposes ST-AGCN, an end-to-end deep learning model integrating Graph Convolutional Networks (GCN), Gated Recurrent Units (GRU), and a dual spatio-temporal attention mechanism for citywide traffic flow forecasting. The model processes recent, daily, and weekly time periods in parallel, leveraging GCN to extract spatial dependencies and GRU to model temporal dynamics. The lightweight attention module dynamically balances critical nodes and historical time steps, enabling adaptive focus on key spatio-temporal features. On the PEMS-Bay and METR-LA datasets, ST-AGCN achieves top performance across 15-, 30-, and 60-minute prediction horizons. Compared to the best baseline model (ASTGCN), it reduces Mean Absolute Error (MAE) by $\mathbf\{5. 0\} \boldsymbol\{\%\}$ and Mean Absolute Percentage Error (MAPE) by $\mathbf\{5. 2\} \boldsymbol\{\%\}$ in $\mathbf\{6 0\}$-minute forecasts. The model demonstrates robust generalization capabilities under simulated severe weather conditions. Supporting real-time deployment, it provides a resilient solution for intelligent transportation management systems.},
  publisher = {IEEE},
  isbn = {979-8-3315-6736-1},
  keywords = {Smart city;Traffic flow Prediction;Model;Algorithm},
}

