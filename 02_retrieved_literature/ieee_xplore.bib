  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11582517},
  abstract = {Traffic flow prediction requires disentangling explicit and latent spatial-temporal dependencies, but existing graph-based methods face three limitations: static adjacency matrices miss long-range dynamics, unidirectional modeling lacks future context, and local architectures ignore global interactions. To address these, we propose Bi-SPLGTNet, a bidirectional spatial-latent graph transformer with three synergistic modules: (1) Spatial-Potential Multi-Scale Graph Convolution for explicit multi-hop diffusion and implicit semantic proximity via dynamic thresholding and latent embedding; (2) Bidirectional SpatialPotential Latent Graph Recurrent module replacing GRU gates with graph convolutions for context-aware bidirectional propagation; (3) Global Spatio-Temporal Dependency Fusion using Transformer self-attention for long-range feature interactions. Experiments on three traffic flow datasets (PeMS03/04/08) and two speed datasets (PeMSD7M/L) show Bi-SPLGTNet outperforms 15 baselines and achieves new state-of-the-art multi-step forecasting accuracy.},
