}

@article{combininglstmandgcntooptimizet2025,
  author = {S. Huang},
  title = {{Combining} {LSTM} and {GCN} to {Optimize} {Traffic} {Flow} {Prediction} {Under} {Complex} {Road} {Conditions} in {Smart} {Transportation}},
  journal = {2025 5th International Conference on Artificial Intelligence and Industrial Technology Applications (AIITA)},
  year = {2025},
  pages = {1564--1568},
  doi = {10.1109/AIITA65135.2025.11047716},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11047716},
  abstract = {The existing traffic flow prediction model has limited accuracy under complex road conditions due to its spatiotemporal coupling and nonlinear dynamic characteristics. This study solves the problem of traffic flow prediction accuracy under sudden disturbances by integrating temporal dependency modeling and road network spatial association through the LSTM (Long Short-Term Memory)- GCN (Graph Convolutional Network) collaborative optimization framework. This paper adopts the PEMS (Performance Measurement System) 04/08 dataset, constructs complex road conditions through time mutation injection and dynamic adjacency matrix, and designs an LSTM-GCN cascade architecture, in which LSTM captures node-level time series dynamics, GCN aggregates spatial features based on the dynamic adjacency matrix, and introduces residual connection and Huber loss to optimize model performance. Experimental results show that in the short-term (5 minutes), medium-term (30 minutes) and long-term (60 minutes) prediction tasks, the MAE (Mean Absolute Error) of LSTM-GCN is reduced to 2.67, 3.01 and 3.45, respectively, and the RMSE (Root Mean Squared Error) is 4.68, 6.32 and 6.45, respectively, which is significantly better than baseline models such as ARIMA (AutoRegressive Integrated Moving Average) and STGCN (Spatio-Temporal Graph Convolutional Network). LSTM-GCN effectively improves the prediction accuracy under complex road conditions through spatiotemporal joint modeling, providing highly robust decision support for intelligent transportation systems.},
  publisher = {IEEE},
  isbn = {979-8-3315-0976-7},
  keywords = {Smart Transportation;Complex Road Conditions;Traffic Flow;Long Short-Term Memory},
}

@article{stwavellmspatiotemporaltraffic2026,
  author = {Y. Tang; D. Li; X. Xu; Y. Liu; X. Zhao},
  title = {{ST-WaveLLM:} {Spatio-Temporal} {Traffic} {Forecasting} via {Wavelet-Enhanced} {Large} {Language} {Models}},
