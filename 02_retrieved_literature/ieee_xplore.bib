@article{dsthgnaknowledgedrivengraphnet2025,
  author = {M. Huang; H. Liu; W. Chen; H. Wang},
  title = {{DST-HGN:} {A} {Knowledge-Driven} {Graph} {Network} for {Trajectory} {Prediction}},
  journal = {2025 IEEE International Conference on Unmanned Systems (ICUS)},
  year = {2025},
  pages = {1979--1986},
  doi = {10.1109/ICUS66297.2025.11295510},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11295510},
  abstract = {Accurate trajectory prediction in dense, interactive urban environments is a critical technical challenge for achieving safe and efficient autonomous driving. Existing models often rely on generic graph neural networks, which treat complex traffic interactions as a black box and fail to effectively incorporate fundamental domain knowledge about traffic dynamics. To address this, we propose Dual-Pathway Spatio-Temporal Heterogeneous Graph Network (DST-HGN). First, we construct a dynamic heterogeneous graph with rich semantic information by modeling the dynamic agents (vehicles) and static environmental elements (lane lines, traffic signs, etc.) in the scene. Second, we design a dual-pathway parallel network architecture. The socio-semantic interaction pathway is a knowledge-driven graph network that goes beyond generic graph attention mechanisms by designing specialized message-passing functions with specific inductive biases for key interaction types (e.g., vehicle-vehicle, vehicle-lane). In parallel, the instantaneous physical geometry pathway focuses on capturing the immediate spatial layout of the scene. Information from both pathways is intelligently fused through a dynamic gating mechanism to form a comprehensive and profound understanding of the scene. We evaluate our model on the challenging INTERACTION dataset. Experimental results show that the architecture excels in prediction accuracy, providing a more interpretable and structured solution for trajectory prediction.},
  publisher = {IEEE},
  isbn = {979-8-3315-2672-6},
  issn = {2771-7372},
  keywords = {autonomous driving;trajectory prediction;dual-pathway;heterogeneous graph neural network},
}

@article{dynamicspatiotemporalplannings2025,
  author = {S. R. Fahim; R. Atat; C. Kececi; A. Takiddin; M. Ismail; K. R. Davis; E. Serpedin},
  title = {{Dynamic} {Spatio-Temporal} {Planning} {Strategy} of {EV} {Charging} {Stations} and {DGs} {Using} {GCNN-Based} {Predicted} {Power} {Demand}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2025},
  volume = {26},
  number = {4},
  pages = {4528--4542},
  doi = {10.1109/TITS.2025.3541190},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10902000},
  abstract = {As a sustainable participant in the modernization of transportation systems, electric vehicles (EVs) call for a well-planned charging infrastructure. To meet the ever-increasing charging demands of EVs, an efficient dynamic spatio-temporal allocation strategy of charging stations (CSs) is necessary. With newly allocated CSs, additional distributed generators (DGs) are required to compensate for the load increase. Given a budget to be allocated over a certain time horizon, we formulate the joint spatio-temporal CSs and DGs planning problem as a multi-objective optimization problem. During each planning period, the allocation strategy aims at minimizing the total power generation costs and CSs/DGs installation costs while satisfying budgetary and power constraints and ensuring a minimum level for the charging requests satisfaction rate. In this regard, we first predict the future power demand of EVs using a graph convolutional neural network (GCNN). Then, using the power demand forecast, we obtain the optimal number and locations of CSs and DGs at each time stage using reinforcement learning. A case study of the proposed allocation strategy over 6 time stages for the 2000-bus power grid of Texas coupled with 720 initially existing CSs is presented to illustrate the performance of the planning strategy.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Charging stations allocation;dynamic program;electric vehicles;prediction;reinforcement learning},
}

@article{explainableaiforencryptedtraff2025,
  author = {X. Zhang; M. Hua},
  title = {{Explainable} {Ai} for {Encrypted} {Traffic} {Detection:} a {Comprehensive} {Survey}},
  journal = {2025 IEEE 3rd International Conference on Computer, Vision and Intelligent Technology (ICCVIT)},
  year = {2025},
  pages = {1--5},
  doi = {10.1109/ICCVIT67848.2025.11391449},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11391449},
  abstract = {With the rapid proliferation of encrypted network traffic, traditional signature-based and port-based detection methods have become ineffective against encrypted protocols such as HTTPS, TLS, and VPN. Deep learning models have achieved remarkable success in encrypted traffic classification due to their ability to learn complex hierarchical representations. However, these models suffer from a lack of transparency, as their decision-making processes remain largely opaque, limiting their reliability and applicability in critical cybersecurity environments. Explainable Artificial Intelligence (XAI) has emerged as a powerful solution to address this interpretability challenge. By integrating techniques such as feature attribution, visualization, surrogate modeling, and counterfactual reasoning, XAI enables human-understandable explanations for deep learning predictions. This paper provides a comprehensive review of recent advances (2023-2025) in XAI-based encrypted traffic detection. The review systematically analyzes representative approaches-SHAP, LIME, attention visualization, counterfactual explanation, and GNNExplainer-across different model architectures (CNN, Transformer, and GNN). A comparative analysis of ten contemporary studies reveals that XAI not only enhances the interpretability and reliability of deep models but also improves anomaly detection and policy optimization in encrypted networks. Finally, we discuss open challenges including real-time interpretability, lightweight deployment, cross-model fusion, and human-AI collaborative security analysis.},
  publisher = {IEEE},
  isbn = {979-8-3315-7700-1},
  keywords = {Explainable Artificial Intelligence;Encrypted Traffic Detection;Deep Learning;Counterfactual Explanation;Graph Neural Networks},
}

@article{aipoweredurbanplanningtransfor2025,
  author = {L. Kosimov; S. Kosimova; K. Turdikulov; M. Ismoilov; L. Qosimov; Y. Hole},
  title = {{AI-Powered} {Urban} {Planning:} {Transforming} {Smart} {Cities} with {Data-Driven} {Decisions}},
