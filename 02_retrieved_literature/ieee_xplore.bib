  abstract = {With the widespread use of mobile networks and smart devices, opportunistic mobile crowdsensing (MCS) has emerged as one of the most promising sensing paradigms for intelligent data. In Opportunistic MCS, the real-time mobility of participants and requesters is a crucial feature, as it significantly impacts the quality of MCS services. However, most existing task allocation approaches focus on optimizing the overall system performance while disregarding the mobile attribute of participants and requesters. To remedy this issue, this article proposes a real-time route prediction-based multiobjective task allocation for Opportunistic MCS, called RRP-MOTA, which presents the participantsâ route-considered task allocation scheme to maximize social welfare comprehensively. Specifically, instead of merely optimizing system performance, a two-stage mechanism is designed to comprehensively enhance task allocation efficiency by estimating and leveraging participantsâ routes. Moreover, by utilizing participantsâ spatioâtemporal location information, an improved graph convolutional network-based participant route prediction method is developed to provide more accurate participant location information for task allocation. Furthermore, a reference vector-based multiobjective task allocation method is suggested to cater to diverse usage preferences by balancing quality of service and task cost. To validate the performance of our proposed method, extensive simulations are performed on synthetic and real datasets in two scenarios. Experimental results demonstrate that the proposed RRP-MOTA significantly outperforms the chosen existing designs.},
  publisher = {IEEE},
  issn = {2329-924X},
  keywords = {Multiobjective optimization;quality of service;real-time position;route prediction;task allocation},
}

@article{enhancingdengueforecastingwith2025,
  author = {W. Thumcharoen; K. Chinnasarn; W. Viriyavit; T. Methiyothin; W. Yookwan; A. Onuean},
  title = {{Enhancing} {Dengue} {Forecasting} with {Information} {Theoretic} {Directional} {Features} in {Graph} {Neural} {Networks}},
  journal = {2025 29th International Computer Science and Engineering Conference (ICSEC)},
  year = {2025},
  pages = {200--205},
  doi = {10.1109/ICSEC67360.2025.11298112},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11298112},
  abstract = {Dengue fever remains a major public health threat in Thailand, where environmental, socioeconomic, and mobility factors jointly drive transmission. Traditional forecasting models such as ARIMA, GAM, and LSTM capture temporal patterns but overlook structural and directional epidemic dynamics. Recent applications of Graph Neural Networks (GNNs) improve spatio-temporal forecasting, yet most rely on static adjacency matrices and environmental covariates, limiting their ability to represent interprovincial transmission pathways. To address these gaps, we introduce information-theoretic features, Delta Empowerment and Transfer Entropy Incoming, that quantify both structural influence and directional information flow among provinces. Weekly dengue case data from 77 provinces in Thailand (2017â 2019) were integrated with environmental and socioeconomic variables. Three GNN architectures STGAT, A3TGCN, and ASTGCN were evaluated using rolling cross-validation. Results show that structural and directional features markedly reduced forecasting errors compared with environmental and static baselines. STGAT achieved the largest gains, lowering MAE and RMSE by over 80%, while A3TGCN improved by 20â25% and ASTGCN by 5â10%. Beyond predictive accuracy, the framework provides structural interpretations, identifying provinces as epidemic sources, hubs, or sinks. By aligning with sustainable development goals this research demonstrates how advanced AI methods can enhance disease surveillance, support resilient health systems, and promote sustainable urban and community planning.},
  publisher = {IEEE},
  isbn = {979-8-3315-7383-6},
  issn = {2768-0592},
  keywords = {Dengue forecasting;Graph Neural Networks;Information Theory;Transfer Entropy;Empowerment;Sustainable Development Goals},
}

@article{scalingrealtimetrafficanalytic2026,
  author = {A. Sharma; P. Naman; R. Banerjee; P. Pansari; S. Gawali; M. Arya; S. Chandra; A. Josephraj; R. Ramesh; P. Rathore; A. Chakraborty; R. Krishnapuram; V. Kovvali; Y. Simmhan},
  title = {{Scaling} {Real-Time} {Traffic} {Analytics} on {Edge-Cloud} {Fabrics} for {City-Scale} {Camera} {Networks}},
  journal = {2026 IEEE 26th International Symposium on Cluster, Cloud and Internet Computing Workshops (CCGridW)},
  year = {2026},
  pages = {70--76},
  doi = {10.1109/CCGridW69005.2026.00027},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11617433},
  abstract = {Real-time city-scale traffic analytics requires processing 100s-1000s of CCTV streams under strict latency, bandwidth, and compute limits. We present a scalable AI-driven Intelligent Transportation System (AIITS) designed to address multi-dimensional scaling on an edge-cloud fabric. Our platform transforms live multi-camera video feeds into a dynamic traffic graph through a DNN inferencing pipeline, complemented by real-time nowcasting and short-horizon forecasting using Spatio-Temporal GNNs. Using a testbed to validate deployment in a Bangalore neighborhood, we ingest 100+ RTSP feeds from Raspberry Pis, while Jetson Orin edge accelerators perform highthroughput detection and tracking, producing lightweight flow summaries for cloud-based GNN inference. A capacity-aware scheduler load-balances across heterogeneous devices to sustain real-time performance as stream counts increase. To ensure continuous adaptation, we integrate SAM3 foundation-model assisted labeling and Continuous Federated Learning to update DNN detectors on the edge. Experiments show stable ingestion at up to 2000 FPS on Jetson Orins, low-latency aggregation, and accurate, scalable ST-GNN forecasts for up to 1000 streams. We will demonstrate live scaling of the full pipeline to 1000 streams, showcasing practical, cross-fabric scalability.},
  publisher = {IEEE},
  isbn = {979-8-3315-7047-7},
  keywords = {intelligent transportation systems;edge-cloud computing;graph neural networks;federated learning},
}

@article{hypergraphattentionnetworkfors2025,
  author = {Y. Tian; Z. Zhang; Y. Yang; R. Li; Z. Yang; R. Jin},
  title = {{Hypergraph} {Attention} {Network} for {Spatio-Temporal} {Interference} {Modeling} in {Cellular} {Networks}},
  journal = {IEEE Wireless Communications Letters},
  year = {2025},
  volume = {14},
  number = {12},
  pages = {4007--4011},
  doi = {10.1109/LWC.2025.3611392},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11172304},
  abstract = {Interference is an indelible dominant feature of wireless cellular networks, which has heavy impact on the transmission quality and network capacity. While much effort has been put on the construction of radio maps that intend to characterize signal distribution with complex channel propagation models, network interference modeling remains largely overlooked, leading to incomplete and inaccurate performance evaluation in network planning and optimization. In this letter, we propose an innovative data-driven approach to characterize the spatio-temporal interference pattern, or statistical interference map, of a multi-cell network, without knowing the exact complex underlying propagation environment and traffic pattern. Specifically, a hypergraph attention network (HGAT) is designed, in which the representation of nodes and edges are inherently aligned with the overall structure and operation of a wireless network, capturing the intricate dependencies between base stations, users, radio resource blocks and the received interferences. By leveraging spatio-temporal convolution, HGAT effectively encodes network dynamics and interference characteristics, enabling accurate and robust statistical prediction. Experimental results demonstrate that our approach surpasses conventional methods in accuracy, efficiency, and scalability, marking a significant step toward intelligent and efficient wireless network planning and optimization.},
  publisher = {IEEE},
  issn = {2162-2345},
  keywords = {Interference modeling;interference map;hypergraph attention network;spatio-temporal convolution},
}

@article{structureawaregnntransformerfo2026,
  author = {X. Nie; C. Zhang; C. Wang; Q. Zhou; X. Zhu; J. Zhang},
