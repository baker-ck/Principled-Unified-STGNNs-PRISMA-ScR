@article{lcastgnetamultimodaldynamicadj2025,
  author = {T. Lu; G. Shi; J. Ding},
  title = {{LCA-STGNet:} {A} {Multimodal} {Dynamic} {Adjacency} {Spatiotemporal} {Graph} {Neural} {Network} for {Traffic} {Prediction}},
  journal = {2025 International Conference on Artificial Intelligence and Digital Ethics (ICAIDE)},
  year = {2025},
  pages = {309--313},
  doi = {10.1109/ICAIDE65466.2025.11189553},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11189553},
  abstract = {In recent years, with the in-depth application of AI technology in the field of spatiotemporal fusion, modeling of complex spatiotemporal dependencies of small sample data has become a hot topic. However, existing methods usually have three major shortcomings: first, the spatial dependency based on the static adjacency matrix is difficult to reflect the real-time evolution of the road network; second, the spatiotemporal features are often modeled separately, and deep coupling cannot be achieved; third, the model structure complexity is high, which does not match the scale of small sample data and easily leads to overfitting. To this end, this paper proposes LCA-STGNet (Link-Coefficient Adaptation Spatio-Temporal GNN), which uses LSTM as a temporal encoder, uses a dynamic adjacency matrix to capture time-varying spatial features, and enhances information interaction and expression capabilities through cross-node attention mechanisms and residual connections. On a multi-section traffic speed dataset, LCA-STGNet performs significantly better than HA, ARIMA, LSTM, GCN+LSTM, and STGCN in multi-step prediction: compared with LSTM, the average RMSE is reduced by $41.5 \%$; compared with STGCN, MAE is reduced by $10.1 \%$ and $\mathbf\{R\}^\{\mathbf\{2\}\}$ is increased by 4.3 percentage points; and it remains robust in long sequence predictions, verifying its robustness and generalization ability in small sample scenarios.},
  publisher = {IEEE},
  isbn = {979-8-3315-2385-5},
  keywords = {Spatio-temporal fusion;Dynamic adjacency matrix;LSTM encoder;Small-sample learning},
}

@article{riccicurvatureenhancedtemporal2026,
  author = {S. Jiang; Q. Liu; X. Dai},
  title = {{Ricci-Curvature-Enhanced} {Temporal} {Graph} {Convolutional} {Networks} for {Traffic} {Speed} {Forecasting}},
  journal = {IEEE Access},
  year = {2026},
  volume = {14},
  pages = {20414--20426},
  doi = {10.1109/ACCESS.2026.3661581},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11373167},
  abstract = {Accurate long-horizon traffic speed forecasting is essential for intelligent transportation systems, yet spatiotemporal graph neural networks can suffer from over-squashing when information must traverse topological bottlenecks. We propose Ricci-T-GCN, a Ricci-curvature-enhanced spatiotemporal forecasting model that augments a temporal graph convolutional network (T-GCN) backbone with discrete OllivierâRicci curvature. A bias-controlled edge reweighting module assigns larger weights to negatively curved bridge edges, expanding effective message-passing capacity without altering the original connectivity. Experiments on two real-world datasets with contrasting topologies (Los-loop highway and SZ-taxi urban grid) show consistent improvements over statistical, machine-learning, and deep-learning baselines for 15â60 min horizons. At a 60 min horizon, Ricci-T-GCN reduces RMSE by about 7.5% on SZ-taxi and yields 1.7â3.0% gains on Los-loop compared with the strongest baseline. Node-wise and spatiotemporal analyses indicate that the largest benefits occur around strongly negative-curvature edges, providing geometric interpretability. These results suggest discrete curvature is a practical tool for mitigating structural bottlenecks in data-driven traffic forecasting.},
  publisher = {IEEE},
  issn = {2169-3536},
  keywords = {Geometric deep learning;graph neural networks;Ricci curvature;spatiotemporal modeling;traffic forecasting},
}

@article{aspatiotemporalgraphconvolutio2025,
  author = {W. Lu; Y. Luo; X. Xue; Y. Wang},
