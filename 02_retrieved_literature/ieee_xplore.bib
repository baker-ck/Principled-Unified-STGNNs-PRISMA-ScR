  abstract = {The process of tobacco blending and flavoring plays a decisive role in the quality of finished products and production efficiency in the tobacco shred process, and the fluctuation of blending flow is often closely related to the operati ng status of the logistics system. In view of the complex structure and significant dynamic changes of the tobacco box logistics system, this paper combines the track topology and transportation behavior of the tobacco box logistics system to design a multi-feature prediction framework that integrates dynamic graph structure learning, graph attention mechanism, and time series modeling. To address the challenge of limited and sparse source data, our model realizes the effective fusion of dynamic and static information by sharing the dynamic flow information with significant time series gradient changes and static distribution information, significantly improving the prediction performance and strengthening the representation and adaptability to complex working conditions. Experiments based on real production data show that the proposed method can achieve a refined prediction of future logistics status.},
  publisher = {IEEE},
  isbn = {979-8-3315-8929-5},
  keywords = {Tobacco box logistics;Spatio-temporal data analysis;Graph neural networks;Dynamic graph structure learning},
}

@article{multiscalemoebasedimplicitgrap2026,
  author = {G. Yang; W. Hong; X. Yin; X. Lian; Y. Liu; J. Chen},
  title = {{Multi-Scale} {MoE-Based} {Implicit} {Graph} {Learning} for {Spatio-Temporal} {Forecasting}},
  journal = {2026 11th International Conference on Computer and Communication Systems (ICCCS)},
  year = {2026},
  pages = {1--6},
  doi = {10.1109/ICCCS69761.2026.11613279},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11613279},
  abstract = {Spatio-temporal forecasting relies heavily on accurate and robust modeling of spatial dependencies among sensing nodes. However, predefined graph structures are often unavailable, incomplete, or noisy in real-world scenarios, which limits the performance of existing graph-based forecasting methods. To address this challenge, we propose a multi-scale mixture-of-experts framework for implicit graph structure learning and spatiotemporal prediction. Specifically, we first initialize a sparse base graph via a K-nearest neighbor strategy and construct multi-scale adjacency matrices through hop expansion to capture spatial dependencies under different receptive fields. A mixture-of-experts graph inference layer is then introduced to learn scale-aware node representations by dynamically routing information across multiple graph experts. Based on the learned embeddings, implicit adjacency relationships are further inferred via similaritybased edge completion, yielding a refined and completed graph structure. The completed graph is subsequently integrated into a spatio-temporal forecasting head for downstream prediction. Extensive experiments on real-world traffic and geophysical datasets demonstrate that the proposed framework consistently outperforms representative baselines. The results validate the effectiveness of multi-scale graph modeling and expert-based inference for implicit graph completion and spatio-temporal forecasting tasks.},
  publisher = {IEEE},
  isbn = {979-8-3195-0734-1},
  issn = {2995-3251},
  keywords = {Graph Neural Networks;Implicit Graph;Multiscale;MoE},
}

@article{adynamicmemorygraphofmultileve2025,
  author = {Z. Liu; A. Ji; L. Su; Z. Sun; L. Yang; M. Kong; X. Wang},
  title = {{A} {Dynamic} {Memory} {Graph} of {Multi-Level} {Feature} {Representation} {Approach} in {Traffic} {Prediction}},
  journal = {2025 IEEE 28th International Conference on Intelligent Transportation Systems (ITSC)},
  year = {2025},
  pages = {1159--1165},
  doi = {10.1109/ITSC60802.2025.11423525},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11423525},
  abstract = {With increasingly complicated urban transportation networks, precise traffic flow prediction provides a solid foundation for intelligent traffic management. This paper introduces a Hybrid Graph Memory Network (HGMN), a novel approach designed to model and forecast complex spatio-temporal dependencies in traffic dynamics. We employ one-dimensional convolutional layers to extract hierarchical features from inputs, facilitating structured representations across various extraction levels through pooling layers. Then, we introduce a graph memory network, which incorporates the decomposed features into a dynamic memory graph. This approach integrates adjacency matrices with time-varying features to capture the spatio-temporal dependencies inherent within the data. Finally, an upsampling mechanism fuses features from different hierarchical levels, ensuring the effective integration of detailed information and promoting the effective memory retention and prediction of short- and long-term traffic dynamics. Experiments across four distinct datasets are conducted to validate the performance of HGMN, alongside a sensitivity analysis to examine the impact of different components. The findings indicate that, compared to the benchmark, HGMN achieves a significant reduction in model sizes by 46.1%, leading to decreased memory usage, while still maintaining an accuracy improvement by 5.7%.},
  publisher = {IEEE},
  isbn = {979-8-3315-2418-0},
  issn = {2153-0017},
}

@article{matvtatransformerbasedapproach2026,
  author = {A. Li; H. Yu; Y. Pan; Z. Xu; H. Bi; B. Gao; K. Li; Y. Chen},
  title = {{MaTVT:} {A} {Transformer-Based} {Approach} for {Multi-Agent} {Prediction} in {Complex} {Traffic} {Scenarios}},
  journal = {IEEE Transactions on Vehicular Technology},
  year = {2026},
  volume = {75},
  number = {3},
  pages = {3904--3915},
  doi = {10.1109/TVT.2025.3614859},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11181100},
  abstract = {The future trajectories of surrounding agents are critical for the motion planning and control of autonomous vehicles. Thus, this study employs Transformer to develop a multi-agent trajectory prediction model named Multi-agent Trajectory Vector Transformer (MaTVT). MaTVT features a lightweight architecture, comprising a dual-level encoder formed by a low-level encoder and a high-level encoder, along with a multi-modal decoder. Once input enters MaTVT, the low-level encoder first constructs polar coordinate systems centered on target agents and then projects historical trajectories and map elements to each agent-centered coordinate system. Next, it utilizes attention mechanisms to encode motion features, agent-agent interactions, and agent-infrastructure constraints independently and fuses them into the agent encoding sequence. Considering the agent response delay, the low-level encoder extracts heterogeneous spatial-temporal features from agent encoding sequences as the local encodings for target agents. Afterward, the high-level encoder treats all agents as the nodes in a directed graph and utilizes a Graph Attention Network to convert inter-agent relationships into global encodings, which are fused with the local encodings of target agents. Finally, the multi-modal decoder translates these fusion encodings into multi-modal trajectory predictions for target agents. This study selects complex traffic scenarios from the Argoverse Motion Forecasting dataset to create a dedicated dataset for MaTVT training, validation, and testing. The test results demonstrate that MaTVT outperforms advanced benchmark methods in prediction performance, revealing its superb accuracy, efficiency, and robustness. In addition, ablation studies further explain the interpretability of the main functional components of MaTVT and their contributions to prediction performance.},
  publisher = {IEEE},
  issn = {1939-9359},
  keywords = {Attention mechanism;complex traffic scenario;multi-agent trajectory prediction;transformer},
}

@article{towardgeneralizedurbancomputin2025,
  author = {Y. Zhang; C. Li; S. He; X. Zhang; J. Chen},
  title = {{Toward} {Generalized} {Urban} {Computing:} {Pretraining} a {Spatial-Temporal} {Model} for {Diverse} {Urban} {Tasks}},
  journal = {IEEE Transactions on Mobile Computing},
  year = {2025},
  volume = {24},
  number = {10},
  pages = {10840--10852},
  doi = {10.1109/TMC.2025.3573373},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11014628},
  abstract = {Urban computing leverages data analysis to improve urban areasâ efficiency and sustainability, tackling tasks like traffic management, crime forecasting, and air quality predictions. Current models, while efficient, often struggle with tasks beyond their initial training due to limited flexibility. Typically, new tasks require developing specialized models, which may not perform optimally with limited data. To overcome these challenges, we propose the development of a universal pretrained model that understands a cityâs various aspects comprehensively. This model serves as a robust foundation, ready to be quickly adjusted for different urban tasks as they arise, even if they occur in different cities. Unlike language models, urban computing models must handle unique spatial-temporal dynamics, making standard pretraining techniques inadequate. Our approach includes a spatial-temporal module with multi-graph convolution and temporal attention mechanisms, capturing the necessary spatial-temporal patterns during pretraining. We also integrate a prompt-tuning module within this framework, which can be adapted for new predictive tasks. The results of extensive experiments on four urban predictive tasks across two cities demonstrate the effectiveness of our model.},
  publisher = {IEEE},
  issn = {1558-0660},
  keywords = {Urban computing;spatial-temporal prediction;within and across cities;data limited},
}

@article{multimodespatiotemporaladaptiv2026,
  author = {C. Li; Y. Chen; S. Xu; X. Chen},
  title = {{Multi-Mode} {Spatiotemporal} {Adaptive} {Fusion} {Network} for {Travel} {Demand} {Prediction}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2026},
  volume = {27},
  number = {3},
  pages = {3546--3563},
  doi = {10.1109/TITS.2025.3639619},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11301019},
  abstract = {The development of multi-mode transportation systems, e.g., bus, metro, taxi, and bike-sharing, presents a fundamental challenge in forecasting demand across heterogeneous, noisy, and complexly interacting data streams. From a feature modeling perspective, this requires a shift from simple data fusion to a more principled approach. This paper introduces a novel end-to-end framework, Multi-mode Spatiotemporal Adaptive Fusion Network (MSTAFN), that systematically addresses this challenge through a two-stage process: 1) unsupervised shared feature selection, and 2) dynamic asymmetric feature interaction modeling. For the first stage, we design an Infomax module that employs an information-theoretic principle to obtain a clean low-dimensional shared latent representation from cross-mode data. This representation captures the underlying semantic drivers of demand, such as latent commuting patterns, while mitigating noise and redundancy. For the second stage, we propose a Multi-Flashback module to explicitly model the complex asymmetric interactions between heterogeneous features, particularly across different temporal granularities. Its Cross-Flashback mechanism is designed to allow low-frequency modes (e.g., metro) to be informed by the latest fine-grained dynamics of high-frequency modes (e.g., bike-sharing). Experiments on a large-scale real-world dataset from New York City demonstrate that our two-stage paradigm outperforms state-of-the-art baselines, especially on the mode with the coarsest time granularity. This validates the superiority of our proposed modeling framework, supporting the improvement of operational efficiency for multi-mode transportation systems.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Demand prediction;multi-mode transportation systems;inter-mode feature learning;adaptive information fusion},
}

@article{animprovedspatiotemporalgraphc2026,
  author = {D. Sun; S. Han; Y. Qi; T. Zhu},
  title = {{An} improved spatio-temporal graph convolutional network with adaptive weighting for traffic congestion prediction},
  journal = {7th International Conference on Artificial Intelligence and Advanced Manufacturing (AIAM 2025)},
  year = {2026},
  volume = {2025},
  pages = {760--765},
  doi = {10.1049/icp.2025.4582},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11510111},
  abstract = {Accurate traffic congestion prediction is a critical component of modern Intelligent Transportation Systems (ITS), yet it remains a significant challenge due to the complex and dynamic spatio-temporal dependencies inherent in traffic flow data. This paper proposes a novel, two-stage framework for high-precision traffic congestion prediction. The primary contribution is an improved Spatio-Temporal Graph Convolutional Network (STGCN) designed for traffic flow forecasting. For spatial feature extraction, the proposed model enhances traditional graph convolution by introducing a learnable, adaptive weight matrix, which overcomes the limitations of fixed adjacency matrices and allows the network to dynamically model the influence between traffic nodes. For temporal feature extraction, a multi-kernel convolutional structure is employed to capture traffic flow patterns across different time scales simultaneously. The second stage of the framework is a congestion evaluation module. This module takes the predicted traffic parameters (flow, speed, and occupancy) from the STGCN and utilizes the Entropy Weight Method to objectively determine the contribution of each parameter to congestion. A Fuzzy Comprehensive Evaluation method is then applied to fuse these weighted parameters and produce a final, precise congestion level classification. Validated on the public PeMS dataset, the proposed model demonstrates superior performance in traffic flow prediction compared to baseline deep learning models and achieves a final weighted average accuracy of ninety-six percent in congestion level prediction.},
  publisher = {IET},
  isbn = {978-1-80705-128-0},
}

@article{aninferencespatiotemporalmachi2025,
  author = {A. Ayman; O. Attallah; A. Onsy; H. Brooks; I. Morsi},
  title = {{An} {Inference} {Spatiotemporal} {Machinery} {Prognostics} {Approach} {Based} on {Graph} {Learning}},
  journal = {2025 7th International Youth Conference on Radio Electronics, Electrical and Power Engineering (REEPE)},
  year = {2025},
  pages = {1--5},
  doi = {10.1109/REEPE63962.2025.10970932},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10970932},
  abstract = {Machinery prognostics facilitates predictive maintenance, minimizing downtime and operational expenses. Nonetheless, challenges persist due to low signal-to-noise ratio and non-stationary signals. Spatiotemporal feature extraction through recurrent and convolutional neural networks has shown promise in addressing these challenges. Nevertheless, the traditional convolutional learning algorithm, which is based on Euclidean distances between the learned features, can increase the model uncertainty. Moreover, traditional feature fusion techniques can weaken the model's performance. This study proposes a novel inferential spatiotemporal approach. Two independent networks based on long short-term memory and a graph convolutional network are designed to extract the influential spatiotemporal features. Then an adaptive neurofuzzy inferential network is introduced to calculate the remaining useful life based on the extracted spatiotemporal features. Experimental validation using a benchmark bearing dataset under various operational conditions demonstrates that the proposed approach outperforms existing state-of-the-art methods by 59.34 %.},
  publisher = {IEEE},
  isbn = {979-8-3315-3183-6},
  issn = {2831-7262},
  keywords = {predictive maintenance;machinery prognostics;graph convolutional networks;remaining useful life prediction},
}

@article{tsgfmtowardsagraphfoundationmo2025,
  author = {H. Latif-MartÃ­nez; P. Casas; J. SuÃ¡rez-Varela; A. Cabellos-Aparicio; P. Barlet-Ros},
  title = {{TSGFM} - {Towards} a {Graph} {Foundation} {Model} for {Time} {Series} {Analysis} in {Network} {Monitoring}},
  journal = {2025 9th Network Traffic Measurement and Analysis Conference (TMA)},
  year = {2025},
  pages = {1--4},
  doi = {10.23919/TMA66427.2025.11096996},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11096996},
  abstract = {We present TSGFM, a Time Series Graph Foundation Model for network monitoring data analysis, based on spatiotemporal Graph Neural Networks (GNN). Inspired by the success of foundation models in achieving generalization and adaptation, TSGFM leverages pretraining on diverse multivariate timeseries (MTS) data from multiple domains to enable effective zero-shot analysis in network monitoring tasks. We compare TSGFM performance against five state-of-the-art AI/ML models in seven zero-shot forecasting scenarios, using five MTS datasets from different domains. Evaluations demonstrate that TSGFM achieves superior performance in six out of seven zero-shot testing scenarios. Most notably, in zero-shot network monitoring analysis, TSGFM surpasses all competing models by at least 18%, even without training on any network monitoring data.},
  publisher = {IEEE},
  isbn = {978-3-903176-74-4},
}

@article{dynkdddynamicgraphbasednetwork2025,
  author = {A. A. Mir; M. F. Zuhairi; S. Musa; A. Namoun},
  title = {{DynKDD:} {Dynamic} {Graph-Based} {Network} {Intrusion} {Detection} {Using} {Graph} {Neural} {Networks}},
  journal = {2025 19th International Conference on Ubiquitous Information Management and Communication (IMCOM)},
  year = {2025},
  pages = {1--8},
  doi = {10.1109/IMCOM64595.2025.10857434},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10857434},
  abstract = {The inability to capture the temporal dynamics of network interactions limits traditional intrusion detection systems (IDSs) in detecting sophisticated threats that evolve over time. This research introduces DynKDD, a dynamic graph-based version of the NSL-KDD dataset, designed to capture the temporal relationships between network entities and their interactions. The proposed solution leverages Graph Neural Networks (GNNs) to detect network intrusions by analysing both the spatial and temporal evolution of network traffic. The methodology involves transforming the static NSL-KDD dataset into a series of timeordered graph snapshots by assigning synthetic timestamps and constructing dynamic graphs. The snapshots represent the evolution of network interactions, enabling advanced dynamic graph learning models to process and detect intrusions. Five stateof-the-art GNN models, Graph Convolutional Networks (GCN), Graph Attention Networks (GAT), Graph Sample and Aggregation (GraphSAGE), Graph Isomorphism Networks (GIN) and Graph Auto-Encoders (GAE), were trained and tested on the DynKDD dataset, and their performance was evaluated using metrics such as accuracy, precision, recall, and F1-score. Evaluation results demonstrate that GraphSAGE consistently outperforms other models, achieving an accuracy of 95.80% on the DynKDD dataset, a notable improvement over the static NSLKDD dataset. Other models follow a similar trend with a significant improvement on the constructed DynKDD dataset. The results validate the superiority of dynamic graph-based intrusion detection systems in identifying evolving network threats. With its ability to model evolving cyberattacks, DynKDD holds immense potential for real-world applications in protecting critical infrastructure from advanced and persistent threats, offering a transformative approach to network intrusion detection.},
  publisher = {IEEE},
  isbn = {979-8-3315-0781-7},
  keywords = {cybersecurity;dataset;dynamic graphs;deep learning;graph neural networks;intrusion detection},
}

@article{clgsdncontrastivelearningbased2025,
  author = {P. Peng; X. Chen; X. Zhang; H. Tang; H. Shen; J. Li},
  title = {{CLGSDN:} {Contrastive-Learning-Based} {Graph} {Structure} {Denoising} {Network} for {Traffic} {Prediction}},
  journal = {IEEE Internet of Things Journal},
  year = {2025},
  volume = {12},
  number = {7},
  pages = {8638--8652},
  doi = {10.1109/JIOT.2024.3502517},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10757324},
  abstract = {The graph neural network-based prediction models have demonstrated remarkable utility in traffic prediction, and their efficacy is highly determined by the quality of the provided graphs. Consequently, there is an increasing demand for employing graph structure learning (GSL) techniques to optimize or generate the graphs. However, existing GSL techniques for traffic prediction encounter various issues, including the absence of temporal dynamicity, noisy connections, and insufficient supervisory information. To address these limitations, this article proposes a novel two-stage graph generation framework called contrastive learning-based graph structure denoising network (CLGSDN). This framework formulates the graph generation task as a probabilistic observation-inference process: using the self-learning adjacency matrix and time delayed self-attention (TDSA) methods to generate a series of graph observations, then inferring the optimal graph based on observations. The self-learning adjacency matrix is responsible for learning all potential connections in the graph, while TDSA enables the graph to change with traffic flow. In addition, CLGSDN identifies and eliminates noisy connections by modeling negative samples of the graph (edges), and defines virtual labels to achieve spatiotemporal graph contrastive learning (ST-GCL) in traffic prediction. The experimental results show that CLGSDN significantly enhances current mainstream traffic prediction models by providing reliable and efficient graphs. As such, it has significant implications for a wide range of applications, including traffic management, logistics, and smart transportation systems.},
  publisher = {IEEE},
  issn = {2327-4662},
  keywords = {Graph contrastive learning (GCL);graph generation;probability modeling;traffic prediction},
}

@article{artificialintelligenceinhumanm2025,
  author = {M. Mert},
  title = {{Artificial} {Intelligence} in {Human} {Mobility} and {Communication} {Modeling:} {A} {Comprehensive} {Survey}},
  journal = {2025 International Conference on Electrical, Communication and Computer Engineering (ICECCE)},
  year = {2025},
  pages = {1--7},
  doi = {10.1109/ICECCE67514.2025.11257939},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11257939},
  abstract = {This study presents a comprehensive review of artificial intelligence (AI) a pproaches for modeling human mobility and communication patterns. Drawing on diverse digital trace sources, including mobile phone metadata, GPS, sensor data, and geolocated social media, this work synthesizes methodological advances in time series and graph-based architectures such as LSTM, ST-GNN, and Transformer models. Each data type is evaluated in terms of its spatiotemporal resolution, strengths and limitations, privacy implications, and suitability for different analytical tasks. The review contextualizes these models across key application domains including urban planning, disaster response, tourism analytics, and social policy. Through these domains, it illustrates how AI-driven mobility modeling informs both real-time decision-making and long-term strategic planning. In addition to empirical insights, the paper identifies critical research gaps around multimodal data fusion, generalizability across contexts, interpretability, and ethical design. By highlighting these unresolved challenges, the study offers a structured roadmap for future research and policy development. It aims to support scholars and practitioners in designing scalable, fair, and transparent AI systems for the dynamic modeling of human behavior in space and time.},
  publisher = {IEEE},
  isbn = {979-8-3315-4915-2},
  keywords = {Human Mobility;Spatiotemporal Modeling;Multimodal Data;Artificial Intelligence},
}

@article{eventcouplednetworkfortrafficc2025,
  author = {M. Chang; Y. Sun; Y. Lu; D. Zhang; X. Li},
  title = {{Event-Coupled} {Network} for {Traffic} {Conversion} {Prediction} in {Weather} {Emergencies}},
  journal = {2025 26th IEEE International Conference on Mobile Data Management (MDM)},
  year = {2025},
  pages = {96--104},
  doi = {10.1109/MDM65600.2025.00031},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11058416},
  abstract = {Capturing traffic conversion between multi-agent travel patterns during weather emergencies is critical for improving urban transportation services and enhancing travel efficiency for citizens. However, existing studies have not fully explored the peculiarities of severe weather events, such as their rapid onset, temporal inhomogeneity, and data sparsity, which challenges conventional prediction models. In this paper, we introduce an Event-Coupled Field-aware Factorization Network(EC-FFN) that characterizes these accompanying events through triples and employs continuous-valued embeddings to address the data inhomogeneity. A Conv-FFN structure, which combines sparse feature interactions with field-aware factorization mechanisms, is designed to capture both local conversion features and global traffic dependencies. Additionally, we consider semantics and hierarchical associations from a spatial evolutionary perspective, enabling a combinatorial analysis of the endogenous causes of traffic conversion. Experiments on New York taxi and bike-share trip datasets demonstrate the model's effectiveness in predicting traffic conversion under weather emergencies.},
  publisher = {IEEE},
  isbn = {979-8-3315-2569-9},
  issn = {2375-0324},
  keywords = {data inhomogeneity representation;eventcoupled analysis;traffic conversion prediction;spatial evolutionary learning},
}

@article{targetconditionedinteractionpr2025,
  author = {J. Zhang; B. Chen; C. Li; Z. Chen; F. Wei; S. Shen},
  title = {{Target-Conditioned} {Interaction} {Pruning} for {Vehicle} {Trajectory} {Prediction} in {Crowded} {Scenarios}},
  journal = {2025 9th CAA International Conference on Vehicular Control and Intelligence (CVCI)},
  year = {2025},
  pages = {1--6},
  doi = {10.1109/CVCI66304.2025.11348324},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11348324},
  abstract = {In high-density traffic, road agents constantly adapt their motion based on others' behavior, making real-time trajectory prediction highly challenging. To address the limitations of existing methods in modeling dynamic dependencies, a spatiotemporal selective trajectory forecaster (SST-Forecaster) is proposed, a novel framework integrating selective interaction modeling with a target-conditioned generation mechanism. It features a two-stage architecture: In the encoding phase, long short-term memory (LSTM) networks and gated graph convolutional networks (GGCN) are used to construct and refine dynamic interaction graphs. In the decoding phase, Transformerenhanced spatiotemporal features are fed into an LSTM for autoregressive prediction, guided by a spatiotemporal state selection mechanism that incorporates surrounding agents' estimated motions while suppressing historical noise. Simulation experiments on the Argoverse dataset show that SST-Forecaster outperforms baseline algorithms in comparative experiments.},
  publisher = {IEEE},
  isbn = {979-8-3315-6906-8},
  keywords = {Trajectory Prediction;Spatiotemporal Modeling;Selective Interaction;Autonomous Driving},
}

@article{researchontouristflowanalysisa2025,
  author = {W. Bai; Y. Tang; J. Wang},
  title = {{Research} on {Tourist} {Flow} {Analysis} and {Prediction} {System} {Using} {Big} {Data}},
  journal = {2025 IEEE 3rd International Conference on Image Processing and Computer Applications (ICIPCA)},
  year = {2025},
  pages = {1710--1715},
  doi = {10.1109/ICIPCA65645.2025.11138252},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11138252},
  abstract = {This paper proposes an innovative tourist flow analysis and prediction system, which combines the hybrid algorithm of GNN and LSTM, aiming to solve the limitations of traditional models in processing large-scale, multi-dimensional data. GNN is used to model the spatiotemporal relationship between tourist attractions and surrounding transportation networks, and can effectively capture the complex interactions between scenic spots and between scenic spots and transportation nodes. LSTM is used to capture the time series dependency in passenger flow data, especially long-term dependency features such as seasonal changes and holiday effects. The combination of the two enables the model to simultaneously consider the spatiotemporal relationship and the long-term dependency of historical passenger flow, thereby improving the prediction accuracy. This paper uses large-scale historical passenger flow data, weather data, traffic data and social event data from multiple tourist attractions for training and verification. The experiment results show that the GNN/LSTM hybrid model is superior to the traditional SVM, RF and other single-machine learning models. Compared with the baseline model, the MSE is decreased by 24.7% and 18.5% respectively. Moreover, the system has demonstrated strong real-time forecast ability, and can deal with the high number of concurrent data requests and dynamic adjustment in the scenic area management.},
  publisher = {IEEE},
  isbn = {979-8-3315-2284-1},
  keywords = {Tourist flow prediction;GNN;LSTM;hybrid algorithm;machine learning},
}

@article{progressivetopologicalinteract2025,
  author = {Y. Lu; Q. Chen; L. Lu; Z. Deng; D. Chu},
  title = {{Progressive} {Topological} {Interaction} for {Vehicle} {Trajectory} {Prediction} at {Signalized} {Intersections}},
  journal = {2025 9th CAA International Conference on Vehicular Control and Intelligence (CVCI)},
  year = {2025},
  pages = {1--6},
  doi = {10.1109/CVCI66304.2025.11348418},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11348418},
  abstract = {Efficient multi-agent trajectory prediction at signalized intersections is crucial for autonomous driving safety. Existing methods typically perform one-shot decoding after hierarchical Map-Agent (AM) and Agent-Agent (AA) interactions. This static approach struggles to capture the dynamic evolution of scenes and its high computational cost limits real-time performance. To address these issues, we propose the Progressive Topological Interaction Network (ProTIn-Net). Our framework enables agents to progressively interact with map elements and other agents through a dynamic topological graph across evolving spatial-temporal scales. Specifically, a Spatial Progressive Interaction Module iteratively encodes map constraints and social influences to capture spatial evolution. Concurrently, a Temporal Progressive Interaction Module employs a dynamic, segmented decoding scheme where the prediction from each time segment serves as the simulated input to update the dynamic topological graph, progressively generating the complete trajectory. Experiments on the V2X-Seq dataset demonstrate that ProTIn-Net achieves an exceptional balance between prediction accuracy and inference speed, yielding superior overall performance compared to existing methods. This work validates the effectiveness of a progressive interaction paradigm for creating accurate and real time trajectory prediction systems.},
  publisher = {IEEE},
  isbn = {979-8-3315-6906-8},
  keywords = {vehicle trajectory prediction;progressive interaction;topological graph;signalized intersection;autonomous driving},
}

@article{citymindamultimodalfederatedtr2026,
  author = {G. Sujatha; S. R. Tottempudi; R. Shaik; G. R. Mittoor; B. Madhavi; B. L. V. S. RamaKrishna},
  title = {{Citymind:} {A} {Multimodal} {Federated} {Transformer} {Framework} for {Real-Time} {Urban} {Anomaly} {Detection} and {Adaptive} {City} {Response}},
  journal = {2026 7th International Conference on Mobile Computing and Sustainable Informatics (ICMCSI)},
  year = {2026},
  pages = {1360--1365},
  doi = {10.1109/ICMCSI67283.2026.11412624},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11412624},
  abstract = {A tremendous amount of data is constantly being generated by sources such as traffic and weather cameras, environmental sensors, digital infrastructure in city areas. In this situation, it has become a big challenge for the smart city managers to detect unusual events in real-time. In this paper, we have proposed a machine learning system based on the METR-LA city traffic dataset that detects abnormal conditions related to traffic and mobility. The proposed framework involves understanding the relationships between road segments by integrating temporal modeling with graph-based spatial learning and works accordingly to the dynamic changes that take place in the traffic flow. Using LSTM and transformer-based sequence modeling techniques, the system predicts normal traffic behavior and identifies deviations from that normal state - such as those associated with traffic congestion, accidents, or infrastructure faults. Experimental results show that, compared to traditional threshold-based and isolation-based methods, the proposed approach achieves greater accuracy, faster convergence, and lower false alarm rate. These results demonstrate that this approach can be effective in providing intelligent decision support to smart city traffic control systems.},
