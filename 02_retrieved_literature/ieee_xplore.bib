}

@article{networkwidetrafficvolumeestima2025,
  author = {L. Hein; G. De Nunzio; G. Chierchia; A. Pirayre; L. Najman},
  title = {{Network-Wide} {Traffic} {Volume} {Estimation} from {Speed} {Profiles} {Using} a {Spatio-Temporal} {Graph} {Neural} {Network} with {Directed} {Spatial} {Attention}},
  journal = {2025 IEEE 28th International Conference on Intelligent Transportation Systems (ITSC)},
  year = {2025},
  pages = {553--560},
  doi = {10.1109/ITSC60802.2025.11423579},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11423579},
  abstract = {Existing traffic volume estimation methods typically address either forecasting traffic on sensor-equipped roads or spatially imputing missing volumes using nearby sensors. While forecasting models generally disregard unmonitored roads by design, spatial imputation methods explicitly address network-wide estimation; yet this approach relies on volume data at inference time, limiting its applicability in sensor-scarce cities. Unlike traffic volume data, probe vehicle speeds and static road attributes are more broadly accessible and support full coverage of road segments in most urban networks. In this work, we present the Hybrid Directed-Attention Spatio-Temporal Graph Neural Network (HDA-STGNN), an inductive deep learning framework designed to tackle the network-wide volume estimation problem. Our approach leverages speed profiles, static road attributes, and road network topology to predict daily traffic volume profiles across all road segments in the network. To evaluate the effectiveness of our approach, we perform extensive ablation studies that demonstrate the model's capacity to capture complex spatio-temporal dependencies and highlight the value of topological information for accurate network-wide traffic volume estimation without relying on volume data at inference time.},
  publisher = {IEEE},
  isbn = {979-8-3315-2418-0},
  issn = {2153-0017},
  keywords = {Traffic volume estimation;spatio-temporal graph neural networks;graph attention;spatial extrapolation;multimodal features},
}

@article{modellingpredictiveuncertainty2026,
  author = {H. N; R. Sumathi},
  title = {{Modelling} {Predictive} {Uncertainty} for {Reliable} {Traffic} {Flow} {Forecasting} {Using} {UA-STTFF} {Framework}},
  journal = {2026 4th International Conference on Knowledge Engineering and Communication Systems (ICKECS)},
  year = {2026},
  pages = {1--8},
  doi = {10.1109/ICKECS70176.2026.11527702},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11527702},
  abstract = {Intelligent Transportation Systems (ITS) rely on precise and reliable traffic flow forecasting (TFF) to alleviate congestion, optimise routing, and allow safe traffic management. Nevertheless, most current spatiotemporal forecasting models do not well model complicated spatial interactions between intersections and changing time dynamics, and do not pay much attention to predictive uncertainty, which is essential in decision-making in the presence of variable traffic conditions. To overcome these difficulties, the present paper introduces an Uncertainty-Aware Spatiotemporal Traffic flow Forecasting (UA-STTFF) framework that simultaneously trains spatial dependencies with the help of graph convolutional networks and time dynamics with the aid of gated recurrent units (GRUs). The structure also uses probabilistic output heads and Monte Carlo (MC) dropout to enable the uncertainty-aware traffic forecasting. The proposed UA-STTFF is strictly tested on simulated multi-intersection time-series data of traffic. Detailed ablation experiments show that the spatial graph convolution and the temporal GRU block are fundamental in the enhancement of predictive accuracy, whereas probabilistic heads and MC dropout considerably enhance the representation of uncertainty. The experiments have demonstrated that UA-STTFF outperforms a deterministic spatiotemporal graph neural network baseline by 26.4%, 25.6%, and 26.4% in mean absolute error (MAE), root mean square error (RMSE), and mean absolute percentage error (MAPE). Further, the model has a prediction interval coverage probability (PICP) of 93.7%, which is a good prediction of uncertainty. Visualising uncertainty at the node level also allows the identification of intersections that are likely to be highly risky, which can be used in risk-conscious traffic control. In general, the suggested framework eliminates the significance of uncertainty-sensitive modelling in dependence on credible and extensive ITS.},
  publisher = {IEEE},
  isbn = {979-8-3315-4777-6},
  keywords = {TFF;UQ;Probabilistic Modelling;ITS;Spatio-Temporal Graph Neural Network (ST-GNN)},
}

@article{bistdgcnabidirectionalspatiote2026,
  author = {J. Yan; B. Dong; B. Qu; Y. Gao},
  title = {{Bi-STDGCN:} {A} {Bidirectional} {Spatiotemporal} {Diffusion} {Graph} {Convolutional} {Network} {With} {Multiscale} {Anomaly-Guided} {Attention} for {Traffic} {Forecasting}},
  journal = {IEEE Internet of Things Journal},
  year = {2026},
  volume = {13},
  number = {6},
  pages = {12405--12422},
  doi = {10.1109/JIOT.2026.3652408},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11343814},
  abstract = {Accurate traffic flow prediction is a key application in Internet of Things (IoT)-enabled intelligent transportation systems (ITSs). However, complex spatiotemporal dependencies and nonstationary anomalies make reliable forecasting particularly challenging. To address these issues, we propose a bidirectional spatiotemporal diffusion graph convolutional network (Bi-STDGCN) with multiscale anomaly-guided attention. The core idea is to jointly model anomaly-aware temporal variations and bidirectional spatial diffusion within a unified multisource dynamic graph framework. First, an anomaly-guided feature enhancement module (AGFEM) employs a difference-driven attention mechanism guided by multiscale temporal patterns derived from wavelet-based decomposition, enhancing the modelâs ability to perceive periodic disruptions and sudden traffic fluctuations. Second, Bi-STDGCN captures directional dependencies in both time and space by integrating a bidirectional diffusion dynamic graph convolutional recurrent unit (BDDGCRU) for temporal modeling to reduce prediction lag under anomalies, and a bidirectional diffusion GCN (BD-GCN) to model upstream propagation and downstream feedback patterns in the spatial domain. Third, the multisource dynamic attention-based graph generation (DAGG) incorporates static topology, temporal attributes, real-time traffic states, and hidden node states to construct robust time-varying spatial graphs. Extensive experiments on five real-world datasets demonstrate that Bi-STDGCN achieves state-of-the-art accuracy and robustness, while ablation and visualization analyses further validate the effectiveness of each component.},
  publisher = {IEEE},
  issn = {2327-4662},
  keywords = {Bidirectional diffusion graph convolution (BDGC);bidirectional gated recurrent unit (GRU);dynamic graph structure;periodicity disruptions sensitivity;sudden short-term changes sensitivity;traffic flow prediction},
}

@article{spatialtemporaldynamicfeatures2026,
  author = {A. A. Qaseem; K. Sheng; D. M. Sime; E. B. Atanaw},
  title = {{Spatial-Temporal} {Dynamic} {Features} {Fusion} {Graph-Transformer} {Network} for {Traffic} {Flow} {Prediction}},
  journal = {2026 5th Asia Conference on Algorithms, Computing and Machine Learning (CACML)},
  year = {2026},
  pages = {1--6},
  doi = {10.1109/CACML68972.2026.11507053},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11507053},
  abstract = {Accurate traffic flow prediction is essential for enhancing the efficiency and reliability of ITS. However, achieving high accuracy remains challenging due to the intricate spatial dependencies among road segments and the evolving temporal dynamics of traffic patterns across multiple time scales. This paper proposes a Spatial-Temporal Dynamic Feature Fusion Graph Transformer Network (STDF-GT) for traffic prediction. STDF-GT introduces a spatial-temporal feature extraction block that combines a Spatial Graph Convolution Network (Spatial Graph-Conv) and a Spatial Transformer Network (SpaFormer) to model both static and dynamic spatial correlations. A Gated Temporal Transformer Network (GTempFormer) is developed to capture short- and long-range temporal dependencies across multiple time scales. Additionally, a feature fusion layer with an attention mechanism effectively integrates the extracted spatiotemporal correlations. Experiments on four real-world traffic datasets show that STDF-GT outperforms baseline methods regarding prediction performance.},
  publisher = {IEEE},
  isbn = {979-8-3315-7095-8},
  keywords = {Traffic flow prediction;Spatial-temporal correlations;Long-term prediction;Transformer network;Graph convolutional network},
}

@article{probabilisticspatiotemporaltra2025,
