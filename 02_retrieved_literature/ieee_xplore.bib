  pages = {286--302},
  doi = {10.1109/TBDATA.2024.3414280},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10557129},
  abstract = {We propose an equity-aware GRAph-fusion differentiable Pooling neural network to accurately predict the spatio-temporal urban mobility (e.g., station-level bike usage in terms of departures and arrivals) with Equity (GRAPE). GRAPE consists of two independent hierarchical graph neural networks for two mobility systemsâone as a target graph (i.e., a bike sharing system) and the other as an auxiliary graph (e.g., a taxi system). We have designed a convolutional fusion mechanism to jointly fuse the target and auxiliary graph embeddings and extract the shared spatial and temporal mobility patterns within the embeddings to enhance prediction accuracy. To further improve the equity of bike sharing systems for diverse communities, we focus on the bike resource allocation and model prediction performance, and propose to regularize the predicted bike resource as well as the accuracy across advantaged and disadvantaged communities, and thus mitigate the potential unfairness in the predicted bike sharing usage. Our evaluation of over 23 million bike rides and 100 million taxi trips in New York City and Chicago has demonstrated GRAPE to outperform all of the baseline approaches in terms of prediction accuracy (by 15.80% for NYC and 50.55% for Chicago on average) and social equity awareness (by 32.44% and 24.43% in terms of resource fairness for NYC and Chicago, and 13.36% and 16.52% in terms of performance fairness).},
  publisher = {IEEE},
  issn = {2332-7790},
  keywords = {Bike sharing;differentiable pooling;equity awareness;usage prediction;target and auxiliary graphs},
}

@article{spatialidentityembeddingoradja2025,
  author = {W. Zhang; D. Hu},
  title = {{Spatial} {Identity} {Embedding} or {Adjacency} {Matrix:} {Rethinking} {Spatial} {Dependency} {Modeling} in {Traffic} {Prediction}},
  journal = {2025 International Joint Conference on Neural Networks (IJCNN)},
  year = {2025},
  pages = {1--10},
  doi = {10.1109/IJCNN64981.2025.11227811},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11227811},
  abstract = {Spatial dependency modeling, with the objective of uncovering the intricate spatial correlations within spatiotemporal data, plays a crucial role in traffic forecasting. Current research endeavors in spatial dependency modeling primarily concentrate on aggregating local or global information. This is achieved through sophisticated adjacency matrices utilizing techniques such as Graph Convolutional Networks (GCNs) or self-attention mechanisms. Nevertheless, recent studies indicate that incorporating spatial identity embedding with simple architectures can achieve modeling performance that competes favorably with more complex counterparts. Motivated by this, our work systematically revisits current spatial dependency modeling methods in traffic prediction, leading to two key observations: 1) All approaches utilizing spatial identity embedding significantly improve the modelâs predictive capabilities; 2) Methods employing learnable static graph demonstrate superior performance among adjacency matrix-based approaches, even without incorporating spatial identity embedding. Next, our attention shifts to spatial indistinguishability, a fundamental aspect of spatial dependency. We establish a clear definition and quantification of spatial indistinguishability in terms of the modelâs data perception. Rethinking spatial dependency modeling through the lens of spatial indistinguishability, we observe that a simple amalgamation of the two aforementioned methods fails to yield the desired performance improvements. To address this issue, we present the Spatio-Temporal Adaptive Embedding Neural Network, STAENet. This network employs spatial identity embedding as the primary spatial dependency modeling technique and the adjacency matrix as an auxiliary spatial dependency modeling method. To seamlessly integrate spatial identity embedding with the adjacency matrix, we introduce a simple yet effective Top-K strategy. This strategy efficiently trims the adjacency matrix, emphasizing the most crucial neighborhood information. Extensive experiments conducted on datasets validate the efficiency and effectiveness of the proposed method over several its competitors. The code will be made public at the following website https://github.com/randomforest1111/STAENet.},
  publisher = {IEEE},
  isbn = {979-8-3315-1042-8},
  issn = {2161-4407},
  keywords = {Spatial Dependency Modeling;Spatial Indistinguishability;Spatial Identity Embedding;Adjacency Matrix;Traffic Prediction},
}

@article{jointspatiotemporalfrequencyaw2026,
  author = {J. Cai; K. Liu; Y. Yue; K. Cai; Y. Zhu; J. Wang},
  title = {{Joint} {Spatiotemporal-Frequency-Aware} {Feature} {Fusion} for {Vehicle} {Trajectory} {Prediction}},
  journal = {IEEE Internet of Things Journal},
  year = {2026},
  volume = {13},
  number = {3},
  pages = {5279--5292},
  doi = {10.1109/JIOT.2025.3642400},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11296752},
  abstract = {To guarantee rational decision-making and safety of intelligent transportation systems and autonomous driving, existing vehicle trajectory prediction (VTP) methods extract spatial and temporal features from complex traffic environments to achieve accurate forecast results. However, they generally do not use the frequency-domain information inherently embedded in vehicle trajectory data, resulting in lower prediction accuracy. To solve this problem, we propose a joint spatiotemporal-frequency-aware feature fusion (STFA-FF) method for VTP. First, an intention recognition network is proposed to integrate spatial features and temporal features to infer driving intentions with high precision. Second, to fully utilize frequency-domain features, we present a multiscale frequency-domain feature extraction (MSFDFE) module to map vehicle trajectory data into the frequency domain, incorporate the high-frequency attenuation mask to suppress high-frequency noise, and deeply integrate short-term variations with long-term trends. In addition, a frequency-domain channel selection (FDCS) module is proposed to dynamically select key frequency channels related to driving modes. Furthermore, a multidomain feature fusion prediction network is proposed to process the spatial, temporal, and frequency-domain features to generate the final trajectory prediction results. Finally, experimental results demonstrate that the proposed method significantly outperforms mainstream approaches in prediction accuracy and robustness.},
  publisher = {IEEE},
  issn = {2327-4662},
  keywords = {Autonomous driving;feature fusion;frequency-domain feature;intelligent transportation system;spatiotemporal-aware;vehicle trajectory prediction (VTP)},
}

@article{osthgcnoptimizedspatialtempora2025,
  author = {X. Lin; Y. Zhang; S. Wang; Y. Hu; B. Yin},
  title = {{OST-HGCN:} {Optimized} {Spatial-Temporal} {Hypergraph} {Convolution} {Network} for {Trajectory} {Prediction}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2025},
  volume = {26},
  number = {3},
  pages = {3056--3070},
  doi = {10.1109/TITS.2025.3529666},
