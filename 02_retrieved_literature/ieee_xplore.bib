@article{dynamicmodelingandanalysisofbi2025,
  author = {J. Fan; F. Zhu; W. Weng; X. Zhang; H. Jiang; H. Tian; H. Wu},
  title = {{Dynamic} {Modeling} and {Analysis} of {Bi-Directional} {Traffic} {Flows} {Through} a {Deep} {Spatio-Temporal} {Graph} {Neural} {Network}},
  journal = {IEEE Transactions on Big Data},
  year = {2025},
  volume = {11},
  number = {6},
