  abstract = {Predicting traffic data is crucial for public safety and efficient resource allocation. Due to the constantly changing nature of traffic data over temporal and spatial patterns, traffic forecasting remains highly challenging. Various spatial-temporal network architectures are employed to effectively process and analyze interconnected spatial and temporal data patterns. However, existing work has mainly focused solely on learning the spatial-temporal dependencies in the data without addressing the issue of distribution shift in non stationary traffic data. Additionally, there is currently a lack of an efficient model to adequately extract spatial dependencies in the data. This study introduces a novel katz-attention enhanced decomposition-fusion approach (KADF) to mitigate the distribution shift challenge which can improve model generalization capability and enhance model robustness.Our method separates intricate traffic data into stable patterns and variable occurrences, then employs a two-pronged spatial temporal neural network to independently analyze these paterns. The reasonable future traffic data can be predicted based on fused trend and event. In addition, we propose a method that utilizes pre-defined graph structure information to model spatial dependencies. Compared to traditional graph attention networks, this method greatly reduces computational complexity. Our research involved comprehensive testing across four distinct datasets, which highlighted the advantages of our model. The results indicated improved forecast precision and reduced computational costs compared to existing approaches.},
  publisher = {IEEE},
  isbn = {979-8-3315-2491-3},
  keywords = {Traffic Forcasting;Non-stationary Time Series;Data Decomposition},
}

@article{eistnetanefficienttrafficflowp2026,
  author = {G. Xie; J. Qiu; C. Yi; J. Zhan; J. Hu; Y. Liu},
  title = {{EISTNet:} {An} {Efficient} {Traffic} {Flow} {Prediction} {Method} via {ExplicitâImplicit} {Spatiotemporal} {Collaborative} {Networks}},
  journal = {IEEE Sensors Journal},
  year = {2026},
  volume = {26},
  number = {15},
  pages = {23087--23101},
  doi = {10.1109/JSEN.2026.3705396},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11579467},
  abstract = {Traffic flow prediction is a core task in intelligent transportation systems (ITSs), yet it remains challenging due to the intricate coupling of local topological correlations and global macrodynamics. We propose the explicitâimplicit spatiotemporal collaborative network (EISTNet), a novel framework that synergistically models these dependencies through a decoupled parallel architecture. The explicit branch utilizes temporal attention and dynamic graph modeling to capture local evolutions, while the implicit branch integrates the Mamba block to model long-range global trends. Extensive experiments demonstrate that the EISTNet delivers competitive accuracy and superior computational efficiency. Notably, analysis on PEMS03 reveals that its extreme spatiotemporal homogeneityâmanifested through spatial redundancy and synchronized fluctuationsârenders learnable embeddings (LEs) prone to overfitting stochastic noise. EISTNet maintains robustness in such scenarios by effectively decoupling global stability from local nuances, allowing each branch to fulfill its respective functional role where serial or individual architectures often fail. Furthermore, t-SNE visualizations on PEMS04 confirm that the fused features of EISTNet generate more discriminative and well-clustered representations compared to serial variants, demonstrating its superior capability in distinguishing heterogeneous traffic patterns. Overall, EISTNet provides a scalable and resilient solution for high-resolution traffic forecasting. The code is available at https://github.com/Kivly/EISTNet},
  publisher = {IEEE},
  issn = {1558-1748},
  keywords = {Graph neural network (GNN);Mamba;spatiotemporal learning;traffic prediction},
}

@article{parallelselflearnedandpredefin2025,
  author = {X. Yang; Q. Li; P. Xu; D. He; H. Tan},
  title = {{Parallel} {Self-Learned} and {Predefined} {Joint} {SpatialâTemporal} {Graph} {Convolutional} {Networks} for {Traffic} {Flow} {Prediction}},
