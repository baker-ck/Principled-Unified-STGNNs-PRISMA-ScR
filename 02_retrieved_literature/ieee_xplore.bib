@article{generativeadversarialpretraini2026,
  author = {Z. Zhao; G. Shen; W. Zhou; J. Qi; Y. Liu; X. Kong},
  title = {{Generative} {Adversarial} {Pre-Training} {Enabled} {SpatialâTemporal} {Graph} {Modeling} of {Traffic} {Data}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2026},
