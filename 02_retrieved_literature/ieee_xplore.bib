@article{featurefusionspatiotemporalnet2025,
  author = {B. Fang; Q. Dong; G. Lu; Z. Cheng; H. Li; Y. Jia},
  title = {{Feature} {Fusion} {Spatio-Temporal} {Network} for {Urban} {Electric} {Vehicle} {Charging} {Load} {Forecasting}},
