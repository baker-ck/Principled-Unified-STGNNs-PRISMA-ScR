@article{afourphasespatiotemporalandqua2026,
  author = {S. S. Chauhan; V. K. Jha; G. S. Gupta},
  title = {{A} {Four-Phase} {Spatio-Temporal} and {Quantum-Enhanced} {Framework} for {Traffic} {Speed} {Forecasting} {With} {Calibrated} {Uncertainty}},
  journal = {IEEE Access},
  year = {2026},
  volume = {14},
  pages = {28994--29017},
  doi = {10.1109/ACCESS.2026.3665240},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11397327},
  abstract = {Short-term forecasting of traffic speeds is a foundational requirement for adaptive signal control, congestion mitigation, and emerging real-time digital twin infrastructures. Despite substantial progress, many deep learning approaches continue to experience difficulties in capturing long-range temporal behavior, handling non-stationary traffic conditions, and producing reliable measures of predictive uncertainty. To address these challenges, this work develops a four-stage hybrid spatio-temporal framework consisting of: (i) a graph-attention spatial encoder, (ii) a temporal Transformer module, (iii) a variational quantum fusion layer, and (iv) a conformal calibration component for uncertainty adjustment. In all our experiments we used the METR-LA benchmark which we did in order to maintain the like conditions for method and empiric study. In the put forth pipeline the Transformer which we introduced in Phase 2 does the best job in terms of point forecast accuracy, we see Mean Absolute Error (MAE) values of 3.46, 3.68, and 3.76 for the 5, 10 and 15 minute prediction horizons which is a 50% or greater improvement over the Spatial-Temporal Graph Attention Network (ST-GAT) base. In Phase 3 we looked at the quantum augmented version which did see a small improvement at the short term horizon but as the time horizon increased we saw a slight drop in performance which we note is a common issue in present variational quantum circuits. Conformal calibration for uncertainty estimation produces prediction intervals with empirical coverage of 92.8%, significantly outperforming ensemble-based and Monte Carlo Dropout (MC-Dropout) methods. On an RTX-class Graphical Processing Unit (GPU), end-to-end inference takes about 150-250 ms, which is compatible with real-time operational requirements in intelligent transportation systems. A configuration with four attention heads, a one-hour historical input window, and a thirty-minute model update interval provides a workable trade-off between accuracy and computational cost, according to sensitivity analyses based on MAE and Root Mean Square Error (RMSE) combined with latency monitoring. Overall, the findings show that the suggested framework facilitates accurate traffic speed forecasting with calibrated uncertainty, allowing for more timely and informed decision-making in urban mobility applications.},
  publisher = {IEEE},
  issn = {2169-3536},
  keywords = {Traffic forecasting;spatio-temporal transformer;quantum machine learning;uncertainty quantification;conformal prediction;intelligent transportation systems},
}

@article{handovervolumeforecastingincel2026,
  author = {S. Bas; F. Cogen},
  title = {{Handover} {Volume} {Forecasting} in {Cellular} {Networks:} {A} {Comparison} of {Temporal} and {Spatio-Temporal} {Models}},
  journal = {2026 9th International Balkan Conference on Communications and Networking (Balkancom)},
  year = {2026},
  pages = {97--102},
  doi = {10.1109/BalkanCom71095.2026.11605025},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11605025},
  abstract = {Accurate short-term handover forecasting is essential for proactive resource allocation and mobility management in cellular networks. While handover dynamics exhibit strong temporal patterns, they are also inherently driven by spatial interactions between neighboring sites. This paper investigates whether explicitly modeling these spatial dependencies through spatio-temporal graph neural networks (STGNNs) leads to significant improvements over temporal-only approaches. Using hourly operational key performance indicator (KPI) data, cell-level handover records are aggregated into 132 sites and formulated as four forecasting targets capturing incoming and outgoing mobility flows. A site-level graph is constructed based on observed handover relations to model inter-site dependencies. A multi-horizon forecasting setup is adopted, where the past 12 hours are used to predict the next 12 hours. Two findings emerge. First, incorporating graph structure consistently improves forecasting accuracy: graph-based models outperform a graph-free temporal LSTM by 36â40% in MAE across all targets, confirming that inter-site spatial dependencies carry predictive value that site-independent models cannot capture. Second, a parameter-free weekly seasonal-naÃ¯ve baseline outperforms all learning-based models, revealing that the dominant weekly periodicity of handover traffic sets a high bar for any data-driven approach. Together, these results motivate future seasonal-aware spatio-temporal architectures that combine graph-based spatial modeling with explicit periodic structure.},
  publisher = {IEEE},
  isbn = {979-8-3195-4806-1},
  keywords = {handover forecasting;cellular networks;mobility prediction;spatio-temporal forecasting;graph neural networks},
}

