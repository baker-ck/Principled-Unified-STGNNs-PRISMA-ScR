@article{spatialtemporaltrafficpredicti2025,
  author = {Y. Ju; X. Huang; Z. Guo; Z. Li; L. Liu; Y. Gong; M. A. Jan},
  title = {{Spatial-Temporal} {Traffic} {Prediction} in {LEO} {Satellite} {Networks} via {Hybrid} {GCN-Transformer}},
  journal = {2025 7th International Conference on Internet of Things, Automation and Artificial Intelligence (IoTAAI)},
  year = {2025},
  pages = {825--830},
  doi = {10.1109/IoTAAI66837.2025.11213151},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11213151},
  abstract = {Low Earth Orbit (LEO) satellite networks are emerging as a critical component in future 6G networks, where accurate traffic prediction is essential for proactive scheduling, resource optimization and load balancing. However, such characteristics of satellite networks as dynamically changing topology, non-Euclidean structure, and significant spatial-temporal correlation pose severe challenges to traffic prediction. This paper proposes a GCN-Transformer scheme that integrates Graph Convolutional Network (GCN) with Transformer Encoding architecture. The GCN component captures local and global spatial dependencies, while the Transformer models long-range temporal dynamics via self-attention. This joint design is capable of processing highly coupled spatial-temporal data and maintaining stable performance under highly dynamic network topologies. Experiments on short-term and long-term prediction tasks (15-60 minutes) show that this scheme consistently outperforms other benchmark schemes in all metrics. The results demonstrate that GCN-Transformer achieves robust spatial-temporal modeling and stable prediction, offering substantial value for adaptive scheduling and resource optimization in satellite networks.},
  publisher = {IEEE},
  isbn = {979-8-3315-9417-6},
  keywords = {LEO satellite network;traffic prediction;Graph Convolutional Network;Transformer;Attention mechanisms},
}

@article{riskpredictionoftrafficacciden2025,
  author = {R. Liu; T. Guo; Y. Chen},
  title = {{Risk} {Prediction} of {Traffic} {Accidents} {Based} on {Temporal} {Knowledge} {Graphs} and {Enhanced} {Multi-Graph} {Attention} {Networks}},
  journal = {2025 4th Conference on Fully Actuated System Theory and Applications (FASTA)},
  year = {2025},
  pages = {1614--1621},
  doi = {10.1109/FASTA65681.2025.11138552},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11138552},
  abstract = {The occurrence of traffic accidents is characterized by significant spatiotemporal dependencies and multi-factor coupling. Accurately modeling the dynamic evolution of accident risk has become a critical issue in smart transportation and urban safety management. Although existing methods have made progress in temporal modeling or graph-based modeling, they generally suffer from limitations in modeling multi-source heterogeneous information, insufficient dynamic temporal modeling, and limited semantic structure representation. To address these challenges, this paper proposes a traffic accident risk prediction framework based on temporal knowledge graphs, integrating improved graph embeddings and attention mechanisms to enhance the spatiotemporal modeling capability of the model. First, a temporal traffic knowledge graph is constructed, integrating information about accidents, roads, weather, and environmental factors. Based on this, the TFME-DistMult model is designed, which introduces a time-modified embedding mechanism to effectively capture the evolution paths and temporal dependencies of accident-related entities. Next, an Enhanced Multi-Graph Attention Network (EMG-GAT) is proposed to achieve relationshipaware multi-semantic information extraction and cross-graph fusion modeling, improving both spatial structure modeling and semantic representation capability. Furthermore, a Transformer encoder is incorporated to capture long- and short-term temporal dependencies, enabling precise segment-level accident risk prediction. Experimental evaluation is conducted using a segmentlevel accident risk dataset built from real-world data. The results demonstrate that the proposed model outperforms mainstream benchmark methods across multiple metrics, achieving superior prediction accuracy and generalization ability.},
  publisher = {IEEE},
  isbn = {979-8-3315-2692-4},
  keywords = {Traffic Accident Prediction;Temporal Knowledge Graphs;Graph Neural Networks;Spatiotemporal Modeling},
}

@article{multisourceurbantrafficflowfor2025,
  author = {W. Xiong; R. Fonod; A. Alahi; N. Geroliminis},
  title = {{Multi-Source} {Urban} {Traffic} {Flow} {Forecasting} {With} {Drone} and {Loop} {Detector} {Data}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2025},
  volume = {26},
  number = {11},
  pages = {18637--18652},
  doi = {10.1109/TITS.2025.3605014},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11174070},
  abstract = {Traffic forecasting is a fundamental task in transportation research, however, the scope of current research has mainly focused on a single data modality of loop detectors. Recently, the advances in Artificial Intelligence and drone technologies have enabled novel solutions to efficient, accurate, and flexible aerial observations of urban traffic. As a promising traffic monitoring approach, drones can create an accurate multi-sensor mobility observatory for large-scale urban networks, when combined with existing infrastructure. Therefore, this paper investigates urban traffic prediction from a novel perspective, where multiple input sources, i.e., loop detectors and drones, are utilized to predict both the segment-level traffic of all road segments and the regional traffic. A simple yet effective graph-based model, Hierarchical Multi-Source Neural Network (HiMSNet), is proposed to integrate multiple data modalities and learn spatio-temporal correlations. Detailed analysis shows that predicting accurate segment-level speed is more challenging than the regional speed, especially under high-demand scenarios with heavier congestion and varying traffic dynamics. Utilizing both drone and loop detector data, the prediction accuracy can be improved compared to single-modality cases, when the sensors have lower coverage and are subject to noise. Our simulation study based on vehicle trajectories in a real urban road network has highlighted the value of integrating drones in traffic forecasting and monitoring.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Urban traffic analysis;deep learning;multi-modal data;drones;graph neural network},
}

@article{multibranchattentivetransforme2025,
  author = {X. Chen; Y. Liang; J. Wang; Q. Ye; Y. Cai},
  title = {{Multibranch} {Attentive} {Transformer} {With} {Joint} {Temporal} and {Social} {Correlations} for {Traffic} {Agents} {Trajectory} {Prediction}},
  journal = {IEEE Transactions on Computational Social Systems},
  year = {2025},
  volume = {12},
  number = {2},
  pages = {525--538},
  doi = {10.1109/TCSS.2024.3517656},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10814979},
  abstract = {Accurately predicting the future trajectories of traffic agents is paramount for autonomous unmanned systems, such as self-driving cars and mobile robotics. Extracting abundant temporal and social features from trajectory data and integrating the resulting features effectively pose great challenges for predictive models. To address these issues, this article proposes a novel multibranch attentive transformer (MBAT) trajectory prediction network for traffic agents. Specifically, to explore and reveal diverse correlations of agents, we propose a decoupled temporal and spatial feature learning module with multibranch to extract temporal, spatial, as well as spatiotemporal features. Such design ensures each branch can be specifically tailored for different types of correlations, thus enhancing the flexibility and representation ability of features. Besides, we put forward an attentive transformer architecture that simultaneously models the complex correlations possibly occurring in historical and future timesteps. Moreover, the temporal, spatial, and spatiotemporal features can be effectively integrated based on different types of attention mechanisms. Empirical results demonstrate that our model achieves outstanding performance on public ETH, UCY, SDD, and INTERACTION datasets. Detailed ablation studies are conducted to verify the effectiveness of the model components.},
  publisher = {IEEE},
  issn = {2329-924X},
  keywords = {Attention mechanism;multibranch network;trajectory prediction;transformer},
}

@article{cashflowpredictionmodelusinggr2025,
