  abstract = {The battery swap market has experienced rapid expansion in recent years. The deployment of battery swap stations (BSSs) is a fundamental issue that needs to be addressed during expansion in new cities. Intuitively, deploying BSSs according to user demand distribution is sensible. However, the absence of historical data makes it challenging to predict the demand in new cities before actual deployment, resulting in a âChicken-Eggâ dilemma. To address this dilemma, we propose STKDec, a spatio-temporal knowledge-guided conditional diffusion model for cross-city battery swap demand prediction. STKDec leverages historical data from source cities with deployed BSSs to predict user demands for target cities planning BSS deployment. The core of STKDec is a novel station-level context representation-based condition module. The key idea of this module is to extract shared spatiotemporal context representations of all stations and use these representations to bridge the source and target cities for demand prediction. Specifically, we derive the spatial context representation of stations through an urban knowledge graph construction and a designed multi-relation-aware graph convolutional network while extracting the temporal context representation using a temporal information encoding strategy. Extensive experiments on real-world battery swap datasets demonstrate that STKDec averagely outperforms state-of-the-art methods by 30.7 %.},
  publisher = {IEEE},
  isbn = {979-8-3315-4305-1},
  issn = {2641-9874},
}

@article{srstmsimulationrealityspatialt2025,
  author = {W. Lin; X. Miao; J. Chen; P. Duan; M. Ye; Y. Xu; X. Liu; H. Jiang},
  title = {{SR-STM:} {SimulationâReality} {SpatialâTemporal} {Model} for {Early} {Warning} of {Power} {Tilt} in {Nuclear} {Power} {Plants}},
  journal = {IEEE Internet of Things Journal},
  year = {2025},
  volume = {12},
  number = {11},
  pages = {17854--17868},
  doi = {10.1109/JIOT.2025.3539864},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10877902},
  abstract = {Balanced in-core power levels in nuclear power plants (NPPs) are critical for safety, whereas power tilt disrupts this balance, reducing safety margins and posing risks. Early warning for power tilt offers an effective way of optimizing monitoring. Due to abnormal-sample scarcity and security concerns, common data-driven models train on the simulated data generated by simulators. However, achieving a satisfactory effect in practices is difficult because simulators imperfectly emulate reality. Thus, we propose a power tilt-oriented early warning method called simulationâreality spatialâtemporal model (SR-STM). Motivated by the physical model in NPPs, a knowledge-guided hierarchical graph is designed to characterize spatial correlations among local power levels for SR-STMâs input. The SR-STM uses a lightweight spatialâtemporal network (LST-Net) as a feature extractor, balancing precision, and efficiency. To bridge sim-real interdomain discrepancies, SR-STM utilizes node-alignment adversarial learning (NAAL) for fine weight tuning in subdomain, and eigenvalue-based scale alignment (ESA) for sim-real feature proximity. Forecasting local power levels using the SR-STM, dynamic metrics and alarm limits are calculated and compared to perform the early warning task. The online experimental prototype verifies that SR-STM surpasses various state-of-the-art methods in terms of early warning and sim-real cross-domain tasks.},
  publisher = {IEEE},
  issn = {2327-4662},
  keywords = {Domain adaptation;early warning;nuclear power plant;power tilt;simulationâreality;spatialâtemporal network},
}

@article{mitigatingcongestioniniotdrive2025,
  author = {L. Kumar; M. Sharma; A. Singh},
  title = {{Mitigating} {Congestion} in {IoT-Driven} {SDN} {Environments:} {An} {Intelligent} {Traffic-Aware} {Flow} {Optimization} {Approach}},
  journal = {2025 IEEE 6th India Council International Subsections Conference (INDISCON)},
  year = {2025},
  pages = {1--6},
  doi = {10.1109/INDISCON66021.2025.11253719},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11253719},
  abstract = {The fast growth of IoT devices in SDN systems creates dynamic and bursty traffic patterns, causing congestion. Static routing protocols, heuristic-based load balancing, and standalone machine learning models (e.g., LSTM or GNN) cannot capture spatial network dependencies and temporal traffic dynamics, making them unable to adapt to real-time traffic fluctuations. LSTM models forecast sequential traffic but lack topological awareness, while GNNs grasp network topology but cannot model time-varying traffic behaviour. We present a Hybrid GNN+LSTM model that synergistically incorporates graph neural networks (GNNs) to overcome these limitations, LSTM networks were used for traffic prediction in time and spatial feature extraction. An attention method dynamically network conditions and traffic need to optimise path selection for Low, High, and Critical traffic classes in our model. Experimental data show that the hybrid technique outperforms standalone LSTM ($95 \%$ accuracy, 88.7 Mbps), GNN ($92 \%$ accuracy, 91.2 Mbps), and ViT ($90 \%$ accuracy, 86.9 Mbps) models with $97 \%$ accuracy, 95.4 Mbps throughput, and $1.82 \%$ packet. This reduces flow setup latency to 18.6 ms and ensures $97.1 \% \mathrm\{QoS\}$ adherence, making it effective for real-time congestion mitigation. The results show that spatial and temporal learning in SDN-based IoT networks provides a scalable and intelligent solution for traffic-aware flow optimisation.},
  publisher = {IEEE},
  isbn = {979-8-3315-1504-1},
  keywords = {SDN;IoT;Congestion Control;GNN;LSTM;Hybrid Model;Traffic Optimization},
}

@article{adropoutregularizedlstmframewo2025,
  author = {K. Munasinghe; N. Dharmaweera; U. Wijewardhana; C. D. Alwis; R. Parthiban},
  title = {{A} {Dropout-Regularized} {LSTM} {Framework} for {High-Accuracy} {Traffic} {Prediction} in {Elastic} {Optical} {Networks}},
  journal = {2025 9th SLAAI International Conference on Artificial Intelligence (SLAAI-ICAI)},
  year = {2025},
  pages = {1--6},
  doi = {10.1109/SLAAI-ICAI68534.2025.11318460},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11318460},
  abstract = {Accurately predicting traffic in elastic optical networks (EONs) is essential to run them efficiently by allocating spectrum and power before congestion happens, improving spectral efficiency, lowering blocking, and cutting energy waste. Existing deep learning models such as Convolutional Long ShortTerm Memory (ConvLSTM) and attention-based LSTMs show strong potential. However, they often face a trade-off: low absolute error can come at the cost of a weaker fit to real traffic peaks, especially when the data is noisy. This paper presents a stacked (double-layer) LSTM model with dropout regularization to minimize overfitting while keeping peak-detection sharp. Trained on a 6-node EON dataset that mimics real diurnal patterns and bursts, our approach delivers up to $\mathbf\{1 8. 7 5 \%\}$ lower Mean Squared Error (MSE), 16.22% lower Mean Absolute Error (MAE), and a $1.29 \%$ increase in $R^\{2\}$ compared to the strongest baseline, Prophet-guided Convolutional LSTM (P-ConvLSTM). To our knowledge, this is the first application of dropout-regularized LSTMs to EON traffic matrices. The results show that simple, well-regularized architectures can outperform heavier spatio-temporal models, making them a practical choice for real-time, impairment-aware Routing Modulation and Spectrum Allocation (RMSA) in live networks.},
  publisher = {IEEE},
  isbn = {979-8-3315-6123-9},
  keywords = {Elastic Optical Networks;Traffic Prediction;LSTM;Dropout Regularization;Machine Learning;RMSA},
}

@article{privacypreservingsparsetraffic2025,
  author = {J. Wei; T. Zhou; C. Li; X. Yao; L. Liu; Y. Wen},
  title = {{Privacy-Preserving} {Sparse} {Traffic} {Flow} {Prediction} in {IIoT:} {A} {Three-Tier} {Federated} {Learning} {Framework}},
  journal = {IEEE Internet of Things Journal},
  year = {2025},
  volume = {12},
  number = {19},
  pages = {39346--39361},
  doi = {10.1109/JIOT.2025.3592772},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11096613},
  abstract = {Traffic flow prediction, as a typical application of Industrial Internet of Things (IIoT) in urban infrastructure, faces critical security challenges. Existing privacy-preserving methods in two-tier federated learning (FL) frameworks primarily focus on dense data while neglecting privacy vulnerabilities in massive sparse traffic flow collected by clients, failing to effectively protect both high-sparsity traffic flow and federated pretrained models against privacy leakage risks. Therefore, this article proposes a novel three-tier FL framework-based privacy-preserving sparse traffic flow prediction (TFLST) scheme, achieving dual protection of sparse traffic flow and model parameters with high-precision prediction. Specifically, we innovatively design a spatiotemporal self-attention transformer-based Gestalt sparse key cell selection (STGSC) method to efficiently extract sparse key cells with high spatiotemporal correlations. Additionally, an adaptive truncated Gaussian mechanism-based local sparse traffic flow protection (ATLSP) algorithm is proposed, which dynamically allocates privacy budgets according to sparse correlations to achieve high-utility sparse data protection. A dynamic spatiotemporal matrix completion-based GCN pretraining protection (DSMGP) method is adopted to enhance the spatiotemporal features of sparse data efficiently, protect model parameter privacy, and improve FL training accuracy. Subsequently, we introduce a spatiotemporal self-supervised learning-based multiobjective weighted traffic flow prediction (SMWTP) method to achieve high-accuracy traffic flow prediction. Rigorous security analysis proves that our scheme satisfies differential privacy requirements. Experimental results on four real-world datasets show that our TFLST scheme reduces prediction errors by 6.21% compared to state-of-the-art methods, effectively balancing data privacy and utility.},
  publisher = {IEEE},
  issn = {2327-4662},
  keywords = {federated learning (FL) framework;federated pretraining;differential privacy (DP);sparse traffic flow prediction},
}

@article{trafficpredictionmodelofcourse2025,
