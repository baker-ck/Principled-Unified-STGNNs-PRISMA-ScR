  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11507320},
  abstract = {Growing wind energy penetration has increased uncertainty in power system operations, yet existing forecasting methods struggle to fuse heterogeneous atmospheric, remote-sensing, and grid-level data while producing calibrated, spatially coherent probabilistic predictions. This gap limits the accuracy and reliability required for real-time grid stability, reserve scheduling, and market operations. The objective of this paper was to Improving calibration, sharpness and spatial coherence over several horizons of an advanced multimodal, physics-informed probabilistic wind-power forecasting system from Accessible resources were used in experimental research. The suggested AegisFlow-HPF model learns expressive multisite predictive distributions by integrating spatio-temporal graph neural networks, conditional normalizing flows and physics-informed feature extraction. Using CRPS, Energy Score, Pinball loss, and Winkler metrics were used to compare the model's performance to baseline ST-GNN and hybrid CNN-LSTM+MDN models complemented by reliability diagrams, shareness histograms, ablation studies and compute-accuracy pareto analysis. AegisFlow-HPF did better than all the benchmarks, lowering CRPS by up to 15%, raising the Energy Score by 24%, and getting much better calibration across quantiles. These findings demonstrate that combining physics knowledge, heterogeneous data fusion and flow based probabilistic modelling greatly improves wind-power forecasting in real-world implications for grid dependability and integrating renewable energy sources.},
  publisher = {IEEE},
  isbn = {979-8-3315-9126-7},
  keywords = {Probabilistic Wind Forecasting;Spatial-Temporal Learning;Renewable Energy Integration;Grid Variability Management},
}

@article{researchonautopilottrajectorys2025,
  author = {B. Long; T. Lin; X. Lin},
