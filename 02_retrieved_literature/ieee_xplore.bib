  abstract = {Accurate pedestrian trajectory prediction is a crucial task for ensuring the safety of autonomous driving. However, most of the existing methods only model pedestrian trajectories in the spatial-temporal domain, which results in a lack of analysis of motion at different scales. In this work, we propose a framework based on wavelet transform and diffusion model, which is called DiffWT. Different from previous approaches, our method employs a discrete wavelet transform (DWT) to perform time-frequency analysis of trajectories. The high-frequency component of the DWT indicates local motion details of the trajectory, while the low-frequency one represents overall motion trends. Second, we propose a trajectory decoder comprising a conditional diffusion model and a cross-constrained bidirectional trajectory generator (C2Bid). The diffusion model generates the distribution of implicit pedestrian behaviors by taking the multiscale motion behaviors as conditions. Furthermore, the C2Bid module is designed as a cross-constrained bidirectional structure to decode behavioral distribution into multimodal trajectories. This trajectory decoder can generate precise distribution of trajectories and reduce accumulation of prediction errors. Extensive experimental results on the ETH/UCY and the Stanford drone datasets (SDDs) demonstrate that our method achieves better performance as well as higher efficiency compared to other state-of-the-art approaches.},
  publisher = {IEEE},
  issn = {2327-4662},
  keywords = {Diffusion model;discrete wavelet transform (DWT);pedestrian trajectory prediction;time-frequency analysis},
}

@article{remainingusefullifepredictiono2025,
  author = {J. Liu; C. Nie; R. Wang; H. Hou; J. Xie},
  title = {{Remaining} {Useful} {Life} {Prediction} of {Bearings} {Based} on {Graph} {Isomorphism} {Network} {With} {Graph-in-Graph} {Framework}},
  journal = {IEEE Transactions on Instrumentation and Measurement},
  year = {2025},
  volume = {74},
  pages = {1--11},
  doi = {10.1109/TIM.2025.3644536},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11301797},
  abstract = {Graph neural networks (GNNs) have drawn much attention for predicting the remaining useful life (RUL) due to their excellent performance in processing correlation relationships among data. Spatiotemporal evolution information and spatial correlation are key factors in the bearing degradation process. Multigraph structures can comprehensively leverage the spatial correlation and temporal evolution characteristics inherent in different graph topologies to extract multiscale spatiotemporal information. In this article, a new graph isomorphism network (GIN)-graph-in-graph (GIG) based on a graph framework in graph is proposed to predict bearing RUL. First, the feature spatial graph is constructed according to the correlation coefficients between the optimal features. Its output is used as the node feature of the new temporal path graph. The GIG framework is constructed by embedding and fusing the feature spatial graphs and the temporal path graphs. Then, the GIN is established to capture the spatial information in the first-hierarchy spatial graph and the local temporal information in the second-hierarchy temporal path graph. Meanwhile, the self-attention mechanism is introduced to achieve adaptive hierarchical fusion of GIN output, so as to enrich the feature information. Finally, the temporal convolutional network (TCN) is established to further extract the global temporal information for performing the RUL prediction. The effectiveness and superiority of the GIN-GIG method are validated using the PHM2012 and IMS bearing datasets, and some comparative experiments have been performed to show its advantage for the RUL prediction.},
  publisher = {IEEE},
  issn = {1557-9662},
  keywords = {Graph isomorphism network (GIN);graph-in-graph (GIG) framework;remaining useful life;temporal convolutional network},
}

@article{metacontrastgnnmetacontrastive2025,
  author = {D. T. Thai; Q. T. Minh},
  title = {{MetaContrast-GNN:} {Meta-Contrastive} {Learning} for {Cross-City} {Travel} {Time} {Estimation}},
  journal = {2025 24th International Symposium on Communications and Information Technologies (ISCIT)},
  year = {2025},
  pages = {1--6},
  doi = {10.1109/ISCIT67082.2025.11231739},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11231739},
  abstract = {Accurate Travel Time Estimation (TTE) is essential in Intelligent Transportation Systems (ITS), supporting tasks such as vehicle dispatching, routing, and traffic management. However, existing models often generalize poorly across cities due to diverse urban dynamics. We propose MetaContrast-GNN, a framework that combines Graph Neural Networks (GNNs), contrastive learning, and Model-Agnostic Meta-Learning (MAML) for robust cross-city TTE under limited data. Evaluated on taxi datasets from New York, Chicago, Washington D.C., and Ho Chi Minh City, our model outperforms baselines. A GNN trained only on Ho Chi Minh City yields a Mean Absolute Error (MAE) of 204.27 seconds (around 3.4 minutes) and Root Mean Squared Error (RMSE) of 209.62 seconds (around 3.5 minutes), while MetaContrast-GNN reduces error to 3.01 and 3.32 minutes, respectively. These results highlight the benefits of meta-learning and contrastive pretraining for scalable, transferable TTE. Though not solving the full vehicle dispatching problem, our method offers a generalizable TTE module to support broader ITS applications.},
  publisher = {IEEE},
  isbn = {979-8-3315-9444-2},
  issn = {2643-6175},
  keywords = {Graph Neural Networks;Meta-Learning;Contrastive Learning;Spatio-Temporal Prediction;Vehicle Dispatching},
}

@article{arealtimeroutepredictionbasedm2025,
  author = {Y. Li; Y. Wang; P. Wang; W. Wang; X. Tong},
  title = {{A} {Real-Time} {Route} {Prediction-Based} {MultiobjectiveÂ} {Task} {Allocation} for {Opportunistic} {MobileÂ} {Crowdsensing}},
  journal = {IEEE Transactions on Computational Social Systems},
  year = {2025},
  volume = {12},
  number = {5},
