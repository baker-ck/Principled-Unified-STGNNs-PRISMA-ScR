  abstract = {Accurate prediction of PM2.5 concentrations is crucial for air quality management and public health protection. Traditional forecasting methods often treat monitoring stations independently, neglecting spatial dependencies from inter-city pollution transport. We propose a novel Spatiotemporal Graph Convolutional Network (ST-GCN) that explicitly models both temporal evolution and spatial propagation of air pollutants across multiple stations. Our approach integrates a hybrid graph construction strategy combining geographic proximity, temporal correlation, and adaptive learning to capture diverse spatial relationships. The ST-GCN architecture employs stacked spatiotemporal blocks with alternating temporal and spatial convolutions to extract hierarchical spatiotemporal features. We evaluate our model on the Air Quality Data in India dataset covering 22 cities from 2015 to 2020. Experimental results demonstrate that ST-GCN significantly outperforms six baseline methods including LSTM, GRU, and TCN, achieving RMSE of $12.34 \mu \mathrm\{~g\} / \mathrm\{m\}^\{3\}$ and MAE of $9.12 \mu \mathrm\{~g\} / \mathrm\{m\}^\{3\}$ for 6 -hour predictions, representing 23.7% and 21.3% improvements over the best baseline. Ablation studies confirm that spatial modeling contributes over 35% performance gain. Our work demonstrates the potential of graph neural networks for multi-station air quality forecasting.},
  publisher = {IEEE},
  isbn = {979-8-3315-6028-7},
  keywords = {PM2.5 prediction;spatiotemporal graph convolutional network;graph neural networks;air quality forecasting;deep learning;multi-station prediction},
}

@article{leveragingspatialtemporalheter2025,
