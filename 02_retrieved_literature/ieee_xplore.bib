  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10423631},
  abstract = {With the rapid growth of urban vehicles, it is necessary to use advanced traffic control technologies for traffic flow control and traffic diversion, and allocate road resources reasonably to ensure smooth urban traffic and maximize the transportation efficiency of the transportation network. Considering the spatial characteristics of urban road networks and the temporal information of traffic speeds, this article proposes a spatiotemporal dynamic deep network called GCN-LSTM, which is based on Graph Convolutional Network (GCN) and Long Short Term Memory (LSTM) neural network. The network utilizes a unique network structure to address the spatiotemporal dynamics, periodicity, and uncertainty of traffic flow. The proposed algorithm utilizes GCN to process the spatial correlation characteristics of traffic flow, and captures the temporal dynamic characteristics of traffic flow using LSTM and attention mechanism. Attention vectors are used as competitive selection to establish the correlation between the state of the next prediction step and the historical state. When predicting traffic fluctuations, this article considers the spatiotemporal correlation in the road network and extracts spatiotemporal correlation features from the fluctuations. Finally, the proposed algorithm uses LSTM to fit historical features and future traffic flow fluctuation momentum. Simulation experiments have demonstrated the effectiveness and superiority of the proposed model.},
  publisher = {IEEE},
  issn = {1939-9359},
  keywords = {Graph convolution network (GCN);long short-term memory neural network (LSTM);road network carrying capacity;spatiotemporal characteristics;traffic flow},
}

@article{deeplearningbasedpredictionofu2025,
