@article{designofanintelligenttrafficfl2025,
  author = {P. -Y. Chen; H. -Y. Zheng; Y. -Y. Huang; W. -C. Chung},
  title = {{Design} of an {Intelligent} {Traffic} {Flow} {Prediction} and {Control} {System} {Based} on {Federated} {Learning}},
  journal = {2025 IEEE International Conference on Consumer Electronics - Taiwan (ICCE-Taiwan)},
  year = {2025},
  pages = {731--732},
  doi = {10.1109/ICCE-Taiwan66881.2025.11207916},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11207916},
  abstract = {As Taiwan becomes urbanized, traffic congestion has worsened, affecting daily commutes. Traditional traffic management systems struggle to adapt to the growing complexity of traffic flows and conditions. To address traffic issues, this paper proposes a distributed traffic flow prediction method based on Federated Learning (FL) among edge clients. The proposed framework integrates the Attention-Based Spatial-Temporal Graph Convolutional Network (ASTGCN) to predict traffic patterns in edge computing. By designing an FL aggregation strategy, the proposed method reduces communication overhead while maintaining accuracy compared to centralized training. The effectiveness of the intelligent traffic control system is also validated using Simulation of Urban Mobility (SUMO).},
  publisher = {IEEE},
  isbn = {979-8-3315-8741-3},
  issn = {2575-8284},
  keywords = {Intelligent Transportation System;Attention-Based Spatial-Temporal Graph Convolutional Network;Federated Learning;Edge Computing},
}

@article{dynamicgraphneuralnetworkmodel2026,
  author = {D. Rajapriya; M. Odeh; I. P. Jayasimman; S. S R; B. Prashanthi; R. M},
  title = {{Dynamic} {Graph} {Neural} {Network} {Model} for {Predictive} {Traffic} {Control} in {Smart} {Urban} {Mobility} {Systems}},
  journal = {2026 International Conference on Connected Intelligence for Industrial Applications (CI2A)},
  year = {2026},
  pages = {1--7},
  doi = {10.1109/CI2A69097.2026.11576860},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11576860},
  abstract = {The networks in urban mobility have been more dynamic, such that the old systems of traffic control, which are not dynamic, cannot be capable of providing congestion mitigation in real time. To overcome this challenge, it introduces a model of Dynamic Graph Neural Network (DGNN) that aims at capturing dynamic road interactions and giving multihorizon traffic predictions that can be used to achieve predictive signal control. The technique builds a dynamic mobility graph, trains the spatiotemporal interactions by updating the nodes and edges of the graph, consequently, and consequently combines the predictions in a compact control engine to optimize real-time signals. The benefits of the experiment are high: the accuracy of the forecast increases as MAPE decreases to 4.8 %, RMSE to 2.14, and node-state reconstruction accuracy is obtained at 98.4 %. The control module minimizes average intersection delay to $\mathbf\{1 8. 7\}$ seconds, minimal spillback probability of the queue to 4.6 %, and improves green-time efficiency by 89.2 % and the control latency to 15 ms. These findings verify that predictive control guided by DGNN has a significant positive effect on throughput, stability, and efficiency of traffic in intelligent urban mobility.},
  publisher = {IEEE},
  isbn = {979-8-3315-8457-3},
  keywords = {Dynamic Graph Neural Network;Spatiotemporal Graph Neural Network;Performance Measurement System;Department of Transportation},
}

@article{overviewoftrafficflowforecasti2025,
  author = {A. Carianni; A. Gemma},
  title = {{Overview} of {Traffic} {Flow} {Forecasting} {Techniques}},
  journal = {IEEE Open Journal of Intelligent Transportation Systems},
  year = {2025},
  volume = {6},
  pages = {848--882},
  doi = {10.1109/OJITS.2025.3580802},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11042911},
  abstract = {Forecasting traffic conditions is critical for modern mobility management. With urbanization and motorization rates rising globally, accurate traffic flow prediction plays a vital role in mitigating congestion, optimizing traffic strategies, and reducing environmental impacts. This paper provides a comprehensive review of traffic forecasting methods, bridging traditional techniques and innovative approaches driven by computational intelligence and abundant data. The study classifies forecasting methods into four categories: naÃ¯ve techniques, parametric methods, simulation-based approaches, and nonparametric models such as machine learning and deep learning. Each category is analyzed for its historical development, theoretical foundations, and practical applications, with special emphasis on artificial intelligenceâs transformative role in enabling dynamic and accurate predictions. The review evaluates traditional models like ARIMA and Kalman filters, alongside nonparametric techniques such as neural networks, and explores hybrid approaches that integrate multiple forecasting methods. It also assesses the complementary role of traffic simulation, from macroscopic to microscopic scales, in capturing complex traffic dynamics. The methodology synthesizes insights from foundational works and recent influential studies, examining metrics for prediction accuracy and identifying contextual factors shaping method effectiveness. The paper highlights strengths, limitations, and opportunities for advancement across forecasting approaches. Concluding with a forward-looking perspective, the review underscores trends such as spatiotemporal modeling and real-time data integration, which promise smarter, more adaptive traffic management solutions. This survey serves as a valuable resource for researchers, policymakers, and practitioners in navigating the evolving field of traffic flow forecasting.},
  publisher = {IEEE},
  issn = {2687-7813},
  keywords = {Categorization;intelligent transportation systems;survey;traffic flow forecasting},
}

@article{gravqraselfrefininggnnllmframe2026,
  author = {S. Ding; K. Hu; T. Pang; L. Peng; Y. Cui; Y. Yang},
  title = {{GraVQR:} {A} {Self-Refining} {GNN-LLM} {Framework} for {Spatio-Temporal} {Traffic} {Prediction}},
  journal = {ICC 2026 - IEEE International Conference on Communications},
  year = {2026},
  pages = {1--6},
  doi = {10.1109/ICC59461.2026.11586894},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11586894},
  abstract = {Accurate spatio-temporal traffic prediction is crucial for dynamic resource allocation in Mobile Edge Computing (MEC), guiding computational and service resources towards user-side deployment on demand. However, the scarcity of large-scale traffic data in MEC scenarios, such as optimizing server placement has resulted in poor model prediction performance. Inspired by recent advances in generative artificial intelligence, we propose GraVQR, a self-refining GNN-LLM framework that effectively harnesses the contextual learning capabilities of large language models (LLMs) and enables robust predictive performance even with limited training data. GraVQR comprises three steps First, we employ a Spatio-Temporal Graph Convolutional Network (STGCN) to embed the input spatio-temporal traffic data. Second, we utilize a Vector Quantized Variational Autoencoder (VQ-VAE) to transform the processed high-dimensional embeddings into discrete token sequences. Third, we feed these tokens into a designed LLM to generate preliminary predictions. Specifically, our approach does not require additional fine-tuning or parameter updates of the LLM. Furthermore, we design a self-refinement mechanism enabling the LLM to analyze and correct its own predictions, yielding the final output. Experimental results demonstrate that our proposed method outperforms existing approaches in data-scarce scenario.},
  publisher = {IEEE},
  isbn = {979-8-3195-4209-0},
  issn = {1938-1883},
  keywords = {Spatio-Temporal traffic prediction;large language models;in context learning;prompt engineering},
}

@article{generativeadversarialnetworkba2025,
  author = {D. Zhang; P. Wang; L. Ding},
  title = {{Generative} {Adversarial} {Network-Based} {Adaptive} {Spatio-Temporal} {Traffic} {Flow} {Prediction} with {Large} {Language} {Models}},
  journal = {2025 IEEE 28th International Conference on Intelligent Transportation Systems (ITSC)},
  year = {2025},
  pages = {1145--1152},
  doi = {10.1109/ITSC60802.2025.11423560},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11423560},
  abstract = {Accurate traffic flow prediction is a critical component of intelligent transportation systems. While previous studies have made significant breakthroughs in modeling spatio-temporal correlations, existing methods still suffer from two significant limitations: (i) underdetermined traffic flows caused by sparse sensor deployment, where incomplete path observations make it difficult to capture non-local spatial dependencies. (ii) nonequilibrium traffic flows arising from congestion propagation and varying driver reaction times, which induce asynchronous temporal correlations and nonlinear dependencies. To address these challenges, we propose a novel Generative Adversarial Network and Large Language Model-based Adaptive SpatioTemporal framework (GLAST). Specifically, It employs an adaptive edge weight augmentation mechanism based on GAN with residuals to capture deviations in periodic patterns and construct dynamic adjacency matrices, which enables the capture of nonlocal spatial dependencies under sparse sensing conditions. The weighted attention mechanism is applied to aggregate lagged adjacency matrices to model asynchronous temporal correlations, effectively capturing temporal delays and nonlinear dependencies. Furthermore, adaptive temporal descriptors and congestion metrics are encoded as prompts for the LLM to enhance the modeling of multi-scale spatio-temporal relationships. Experimental results on benchmark datasets demonstrate that GLAST consistently outperforms various state-of-the-art baselines. Given the widespread presence of sparse sensing and congestion propagation in real-world highways, the proposed framework also holds the potential to inspire other urban traffic applications.},
  publisher = {IEEE},
  isbn = {979-8-3315-2418-0},
  issn = {2153-0017},
}

@article{curstnetcurriculumlearningguid2026,
  author = {S. Chen; X. Chen; Y. Huang; Y. Su; G. Liu; Y. -G. Fu},
  title = {{CurST-Net:} {Curriculum} {Learning} {Guided} {SpatialâTemporal} {Network} for {Traffic} {Flow} {Prediction}},
  journal = {IEEE Transactions on Systems, Man, and Cybernetics: Systems},
  year = {2026},
  volume = {56},
  number = {6},
  pages = {3472--3486},
  doi = {10.1109/TSMC.2026.3661914},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11399924},
  abstract = {Traffic flow prediction is crucial to intelligent transportation systems (ITSs). However, the existing methods usually ignore the problem that the prediction difficulty of nodes in the traffic network is actually different. Besides, they fail to effectively handle the dilution of the original semantic information passed layer by layer when capturing the global dependency. To address these issues, this article proposes a curriculum learning guided spatialâtemporal network (CurST-Net). Inspired by the human learning process, CurST-Net introduces a curriculum learning (CL) module that defines four metrics from multiple views to evaluate node difficulty and uses a training scheduler (TNS) to gradually introduce easy-to-difficult training nodes to the model to improve prediction ability. Moreover, we design a global spatialâtemporal encoder that uses a multihead spatialâtemporal attention mechanism and performs interlayer residual scaling on the original semantic information to efficiently capture the global spatialâtemporal correlation of nodes. To the best of our knowledge, this is the first work that uses CL to solve the varying prediction difficulty of nodes in traffic flow prediction. The effectiveness of our model is validated through extensive experiments with 12 baseline models on three real-world traffic datasets. For the 1-h prediction horizon, the MAE values of our model on the three datasets are 15.19, 19.22, and 15.50, respectively. Our method yields an overall reduction of 6.51% in MAE across all three datasets compared to DSTAGNN, an advanced traffic flow prediction method. Additionally, the inference time on the PEMSD8 dataset is 5.44 s, requiring only 45% of the inference time of DSTAGNN, which demonstrates a significant improvement in inference speed.},
  publisher = {IEEE},
  issn = {2168-2232},
  keywords = {Curriculum learning (CL);prediction difficulty;residual scaling;spatialâtemporal correlation;traffic flow prediction},
}

@article{anadaptivespatiotemporalgrapha2026,
  author = {T. Y; V. R; S. K},
  title = {{An} {Adaptive} {Spatio-Temporal} {Graph-Attention} {Framework} for {Real-Time} {Urban} {Traffic} {Accident} {Risk} {Prediction} and {Proactive} {Mobility} {Management}},
  journal = {2026 International Conference on Visual Analytics and Data Visualization (ICVADV)},
  year = {2026},
  pages = {1634--1639},
  doi = {10.1109/ICVADV67766.2026.11470439},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11470439},
  abstract = {Prediction of traffic accidents is a vital element to intelligent transportation systems since the accidents occur due to non-linear, and multi-dimensional interactions among road geometry, environmental conditions, and movement of traffic. Traditional models have the drawback of lacking simultaneous spatial correlations of road networks and temporal patterns of fast traffic flows. The proposed paper presents STDL-Net, a single Spatio-Temporal Deep Learning Framework that combines Graph Convolutional Networks with LSTM and TCN that forecast the occurrence of accidents with accuracy and precision. The model of urban roads is represented by weighted space graphs complemented by multi-source multi-temporal inputs like traffic flow, weather indicators, visibility, and historical patterns of accidents. Predictive stability is further enhanced with two specialized components: the Hybrid Attention Fusion Layer to enhance spatial -temporal feature enhancement and the Adaptive Risk Encoding Module to dynamic risk profile. Experimental analyses demonstrate a better performance on accuracy and recall than baseline systems and generated risk heatmap is used to assist real-time alerts and high-intelligence route planning within smart city systems.},
  publisher = {IEEE},
  isbn = {979-8-3315-9237-0},
  keywords = {Prediction of accidents;Spatio-temporal modelling;graph convolutional networks;long short-term memory;time convolutional networks;attention mechanisms;smart transport systems},
}

@article{aspatiotemporalsplitlearningfr2025,
  author = {J. M. Ziazet; B. Jaumard},
  title = {{A} {Spatio-temporal} {Split} {Learning} {Framework} for {5G} and {B5G} {Traffic} {Prediction}},
  journal = {2025 25th Anniversary International Conference on Transparent Optical Networks (ICTON)},
  year = {2025},
  pages = {1--6},
  doi = {10.1109/ICTON67126.2025.11125406},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11125406},
  abstract = {Accurate traffic prediction is fundamental for enabling energy-aware 5G and Beyond 5G (B5G) cognitive networks. As traffic becomes increasingly heterogeneous and dynamic across geographically distributed sites, existing centralized or fully decentralized machine learning paradigms face significant challenges: centralized models suffer from scalability and privacy concerns, while fully distributed methods often fail to capture global patterns.We propose ST-SplitGNN, a Spatio-Temporal Split Learning Framework for traffic prediction that emphasizes site-level specialization. Each site independently learns the temporal dynamics of its local traffic profile using a dedicated encoder, ensuring that the model adapts to the unique behavior of each site. In addition, nodes transmit intermediate representations to a central server, which aggregates them through a graph neural network (GNN) that models inter-node dependencies.Numerical results show that the proposed approach provides a scalable, communication-efficient and adaptive solution for real-time traffic forecasting, enabling smarter resource allocation and energy-efficient network operations.},
  publisher = {IEEE},
  isbn = {979-8-3315-9777-1},
  issn = {2161-2064},
  keywords = {Spatio-temporal traffic prediction;split learning;graph neural network;dynamic resource allocation},
}

@article{researchontrafficflowpredictio2025,
  author = {Y. Wu; Z. Wang; Z. Ren; Y. Chen},
  title = {{Research} on {Traffic} {Flow} {Prediction} {Methods} {Based} on {EMD-BiLSTM}},
  journal = {2025 5th International Conference on Artificial Intelligence and Industrial Technology Applications (AIITA)},
  year = {2025},
  pages = {1803--1807},
  doi = {10.1109/AIITA65135.2025.11048010},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11048010},
  abstract = {Traffic flow prediction plays a crucial role in traffic management and urban planning. Accurate predictions can effectively alleviate traffic congestion and enhance the overall efficiency of the transportation system. In this paper, we propose a traffic flow prediction method based on EMD-BiLSTM. The method first uses Empirical Mode Decomposition (EMD) to process the raw traffic flow data, breaking it down into multiple Intrinsic Mode Functions (IMFs) and a residue. The advantage of EMD is its ability to precisely extract the inherent characteristics of the data, thereby effectively reducing the complexity of the subsequent prediction model. Subsequently, a Bi-Directional Long Short-Term Memory (BiLSTM) network is employed to predict each IMF and the residue. The unique structure of the BiLSTM network enables it to capture both the long-term trends and short-term fluctuations in the data, demonstrating a strong capability for modeling the spatiotemporal characteristics of traffic flow. The experimental results fully demonstrate that our proposed method has a significant advantage over other deep learning methods in terms of prediction accuracy and stability. Specifically, the Mean Absolute Error (MAE) and Root Mean Square Error (RMSE) of our method are significantly lower than those of other comparative methods. Furthermore, a case study using an actual traffic flow dataset further verifies the effectiveness and feasibility of the proposed method.},
  publisher = {IEEE},
  isbn = {979-8-3315-0976-7},
  keywords = {Traffic flow prediction;EMD-BiLSTM;Intrinsic Mode Functions;Machine learning;Prediction accuracy},
}

@article{trafficspeedseriespredictionba2025,
  author = {D. Zhang; W. Yang; Y. Xie; Z. Qu},
  title = {{Traffic} {Speed} {Series} {Prediction} {Based} on {Multi-View} {Spatial-Temporal} {Graph} {Convolutional} {Networks}},
  journal = {2025 IEEE International Conference on High Performance Computing and Communications (HPCC)},
  year = {2025},
  pages = {1302--1307},
  doi = {10.1109/HPCC67675.2025.00186},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11207397},
  abstract = {Accurate prediction of future traffic flow is crucial for route planning and congestion mitigation. However, most existing spatio-temporal models do not adequately capture the topological and semantic relationships in traffic networks. They also struggle to model how individual node flows influence broader traffic patterns. To tackle these challenges, we propose a Spatial-Temporal Dynamic Graph Convolutional Network with Multi-View Feature Fusion (STDGCNM) for traffic speed prediction. Our approach encodes spatio-temporal node embeddings from both spatial and temporal perspectives, employing convolutions with multi-head attention to model global dependencies. The model integrates static spatial graphs with dynamic spatio-temporal graphs via dynamic graph convolution, and employs a global correlation graph to capture long-range dependencies. We validate the effectiveness of STDGCNM on two benchmark traffic datasets. On the Los-loop dataset, STDGCNM reduces the average MAE and RMSE by 0.68 and 1.31, respectively, while increasing the average ACC and $R^\{2\}$ by 0.02 and 0.07 compared to existing models. On the SZtaxi dataset, STDGCNM consistently outperforms all state-of-the-art methods across all evaluation metrics. These results demonstrate that, by jointly modeling static and dynamic connections and capturing both local and global correlations, STDGCNM substantially improves prediction accuracy and robustness.},
  publisher = {IEEE},
  isbn = {979-8-3315-6874-0},
  keywords = {traffic speed prediction;spatial-temporal correlation;multi-head attention mechanism;graph convolutional network;time series},
}

@article{aspatiotemporalneuralnetworkfo2025,
  author = {K. Katta},
  title = {{A} {Spatiotemporal} {Neural} {Network} for {Short-Term} {Traffic} {Flow} {Prediction}},
  journal = {2025 IEEE International Conference on Future Machine Learning and Data Science (FMLDS)},
  year = {2025},
  pages = {304--309},
  doi = {10.1109/FMLDS67896.2025.00058},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11446714},
  abstract = {Accurate short-term traffic flow prediction is crucial for the efficient functioning of Intelligent Transportation Systems (ITS). This study proposes a novel neural network architecture combining Independent Recurrent Neural Networks (IndRNN) and Graph Convolutional Networks (GCN) to have temporal and spatial dependencies in traffic data. Utilizing an encoder-decoder framework with scheduled sampling, the model effectively mitigates noise accumulation and achieves superior prediction accuracy compared to traditional methods. Experiments on real-world traffic data from Los Angeles demonstrates that the proposed method outperforms state-of-the-art approaches, improving prediction performance by (7-15)% across multiple forecasting horizons},
  publisher = {IEEE},
  isbn = {979-8-3315-5397-5},
}

@article{msstanatrafficflowpredictionmo2025,
  author = {J. Xue; G. Gui; K. Li; W. Gui},
  title = {{MSSTAN:} {A} {Traffic} {Flow} {Prediction} {Model} based on {Multi-Scale} {Spatio-temporal} {Attention} {Network}},
  journal = {2025 China Automation Congress (CAC)},
  year = {2025},
  pages = {1116--1122},
  doi = {10.1109/CAC67268.2025.11486975},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11486975},
  abstract = {To overcome the shortcomings of current traffic flow prediction models, which often disregard data periodicity and static spatial dependencies this paper proposes a model based on multi-scale spatio-temporal attention network that can extract dynamic spatiotemporal features in the road network by adopting attention mechanism. This model designs a multi-scale classification strategy to model the inherent periodic patterns of traffic flow. In the temporal dimension, attention mechanisms are employed to model long-range dependencies across different time scales, effectively capturing long-distance temporal patterns. For spatial modeling, a hybrid approach combining dynamic self-attention mechanisms with fixed geographical constraints is introduced to represent dynamic spatial correlations, overcoming the limitations of traditional static spatial dependency assumptions. Experiments conducted on three real-world traffic datasets demonstrate that the proposed model achieves superior prediction accuracy compared to other baseline models.},
  publisher = {IEEE},
  isbn = {979-8-3315-8967-7},
  issn = {2688-0938},
  keywords = {Spatiotemporal Sequence;Traffic Flow Prediction;Attention Mechanism;Multi-scale},
}

@article{channelinformationexchangeindu2025,
  author = {Y. Xu; F. Qin; Y. Luo; W. Ke; Q. -X. Zhu; Y. -L. He; Y. Zhang; M. -Q. Zhang},
  title = {{Channel} {Information} {Exchange-Induced} {Spatiotemporal} {Graph} {Convolutional} {Network}},
  journal = {IEEE Sensors Journal},
  year = {2025},
  volume = {25},
  number = {15},
  pages = {29262--29270},
  doi = {10.1109/JSEN.2025.3582952},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11062491},
  abstract = {Accurately predicting traffic flow is a highly crucial task essential for providing functional services to urban road networks. Urban traffic is a complex and constantly evolving system, influenced not only by factors within individual regions but also by interactions among different regions within the entire city network. The majority of current traffic flow prediction methods rely on static geographic information, thus ignoring the cross-regional flow of traffic within cities. To tackle this issue, this article proposes a channel information exchange-induced spatiotemporal graph convolutional network (CIE-STGCN). This network constructs both a static adjacency matrix constructed from geographic information and a dynamic adjacency matrix based on adaptive parameter learning for nodes. The static and dynamic STGCNs operate on separate channels to extract features. Additionally, a channel information exchange module based on channel attention and gating mechanisms is designed to achieve global complementarity of static and dynamic features in traffic flow data. Validation using multiple real-world traffic flow datasets demonstrates the efficacy of the proposed model in reliably predicting traffic flow.},
  publisher = {IEEE},
  issn = {1558-1748},
  keywords = {Adaptive spatiotemporal embeddings;channel information exchange module;spatiotemporal graph convolutional network (STGCN);traffic flow prediction},
}

@article{aspatiotemporalgraphattentionb2026,
  author = {C. Ma; C. Shi; B. Du},
  title = {{A} {Spatiotemporal} {Graph} {Attention-Based} {Traffic} {Speed} {Prediction} {Method} {With} {Bayesian} {Optimization} and {Evolutionary} {Algorithm} {Mutual} {Feedback} {Optimization}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2026},
  volume = {27},
  number = {2},
  pages = {2408--2423},
  doi = {10.1109/TITS.2025.3632402},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11261349},
  abstract = {Accurate traffic speed prediction is a critical precursor for traffic management activities such as congestion prevention, accident warning, and traffic network optimization. Given the complexity of traffic flow data and the spatiotemporal correlations within this data, we present a Spatiotemporal Multi-head Graph Attention (STMGAT) traffic speed prediction model, which consists of multiple layers for extracting spatiotemporal features from traffic speed data. Each layer is constructed by serially connecting a Bidirectional Long Short-Term Memory Network (Bi-LSTM), a Multi-head Graph Attention Network (MGAT), and a gated causal Convolution Neural Network (gated causal CNN). In this structure, Bi-LSTM and gated causal CNN are responsible for two stages of temporal feature extraction from the traffic speed, while the MGAT, positioned between Bi-LSTM and gated causal CNN, facilitates the transfer of temporal features and the aggregation of spatial features. Furthermore, a Bayesian Optimization-Evolutionary Algorithm (BO-EA) mutual feedback optimization framework is proposed to optimize the network architecture and hyperparameters of the STMGAT model. The evolutionary algorithm provides evolutionarily-informed sampling points to the Bayesian optimization, while the Bayesian optimization supplies exogenous population individuals to the evolutionary algorithm. The two algorithms effectively optimize the network architecture and hyperparameters of the STMGAT model by continuously exchanging optimization information with each other. Experimental results demonstrate that the STMGAT model, featured with a decision-based and adaptive architecture, can effectively capture the complex spatiotemporal features in traffic speed data, achieving superior prediction performance compared to the baseline models. Moreover, the BO-EA mutual feedback framework shows higher efficiency on optimizing the network architecture and hyperparameters compared to single optimization algorithms.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Traffic speed prediction;spatiotemporal feature extraction;multi-head graph attention network;Bayesian optimization;evolutionary algorithm},
}

@article{longtermtrafficflowpredictiona2025,
  author = {C. Li; L. Feng; W. Li; F. Zhou},
  title = {{Long-Term} {Traffic} {Flow} {Prediction:} {A} {Knowledge-Driven} {Graph} {Attention} {Spatio-Temporal} {Network}},
  journal = {IEEE Transactions on Network and Service Management},
  year = {2025},
  volume = {22},
  number = {5},
  pages = {4206--4221},
  doi = {10.1109/TNSM.2025.3595919},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11114796},
  abstract = {As an important research topic in the field of intelligent network management, network traffic prediction has received extensive attention in recent years. However, the existing research mainly focuses on short-term network traffic prediction and does not consider the influence of external factors and the effective embedding of heterogeneous data sources. Effective long-term traffic prediction has become a challenging problem. To address these challenges, this paper proposes a knowledge-driven deep learning method KGASTN for spatio-temporal graphical convolutional networks for long-term traffic flow prediction with multiple factors. In the method, our innovative idea is to design a knowledge-data dual-driven feature extraction scheme that fuses the knowledge representation of external factors into a spatio-temporal graph convolutional network. The method utilizes knowledge inference and sequence similarity algorithms to realize the extraction of explicit knowledge in log data and the construction of similarity graphs between traffic data sequences; and fuses explicit knowledge and similarity relationships based on the knowledge-data dual-drive model, and ultimately constructs spatio-temporal graph convolutional networks based on the attention mechanism. We evaluate KGASTN with a heterogeneous dataset containing log data, and use several sequence prediction datasets from other application domains for additional comparison. Experimental results show that our method outperforms several state-of-the-art baselines.},
  publisher = {IEEE},
  issn = {1932-4537},
  keywords = {Long-term network traffic prediction;knowledge inference;spatio-temporal graph convolutional network;deep learning},
}

@article{fehgatfrequencyenhancedhybridg2025,
  author = {Y. Ren; W. Zhu; S. Lan; X. Zhou; H. Yang; Z. Hou},
  title = {{FE-HGAT:} {Frequency-Enhanced} {Hybrid} {Graph} {Attention} {Network} {For} {Traffic} {Prediction}},
  journal = {2025 IEEE International Conference on Systems, Man, and Cybernetics (SMC)},
  year = {2025},
  pages = {5173--5178},
  doi = {10.1109/SMC58881.2025.11342712},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11342712},
  abstract = {Traffic flow prediction is crucial for urban traffic management and planning. However, although existing research has achieved promising results, most methods primarily focus on time-domain processing, with insufficient exploration of frequency-domain signal characteristics. Moreover, existing approaches often fail to effectively distinguish and simultaneously model the spatial dependencies between nearby and distant nodes. To address these issues, this paper proposes a Frequency-Enhanced Hybrid Graph Attention Network (FE-HGAT) for traffic flow prediction. Our approach employs a dynamic filter in the temporal dimension, which utilizes Fast Fourier Transform (FFT) to enhance key frequency-domain features, thereby better characterizing the temporal dependencies in traffic data. Besides, to capture spatial dependencies between nodes at varying distances, we design a dynamic threshold module to distinguish between nearby and distant nodes, employing external attention (EA) and a mixture-of-experts-enhanced graph attention network (MOE-GAT) to model local dependencies and long-distance semantic similarities, respectively. Experiments demonstrate that FE-HGAT outperforms existing baseline models on several public transportation datasets, validating its effectiveness in traffic forecasting. The code is available at https://github.com/ry123scuer/FE-HGAT.},
  publisher = {IEEE},
  isbn = {979-8-3315-3358-8},
  keywords = {traffic flow prediction;spatial-temporal data;graph attention network},
}

@article{gcnlstmassistedrealtimetraffic2025,
  author = {T. Bansal; Sahil},
  title = {{GCN-LSTM-Assisted} {Real-Time} {Traffic} {Congestion} {Prediction:} {An} {Edge-Cloud} {Based} {Framework}},
  journal = {2025 International Conference on Electronics and Computing, Communication Networking Automation Technologies (ICEC2NT)},
  year = {2025},
  pages = {1--6},
  doi = {10.1109/ICEC2NT65402.2025.11379941},
