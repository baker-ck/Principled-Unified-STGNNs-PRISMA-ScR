  year = {2026},
  pages = {35--40},
  doi = {10.1109/SERA69989.2026.11618669},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11618669},
  abstract = {Traffic congestion has become a growing concern in urban areas due to increasing vehicle usage and infrastructure limitations. There are many existing traffic prediction algorithms to predict traffic flow. However, due to the inherent complexity and dynamic nature of traffic conditions, there remains potential for improving the accuracy of the prediction. In this study, we leverage a Spatio-Temporal Graph Neural Network (STGNN)-based traffic prediction mechanism to further improve predictive accuracy. We improve the STGNN framework by incorporating both spatial and temporal dependencies. Specifically, we first account for both spatial and temporal dependencies within traffic networks. For example, we consider the influences from both directly connected roads (adjacent roads) and indirectly connected roads (non-adjacent roads), which may affect traffic conditions due to congestion effects or shared demand patterns. In addition, we involve unexpected changes in traffic patterns and high congestion levels, particularly during peak hours. Secondly, we combine weather conditions (e.g. rainfall, temperature) into consideration since the weather significantly impacts the traffic flow. Evaluation results show that the STGNN with multi-source data outperforms traditional models, achieving a Mean Absolute Error (MAE) of 0.10, Root Mean Square Error (RMSE) of 0.13, and Mean Absolute Percentage Error (MAPE) of $\mathbf\{1 6. 2 6 \%\}$, with a high $R^\{2\}$ of 0.96. In addition to continuous traffic predictions, the model classifies congestion levels during peak hours, achieving a classification accuracy of 99%. These results show that leveraging STGNN for traffic prediction improves forecasting accuracy and enhances congestion classification. As a result, our study contributes to traffic control systems, urban planners, and authorities aiming to reduce congestion and improve traffic flow in urban environments.},
  publisher = {IEEE},
  isbn = {979-8-3195-0657-3},
