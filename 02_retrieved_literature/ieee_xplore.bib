@article{improvingthestabilityofmultiho2025,
  author = {Y. Hu},
  title = {{Improving} the {Stability} of {Multi-hop} {IoT} {Communication} {Paths} {Using} {Graph} {Neural} {Networks}},
  journal = {2025 4th International Conference on Electronics, Integrated Circuits and Communication Technology (EICCT)},
  year = {2025},
  pages = {354--358},
  doi = {10.1109/EICCT65471.2025.11099689},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11099689},
  abstract = {This paper aims to solve the problem of path stability degradation caused by topological dynamics and link quality fluctuations in multi-hop IoT (Internet of Things) communications. It introduces Graphormer's global self-attention and structural encoding methods to efficiently model global and local information of the network and improve the stability of the communication path. It then constructs node features and edge features, designs the Graphormer module, introduces the shortest path distance bias, degree centrality encoding, and channel quality bias to enhance global topological perception, and uses sliding time window dynamic graph input to capture network evolution. The experiments are conducted on the OMNeT++ platform, covering 50â400 node scales and multiple mobility models. The results show that when the number of nodes increases from 50 to 400, the link availability decreases and the packet loss rate increases to a higher level. In terms of path life, Graphormer reaches 29.5 seconds in the Random Direction scenario, which is significantly better than DGI (Deep Graph Infomax) (22.8 seconds) and GAT (Graph Attention Network) (18.9 seconds), and reaches 37.8 seconds in Reference Point Group Mobility, which is better than AODV (Ad hoc On-Demand Distance Vector) (19.5 seconds) and RPL (Routing Protocol for Low-Power and Lossy Networks) (21.0 seconds). In the delay jitter comparison, Graphormer's end-to-end delay fluctuation range is smaller, significantly lower than other models. Graphormer effectively improves path stability through global attention and dynamic graph modeling.},
  publisher = {IEEE},
  isbn = {979-8-3315-3594-0},
  keywords = {Multi-hop IoT;Communication Path;Stability Analysis;Graph Neural Network},
}

@article{scdvhtspectrumconstrainedmarlf2025,
  author = {H. Wu; D. Guo; R. Chen; C. Li; H. Hu},
  title = {{SC-DVHT:} {Spectrum-Constrained} {MARL} for {Dynamic} {Vehicle} {Control} in {Heterogeneous} {Traffic}},
  journal = {2025 IEEE 2nd International Conference on Big Data Science and Engineering (ICBDSE)},
  year = {2025},
  pages = {1--9},
  doi = {10.1109/ICBDSE65491.2025.11220132},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11220132},
  abstract = {In dense heterogeneous traffic scenarios, the co-evolution of long-term strategic planning and instantaneous behavioral responses in driving patterns exhibits strong coupling dynamics, leading to substantial uncertainties in intention inference and trajectory prediction (e.g., frequent lane-changing behaviors may stem from transient road anomalies or persistent driving habits). Conventional autonomous driving approaches struggle to address these challenges due to inherent limitations in pattern disambiguation, computational efficiency, and temporal modeling. To overcome these limitations, this study proposes SC-DVHT (Spectral-Constraint Dynamic Vehicle Heterogeneous Traffic framework), which establishes a dynamic spectral-spatiotemporal joint modeling architecture for effective decoupling of multi-scale driving characteristics:(1)The dynamic spectral-constraint mechanism confines behavioral cycles to physically interpretable from 3 to $T / 2$ intervals to suppress both high-frequency noise artifacts and low-frequency pseudo-periodic disturbances;(2)Asymmetric convolutional kernel assemblies coupled with sparse attention gating mechanisms collaboratively extract micro-scale maneuvers (e.g., steering angles) and macro-scale tactical patterns (e.g., overtaking frequencies);(3)Multi-granularity contextual modeling integrates second-level instantaneous behaviors with minute-level strategic evolution, enabling holistic intention reasoning that âcaptures both granular details and global patternsâ.Experimental results demonstrate that in heterogeneous highway environments, TemporalNet outperforms the Decentralized Training with Decentralized Execution (DTDE) MARL algorithm (iPLAN) by $11.7 \%$ in survival duration and $9.1 \%$ in success rate under moderate traffic conditions. When benchmarked against QMIX - the widelyused CTDE (Centralized Training with Decentralized Execution) framework in multi-agent reinforcement learning - the proposed method demonstrates superior performance in moderate traffic conditions, exhibiting a $1.37 \%$ extension in operational duration, $13.27 \%$ enhancement in mission completion efficiency, and $7.72 \%$ improvement in motion continuity maintenance. Notably, in chaotic traffic scenarios, SC-DVHT exhibits $0.8 \%$ and $7.4 \%$ improvements in survival time and success rate over iPLAN, respectively. These findings confirm that spectral-spatiotemporal joint modeling significantly enhances robustness of intention perception in complex traffic environments, establishing a novel paradigm for high-density dynamic driving decisionmaking systems.},
  publisher = {IEEE},
  isbn = {979-8-3315-4407-2},
  keywords = {Autonomous driving;MARL;Spectralspatiotemporal joint modeling},
}

@article{tgatmarldeeplearningbasedproac2026,
  author = {D. Kavitha; K. R. Rao},
  title = {{TGAT-MARL:} {Deep} {Learning} based {Proactive} {Link} {Failure} {Prediction} and {Routing} in {MANETs}},
  journal = {2026 6th International Conference on Expert Clouds and Applications (ICOECA)},
  year = {2026},
  pages = {951--958},
  doi = {10.1109/ICOECA68095.2026.11485122},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11485122},
  abstract = {Mobile Ad Hoc Networks (MANETs) are highly vulnerable to frequent link failures due to node mobility, dynamic topology, and unstable wireless channels, which significantly degrade routing reliability and network performance. To address this challenge, this paper proposes a novel Proactive Link Failure Prediction and Reliable Routing framework based on Deep Learning-enabled Temporal Graph Attention and Multi-Agent Reinforcement Learning (TGATMARL). The proposed approach leverages temporal graph attention networks to learn spatio-temporal link dynamics from realistic MANET mobility traces and proactively predicts imminent link failures, while a multi-agent reinforcement learning policy jointly optimizes routing decisions to ensure reliability and adaptability. The framework is implemented and evaluated using the SimPy simulator under a realistic MANET workload dataset derived from standard mobility and traffic patterns. Comprehensive experimental results demonstrate that the proposed TGAT-MARL approach significantly outperforms state-of-the-art methods, including Multi-Agent Deep Learning (MADL), GAT-based PPO, and conventional DRL. Specifically, it achieves up to 14-22% improvement in packet delivery ratio, 18-27% reduction in end-to-end delay, 20-30% reduction in routing overhead, and 16-25% improvement in throughput. These gains confirm that proactive link failure awareness combined with cooperative multi-agent learning enables more robust, efficient, and scalable routing in highly dynamic MANET environments.},
  publisher = {IEEE},
  isbn = {979-8-3315-7451-2},
  keywords = {MANET;Failure Prediction;Graph Attention;Reinforcement Learning;SimPy;End-to-End Delay},
}

@article{vehicularmultimodalmotionforec2025,
  author = {Y. Zhou; Z. Wang; N. Ning; N. Lu; M. Dong; X. Shen},
  title = {{Vehicular} {Multimodal} {Motion} {Forecasting} {With} {Scenario-Guided} {Diffusion} {Probabilistic} {Models}},
  journal = {IEEE Transactions on Vehicular Technology},
  year = {2025},
  volume = {74},
  number = {11},
  pages = {16962--16977},
  doi = {10.1109/TVT.2025.3575478},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11018804},
  abstract = {Ensuringthe safe driving and decision-making of autonomous vehicles requires reliable modeling of the multimodal motion of vehicles. In this paper, we propose a novel scenario-guided diffusion probabilistic model called RoadDiff to address these issues. By modeling and interacting with scene-contextual heterogeneous data at the feature level, we achieve lightweight and high-quality representations of traffic dynamics. We interpolate these representations as guiding conditions into a stochastic iterative denoising process of reverse diffusion, progressively transforming a known prior distribution into a multimodal trajectory distribution that includes the ground truth mode. Our well-designed Transformer-based neural network approximates the denoising matching function of the reverse diffusion process, and our region of interest-based training strategy ensures that the sampled multimodal trajectories conform to road and physical constraints to overcome mode blur. We carefully design two loss functions to ensure multimodal prediction for regions of interest and efficient trajectory guidance during this process. Experimental results on real-world motion datasets demonstrate that RoadDiff outperforms state-of-the-art methods in terms of prediction multimodality and accuracy, indicating its potential as a novel paradigm for vehicular multimodal motion prediction.},
  publisher = {IEEE},
  issn = {1939-9359},
  keywords = {Connected and automated vehicles;heterogeneous representation;multimodal motion prediction;diffusion probabilistic model},
}

@article{causalityawaredualgraphapproac2026,
  author = {Y. Luo; J. Zheng; S. Qin; T. Chen; D. Wu},
  title = {{Causality-Aware} {Dual} {Graph} {Approach} for {Multi-Cloud} {Networking} {Forecasting}},
  journal = {IEEE Transactions on Network Science and Engineering},
  year = {2026},
  volume = {13},
  pages = {9447--9462},
  doi = {10.1109/TNSE.2026.3691846},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11514131},
  abstract = {Multi-cloud networking enables enterprises to orchestrate applications across heterogeneous cloud platforms, offering improved scalability, resilience, and cost-effectiveness. However, complex interactions among distributed cloud resources introduce intricate interdependencies, particularly through inter-VM traffic flows and shared network pathways. Current forecasting methods for system metrics often overlook these fine-grained traffic dynamics and the causal relationships inherent in multi-cloud environments, failing to capture how resource usage in one VM can influence others. In this paper, we propose a causality-aware dual-graph neural network designed explicitly for multivariate system metric forecasting in multi-cloud settings. Our framework employs an adaptive dual-graph architecture to simultaneously model spatial dependencies among metrics across different VMs and temporal dependencies within individual VM metrics. To explicitly encode directional causal relationships, we construct a Transfer Entropy-based causality matrix optimized through Bayesian search. A causally guided fusion module integrates these representations using contrastive and triplet learning, aligning latent spaces to emphasize causality-aware structures. Extensive experiments on real-world multi-cloud traces demonstrate that our approach consistently outperforms strong spatio-temporal and Transformer-based forecasting baselines, achieving relative error reductions of at least 8% (across MAE/RMSE/MAPE) in the 15-VM setting.},
  publisher = {IEEE},
  issn = {2327-4697},
  keywords = {Cloud networking;graph neural network;time series;granger causality;alignment},
}

@article{mathrma3mathrme2netintegrating2025,
  author = {Y. Li; X. Wei; X. Zhao; P. Zhai; L. Zhang},
  title = {{$\mathrm\{A\}^\{3\}} {\mathrm\{E\}^\{2\}$} {Net:} {Integrating} {Waypoints,} {Lanes,} and {Traces} for {Multi-Modal} {Trajectory} {Prediction}},
  journal = {2025 IEEE 37th International Conference on Tools with Artificial Intelligence (ICTAI)},
  year = {2025},
