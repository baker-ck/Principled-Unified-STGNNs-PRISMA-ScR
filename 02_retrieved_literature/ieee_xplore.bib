@article{applicationresearchontrafficop2026,
  author = {S. Qian; S. Hao; X. Zheng; Y. Jin; M. Ding},
  title = {{Application} research on traffic operation state monitoring and management-control platform for expressway reconstruction and expansion sections},
  journal = {14th International Conference on Transportation and Traffic Engineering (ICTTE 2025)},
  year = {2026},
  volume = {2025},
  pages = {468--472},
