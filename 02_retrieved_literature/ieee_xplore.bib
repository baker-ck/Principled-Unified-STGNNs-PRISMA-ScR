@article{anexplainablegnnbasedframework2026,
  author = {A. R. Sana Ullah; A. Baghbani; N. Bouguila; Z. Patterson},
  title = {{An} {Explainable} {GNN-Based} {Framework} for {Short-Term} {Bus} {Passenger} {Flow} {Forecasting}},
