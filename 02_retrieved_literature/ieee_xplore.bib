  abstract = {Traffic forecasting remains a challenging task due to complex spatio-temporal dependencies and dynamic patterns across urban road networks, while many existing methods struggle to effectively disentangle multiscale temporal patterns and incorporate high-level semantic information. In this paper, we propose ST-WaveLLM, a novel hybrid model that integrates wavelet-enhanced signal decomposition with large language models (LLMs) for accurate and interpretable spatio-temporal traffic forecasting. ST-WaveLLM consists of three main components: (1) wavelet-based decomposition that separates multiscale traffic patterns into low-frequency trends and high-frequency fluctuations; (2) graph-based spatial modeling with static and adaptive graph encoders to capture topological dependencies among nodes; and (3) Transformer-based temporal modeling fused with a pre-trained LLM (Qwen2.5-1.5B) via lightweight LoRA adaptation. A gated fusion module balances learned traffic dynamics with LLM-augmented semantic priors. Experiments on the PEMS08 and PEMS04 datasets demonstrate that ST-WaveLLM achieves state-of-the-art performance while maintaining interpretability and scalability.},
  publisher = {IEEE},
  isbn = {979-8-3315-6701-9},
  issn = {2379-190X},
  keywords = {Traffic forecasting;multi-scale temporal modeling;discrete wavelet transform;graph attention network;spatio-temporal fusion;frequency decomposition},
}

@article{aknowledgedistillationbasedfra2025,
  author = {J. Gao; Y. Lin; Z. Du; Y. Chen; W. Bao; S. Djahel},
