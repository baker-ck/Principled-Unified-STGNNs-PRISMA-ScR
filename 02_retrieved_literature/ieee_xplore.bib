  doi = {10.1109/HONET67928.2025.11318432},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11318432},
  abstract = {Accurate trajectory prediction is essential for enhancing the planning and control capabilities of autonomous vehicles. In complex traffic environments, social interactions among vehicles significantly influence their future movements. However, trajectory prediction models based on recurrent neural networks (RNNs) or convolutional neural networks (CNNs) often struggle with long-term predictions. Most existing approaches are limited to fixed spatial neighborhoods or short temporal windows for interaction modeling, which leads to accumulated errors and a failure to capture long-range dependencies. To address these limitations, we propose a non-local spatio-temporal interaction-based single-layer long short-term memory (NST-Single-LSTM) model for trajectory prediction. This model effectively captures higher-order interactions among vehicles without being restricted by spatial or temporal constraints. We evaluated proposed model on the real-world HighD dataset. Experimental results demonstrate that our model outperforms several baseline methods, achieving a 58% reduction in RMSE compared to the next-best LS-LSTM model over a long-range prediction horizon.},
  publisher = {IEEE},
  isbn = {979-8-3315-7643-1},
  issn = {1949-4106},
  keywords = {Autonomous driving;long-short-term memory (LSTM);spatiotemporal;vehicle trajectory prediction},
}

@article{knowledgetransferserviceformul2025,
  author = {J. Mo; J. Chen; Z. Gong},
  title = {{Knowledge} {Transfer} {Service} for {Multi-Granular} {Traffic} {Prediction} in {Smart} {Cities}},
