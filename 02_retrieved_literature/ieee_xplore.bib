  title = {{Leveraging} {SpatialâTemporal} {Heterogeneity} and {Cross-Mode} {Interactions:} {A} {Meta-Learning} {Approach} for {Multimodal} {Transportation} {Demand} {Prediction}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2025},
