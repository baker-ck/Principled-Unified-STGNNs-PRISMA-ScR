  abstract = {Frequent lane-changing maneuvers significantly increase the risk of traffic accidents on highways and constitute a critical factor affecting road safety. This study investigates the complex dynamic interactions that occur during vehicle lane changes in highway merging and diverging zones. Based on vehicle trajectory data captured from an autonomous aerial vehicle (AAV) perspective, a conflict prediction modeling approach is proposed that incorporates both trajectory features and spatiotemporal conflict characteristics. The method employs the attention mechanism of a graph attention network (GAT) to dynamically aggregate the spatial features of neighboring vehicles and integrates the self-attention mechanism of a Transformer to capture the temporal evolution of trajectories within a defined time window, thereby uncovering latent patterns and key distinguishing features of lane-changing conflicts in merging and diverging areas. Experimental results indicate that vehicles in merging zones exhibit higher lane-changing frequencies and greater lateral accelerations. Compared with baseline methods, the proposed GAT-Transformer-based conflict prediction model achieves superior performance, reaching a maximum prediction accuracy of 95.49% and an F1 score of 97.64%. These results underscore the modelâs effectiveness in balancing predictive precision with comprehensive detection of true conflicts. Furthermore, the model consistently maintains prediction accuracies above 90% under varying penetration rates and demonstrates strong robustness and reliability across different levels of data availability.},
  publisher = {IEEE},
  issn = {2169-3536},
  keywords = {Lane-change conflict prediction;vehicle trajectory data;highway merging and diverging areas;graph attention network;deep learning},
}

@article{multiscalespatiotemporalgraphs2026,
  author = {J. Wang; W. Ren; M. Lei},
  title = {{Multi-Scale} {Spatiotemporal} {Graph} {State} {Coevolution} for {Traffic} {Flow} {Forecasting}},
  journal = {2026 11th International Conference on Computer and Communication Systems (ICCCS)},
  year = {2026},
  pages = {1298--1303},
  doi = {10.1109/ICCCS69761.2026.11613305},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11613305},
  abstract = {As the development of intelligent transportation systems moves closer toward full-scale implementation, the inherent limitations of individual node intelligence in complex situations have increasingly become obvious, and collective perception as well as collaborative scene understanding are crucial for guaranteeing the safety and efficiency of traffic operations. The existing approaches are challenged in their ability to recognize the long and short-term patterns of multi-node information and their continuous evolution characteristics in complex and changing traffic scenarios. In light of these challenges, a collaborative scene understanding framework for intelligent transportation system operations is presented, which combines Multi-Scale Spatiotemporal Graph Neural Networks with Ordinary Differential Equations. In our framework, road segments or vehicles are considered collaborative perception nodes in a complex traffic network, which adaptively integrates different types of sensory information via multi-scale graph structures and uses neural ODEs for continuous description of the dynamic evolution of scene states. In addition, an anomaly-aware gating module is designed for more sensitive responses to sudden traffic events. Experimental findings on actual datasets demonstrate that our framework can significantly reduce prediction errors and correctly capture the spatiotemporal evolution characteristics of complex dynamic scenes.},
  publisher = {IEEE},
  isbn = {979-8-3195-0734-1},
  issn = {2995-3251},
  keywords = {Collaborative Scene Understanding;Coevolution;Traffic flow prediction;Multi-Scale Spatiotemporal Graphs;Ordinary Differential Equations;Traffic State Estimation},
}

@article{fmegcnamultisourceheterogeneou2025,
  author = {G. Yuan; X. Fan; Y. Xiao; Y. Lu},
  title = {{FME-GCN:} {A} {Multi-Source} {Heterogeneous} {Data} {Fusion} {Approach} for {High-Accuracy} {Traffic} {Flow} {Prediction}},
