  doi = {10.1109/ISCAIT69154.2026.11477269},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11477269},
  abstract = {As distributed photovoltaic (PV) systems become increasingly prevalent in modern microgrids, accurate power forecasting is essential for maintaining grid stability and optimizing energy management. Traditional forecasting models primarily focus on individual station time-series data, often failing to capture the complex spatial dependencies among neighboring PV stations that share similar meteorological conditions. This paper proposes a novel Spatio-Temporal Graph Neural Network (STGNN) framework for multi-station PV power forecasting. We introduce an adaptive graph learning mechanism to capture latent correlations and utilize spatio-temporal convolution blocks to extract hierarchical dependencies. Experimental results on a real-world dataset comprising 22 PV inverters demonstrate that our proposed STGNN achieves a Mean Absolute Error (MAE) of 90.99 W, representing a 39.81% improvement over the persistence baseline and substantial gains over LSTM and GRU models. Ablation studies further reveal that correlation-based graph construction with threshold 0.7 yields optimal performance among various graph construction strategies.},
  publisher = {IEEE},
  isbn = {979-8-3315-8099-5},
  keywords = {Energy Management;Photovoltaic Power Forecasting;Spatio-Temporal Graph Neural Networks;Adaptive Graph Learning;Deep Learning},
}

@article{aunifiedsoftwaredefinedautonom2025,
