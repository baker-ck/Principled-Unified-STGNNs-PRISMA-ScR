  abstract = {Accident severity prediction has become a pivotal factor in ensuring public safety, emergency response optimization, and traffic control. In this paper, a hybrid ensemble framework is proposed that integrates ExtraTreesClassifier (ETC) and SpatioTemporal Graph Neural Networks (ST-GNN) to refine the accuracy of predictions. The method proposed leverages graph-like learning to identify the position of the accident records both spatially and temporarily, utilizing the power of ETC in terms of efficiency and interpretability at the same time. Data imbalances were resolved by employing Random Oversampling and SMOTE techniques. The ST-GNN part employs k-Nearest Neighbours (kNN) for edge creation in the structured relationship depicting after accident record processing as graph nodes. A meta-classifier (Logistic Regression) is applied to prediction of both models to enhance the accuracy, with ETC serving as the supportive ensemble classifier. High precision (97 %) and recall (96 %) rates testify that the ensemble model prevents false negatives and marks severe accidents properly. The study divulges the efficacy of the combination of graph neural networks and traditional ensemble learning, and thereby paving the way for enhanced accident severity prediction models.},
  publisher = {IEEE},
  isbn = {979-8-3195-2966-4},
  keywords = {Graph Neural Networks;SMOTE;Ensemble learning;Logistic Regression;ETC;kNN;ST-GNN},
}

