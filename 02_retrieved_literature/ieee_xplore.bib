@article{atrafficconflictidentification2025,
  author = {Z. Guo; R. Wang; B. Han; W. Ding; Z. Zhao; X. Chen; B. M. Chen},
  title = {{A} {Traffic} {Conflict} {Identification} and {Severity} {Assessment} {Method} {Based} on {Multi-Vehicle} {Trajectory} {Prediction}},
  journal = {2025 44th Chinese Control Conference (CCC)},
  year = {2025},
  pages = {6603--6608},
  doi = {10.23919/CCC64809.2025.11178854},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11178854},
  abstract = {Intelligent and precise traffic safety evaluations are essential for developing next-generation smart traffic management systems. While accident-based methods suffer from the rare and random nature of traffic accidents, traffic conflict techniques provide a more effective alternative for evaluating traffic safety, as traffic conflicts occur more frequently and positively correlate with accident rates. However, traditional traffic conflict assessment methods fail in complex multi-lane interaction scenarios-such as cut-ins, merges, and overtakes-due to oversimplified vehicle models and the neglect of motion uncertainties. To address this gap, we propose a novel method for traffic conflict identification and severity assessment based on multi-vehicle trajectory predictions. This method utilizes a Graph Neural Network (GNN)-based intention-aware trajectory prediction model that accounts for lane change intention, the influence from neighbor vehicles, and the uncertainty in future vehicle motions to forecast the trajectories of vehicles. Using predicted information, we calculate the collision probabilities and assess potential risks among nearby vehicles to identify the traffic conflict. The efficacy of our proposed method is demonstrated through a series of cut-in interaction simulations using the CARLA simulator. The trajectory prediction error is within 0.2m. Compared to other algorithms, our method significantly improves conflict identification accuracy and computational efficiency.},
  publisher = {IEEE},
  isbn = {978-988-75816-1-1},
  issn = {1934-1768},
  keywords = {Smart traffic;traffic safety evaluation;traffic conflict;vehicle trajectory prediction},
}

@article{multimodalspatiotemporalforeca2025,
  author = {J. Lv; S. Yang; M. Liu; Z. Feng; S. Wang},
  title = {{Multimodal} {Spatiotemporal} {Forecasting} with {Diffusion} {Transformer} and {Feature} {Distillation}},
  journal = {2025 8th International Symposium on Big Data and Applied Statistics (ISBDAS)},
  year = {2025},
  pages = {189--194},
  doi = {10.1109/ISBDAS64762.2025.11116933},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11116933},
  abstract = {Spatiotemporal forecasting is crucial for many real-world applications, such as predicting wildfire spread or dynamic environmental changes. Traditional methods often struggle with complex, high-dimensional data and require substantial computational resources. This paper addresses these challenges by proposing a novel three-stage framework. In the first stage, we build a multimodal dataset by converting visual data into natural language descriptions, providing richer semantic information. In the second stage, we leverage advanced image processing models to extract meaningful features from spatiotemporal sequences and apply a Diffusion Transformer for effective feature fusion. The decoder then predicts future sequences with high accuracy. In the final stage, we distill these complex features into lightweight models like UNet, ensuring computational efficiency without sacrificing prediction quality. Our approach significantly improves spatiotemporal forecasting performance while reducing computational costs, offering a promising solution for scalable and efficient real-world applications.},
  publisher = {IEEE},
  isbn = {979-8-3315-0719-0},
  keywords = {spatio-temporal;dynamic system;graph neural network},
}

@article{clkananovelhybridapproachforsp2025,
  author = {W. Chen; X. Li},
  title = {{CL-KAN:} {A} {Novel} {Hybrid} {Approach} for {Spatiotemporal} {Traffic} {Predictions}},
  journal = {2025 IEEE 49th Annual Computers, Software, and Applications Conference (COMPSAC)},
  year = {2025},
  pages = {1820--1827},
  doi = {10.1109/COMPSAC65507.2025.00249},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11126751},
  abstract = {Traffic flow prediction is a critical technology in intelligent transportation management systems, contributing to alleviating traffic congestion and optimizing resource allocation. However, the nonlinear and complex spatiotemporal characteristics of traffic flow data pose significant challenges to accurate prediction. To address these issues, this paper proposes a hybrid model, CL-KAN, which combines Convolutional Neural Networks, Long Short-Term Memory networks, and Kolmogorov-Arnold Networks. The model improves prediction performance and computational efficiency through spatial feature extraction, temporal sequence modeling, and nonlinear feature integration. Experimental results demonstrate that the CL-KAN model achieves prediction performance comparable to the Transformer model while significantly reducing the number of parameters and improving computational efficiency, making it particularly suitable for resource-constrained scenarios. Furthermore, compared to other models, CL-KAN exhibits superior performance in capturing complex spatiotemporal dependencies and dynamic changes. This study validates the efficiency and practicality of the CL-KAN model, providing a feasible solution for real-time prediction and complex scenario applications in intelligent transportation systems.},
  publisher = {IEEE},
  isbn = {979-8-3315-7434-5},
  issn = {2836-3795},
  keywords = {Long Short-Term Memory Networks;Convolutional Neural Networks;Kolmogorov-Arnold Networks;Hybrid Model},
}

@article{coingnninductivespatialtempora2025,
  author = {J. Zheng; D. Saxena; J. Cao},
  title = {{COIN-GNN:} {Inductive} {Spatial-Temporal} {Prediction} for {Continuous} {Distribution} {Shifts} via {Graph} {Neural} {Networks}},
  journal = {IEEE Transactions on Knowledge and Data Engineering},
  year = {2025},
  volume = {37},
  number = {11},
  pages = {6320--6333},
  doi = {10.1109/TKDE.2025.3606629},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11152361},
  abstract = {Distribution shifts from external events and new entities can significantly compromise spatial-temporal prediction accuracy, potentially leading to severe outcomes like traffic accidents. Existing methods often fail under these conditions due to two main limitations: they focus on invariant patterns, missing the diversity required to capture the evolving dynamics of distribution shifts; they rely on often inaccessible future knowledge, such as spatial information of new entities, limiting their generalizability. To address these limitations, we formally define the problem of inductive spatial-temporal prediction under continuous distribution shifts and introduce the Contrastive Learning Based Inductive Graph Neural Network (COIN-GNN) as a solution. We develop a novel metric, Relation Importance (RI), to effectively select stable entities and distinct spatial relationships, forming an informative subgraph. Additionally, we construct an informative temporal memory buffer to store and review influential timestamps identified using influence functions. COIN-GNN then generates pseudo-observations for unstable and uninformative entities during these influential timestamps, simulating potential distribution shifts. By applying contrastive learning, the network learns stable and informative representations that can effectively counter distribution shifts without relying on future knowledge. Our extensive experiments on several real-world datasetsâfrom traffic to weatherâdemonstrate COIN-GNNâs superior performance across different domains without requiring future knowledge.},
  publisher = {IEEE},
  issn = {1558-2191},
  keywords = {Spatial-temporal prediction;inductive learning;continual learning;distribution shifts},
}

@article{anextendedspatiotemporaldeeple2026,
  author = {N. M. Babu; B. Nimmagadda; A. Harika; B. A. Devi; V. A. Kumar},
  title = {{An} {Extended} {Spatio-Temporal} {Deep} {Learning} {Framework} for {Earthquake} {Forecasting} {Using} {Graph} {Neural} {Networks} and {LSTM}},
  journal = {2026 International Conference on Signal, Systems, and Computing for Next-Gen Automation (ICSSCNA)},
  year = {2026},
  pages = {985--991},
  doi = {10.1109/ICSSCNA68616.2026.11546969},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11546969},
  abstract = {Earthquake prediction remains a formidable scientific challenge due to the non-linear, multi-dimensional characteristics of seismic events across space and time. Although recent breakthroughs in deep learning techniques, notably Convolutional Neural Networks (CNN) and Long Short-Term Memory (LSTM) models, have enhanced temporal forecasting, they frequently fail to capture the non-Euclidean spatial geometries and fault-based error processes inherent in geological networks. To address this gap, we present an extended SpatioTemporal Deep Learning Framework that fundamentally upgrades standard IEEE CNN-LSTM architectures by integrating Graph Neural Networks (GNN) and Transformerbased temporal fusion. The proposed Spatio-Temporal GNN + BiLSTM model is explicitly designed to jointly map fault-aware spatial topologies and long-term temporal seismic patterns. The framework is rigorously validated using a complex real-world seismic dataset featuring Gutenberg-Richter b-values, seismic energy densities, Total Electron Content (TEC) anomalies, and crustal strain rates mapped against critical fault-line distances. Experimental results demonstrate that the proposed architecture significantly outperforms existing baselines, achieving a predictive accuracy of 0.9833, an $F 1$-score of 0.9573, and an ROC-AUC of 0.9941. By explicitly modeling geological interactions, the system yields a $\mathbf\{+ 2. 6 6 \%\}$ improvement in overall accuracy and $\mathbf\{+ 7. 4 4 \%\}$ increase in the $\mathbf\{F 1\}$-score compared to the standard CNN-LSTM baseline, proving its superior efficacy and reliability for multi-region earthquake early-warning systems.},
  publisher = {IEEE},
  isbn = {979-8-3315-7039-2},
  keywords = {Earthquake Forecasting;CNN-LSTM Extension;Graph Neural Networks;Spatio-Temporal Learning;Transformer;Deep Learning},
}

@article{iotdatafusionandalgorithmsinsm2025,
  author = {H. Feng; D. Li},
  title = {{IoT} {Data} {Fusion} and {Algorithms} in {Smart} {Cities}},
  journal = {2025 International Conference on Intelligent Computing and Knowledge Extraction (ICICKE)},
  year = {2025},
  pages = {1--6},
  doi = {10.1109/ICICKE65317.2025.11136741},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11136741},
  abstract = {The data fusion and algorithm of the Internet of Things in smart cities aims to solve the problems of decision lag and resource waste caused by inconsistent formats, noise interference, and insufficient real-time performance of multi-source heterogeneous sensor data. First, the raw data is cleaned and normalized, and the spatiotemporal feature encoder is used to extract the periodicity and spatial topological correlation of the time series. Then, the improved TuckER tensor fusion algorithm is used to map the multidimensional data of traffic cameras, geomagnetic sensors, and social media into a low-rank joint embedding space, and congestion prediction and traffic light optimization are achieved through a graph convolutional network and LSTM hybrid model. Under the real data set of the main urban area of Hangzhou, this method achieved a traffic flow prediction accuracy of 97.1%, the event response delay was reduced to 0.53 seconds, and the average road traffic efficiency for the entire period was 0.64TTI, which verified the significant role of cross-domain data fusion and spatiotemporal joint modeling in improving the efficiency of urban intelligent management, and provided a scalable technical path for dynamic resource allocation.},
  publisher = {IEEE},
  isbn = {979-8-3315-3681-7},
  keywords = {IoT data fusion;smart city;KNN;spatiotemporal features;GCN-LSTM},
}

@article{shorttermareatripattractionpre2026,
  author = {S. Xu; C. Li; Y. Chen; Y. Su; Y. Li; X. Chen},
  title = {{Short-Term} {Area} {Trip} {Attraction} {Prediction} {Based} on {Real-Time} {Human} {Mobility} {Data}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2026},
  volume = {27},
  number = {2},
  pages = {2470--2487},
  doi = {10.1109/TITS.2025.3639260},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11293769},
  abstract = {While considerable research has been dedicated to the prediction of area trip demand, relatively little attention has been paid to the area trip attraction prediction problem. A primary challenge in short-term trip attraction prediction stems from the partial observability of destination information, as trips are either still en route or have recently arrived but not yet confirmed as completed, leading to delayed and incomplete measurement of attraction dynamics. This paper proposes the field theory-guided area trip attraction prediction fusion network (FG-ATAPFN), which leverages potential energy fields (PEFs) to model underlying physical principles of urban dynamics. Furthermore, it establishes a connection between trip attraction and traffic flow through the continuity equation derived from field theory. FG-ATAPFN consists of three pivotal components: spatial-temporal Transformer to model spatial-temporal dependencies in historical area trip attraction sequences effectively, an OD flow PEF prediction network to derive precise trip destination insights, and an edge flow PEF prediction network to track and predict real-time human mobility flows dynamically, all leveraging both historical and real-time data to enable a comprehensive and precise analysis of travel behaviors within urban transportation systems. The proposed model is validated on an open-sourced real-world dataset comprising human movement trajectories from 100,000 users in Nagoya, Japan, and benchmarked against state-of-the-art prediction models. Experimental results indicate that FG-ATAPFN achieves a 15.5% reduction in mean absolute percentage error, surpassing baseline models in predicting trip attraction. We demonstrate that field theory effectively enhances the accuracy of trip attraction prediction, which is critical for optimizing transportation infrastructure design and guiding urban policy.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Trip attraction;partial observations;field theory;human mobility;potential energy fields},
}

@article{robustspatiotemporalgraphconvo2025,
  author = {R. Iwasa; Y. Dose; T. Hara; T. Maekawa; K. Shimazaki; T. Seguchi; T. Kikuchi; K. Kato},
