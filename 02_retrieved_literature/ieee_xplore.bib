@article{dynamicspatialtemporalgraphcon2025,
  author = {D. Yu; G. Guo; D. Wang; T. OuYang; F. Wan; J. Liu; G. Xu; S. Deng},
  title = {{Dynamic} {Spatial-Temporal} {Graph} {Convolution} {Network} for {E-Bike} {Traffic} {Flow} {Forecasting}},
