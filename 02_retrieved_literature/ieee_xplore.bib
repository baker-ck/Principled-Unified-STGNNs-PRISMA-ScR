@article{stgatlanechangingvehicletrajec2025,
  author = {Y. Zhang; N. Wang},
  title = {{STGAT:} {Lane-Changing} {Vehicle} {Trajectory} {Prediction} with {Spatio-Temporal} {Feature} {Fusion}},
  journal = {2025 7th International Conference on Robotics, Intelligent Control and Artificial Intelligence (RICAI)},
  year = {2025},
  pages = {351--357},
  doi = {10.1109/RICAI68060.2025.11384825},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11384825},
  abstract = {To enhance the accuracy of vehicle trajectory prediction in complex traffic scenarios, a spatio-temporal feature fusion trajectory prediction model (STGAT) is proposed. Temporal motion features are extracted from past trajectory data of the target vehicle and its surrounding vehicles using a Transformer encoder, while spatial interaction features among surrounding vehicles are captured by a multi-head graph attention network. At each time step, these spatio-temporal features are adaptively fused through a feature fusion gating unit. A two-layer GRU decoder then generates the probability distribution of future positions of the target vehicle over the prediction horizon. Experiments on the HighD dataset demonstrate that STGAT achieves substantial improvements in long-term trajectory prediction accuracy compared with baseline models, demonstrating its capability in modeling vehicle interactions and motion dynamics in both lane-keeping and lane-changing scenarios.},
  publisher = {IEEE},
  isbn = {979-8-3315-6934-1},
  keywords = {vehicle trajectory prediction;graph attention network;vehicle interaction modeling;deep learning},
}

@article{hardtokenspatiotemporalpretrai2025,
  author = {M. Jiang; J. Liu; Y. Xu; H. Hu; L. Xie},
  title = {{Hard-Token} {Spatiotemporal} {Pre-Training}},
  journal = {2025 IEEE International Conference on Big Data (BigData)},
  year = {2025},
  pages = {966--974},
  doi = {10.1109/BigData66926.2025.11402558},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11402558},
  abstract = {Real-time traffic forecasting in smart cities re-quires models that jointly capture complex spatial structures and evolving temporal patterns. Pre-training via self-supervised learning extracts general spatiotemporal patterns from large-scale unlabeled data, providing a robust feature-representation foundation for downstream tasks. However, existing graph-tensor methods often underutilize pre-training and rely on uniform masking or handcrafted heuristics, which yields insufficient feature learning in dynamic regions and error accumulation in mid-to-Iong-term forecasts. To address these limitations, we propose Hard-Token Spatiotemporal Pre-training (HT-STP), a unified framework that adapts its pre-training objective through selective hard-token masking. HT-STP achieves success through: (i) prioritizing high-loss tokens to create challenging proxy tasks for refined representation learning, (ii) introducing multi-target loss functions in both time and frequency domains, (iii) applying an iterative residual-refinement and gating mechanism to dynamically balance spatial and temporal cues. Extensive experiments on typical datasets demonstrate HT-STP's efficacy in advancing pre-training phase's performance and reducing the long-term drift in downstream tasks.},
  publisher = {IEEE},
  isbn = {979-8-3315-9447-3},
  issn = {2573-2978},
  keywords = {Traffic How prediction;Spatiotemporal heterogeneity;Self-supervised pretraining},
}

@article{multiformspatiotemporalfeature2025,
  author = {Q. Shen; Z. Ying; Z. Liu; J. Lou},
  title = {{Multi-Form} {Spatiotemporal} {Feature} {Fusion} {Enhancement} {Network} for {Traffic} {Flow} {Prediction}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2025},
  volume = {26},
  number = {11},
  pages = {20912--20929},
  doi = {10.1109/TITS.2025.3591109},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11106403},
  abstract = {Spatiotemporal fusion strategies are a crucial direction in traffic flow prediction. However, studies often emphasize the learning of local dynamic spatiotemporal dependencies from historical data while neglecting the potential impacts of label sequence autocorrelation, nonstationary signals, and temporal pattern changes on spatiotemporal dependency modeling. For example, the delayed propagation of abnormal traffic conditions, such as sudden traffic congestion, and abnormal weather between nodes and within sequences may trigger signal shifts, which in turn lead to changes in local flow patterns. Such changes can produce locally dependent misleading learning, making it difficult for spatiotemporal fusion strategies to accurately reflect the true relationships between signals. We propose a framework for traffic flow prediction, which first enhances the original signals in a targeted manner using knowledge of the autocorrelation of sequences through a multiform feature enhancement module, to obtain a more representative and enriched feature representation for model training. The framework processes features by decoupling multi-granularity in temporal patterns, comprehensively identifying complex traffic patterns, and eliminating the impact of nonstationary noise. A dual-channel spatiotemporal fusion network models local spatiotemporal dependencies and global seasonal dependencies to reasonably predict traffic. Experimental results on four real-world datasets show that the original method improves the Mean Absolute Error (MAE), Root Mean Square Error (RMSE), and Mean Absolute Percentage Error (MAPE) metrics by an average of 5.47%, 4.27%, and 7.05%, respectively, compared to all the metrics of the baseline model over the last two years. We also evaluated the performance of each module through ablation studies.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Traffic flow forecasting;pattern decomposition;spatiotemporal pattern fusion;feature enhancement},
}

@article{uavstnuncertaintyawarevariatio2025,
  author = {Y. Ma; Y. Duan; C. Zhang},
  title = {{UA-VSTN:} {Uncertainty-aware} {Variational} {Spatiotemporal} {Network} for {Traffic} {State} {Prediction}},
  journal = {IGARSS 2025 - 2025 IEEE International Geoscience and Remote Sensing Symposium},
  year = {2025},
  pages = {462--467},
  doi = {10.1109/IGARSS55030.2025.11242611},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11242611},
  abstract = {Quantifying uncertainty of prediction outcomes in traffic state prediction is vital for enhancing the reliability of decision-making in traffic management. However, most existing methods primarily focus on improving the accuracy of point prediction and are unable to effectively quantify the inherent uncertainty in traffic data. They also face significant challenges in capturing the dynamic spatial dependencies of graph-structured data in a variational framework. To address these gaps, we propose the uncertainty-aware variational spatiotemporal network (UA-VSTN), which quantifies the uncertainty of prediction outcomes by predicting the distribution of traffic state information. UA-VSTN integrates variational inference into the modeling of spatiotemporal dependencies in traffic data, enhancing the model's ability to handle the stochasticity of traffic data. Specifically, includes three main components: variational dynamic graph convolutional network (V-DGCN), variational simplified long short-term memory (V-SLSTM), and variational 2D convolutional network (V-Conv2D). V-DGCN captures dynamic spatial dependencies among road segments in graph data, V-SLSTM efficiently captures temporal dependencies by eliminating dependency on the previous hidden state, and V-Conv2D provides probabilistic distributions of traffic state for uncertainty quantification, including mean and variance. Comprehensive experiments conducted on two real-world datasets demonstrate that UA-VSTN outperforms all baselines in both point and interval predictions.},
  publisher = {IEEE},
  isbn = {979-8-3315-0810-4},
  issn = {2153-7003},
  keywords = {traffic state prediction;uncertainty;variational inference;graph},
}

@article{modelingcontinuousandheterogen2026,
  author = {M. Wen; X. Niu; J. Zhu; P. Fournier-Viger},
  title = {{Modeling} {Continuous} and {Heterogeneous} {Spatio-Temporal} {Dependencies} for {Accurate} {Traffic} {Forecasting}},
  journal = {IEEE Internet of Things Journal},
  year = {2026},
  volume = {13},
  number = {8},
  pages = {17696--17715},
  doi = {10.1109/JIOT.2026.3663402},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11389793},
  abstract = {Accurate traffic flow prediction is fundamental to intelligent transportation systems (ITSs), yet it remains challenging due to the complex spatio-temporal dynamics of road networks. Most existing approaches model traffic conditions as discrete snapshots, which fail to capture the underlying continuous evolution of traffic states and lead to significant information loss. Moreover, many methods insufficiently model spatial heterogeneity, inadequately distinguishing between local geographic proximity and global semantic correlations. To address these limitations, we propose spatio-temporal forecasting with adaptive continuous learning and heterogeneity awareness (STFACH), a novel framework for traffic forecasting. First, we introduce an adaptive continuous learning module that bridges discrete observations and continuous dynamics, while capturing intrinsic volatility often filtered out by deterministic interpolation. Driven by a learnable control path derived from intrinsic traffic volatility, this module leverages attentive neural differential equations (NDEs) to reconstruct continuous latent trajectories and explicitly model fine-grained temporal evolution. Second, we design a heterogeneity-aware module to resolve spatial ambiguity by disentangling spatial dependencies into dual branches, constructing adaptive adjacency matrices that jointly capture local geometric relations and global semantic affinities. Extensive experiments on ten real-world benchmark datasets spanning diverse traffic scenarios demonstrate that STFACH significantly outperforms state-of-the-art baselines, validating its effectiveness and robustness in modeling both continuous dynamics and structural heterogeneity. The code is publicly available at https://github.com/MaxRubby/STFACH_2026},
  publisher = {IEEE},
  issn = {2327-4662},
  keywords = {Graph neural network (GNN);intelligent transportation system (ITS);neural differential equations (NDEs);spatio-temporal dependencies;traffic forecasting},
}

@article{mmsttmetaoptimizedmultiperiods2026,
  author = {M. Wang; Y. Zhang; J. Cui; J. Jin; Y. Chang; L. Wu},
  title = {{MMSTT:} {Meta-Optimized} {Multi-Period} {Spatial-Temporal} {Transformer} for {Multi-Pattern} {Cellular} {Traffic} {Prediction}},
  journal = {IEEE Transactions on Mobile Computing},
  year = {2026},
  volume = {25},
  number = {8},
  pages = {12536--12547},
  doi = {10.1109/TMC.2026.3672653},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11427347},
  abstract = {The exponential growth of mobile network traffic makes accurate traffic prediction essential for network optimization. However, this remains challenging due to complex spatial-temporal dependencies and diverse traffic patterns across base stations. Existing methods often rely on single-factor modeling or fail to effectively handle this multi-pattern heterogeneity. We propose the Meta-Optimized Multi-Period Spatial-Temporal Transformer (MMSTT), a novel framework integrating dynamic graph-based spatial modeling and multi-period temporal fusion within a Transformer architecture. To address the multi-pattern nature of traffic data, we incorporate a clustering algorithm and a meta-learning optimization process. This process captures shared features across patterns during meta-training and adapts to pattern-specific characteristics during meta-testing. Experimental results on a real-world dataset demonstrate that MMSTT significantly outperforms existing baselines, reducing the mean absolute error (MAE) to 28.39, root mean square error (RMSE) to 42.83, and mean absolute percentage error (MAPE) to 0.37. Compared to the standard Transformer and GCN baselines, MMSTT achieves improvements of 38.71% in MAE, 33.57% in RMSE, and 60.22% in MAPE.},
  publisher = {IEEE},
  issn = {1558-0660},
  keywords = {Multi-pattern cellular traffic prediction;meta-learning;multi-period fusion;graph transformer;clustering algorithm},
}

@article{dynamicroutingspatialtemporalt2025,
  author = {M. Zhang; J. X. Cao},
  title = {{Dynamic} {Routing} {Spatial-Temporal} {Transformer} {Model} for {Traffic} {Flow} {Prediction}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2025},
  volume = {26},
  number = {7},
  pages = {10116--10130},
  doi = {10.1109/TITS.2025.3552404},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10945829},
  abstract = {Predicting traffic flow is vital component of Intelligent Transportation Systems (ITS), aimed at enhancing urban traffic management and optimization efforts. However, accurate prediction remains a significant challenge due to the vast array of influencing factors. Many existing approaches often overlook the comprehensive impact of diverse factors on prediction accuracy by considering only a subset of data features. To address this critical issue, a Dynamic Routing Spatial-Temporal Transformer (DRSTT) model specifically tailored for traffic flow prediction is proposed. The DRSTT model captures data features through the design of specialized modules that effectively handle short-term variations, long-term trends, static spatial information of road networks, and dynamically evolving spatial patterns. The proposed approach combines dynamic routing techniques with the transformer model to intelligently adjust information transmission paths within the network according to the distinct features of real-time input data. Utilizing its robust self-attention mechanism, the transformer model effectively captures and analyzes the spatial-temporal dependencies present in data, thereby improving the accuracy of traffic flow predictions. Furthermore, distinct position embeddings are incorporated for different modules to further enhance the modelâs capability to recognize and utilize various feature types. The DRSTT model has been thoroughly tested on three traffic flow datasets, consistently surpassing leading techniques and demonstrating its reliability and efficiency in traffic flow prediction.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Transformer;spatial-temporal;dynamic routing;traffic flow prediction},
}

@article{mkdstnmultikerneldiscretespace2025,
  author = {K. Cao; J. Xiao; H. Xiao; J. Yu; X. Luo; L. Ding; P. Yang},
  title = {{MKDSTN:} {Multi-Kernel} {Discrete} {Space-Time} {Network} for {Traffic} {Flow} {Prediction}},
  journal = {2025 2nd International Symposium on IoT and Intelligent Robotics (IoTIR)},
  year = {2025},
  pages = {139--144},
  doi = {10.1109/IoTIR66925.2025.00031},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11327647},
  abstract = {Traffic information prediction plays a crucial role in mitigating traffic congestion and enhancing traffic efficiency. Early models often struggle to adapt to the variations in different scenarios and data distributions when handling large-scale and complex traffic network data. To effectively address the challenges posed by the complex characteristics of traffic flow information, this paper introduces a novel traffic flow prediction model known as the Multi-Kernel Discrete Spatio- Temporal Network (MKDSTN). This model integrates the channel attention mechanism, Gated Recurrent Unit (GRU), Graph Convolutional Network (GCN), and a multi-convolution kernel fusion network, while also incorporating a discrete cosine transform mechanism to bolster the effectiveness of the GCN. This enhancement allows the model to fuse GCN cwith time series models, focus on key features through the channel attention mechanism, and leverage the discrete cosine transform mechanism to integrate frequency and time domain features, comprehensively obtain the spatio-temporal correlation characteristics of traffic data and improving prediction accuracy. Experimental results on two real traffic datasets show that MKDSTN is superior to all compared baseline methods.},
  publisher = {IEEE},
  isbn = {979-8-3315-1493-8},
  keywords = {traffic flow prediction;channel attention mechanism;Gated Recurrent Unit;Graph Convolutional Network},
}

@article{progressivemultifaceteddynamic2025,
  author = {B. Ren; Y. Zhang; Y. Wen; H. Luo; T. Cheng; C. He},
  title = {{Progressive} {Multifaceted} {Dynamic} {Hypergraph} {Convolutional} {Network} {Model} for {Traffic} {Flow} {Prediction}},
  journal = {2025 International Joint Conference on Neural Networks (IJCNN)},
  year = {2025},
  pages = {1--8},
  doi = {10.1109/IJCNN64981.2025.11228823},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11228823},
  abstract = {In recent years, graph structures have been widely used in traffic flow prediction. Methods that construct adaptive graphs for data have been shown to outperform models that rely on a single static graph structure. However, most of the current adaptive graphs are static in nature and are constructed in the training set. Since traffic data often suffers from irregular changes in time series, such model architectures are usually unable to reliably, accurately, and timely learn the complex dependencies in traffic data. This paper proposes a new traffic prediction framework - Progressive Multifaceted Dynamic Graph Convolutional Network. Specifically, a progressive adjacency matrix is constructed by learning the trend similarity between graph nodes, and a set of graphs are constructed by gradually adapting to online input data during training and testing phases. Finally, asymptotically dynamic graph convolution is used to capture the complex spatiotemporal relationships in the asymptotic graph to improve traffic prediction accuracy. We apply the model to 4 different real traffic datasets and achieve the best consistency on all datasets.},
  publisher = {IEEE},
  isbn = {979-8-3315-1042-8},
  issn = {2161-4407},
  keywords = {Graph neural network;Traffic flow prediction;Progressive graph;Dynamic hybrid spatial graph learning},
}

@article{hpcacceleratedgraphmultiscales2025,
  author = {M. S. Deepika; A. Appaji; P. D. Shenoy; K. R. Venugopal},
  title = {{HPC-Accelerated} {Graph} {Multi-Scale} {Spatio-Temporal} {Transformer} for {Traffic} {Forecasting:} {A} {Multi-GPU} {Implementation} on {METR-LA}},
  journal = {2025 Supercomputing India (SCI)},
  year = {2025},
  pages = {1--8},
  doi = {10.1109/SCI68648.2025.11333847},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11333847},
  abstract = {Traffic prediction is a critical component of Intelligent Transportation Systems (ITS), requiring advanced models to capture complex spatio-temporal dependencies across sensor networks while meeting real-time constraints. This paper presents an HPC-optimized implementation of Gated Multi-Scale Spatio-Temporal Graph Transformer (GMSTGT) on the METR-LA dataset, utilizing distributed training across 4 GPUs on Param Utkarsh HPC system for simultaneous multi-horizon prediction. The proposed GMSTGT architecture integrates dynamic graph construction with hierarchical attention mechanisms, reducing memory complexity from $\mathbf\{O\}\left(\mathbf\{N\}^\{2\}\right)$ to $\mathrm\{O\}(\mathrm\{N\} \log \mathrm\{N\})$ for 207 -sensor networks. Experimental validation demonstrates Mean Absolute Error (MAE) of 2.68 (15-min), 3.24 $(30-\mathrm\{min\})$, $3.89(45-\mathrm\{min\})$, and $4.45(60-\mathrm\{min\})$ with 15.8 ms inference latency at batch size 64. The distributed implementation achieves nearly linear scaling ($\approx 4$) speedup over sequential approaches while maintaining prediction accuracy within 0.1% of single-GPU baselines.},
  publisher = {IEEE},
  isbn = {979-8-3315-5758-4},
  keywords = {Graph Transformer;HPC;Multi-GPU;Spatio-temporal forecasting;Traffic prediction},
}

@article{bayesianspatialtemporalgraphco2026,
  author = {Z. Jiang; W. Fan; L. Lu; H. Liu},
  title = {{Bayesian} {Spatial-Temporal} {Graph} {Convolutional} {Network} for {Aircraft} {Bumpiness} {Prediction}},
  journal = {2026 29th International Conference on Computer Supported Cooperative Work in Design (CSCWD)},
  year = {2026},
  pages = {1769--1774},
  doi = {10.1109/CSCWD68734.2026.11581616},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11581616},
  abstract = {Turbulence-induced aircraft bumpiness poses a significant threat to flight safety. Aircraft bumpiness prediction based on turbulence prediction is of great importance to the civil aviation industry. Traditional numerical weather prediction methods struggle to predict the small-scale turbulence that causes aircraft bumpiness. In recent years, various machine learning and deep learning methods have been applied to this problem. Nevertheless, The available turbulence labels are typically sparse, which makes it difficult for the model to accurately capture spatial correlations under such sparse distributions and leads to uncertainty in modeling spatial dependencies. To address these challenges, this paper proposes an aircraft bumpiness prediction method based on a Bayesian Spatial-Temporal Graph Convolutional Network (BSTGCN). In the proposed method, the graph structure is treated as a random variable within a parameterized generative model. A constant adjacency matrix is first constructed based on the spatial positions of data points, followed by a learnable perturbed adjacency matrix established through Gaussian sampling. Moreover, Monte Carlo dropout is employed to approximate the posterior distribution of the graph structure. Experimental results show that BSTGCN improves prediction accuracy by 1.67, 1.95, and 1.93 percentage points, respectively, compared with the current best baseline model under different input time steps.},
  publisher = {IEEE},
  isbn = {979-8-3315-8470-2},
  issn = {2768-1904},
  keywords = {aircraft bumpiness;turbulence;spatial-temporal prediction;graph convolutional network;Bayesian},
}

@article{attentionguideddeeplearningmod2026,
  author = {R. N; R.Ramya},
  title = {{Attention-Guided} {Deep} {Learning} {Model} for {Intelligent} {Traffic} {Flow} {Prediction} in {Smart} {Cities}},
