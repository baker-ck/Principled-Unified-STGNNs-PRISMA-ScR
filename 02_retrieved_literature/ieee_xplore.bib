  doi = {10.1109/JSAC.2025.3531563},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10845808},
  abstract = {Due to the exponential increase in wireless devices and a diversification of network services, unprecedented challenges, such as managing heterogeneous data traffic and massive access demands, have arisen in next-generation wireless networks. To address these challenges, there is a pressing need for the evolution of multiple access schemes with advanced transceivers. Millimeter-wave (mmWave) communication emerges as a promising solution by offering substantial bandwidth and accommodating massive connectivities. Nevertheless, the inherent signaling directionality and susceptibility to blockages pose significant challenges for deploying multiple transceivers with narrow antenna beams. Consequently, beam management becomes imperative for practical network implementations to identify and track the optimal transceiver beam pairs, ensuring maximum received power and maintaining high-quality access service. In this context, we propose a Contextual Combinatorial Beam Management (CCBM) framework tailored for mmWave wireless networks. By leveraging advanced online probing techniques and integrating predicted contextual information, such as dynamic link qualities in spatial-temporal domain, CCBM aims to jointly optimize transceiver pairing and beam selection while balancing the network load. This approach not only facilitates multiple access effectively but also enhances bandwidth utilization and reduces computational overheads for real-time applications. Theoretical analysis establishes the asymptotically optimality of the proposed approach, complemented by extensive evaluation results showcasing the superiority of our framework over other state-of-the-art schemes in multiple dimensions.},
  publisher = {IEEE},
  issn = {1558-0008},
  keywords = {Beam management;mmWave;transceiver pairing;wireless networks;multi-armed bandit;contextual awareness},
}

@article{humantrajectoryrecoverynetwork2025,
  author = {L. Song; P. Zeng; Y. Lai; F. Fan; W. Zhou; F. Liu},
  title = {{Human} {Trajectory} {Recovery} {Network} {Based} on {Trajectory-User} {Linking}},
  journal = {2025 6th International Conference on Computers and Artificial Intelligence Technology (CAIT)},
  year = {2025},
  pages = {232--238},
  doi = {10.1109/CAIT68620.2025.11424775},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11424775},
  abstract = {Human trajectory recovery aims to mine historical trajectories and leverage their correlation with current trajectories to predict missing points at given times. Existing trajectory recovery models tend to focus on characteristics of trajectories, incorporating spatiotemporal dependencies before and after missing points, while neglecting exploration of user-specific preferences. Linking trajectories to their corresponding users and leveraging specific user behavior patterns for precise prediction not only enhances tasks like trajectory recovery and prediction, but also facilitates the extraction of user contextual features, enabling a deeper understanding of semantic information within user trajectories. Based on this, this paper proposes a Human Mobility Trajectory Recovery Network based on Trajectory-User Linking(GVAE-TUL). The trajectory encoding extracted by this network, enriched with user features, can be integrated into multiple trajectory recovery model frameworks to enhance the semantic representation of user characteristics. Experiments conducted on three real-world datasets validate the effectiveness of GVAE-TUL and demonstrate its ability to improve the performance of trajectory recovery models.},
  publisher = {IEEE},
  isbn = {979-8-3315-5882-6},
  keywords = {Trajectory Recovery;Trajectory-User Linking;Variational Autoencoder;Gated Graph Neural Network},
}

@article{continuousgraphlearningbasedse2025,
  author = {M. Zhou; J. Lu},
  title = {{Continuous} {Graph} {Learning-Based} {Self-Adaptation} for {Multi-Stream} {Concept} {Drift}},
  journal = {IEEE Transactions on Cybernetics},
  year = {2025},
  volume = {55},
  number = {8},
  pages = {3760--3773},
  doi = {10.1109/TCYB.2025.3569816},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11028064},
  abstract = {Concept drift, characterized by changes in data distribution over time, has always been an inevitable problem in nonstationary data stream environments. Multistream scenarios are particularly complex due to the potential alteration of interstream correlations, posing significant challenges in addressing concept drift across multiple streams. Most existing adaptation methods target single-stream data, with limited research on multistream. To address these gaps, we propose a Continuous Graph Learning-based self-adaptation framework for Multistream concept drift, termed as CGLM. Our framework introduces a novel graph neural network (GNN) structure embedded with a dynamic graph generator (AGG). This generator creates an adaptive correlation graph using small-scale historical data, capturing spatio-temporal dependencies among streams without predefined graphs during the training phase. A base prediction GNN model is then initialized. When online testing starts, real-time performance is monitored to detect concept drift. Self-adaptation process is achieved by subgraph updating, with different continuous graph learning mechanisms are applied to nondrift or drift scenarios. Lightweight adjustment of subgraphs is performed under nondrift. When drift occurs, AGG generates a new dynamic graph based on newly arriving samples. Our adaptive diffusion graph attention module (ADGAT) captures local correlation changes caused by the drift in the newly generated dynamic graph. It adaptively updates the weights of the original correlation graph based on the extent of the drift. Experimental results on three large-scale real-world datasets demonstrate the superiority of our method over all baseline methods. Additionally, when large-scale data is available for training, our proposed CGLM still surpasses baseline methods.},
  publisher = {IEEE},
  issn = {2168-2275},
  keywords = {Concept drift;data streams;drift adaptation;graph neural network (GNN)},
}

@article{enhancingtrafficflowprediction2025,
  author = {Y. Liu; F. Liu},
  title = {{Enhancing} traffic flow prediction with multi-dimensional time series and advanced deep learning models},
  journal = {4th International Conference on Electronic Information Engineering, Big Data and Computer Technology (EIBDCT 2025)},
  year = {2025},
  volume = {2025},
  pages = {398--403},
  doi = {10.1049/icp.2025.2786},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11186518},
  abstract = {In this paper, we propose a Spatial-Temporal Attention-Gated Transformer (STAGFormer) for bus passenger flow forecasting. Existing methods typically use static spatial graphs and predefined temporal patterns, which may not fully represent the dynamic and heterogeneous nature of urban transit networks. In contrast, the proposed STAGFormer framework applies a GCN for local spatial feature extraction and incorporates a GRU enhanced with an attention mechanism to better capture temporal correlations. Furthermore, an integrated Transformer module is utilized to enhance the learning of intricate spatiotemporal patterns, and residual connections are incorporated to ensure dimensional consistency and mitigate overfitting. Extensive experiments on urban mobility datasets demonstrate that STAGFormer achieves superior predictive accuracy and robustness compared to state-of-the-art methods, highlighting its potential for optimizing bus passenger flow forecasting and urban transportation management.},
  publisher = {IET},
  isbn = {978-1-83724-732-5},
}

@article{historicalmutualinformationmul2025,
  author = {L. Song; P. Zeng; Y. Lai; H. Huang; B. Huang; J. Tu},
  title = {{Historical} {Mutual} {Information} {Multi-Level} {Trajectory} {Recovery} {Network} for {Recommendation}},
  journal = {2025 6th International Conference on Computers and Artificial Intelligence Technology (CAIT)},
  year = {2025},
  pages = {218--225},
  doi = {10.1109/CAIT68620.2025.11424712},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11424712},
  abstract = {Human trajectory recovery which depends on historical trajectories and discrete current trajectory points to complete missing locations, is a crucial task in human mobility prediction. Previous efforts primarily focus on enhancing the semantic richness of historical trajectory features utilizing geographic and sequential information to achieve better trajectory recovery results. However, most of these works simply combine geographic and sequential information or reflect them in loss functions without exploring the relationship and fusion strategies between these heterogeneous types of data. Influenced by recent multi-modal fusion research, the Historical Mutual Information Multi-Level Trajectory Recovery Network (HMIML) is proposed to improve the fusion efficiency of geographic and sequential information. It incorporates a Maximal Mutual Information Gate Fusion Layer and a Multi-Level Aggregation Layer. The Maximal Mutual Information layer explores the conditional independence of geographic and sequential data and employs a method to maximize the mutual information of the two contexts for information gain, followed by the use of a gating layer for fusion. The Multi-Level Aggregation Layer utilizes multiple levels to extract overall information about user trajectories, thereby uncovering general movement patterns. Experimental results demonstrate the effectiveness of our approach, confirming that efficient fusion methods can enhance the efficiency of trajectory recovery.},
  publisher = {IEEE},
  isbn = {979-8-3315-5882-6},
  keywords = {Recommendation Service;Mobile Trajectory Recovery;Spatiotemporal Mutual Information;Graph Convolutional Network;Attention Mechanism},
}

@article{artificialintelligencebaseddec2026,
  author = {B. Nune; B. Singh; Ernawati; A. Malhotra; B. Swapna; S. R. Bittla},
  title = {{Artificial} {Intelligence-Based} {Decision} {Support} {Systems} for {Enhanced} {Public} {Health} {Policy} and {Crisis} {Management}},
  journal = {2026 International Conference on Multidisciplinary Innovations For Smart \& Sustainable Future (MISSF)},
  year = {2026},
  pages = {1--6},
  doi = {10.1109/MISSF68264.2026.11521897},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11521897},
  abstract = {The article presents the Hierarchical Predictive Fusion Engine (HPFE) a new computational architecture that aims to optimize risk prediction of populations in large scale during changing health upheavals and intervention streaming. The system incorporates the heterogeneous streams of data, such as clinical indicators, behavioral patterns, environmental variables, mobility structures, etc., into a single dynamically adaptive architecture. The graph enhanced temporal encoder represents the dynamics of spatiotemporal propagation, and the behavior environment feedback module gives a representation of human behavior in a real world that is adapting to various changing environments. These elements input into a metaepidemic simulator that can produce multi-horizon scenario forecasts that indicate nonlinear risks development. In order to assist in grounded action decision making, an evolutionary optimization layer examines the intervention strategies against conflicting goals like maximum risk minimization, resource use and economic consequences. The framework pits in a confidence-regulated action engine that supports interpretable recommendations with quantified uncertainty thus permitting readable and reliable planning. Experimental tests indicate that HPFE does not only increase predictive robustness in noisy environment, with quickly changing situations, but also leads to the increased clarity and effectiveness of recommended response strategies. HPFE has the ability to standardize forecasting, behavioral modeling, simulation, and optimization under a common architecture to provide a revolutionary way to control high-stakes population-scale interventions in guiding and empowering capabilities in the face of large-scale disruption in the future. The suggested approach attains an overall accuracy of 93.3 percent.},
  publisher = {IEEE},
  isbn = {979-8-3315-8406-1},
  keywords = {TCN;GAT-Epi;LSTM-BF;EFE-Hybrid;HPFE},
}

@article{ecov2gjointoptimizationofevcha2026,
  author = {M. Zhang; M. Wang; F. Li; L. Wang; H. Zhang},
  title = {{ECO-V2G:} {Joint} {Optimization} of {EV} {Charging,} {Discharging,} and {Task} {Offloading} in {V2G} {Networks} {With} {Heuristic} {McCormick}},
  journal = {IEEE Transactions on Vehicular Technology},
  year = {2026},
  volume = {75},
  number = {1},
  pages = {1322--1338},
  doi = {10.1109/TVT.2025.3593892},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11105542},
  abstract = {The increasing number of electric vehicles (EVs), along with advances in battery and onboard computing technologies, has enabled EVs to gradually serve as energy carriers and computational nodes in urban vehicular networks. However, factors such as dynamic pricing in energy markets and uneven demand distribution have led to spatiotemporal fluctuations in charging station loads and electricity prices, posing new challenges for the efficient management of EV charging/discharging and routing in urban environments. To address these challenges, we propose a unified framework called ECO-V2G, in which charging stations are enhanced with both energy trading and edge computing capabilities, forming an integrated edge charging station (ECS) network. Within this framework, we first design a bidirectional spatiotemporal graph transformer to accurately predict the real-time load and electricity prices of ECSs. The predictions are then incorporated into a mixed-integer nonlinear programming (MINLP) problem that jointly optimizes EV routing, charging/discharging, and task offloading decisions, which is efficiently solved on a state transition network using a McCormick-based heuristic algorithm. Finally, we conduct extensive simulations to validate the effectiveness of the proposed ECO-V2G framework. Experimental results show that it reduces EV user travel costs by up to 39.41% compared to state-of-the-art baselines, highlighting its effectiveness in complex urban scenarios.},
  publisher = {IEEE},
  issn = {1939-9359},
  keywords = {Edge computing;electric vehicle (EV);computation offloading;energy trading;path selection},
}

@article{passengerflowestimationforurba2026,
  author = {T. Mimura; R. Yamada},
  title = {{Passenger} {Flow} {Estimation} for {Urban} {Rail:} {Meta-Learning} {Approach} with {Mobile} {Network} {Data}},
  journal = {2026 IEEE International Conference on Pervasive Computing and Communications Workshops and other Affiliated Events (PerCom Workshops)},
  year = {2026},
  pages = {1--7},
  doi = {10.1109/PerComWorkshops68308.2026.11585473},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11585473},
  abstract = {Accurate estimation of station-to-station passenger flows in urban rail networks is essential for operations, planning, and congestion management. Mobile network data offer a scalable and privacy-preserving alternative to ticketing or sensor data, but base-station logs are noisy, incomplete, and misaligned with railway infrastructure, leading to sparse coverage, missing logs, and "cold-start" lines with little historical data. We tackle these issues with a two-stage framework based on anonymized mobile network statistics. First, a rule-based system built on Mobile Spatial Statistics infers hourly passenger flows on station-to-station edges, and a macroscopic analysis on the Osaka Metro network shows that it reproduces realistic spatial and temporal demand patterns. Second, we refine and impute these estimates using an Attentive Neural Process (ANP) that treats OD estimation as a meta-learning problem over spatiotemporal episodes, conditioning on context edgeâtime pairs and predicting flows for target pairs via attention over edge-level features, without explicit graph message passing. Experiments on Osaka Metro under three scenariosârandom splits, held-out lines (cold-start), and held-out edges (coverage gaps)âshow that ANP consistently outperforms k-nearest neighbors, a multilayer perceptron, and a graph neural network, reducing RMSE by more than 60% in the held-out line setting and enabling robust, transferable passenger flow estimation under severe data sparsity.},
  publisher = {IEEE},
  isbn = {979-8-3315-7615-8},
  issn = {2766-8576},
  keywords = {location data;rail advertising;mobile network analytics;passenger flow estimation;privacy preservation;urban computing},
}

@article{multimodalgraphbasedreinforcem2025,
  author = {M. R. Mohebbi; E. Kafash; M. DÃ¶ller},
  title = {{Multimodal} {Graph-Based} {Reinforcement} {Learning} for {Multi-Agent} {Autonomous} {Navigation}},
  journal = {2025 IEEE 37th International Conference on Tools with Artificial Intelligence (ICTAI)},
  year = {2025},
  pages = {299--304},
  doi = {10.1109/ICTAI66417.2025.00046},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11272784},
  abstract = {Accurate prediction of multi-agent behavior in dense and dynamic environments remains a central challenge for autonomous systems, with applications in robotic navigation, traffic management, and human-robot interaction. Conventional approaches often fail to model both the spatial interdependencies among agents and the long-term temporal patterns required for reliable trajectory prediction. To address this limitation, a multimodal framework is proposed that integrates Graph Neural Networks (GNNs), Long Short-Term Memory (LSTM) networks, and Inverse Reinforcement Learning (IRL). Spatial dependencies are represented through GNN layers, temporal dynamics are encoded by LSTMs, and reward functions are inferred from demonstrations via IRL. Multimodal fusion between trajectory histories and aerial imagery is further introduced to enhance environmental awareness. The framework is evaluated on the Stanford Drone Dataset (SDD) and SUMO simulations, where higher accuracy, robustness, and safety are observed relative to established baselines, including LSTM, Social-LSTM, and representative spatio-temporal models. A deployment-oriented analysis covering computational efficiency, robustness to noise/occlusion, and safety metrics (collision rate and time-to-collision) is also provided, underscoring the practicality of the approach for real-world navigation.},
  publisher = {IEEE},
  isbn = {979-8-3315-4919-0},
  issn = {2375-0197},
  keywords = {Multi-Agent Systems;Reinforcement Learning;Graph Neural Networks;Multimodal Learning;Autonomous Navigation;Spatio-Temporal Modeling},
}