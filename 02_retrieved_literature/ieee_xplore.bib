@article{stadgnaspatiotemporalattention2026,
  author = {T. Zhou; Q. Zhang; Y. Tian; X. Yang; J. Liu; G. Lin},
  title = {{STA-DGN:} {A} {Spatio-Temporal} {Attention-Enhanced} {Dynamic} {Graph} {Network} for {Predicting} {Traffic} {Flow} in {Signalized} {Intersection}},
