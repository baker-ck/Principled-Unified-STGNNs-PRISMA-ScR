@article{stieformerspatiotemporalintera2026,
  author = {S. Li; H. Jia; Y. Chen},
  title = {{STIEFormer:} {Spatio-Temporal} {Interaction} and {Cross-View} {Fusion} {Enhanced} {Transformer} for {Traffic} {Forecasting}},
