}

@article{spatiotemporalgraphlearningfor2025,
  author = {A. Jamali; M. Kabak; N. Aslshahrivar; B. Bolandparvaz; R. Hesami; H. Khayyam},
  title = {{Spatio-Temporal} {Graph} {Learning} for {Rail} {Traction} {Power} {Flow} {Prediction}},
  journal = {2025 IEEE International Conference on Energy Technologies for Future Grids (ETFG)},
  year = {2025},
  pages = {1--6},
  doi = {10.1109/ETFG61999.2025.11400956},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11400956},
  abstract = {Urban rail traction power systems experience fast-changing, high-magnitude, and nonstationary loads, which make real-time situational awareness difficult. While supervisory control and data acquisition (SCADA) systems usually provide substation measurements, such data may be unavailable, incomplete, or delayed. We propose a two-stage, topology-aware machine-learning pipeline for real-time estimation of electrical parameters at both substations and trains. In Stage 1, XGBoost maps operational and kinematic features to first-pass substation parameter estimates (voltage, current, power). In Stage 2, a spatiotemporal graph neural network (GNN) refines these estimates by encoding the railway's electrical topology, representing trains as moving nodes and substations as fixed nodes. This design captures network-wide interactions such as regenerative energy reproduction and feeder coupling, yielding accurate substation- and train-level electrical parameters at time t. To prioritize robustness under operational stress, an Operational Criticality-Weighted loss (OCW-Loss) upweights errors in low-voltage / high-current conditions. Validation of one year of operational data from a high-demand urban rail corridor shows high accuracy, with a mean substation-voltage $\mathrm\{R\}^\{\mathrm\{2\}\}$ of 0.952 across 20 substations. The method provides a practical, data-driven alternative to SCADA for substation monitoring and a basis for âwhat-ifâ operational analyses without re-engineering a physics simulator.},
  publisher = {IEEE},
  isbn = {979-8-3315-7640-0},
  keywords = {Power flow prediction;traction power systems;graph neural networks;XGBoost;Railway},
}

@article{distributedcooperativeposition2025,
  author = {Y. Cao; S. Yang; Z. Feng; P. Zhang; S. Chen},
  title = {{Distributed} {Cooperative} {Positioning} in {Mobile} {Wireless} {Networks:} {A} {GNN-Aided} {Joint} {Model-} and {Data-Driven} {Framework} {With} {High-Accuracy} {Closed-Form} {Message} {Representation}},
  journal = {IEEE Transactions on Wireless Communications},
  year = {2025},
  volume = {24},
  number = {8},
  pages = {6443--6457},
  doi = {10.1109/TWC.2025.3553136},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11124342},
  abstract = {Future mobile wireless networks will catalyze substantial demand for precise distributed cooperative positioning (DCP), especially when the global navigation satellite systems are unavailable. However, conventional message passing based DCP methods may suffer considerable performance degradation due to message approximation and sparsity/mobility of nodes. In this paper, we first present a high-accuracy parametric message approximation method, which achieves closed-form representations of all types of messages involved and reduces the computational complexity of message passing procedures. Using these representations, we propose a model- and data-driven hybrid inference approach, dubbed graph neural network enhanced spatio-temporal message passing (GNN-STMP), which fine-tunes parametric messages passed on factor graph and obtains more accurate a posteriori distribution of nodesâ positions by exploiting GNN-generated messages. Furthermore, we develop a universal framework for the parametric message passing based DCP problem, by integrating GNN-STMP with the extend Kalman filter based nodeâs state prediction and refinement. This framework significantly reduces the positioning ambiguity caused by insufficient spatial ranging measurements from neighbor nodes. Simulation results and analyses demonstrate that, compared with state-of-the-art methods, our proposed approaches achieve the best and near-best positioning accuracy when insufficient and sufficient spatial ranging measurements are available, respectively, while incurring modest computational complexity.},
  publisher = {IEEE},
  issn = {1558-2248},
  keywords = {Distributed cooperative positioning;factor graph;graph neural network (GNN);mobile wireless networks;parametric message representation},
}

@article{chromaerachromosomeinspiredmul2026,
  author = {P. Mathialagan; N. Arora; S. Nair; S. Gulati},
  title = {{CHROMA-ER:} {A} {Chromosome-Inspired} {Multi-Objective} {Algorithm} for {AI-Driven} {Emission} {Tracking} and {Pollution} {Reduction}},
