@article{multisourcetransferlearningwit2026,
  author = {X. Wen; M. Khosla; S. Hoogendoorn},
  title = {{Multi-Source} {Transfer} {Learning} {With} {Spatial-Temporal} {Graph} {Neural} {Network} for {Short-Term} {Bicycle} {Traffic} {Prediction}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2026},
  volume = {27},
  number = {2},
  pages = {1952--1968},
  doi = {10.1109/TITS.2025.3633930},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11269925},
  abstract = {Bicycle transportation, a low-carbon option, is essential for promoting sustainable urban mobility. However, predicting bicycle traffic is challenging due to limited investments in data collection, especially in smaller cities. This paper proposes a multi-source transfer learning spatial-temporal graph neural network (Multi-TLSTGCN) for accurate bicycle traffic prediction in target cities with limited available data. This study first examines how to transfer knowledge from single source domain to the target domain while mitigating the risk of negative transfer. Following this, a multi-source adaptive transfer learning approach is developed to optimize traffic prediction in the target domain by adaptively integrating knowledge from multiple sources. Finally, the performance of the Multi-TLSTGCN model is evaluated under various levels of target data scarcity and compared with models that do not incorporate source domain knowledge. The experimental results demonstrate several key insights: 1) Models fine-tuned with a single-cluster pre-trained source model where the clusters are formed based on similar traffic patterns are more effective at minimizing negative knowledge transfer than those fine-tuned with single-city pre-trained source models. 2) The proposed Multi-TLSTGCN outperforms baseline models in bicycle traffic prediction, showing promise for accurate predictions in data-scarce environments; and 3) The Multi-TLSTGCN model remains robust across varying levels of data scarcity, exhibiting only a slight decrease in accuracy as the availability of target data decreases, in contrast to models relying solely on target domain data. These findings highlight the Multi-TLSTGCN model as an effective and promising solution for bicycle traffic prediction with limited data availability.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Bicycle traffic;transfer learning;traffic prediction},
}

@article{spatiotemporalembeddingandmemo2025,
  author = {P. Chen; L. Liu},
  title = {{Spatio-Temporal} {Embedding} and {Memory} {Learning} {Network} for {Traffic} {Forecasting}},
  journal = {2025 5th International Conference on Neural Networks, Information and Communication Engineering (NNICE)},
  year = {2025},
  pages = {1922--1926},
  doi = {10.1109/NNICE64954.2025.11064726},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11064726},
  abstract = {Traffic forecasting is a critical task for improving urban traffic management, but it faces the challenges of learning complex spatio-temporal dependencies and non-stationarity caused by unexpected events. To address these issues, we propose a spatio-temporal embedding and memory learning network (STEM-Net) for traffic forecasting. Specifically, a spatio-temporal embedding layer is first designed to achieve the spatio-temporal adaptive embeddings, and a masking strategy is used to enhance the robustness of the model. After that, we capture the complex spatio-temporal dependencies through a spatio-temporal attention layer. Furthermore, a memory layer is devised to memorize the long-term spatio-temporal dependencies to enhance STEM-Net's predictive performance. Extensive experiments are conducted on two real-world traffic datasets, and the results show that the model has the superior performance, especially in the case of non-station-arity caused by unexpected events.},
  publisher = {IEEE},
  isbn = {979-8-3315-0796-1},
  keywords = {traffic forecasting;spatio-temporal embedding;masking;memory learning;attention mechanism},
}

@article{tgcnlitealightweighttemporalgr2026,
  author = {D. L. S; R. Rajendran; J. Joseph},
  title = {{T-GCN-Lite:} {A} {Lightweight} {Temporal} {Graph} {Convolutional} {Network} for {Traffic} {Speed} {Forecasting}},
  journal = {2026 7th International Conference on Computational Intelligence and Networks (CINE)},
  year = {2026},
  pages = {1--6},
  doi = {10.1109/CINE68769.2026.11502615},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11502615},
  abstract = {Traffic speed forecasting plays a vital role in intelligent transportation systems and smart city development. However, traditional deep learning approaches such as Graph Convolutional Networks (GCNs) and Recurrent Neural Networks (RNNs) often incur high computational costs and suffer from over-parameterization, limiting their deployment in real-time applications. To address these challenges, this paper proposes T-GCN-lite, a lightweight hybrid architecture that integrates temporal convolutional layers with graph convolutional layers to effectively capture both temporal and spatial dependencies in traffic networks. The proposed model reduces computational complexity while maintaining high predictive accuracy. Experiments conducted on the METR-LA dataset demonstrate that T-GCN-lite achieves a Mean Absolute Error (MAE) of $2.35 ~\text\{km\} / \mathrm\{h\}$ and a Root Mean Square Error (RMSE) of $2.62 ~\text\{km\} / \mathrm\{h\}$, outperforming traditional baselines with significantly lower resource requirements. These results highlight the potential of T-GCN-lite for efficient, scalable, and real-time traffic speed forecasting in intelligent transportation systems.},
  publisher = {IEEE},
  isbn = {979-8-3315-6346-2},
  keywords = {Traffic Forecasting;Graph Neural Network;Spatio-temporal Modeling;Deep Learning;Intelligent Transportation Systems},
}

@article{abasestationsleepingstrategyfo2026,
  author = {M. Yang; D. Zhai; R. Zhang; L. Liu; Z. Liu; D. Niyato},
  title = {{A} {Base} {Station} {Sleeping} {Strategy} for {Large-Scale} {Scenarios} {With} {Multi-Time-Window} {SpatioâTemporal} {Graph} {Convolutional} {Network}},
  journal = {IEEE Transactions on Communications},
  year = {2026},
  volume = {74},
  pages = {3704--3719},
  doi = {10.1109/TCOMM.2026.3655779},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11358934},
  abstract = {The explosive growth of mobile data traffic has prompted operators to deploy a large number of base stations (BSs). However, due to the uneven traffic distribution, many BSs remain underutilized or idle during off-peak periods while still consuming substantial amounts of energy. To tackle this issue, we propose a Proactive Optimization-based (PO-based) BS sleeping strategy for large scale scenarios with hundreds of BSs. Specifically, by analyzing the Autocorrelation Function (ACF) of BS traffic in real-world scenarios, we identify multiple potential periods. Guided by this insight, we introduce multi-time-window mechanism and Graph Convolutional Network (GCN), designing Multi-Time-Window Spatio-Temporal Graph Convolutional Network (MTSGCN) to effectively capture the complex spatio-temporal dependencies present large-scale settings. The forecasted results acquired by MTSGCN serve as inputs to a multiple-BSs cooperative sleeping problem with the objective to minimize the total energy consumption. To tackle this huge problem efficiently, we first use K-means++ to divide the large region into several small cooperative clusters and then adopt the Integral Linear Programming (ILP) algorithm to solve each subproblem. Experimental results demonstrate that MTSGCN reduce the forecasting error by 10.9% compared with the state-of-the-art methods. Furthermore, the proposed MTSGCN-ILP algorithm achieves over 20% energy savings gains compared to the other typical strategies.},
  publisher = {IEEE},
  issn = {1558-0857},
  keywords = {Base station sleeping strategy;base station traffic forecast;multi-time-window spatio-temporal graph convolutional network;integer linear programming},
}

@article{traveltimeandweatherawaretraff2025,
  author = {M. Patil; Q. Ahmed; S. Midlam-Mohler},
  title = {{Travel} {Time} and {Weather-Aware} {Traffic} {Forecasting} in a {Conformal} {Graph} {Neural} {Network} {Framework}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2025},
  volume = {26},
  number = {12},
  pages = {21734--21744},
  doi = {10.1109/TITS.2025.3611267},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11176836},
  abstract = {Traffic flow forecasting is essential for managing congestion, improving safety, and optimizing various transportation systems. However, it remains a prevailing challenge due to the stochastic nature of urban traffic and environmental factors. Better predictions require models capable of accommodating the traffic variability influenced by multiple dynamic and complex interdependent factors. In this work, we propose a Graph Neural Network (GNN) framework to address the stochasticity by leveraging adaptive adjacency matrices using log-normal distributions and Coefficient of Variation (CV) values to reflect real-world travel time variability. Additionally, weather factors such as temperature, wind speed, and precipitation adjust edge weights and enable GNN to capture evolving spatio-temporal dependencies across traffic stations. This enhancement over the static adjacency matrix allows the model to adapt effectively to traffic stochasticity and changing environmental conditions. Furthermore, we utilize the Adaptive Conformal Prediction (ACP) framework to provide reliable uncertainty quantification, achieving target coverage while maintaining acceptable prediction intervals. Experimental results demonstrate that the proposed model, in comparison with baseline methods, showed better prediction accuracy and uncertainty bounds. We, then, validate this method by constructing traffic scenarios in SUMO and applying Monte-Carlo simulation to derive a travel time distribution for a Vehicle Under Test (VUT) to reflect real-world variability. The simulated mean travel time of the VUT falls within the intervals defined by INRIX historical data, verifying the modelâs robustness.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Traffic flow prediction;adaptive adjacency matrices;graph neural network;uncertainty quantification},
}

@article{dynamicspatiotemporalgraphconv2026,
  author = {W. Lin; Z. Zhang; R. Wang; G. Ren; Y. Zhao; J. Song; Q. Cao},
  title = {{Dynamic} {Spatiotemporal} {Graph} {Convolutional} {Neural} {Network} {Based} on {Congestion} {Propagation} for {Traffic} {Prediction}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2026},
  volume = {27},
  number = {1},
  pages = {1079--1092},
  doi = {10.1109/TITS.2025.3628554},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11241123},
  abstract = {Accurate traffic prediction is crucial for the management of intelligent transportation systems. Recently, researchers have developed spatiotemporal graph neural networks (ST-GNNs), achieving significant progress in performance. However, most ST-GNNs construct the graph adjacency matrix using predefined rules or trainable parameters, without fully leveraging the congestion relationships within traffic flows to guide graph structure learning. Addressing this issue, we propose a dynamic spatiotemporal graph convolutional network (DSTGCN), which adequately considers the impact of traffic congestion on traffic prediction. Firstly, based on the fundamental traffic flow graph model and congestion propagation path algorithm, a congestion propagation matrix among road nodes is constructed. Then, the real-time congestion propagation matrix is fused with the static road adjacency matrix to establish a time-varying dynamic graph neural network structure, enabling dynamic capture of traffic state changes. Finally, complex spatiotemporal correlations are captured through a specially designed spatiotemporal convolutional architecture for multi-horizon traffic prediction. Extensive experiments conducted on real-world datasets demonstrate the effectiveness and interpretability of our approach.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Traffic prediction;dynamic spatiotemporal graph convolutional neural network;congestion propagation;graph structure learning},
}

@article{selectivestatefocusedgraphatte2026,
  author = {S. Vashistha; N. Kumar},
  title = {{Selective} {State-Focused} {Graph} {Attention} {Networks} for {Multihorizon} {Traffic} {Forecasting}},
  journal = {IEEE Transactions on Computational Social Systems},
  year = {2026},
  volume = {13},
  number = {2},
  pages = {2030--2046},
  doi = {10.1109/TCSS.2025.3605930},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11208846},
  abstract = {Traffic forecasting plays an important role in minimizing travel delays and enhancing road safety by using historical and real-time data to predict future traffic conditions. However, current state-of-the-art methods using graph representational learning fail to model localized complex and dynamic spatioâtemporal relationships. Also, they struggle with segmenting long, context-aware traffic sequences, which are crucial for accurate forecasting. To address these issues, this work presents a novel selective state-focused graph attention network (SSGN) for traffic forecasting. SSGN utilizes a diagonally masked multihead adaptive graph attention that allows it to attend to relevant neighboring traffic nodes and analyze complex traffic patterns dynamically. Additionally, the selective state space layer is designed and integrated to model long context-aware traffic sequences to effectively capture both short and long-term sequences in traffic data. The effectiveness of SSGN is demonstrated using the simulation of urban mobility (SUMO) simulator and popular real-world benchmark datasets, namely PEMS03, PEMS04, PEMS07, and PEMS08. As a result, SSGN improved forecasting accuracy by $\sim$8% and $\sim$6% for short and long-term traffic forecasting, respectively, in comparison to other state-of-the-art methods.},
  publisher = {IEEE},
  issn = {2329-924X},
  keywords = {Autonomous driving;graphs neural networks (GNNs);multihead attention;selective state spaces;traffic forecasting},
}

@article{aspatiotemporaltransferlearnin2025,
  author = {R. Geetha; R. S. Rubeshkanna; A. Yoganathan; P. Anitha; P. Kalyanasundaram; J. K. Kanimozli},
  title = {{A} {Spatiotemporal} {Transfer} {Learning} {Frameworks} with {Mixture} of {Experts} for {Traffic} {Flow} {Predictions}},
  journal = {2025 4th International Conference on Innovative Mechanisms for Industry Applications (ICIMIA)},
  year = {2025},
  pages = {828--832},
  doi = {10.1109/ICIMIA67127.2025.11200920},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11200920},
  abstract = {The aim of the present work of is to evaluate the improvement flow predictions over the Louvain algorithm using a spatiotemporal transfer learning framework with a mix of experts. Materials and Methods: For this investigation, two approaches were assessed: Group 1 trained on temporal traffic data from 30 urban locations using a spatiotemporal transfer learning framework. Temporal dependencies were captured by long short-term memory (LSTM) networks, while spatial correlations were modeled by graph convolutional networks (GCNs). Group 2 used the Louvain algorithm to identify community structures and estimate traffic flow. A 95% confidence interval was employed for statistical analysis, and evaluation metrics included prediction accuracy, robustness, and computational efficiency. Result: With a prediction accuracy range of 85.0% to 94.5%, Group 1 (STTL-MoE model) outperformed Group 2 (Louvain algorithm), which had an accuracy range of 82.5% to 90.0%. Group 2's MAE varied from 12.5 to 18.7 units, whereas Group 1's ranged from 8.4 to 12.6 units. The RMSEs of Group 1 and Group 2 varied from 15.2 to 22.0 units and 20.3 to 26.5 units, respectively. A t-test revealed a significant difference in performance with a p-value < 0.005. Conclusion: The spatiotemporal transfer learning framework with a mix of experts outperforms the Louvain algorithm in terms of prediction accuracy, computational efficiency, and adaptability, offering benefits for real-time traffic management and urban mobility.},
  publisher = {IEEE},
  isbn = {979-8-3315-5386-9},
  keywords = {Traffic Flow Prediction;Spatiotemporal Transfer Learning;Mixture of Experts;Louvain Algorithm;Prediction;weather},
}

@article{enhancedtrafficpredictionusing2026,
  author = {A. Kumar; A. Sinha; Y. P. Singh},
  title = {{Enhanced} {Traffic} {Prediction} {Using} {SpatialâTemporal} {Graph} {Neural} {Networks}},
  journal = {IEEE Access},
  year = {2026},
  volume = {14},
  pages = {107120--107129},
  doi = {10.1109/ACCESS.2026.3708996},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11592369},
  abstract = {The ability to forecast traffic conditions in urban environments is essential for intelligent transport systems because it provides proactive congestion management, traffic control and informed urban mobility planning. However, due to the extreme spatial and temporal volatility of traffic flow patterns, conventional statistical, machine learning, and sequence-based deep learning approaches either fail to account for the spatial relationships between highway segments or fail to sufficiently model long-range temporal dynamics. To address these gaps, the present study uses a Spatial-Temporal Graph Neural Network (STGNN) framework that can learn a combination of spatial and temporal relationships in road networks and changing time-varying patterns in traffic flow. The model has a graph-based architecture where graph-convolutional layers are combined with gated recurrent units and transformer-based attention units, thus creating a hybrid architecture that is capable of multi-scale spatio-temporal dependencies. The METR-LA dataset was used in experiments, and it was observed that STGNN had smaller Mean Absolute Percentage Error(MAPE), Mean Absolute Error(MAE), and Root Mean Squared Error(RMSE) at 15, 30, and 60 minute horizons of prediction than the baseline and the implemented models: Sequence to Sequence (Seq2Seq) and Temporal Graph Convolutional Network (T-GCN). The model achieved the best results for the 15-minute interval with an MAE of 2.71, an RMSE of 5.17, and a MAPE of 7.08. The results imply that adaptive spatial learning, together with the temporal sequence modeling, can produce much better forecasting stability, which underlines the potential STGNN-based traffic prediction systems have to contribute to real-time traffic control.},
  publisher = {IEEE},
  issn = {2169-3536},
  keywords = {Time series analysis;traffic forecasting;spatial-temporal graph neural network;deep learning;METR-LA dataset},
}

@article{mtdastgcnmoderntemporalanddual2025,
  author = {Y. Kuang; S. Yuan; X. Zou; J. Zhang; Z. Shi; Y. Zhang; F. Meng; Z. Wang},
  title = {{MTDA-STGCN:} {Modern} {Temporal} and {Dual-Attention-Based} {Spatiotemporal} {Graph} {Convolutional} {Network} for {4D} {Trajectory} {Prediction}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2025},
  volume = {26},
  number = {12},
  pages = {21809--21823},
  doi = {10.1109/TITS.2025.3605670},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11159095},
  abstract = {Four-dimensional (4D) trajectory prediction plays a critical role in modern air traffic management, enabling applications such as conflict detection, anomaly monitoring, and congestion mitigation. However, existing methods have limited information sources when modeling potential spatial correlations between aircraft in complex airspace scenarios, and their final trajectory inference ability is weak, resulting in lower prediction accuracy. Faced with these challenges, we propose Modern Temporal and Dual Attention based Spatiotemporal Graph Convolutional Network (MTDA-STGCN), which employs a self-attention mechanism to reconstruct the adjacency matrix to enhance the ability of capturing global node correlations. This adjacency matrix reconstructed with the self-attention mechanism is dynamically optimized throughout the training process of network, offering a more nuanced reflection of the inter-node relationships compared to traditional algorithms. Subsequently, our model uses graph attention to extract additional global features for modeling accuracy interactions between aircraft. Finally, the output is input into the Modern Temporal Prediction Network (MTPN) to obtain the predicted trajectory probability distribution. The experiments on real-world ADS-B datasets demonstrate that MTDA-STGCN outperforms existing 4D trajectory prediction algorithms on all datasets. The proposed dual-attention framework significantly enhances the capture of node spatial correlations, while the MTPN module effectively improves the accuracy of the predicted results.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {4D trajectory prediction;spatiotemporal graph convolutional network;self-attention mechanism;time series prediction},
}

@article{dbstagcnadualbranchspatialtemp2025,
  author = {Z. Yang; Z. Wu; F. Ji; L. Du; X. Hu; Y. Zheng},
  title = {{DB-STAGCN:} {A} {Dual-Branch} {Spatial-Temporal} {Attention} {Graph} {Convolutional} {Network} for {Traffic} {Flow} {Prediction}},
  journal = {2025 International Joint Conference on Neural Networks (IJCNN)},
  year = {2025},
  pages = {1--9},
  doi = {10.1109/IJCNN64981.2025.11228959},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11228959},
  abstract = {Traffic flow prediction is a typical spatiotemporal forecasting problem, characterized by complex dynamic relationships within traffic data. Traditional graph convolutional methods depend on predefined static graph structures, which can limit the model's ability to capture spatial dependencies due to issues like over-smoothing. Additionally, dimensionality reduction techniques may hinder feature dependency learning. To overcome these challenges, we propose a novel dual-branch spatiotemporal attention graph convolution network (DB-STAGCN). This model introduces an adaptive graph structure learner, which dynamically adjusts the static graph based on evolving traffic correlations. Furthermore, a new GNN architecture is designed that employs spatial and channel attention modules to simultaneously extract temporal and spatial features. The proposed DB-STAGCN model achieves superior performance on four public traffic datasets, outperforming baseline models in terms of accuracy and efficiency. Our results demonstrate that DB-STAGCN provides an effective solution for modeling spatiotemporal dependencies in traffic flow prediction.},
  publisher = {IEEE},
  isbn = {979-8-3315-1042-8},
  issn = {2161-4407},
  keywords = {Traffic Flow Prediction;Graph Convolutional Network;Spatial-Temporal Attention;Adaptive Graph Structure Learner},
}

@article{anovelattentionbaseddynamicmul2025,
  author = {C. Diao; D. Zhang; W. Liang; M. Jiang; K. Li},
  title = {{A} {Novel} {Attention-Based} {Dynamic} {Multi-Graph} {Spatial-Temporal} {Graph} {Neural} {Network} {Model} for {Traffic} {Prediction}},
  journal = {IEEE Transactions on Emerging Topics in Computational Intelligence},
  year = {2025},
  volume = {9},
  number = {2},
  pages = {1910--1923},
  doi = {10.1109/TETCI.2024.3462513},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10716245},
  abstract = {Traffic flow prediction is a non-negligible part of intelligent transportation and mobility. Unfortunately, the unique non-linearity and complex spatial-ST-correlation of transport flow data suggest considerable challenges in prediction. The dynamic interaction of multiple spatial relations greatly influences traffic flow prediction. However, the existing spatial-temporal prediction algorithms are based on graph convolution to capture global or heterogeneous relationships, and simpler graph convolution models cannot accurately capture complex dynamic spatial relationships. To address the issues as mentioned above, this study proposes an attention-based multi-graph dynamic spatial-temporal prediction model ADMSTGCN to capture a variety of dynamic interaction relationships in traffic flow. First, we use a distance graph to explore the relationships between adjacent distances and use a semantic graph to mine spatial relationships between nodes that are far apart but have similar relationships, then fuse these two graphs to obtain a fusion graph with multiple spatial interaction relationships. The correlations between different neighbors are then further learned through a dynamic multi-graph spatial-temporal learning module that aggregates the features of different neighbors through gated graph convolution and attention mechanisms to capture various dynamic and complex spatial-temporal interactions. Experimental evaluations show that the framework proposed outperforms existing methods with better results in the analysis performed with publicly available datasets and also demonstrates the importance of capturing multiple interactions of spatial-temporal relationships.},
  publisher = {IEEE},
  issn = {2471-285X},
  keywords = {Graph conventional network;attention mechanism;multi-graph;spatial-temporal system;traffic prediction},
}

@article{lightweightcalibstgcnforpersen2026,
  author = {D. Solanki; M. Shreyan Mehta; S. A. Mehta},
  title = {{Light} {Weight} {Calib-STGCN} for {Per-Sensor} {Traffic} {Forecasting}},
  journal = {2026 7th International Conference on Inventive Research in Computing Applications (ICIRCA)},
  year = {2026},
  pages = {563--568},
  doi = {10.1109/ICIRCA69024.2026.11570402},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11570402},
  abstract = {Timely and accurate traffic forecasting is critical for todayâs expanding urban development. Traffic flow is highly nonlinear and has complex spatiotemporal dependencies. While various approaches address spatial heterogeneity in traffic forecasting, simple post-training calibration techniques from sensor networks remain underutilized. This research proposes Calib-STGCN, a Spatio-Temporal Graph Convolutional Network (STGCN) framework enhanced with a per-sensor calibration technique using TensorFlow and Keras. Instead of treating all sensors uniformly, this work introduces a lightweight calibration mechanism that learns individual linear correction for each sensor on validation data and applies them as post training adjustments. The methodology preserves the efficiency of the original STGCN architecture while significantly improving prediction accuracy by accounting for location specific biases. Experiments on six real world datasets (PEMS03, PEMS04, PEMS07, PEMS08, PEMS-BAY, METR LA) demonstrated that the Calib-STGCN improves baseline STGCN performance by achieving average improvements of 9.48% in MAE, 3.58% in MAPE, 6.73% RMSE and 1.58% R2. These improvements are achieved with minimal overhead, adding only 2n parameters for n sensors, making the approach highly practical for large-scale traffic networks},
  publisher = {IEEE},
  isbn = {979-8-3315-5940-3},
  keywords = {Traffic Forecasting;Spatio-Temporal Graph Convolutional Network;Per-Sensor Calibration;Intelligent Transportation Systems;Graph Neural Networks Introduction},
}

@article{adaptivespatialtemporalmodelin2026,
  author = {G. Chu; F. Ma; T. Yu; F. Li; M. Hui},
  title = {{Adaptive} {Spatial-Temporal} {Modeling} with frequency-decoupled {Graph} {Transformer} for {Traffic} {Forecasting}},
  journal = {2026 International Conference on Robotics, Automation and Intelligent Transportation Systems (RAITS)},
  year = {2026},
  pages = {1--5},
  doi = {10.1109/RAITS68656.2026.11580242},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11580242},
  abstract = {Accurate traffic flow forecasting is fundamental to intelligent transportation systems, yet remains challenging due to complex and dynamic spatio-temporal dependencies in road networks. Current methods often use static graphs or model temporal patterns at a single frequency, failing to capture both lengthy period stability correlations and short period dynamic interactions. Here, we propose ASTGformer, an adaptive spatio-temporal graph transformer that integrates two novel modules: a Sparse Dynamic Adaptive Graph Convolution(SDAGCN), which models persistent topology and time-varying spatial relationships via adaptive and dynamic adjacency matr-ices with learnable sparsification, and a Frequency Decoupled Temporal Attention module(FDTAm), which separates low-frequency trends from high-frequency fluctuations via Fourier transform and models them separately to mitigate over-smoothing. Evaluated on real-world highway datasets, ASTGformer outperforms existing baselines, reducing the mean absolute percentage error by 9.7% on PeMS03. Our framework provides an effective and scalable approach for spatio-temporal traffic forecasting.},
  publisher = {IEEE},
  isbn = {979-8-3315-5807-9},
  keywords = {traffic forecasting;deep learning;frequencydecoupled;attention},
}

@article{stfdgcnspatialtemporalfusionti2025,
  author = {K. Guo; G. Duan; J. Ma; J. Fu},
  title = {{STFDGCN:} {SpatialâTemporal} {Fusion} {Time} {Delayed} {Simulation} {Graph} {Convolutional} {Network} for {Traffic} {Flow} {Forecasting}},
  journal = {IEEE Access},
  year = {2025},
  volume = {13},
  pages = {67808--67820},
  doi = {10.1109/ACCESS.2025.3559662},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10962135},
  abstract = {Accurate prediction of traffic flow is fundamental to building intelligent transportation systems. However, most existing research methods fail to fully account for the potential spatiotemporal correlations, heterogeneity, and time delays present in traffic flow data. In addressing these concerns, this work introduces a novel Spatio-Temporal Fusion Delay Graph Convolutional Network (STFDGCN) model. The STFDGCN model features a Spatio-Temporal Delay Graph Convolution Module (STDGCM) that simulates time delays in traffic flow through displacement operations following local graph convolutions, and captures spatiotemporal heterogeneity by employing multiple STDGCMs. The inclusion of a self-attention mechanism allows the model to effectively capture global spatiotemporal correlations. Additionally, the model incorporates an Information Fusion Module (IFM) that integrates local information with global information captured by the self-attention mechanism, offering a more comprehensive analysis. Finally, the modelâs comprehensive capability is further improved by stacking multiple STFDGCL layers. Extensive tests on three real-world datasets validate the usefulness of the proposed STFDGCN model by demonstrating its superior prediction accuracy compared to other baselines, highlighting the modelâs robustness and its potential to enhance traffic flow forecasting in various practical scenarios.},
  publisher = {IEEE},
  issn = {2169-3536},
  keywords = {Deep learning;traffic forecast;graph convolution;information fusion;time-delay simulation},
}

@article{dynamicmultitaskspatiotemporal2025,
  author = {K. M. Monica; M. H. N; Z. Alkhafajy; R. Kuppan; S. P. C},
  title = {{Dynamic} {Multi-Task} {Spatio-Temporal} {Gated} {Graph} {Attention} {Network} for {Comprehensive} {Traffic} {Forecasting}},
  journal = {2025 International Conference on Intelligent Communication Networks and Computational Techniques (ICICNCT)},
  year = {2025},
  pages = {1--7},
  doi = {10.1109/ICICNCT66124.2025.11232974},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11232974},
  abstract = {In recent years, systems of intelligent transportation have increasingly relied on advanced machine learning and deep learning models for accurate traffic forecasting, which is critical for urban mobility, and smart city development. Traditional work on Spatio-Temporal Gated Graph Attention Networks (STGGAN) has shown promising results. However, model faces challenges due to its dependence on a static graph structure, which cannot adapt to dynamic traffic variations, and its single-task focus on speed prediction. Therefore, a Dynamic Multi-Task Spatio-Temporal Gated Graph Attention Network (DM-STGGAN) is proposed. Initially, traffic datasets like California Performance Measurement System District 4 (PeMSD4) and PeMSD8 are preprocessed by cleaning missing values and deriving indicators of key traffic including flow, density, and average speed. Further, a Dynamic Graph Learner adaptively updates adjacency matrices using both road topology and real-time traffic correlations followed by node and edge feature representation. Then, temporal dependencies are captured using Gated Recurrent Units (GRUs), while edge-aware multihead attention with a gated mechanism models complex spatial dependencies. Furthermore, a multi-task output layer jointly predicts speed, flow, and density for comprehensive forecasting. Experimental results demonstrate that proposed DM-STGGAN achieves lower root mean square error (2.7 speed), mean absolute error (1.6 speed) and higher accuracy (98.4 %) respectively.},
