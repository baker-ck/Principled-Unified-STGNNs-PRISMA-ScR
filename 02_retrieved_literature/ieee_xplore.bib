  abstract = {The Automated Material Handling System (AMHS) is a crucial component of a 12-inch semiconductor wafer fabrication system. AMHS congestion is the primary factor restricting its production efficiency. Predicting the traffic flow in various areas of the AMHS can help anticipate congestion, which plays a significant role in optimizing the overhead hoist transport (OHT) route planning and improving transportation efficiency. In this paper, a traffic flow prediction method integrating of Transformer and Graph Convolutional Network (ITGCN) for AMHS is proposed. In the encoder and decoder layers of ITGCN, the temporal-aware multi-head attention layer captures the local trends of traffic flow data to effectively model the temporal dynamic features. In addition, the graph convolutional network module is embedded to model the spatial correlation among nodes based on the fixed topology of the guideway network. Experimental verification is carried out based on simulation data and real data. The results show that the ITGCN method is effective.},
  publisher = {IEEE},
  isbn = {979-8-3315-0381-9},
  keywords = {AMHS;deep learning;attention mechanisms;graph convolutional networks;traffic flow prediction},
}

@article{towardhighaccuracyandlowlatenc2025,
  author = {Z. Zhang; X. Huang; R. Yu; M. Wu; J. Kang; S. Xie},
