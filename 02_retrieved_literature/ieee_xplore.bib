  doi = {10.1109/CCDC69976.2026.11560347},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11560347},
  abstract = {Accurately predicting traffic flow in the near-signal zone to improve traffic efficiency at signalized intersections is a critical component of intelligent transportation system development. To address the limitations of conventional approaches in capturing the complex spatio-temporal dynamics of traffic flow and the spatial heterogeneity inherent in nearsignal areas, this paper proposes STA-DGN (Spatio-Temporal Attention-Enhanced Dynamic Graph Network), a novel deep learning framework. The proposed model integrates two key components-AttentionFusion and EnhancedDGCN-to enable adaptive fusion of spatio-temporal features and dynamic graph structure learning. Specifically, the AttentionFusion module adaptively weights temporal and spatial features through attention mechanisms, thereby enhancing sensitivity to evolving traffic patterns; meanwhile, the EnhancedDGCN module dynamically refines the graph topology during training, overcoming the rigidity of static adjacency matrices and improving the representation of spatial dependencies. Experimental results on the Argoverse 2 dataset (Pittsburgh area) demonstrate that STADGN significantly outperforms baseline models in both prediction accuracy and robustness. These findings underscore its potential as an effective intelligent solution for signal timing optimization and urban traffic management.},
