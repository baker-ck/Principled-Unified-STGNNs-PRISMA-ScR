@article{minerafresidualawaremultimodal2026,
  author = {X. Chen; B. Zhou; J. Wu; H. Li; Z. Tang},
  title = {{MineRAF:} {Residual-Aware} {Multimodal} {Trajectory} {Prediction} with {Attention-based} {Fusion} in {Mining} {Environments}},
