  abstract = {Real-time traffic signal control in Intelligent Transportation Systems (ITS) requires millisecond-level prediction latency, yet state-of-the-art deep learning models incur prohibitive computational costs on resource-constrained edge devices. To address this challenge, this paper proposes a Hardware-Aware Evolutionary Boosting Framework that integrates a spatio-temporal feature mining strategy with a Particle Swarm Optimizer (PSO) for lightweight inference. The framework explicitly optimizes tree structures and hyperparameters under strict edge hardware constraints while capturing complex spatio-temporal dependencies via rule-based meta-knowledge extraction. Experimental results on benchmark PEMS-BAY and METR-LA datasets show that the framework achieves an $\mathrm\{R\}^\{2\}$ score of 0.9560 and an MAE of 0.8317, statistically comparable to advanced deep learning baselines like ST-GCN and LSTM. Deployment tests on a standard x86-based edge node demonstrate an inference latency of only 0.135 ms and a compact model size of $0.159 \text\{MB\}$, reducing energy consumption by $99.8 \%$. Furthermore, the model exhibits superior fault tolerance, sustaining reliable predictions even with up to 40% missing sensor data. Ultimately, this framework achieves Pareto-optimal performance, balancing high accuracy, computational efficiency, and resilience for sustainable urban infrastructure.},
  publisher = {IEEE},
  isbn = {979-8-3315-6042-3},
  issn = {2833-2423},
  keywords = {green edge intelligence;evolutionary boosting;hardware-aware optimization;traffic flow prediction;smart city infrastructure;urban computing;XGBoost},
