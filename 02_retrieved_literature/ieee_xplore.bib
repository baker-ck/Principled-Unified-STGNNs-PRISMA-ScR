@article{embeddingenhancedmlpenablessim2025,
  author = {Z. Wang; Y. Zhang; P. Wang; X. Wang; Y. Wang},
  title = {{Embedding} {Enhanced} {MLP} {Enables} {Simple} and {Extensible} {Spatiotemporal} {Forecasting}},
