  year = {2026},
  pages = {1--6},
  doi = {10.1109/RAITS68656.2026.11580139},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11580139},
  abstract = {Accurate vehicle trajectory prediction is pivotal for the safety of autonomous mining trucks, yet it remains challenging due to the unstructured environments and weak traffic constraints inherent in open-pit mines. To address these issues, this paper proposes a multimodal trajectory prediction framework tailored for mining scenarios. We establish a vectorized tri-stream encoding architecture utilizing Graph Convolutional Networks (GCN), Long Short-Term Memory (LSTM) networks and Multilayer Perceptrons (MLP) to extract maplevel topological structures and motion-level temporal dependencies, respectively. Furthermore, an attention-based feature fusion network is designed to achieve fine-grained alignment and integration of heterogeneous information across spatiotemporal dimensions. Additionally, a residual refinement module combined with a diversity loss function is introduced, which rectifies initial trajectory deviations and effectively mitigates mode collapse in multimodal prediction. Experimental results on real-world mining datasets demonstrate that the proposed method effectively handles complex interactions, exhibiting superior robustness and significantly outperforming kinematics-based baselines in prediction accuracy.},
  publisher = {IEEE},
  isbn = {979-8-3315-5807-9},
  keywords = {Autonomous driving;Multimodal trajectory prediction;Open-pit mining},
}

@article{graphdrivegraphattentiverelati2025,
  author = {A. WallyAllah; O. A. Nasr},
  title = {{GraphDrive:} {Graph-Attentive} {Relational} {Reasoning} for {Autonomous} {Driving}},
  journal = {2025 International Conference on Computer and Applications (ICCA)},
  year = {2025},
