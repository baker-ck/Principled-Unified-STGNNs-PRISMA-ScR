@article{trafficflowpredictionbasedongr2026,
  author = {Y. Qiao; Y. Chen; J. Liu},
  title = {{Traffic} {Flow} {Prediction} {Based} on {Graph} {Neural} {Networks}},
  journal = {2026 IEEE International Conference on Pattern Recognition, Machine Vision and Artificial Intelligence (PRMVAI)},
  year = {2026},
  pages = {1--10},
  doi = {10.1109/PRMVAI70103.2026.11605878},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11605878},
  abstract = {With the rapid deployment of autonomous mobile robots (AMRs) in urban scenarios, including autonomous driving vehicles, last-mile delivery robots, and intelligent service robots, accurate real-time traffic flow forecasting has become a critical enabling technology for robot safe navigation and intelligent decision-making. However, existing traffic prediction methods face three fundamental challenges that severely limit robot performance: insufficient joint modeling of complex spatio-temporal dependencies in road networks, degraded prediction accuracy in dense and irregular urban environments, and poor adaptability to sudden traffic fluctuations during peak hours. These limitations often lead to robot path planning failures, collision risks, and mission delays. To address these issues, this paper proposes a Spatio-Temporal Graph Convolutional Network with Spatio-Time Attention block (STGCN-STA) tailored for robot-centric traffic perception. The model integrates graph convolutional networks (GCN) for spatial topology modeling with long short-term memory (LSTM) networks for temporal dependency capture, and further introduces a self-attention mechanism to adaptively learn dynamic association weights between road segments, overcoming the inherent limitation of traditional STGCNs that rely on pre-defined static adjacency matrices. Extensive experiments are conducted on real-world traffic datasets collected from three high-traffic areas in Shanghai (Century Avenue, Hongqiao Railway Station, and Yanâan East Road Interchange) as well as public benchmark datasets. Results show that the proposed model outperforms baseline models including GCN, LSTM, and standard STGCN by 12.7% in MAE, 15.3% in RMSE, and 14.1% in MAPE, achieving higher prediction accuracy and robustness in complex urban road networks. This work provides a reliable software engineering solution for real-time traffic perception of autonomous mobile robots and offers technical support for the development of next-generation intelligent robot navigation systems.},
  publisher = {IEEE},
  isbn = {979-8-3315-4648-9},
  keywords = {Traffic Flow Forecasting;Spatio-Temporal Graph Convolutional Networks;Graph Neural Networks;Self-Attention Mechanism;Autonomous Mobile Robots;Robot Perception},
}

@article{akatzattentionenhanceddecompos2025,
  author = {H. Yanzan; H. Pan},
  title = {{A} {Katz-Attention} {Enhanced} {Decomposition-Fusion} {Framework} for {Robust} {Traffic} {Forecasting}},
