  doi = {10.1109/TITS.2025.3591264},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11106392},
  abstract = {Urbanization, characterized by the continuous growth of population and density in urban areas, has led to the expansion and increased complexity of transportation networks, exacerbating traffic congestion. Accurate traffic speed prediction is crucial for effective traffic network management and planning. As the complexity of real-world road networks increases, integrating spatial and temporal information for accurate traffic speed prediction has become a challenging research task. This paper proposes a novel approach by introducing a spatial-temporal graph neural network (STGNN)-based model to enhance the accuracy of traffic speed prediction. By employing an attention-based STGNN, we effectively capture the complex relationships among road segments in real-world scenarios. We utilize the Huber loss as the training objective to improve prediction accuracy. Furthermore, we present an architecture that incorporates Root Mean Square Layer Normalization into the Transformer and integrates the Spatial-Temporal Attention Wavenet (STAWnet) into the model backbone, enabling faster training while maintaining model stability. We evaluate the proposed model using five real-world traffic speed benchmark datasets. The experimental results demonstrate that our method achieves superior performance compared to state-of-the-art traffic speed prediction approaches.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Traffic speed prediction;attention-based spatial-temporal GNN;road segment;integrate spatial and temporal data},
}

@article{ontheproblemoftrafficforecasti2025,
  author = {M. Gorodnichev},
  title = {{On} the {Problem} of {Traffic} {Forecasting} {Using} {Graph} {Neural} {Networks} and {Dynamic} {Adjacency} {Matrix}},
  journal = {2025 Intelligent Technologies and Electronic Devices in Vehicle and Road Transport Complex (TIRVED)},
  year = {2025},
  pages = {1--4},
  doi = {10.1109/TIRVED67702.2025.11367199},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11367199},
  abstract = {Accurate short-term traffic flow forecasting is essential for intelligent transportation systems (ITS) and urban operations. However, most graph neural network (GNN) approaches rely on static graphs and fail to capture the timevarying dependencies that emerge during incidents, roadworks, or special events. We introduce a Dynamic Adaptive Graph Neural Network (DAGNN) that learns a time-varying adjacency at each time step from current node embeddings via an attention mechanism, enabling the graph topology to adapt to evolving traffic conditions. The architecture couples a Temporal Convolutional Network for temporal pattern extraction with adaptive graph convolutions conditioned on the learned adjacency (ChebNet as the default, GraphSAGE as an alternative). A spatio-temporal fusion module integrates temporal and spatial features, and a Transformer encoder further aggregates temporal context. DAGNN produces direct multi-step forecasts (e.g., 5, 15, 30 minutes ahead) for all sensors. Evaluated on the real-world METR-LA dataset, DAGNN achieves competitive accuracy across horizons and remains robust under distribution shifts and anomalous conditions, underscoring the value of dynamic topology learning for real-time traffic management. Code and models are released to foster reproducibility and further research.},
  publisher = {IEEE},
  isbn = {979-8-3315-6035-5},
  keywords = {Intelligent transportation systems;Traffic Flow Forecasting;Graph Neural Networks;Dynamic Graph Learning;Temporal Convolutional Networks;Spatio-Temporal Modeling},
}

@article{researchonnetworktrafficforeca2025,
  author = {Z. Lu; Z. Yang; J. You; J. Ma},
  title = {{Research} on {Network} {Traffic} {Forecasting} {Methods} {Integrating} {Graph} {Neural} {Networks} and {Deep} {Reinforcement} {Learning}},
  journal = {2025 7th International Academic Exchange Conference on Science and Technology Innovation (IAECST)},
  year = {2025},
  pages = {428--432},
  doi = {10.1109/IAECST68792.2025.11415241},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11415241},
  abstract = {Network traffic forecasting serves as a core technological foundation for network resource scheduling, congestion control, and quality of service assurance. Addressing the limitations of traditional forecasting methodsâwhich struggle to simultaneously capture the spatio-temporal correlations of traffic, resulting in insufficient prediction accuracy and weak adaptive capabilities within complex network scenariosâthis study proposes a novel network traffic forecasting approach (GNN-DRL) that integrates Graph Neural Networks (GNN) with Deep Reinforcement Learning (DRL). This approach first employs a Graph Attention Network (GAT) to uncover spatial dependencies between network topology and traffic data, while integrating a Long Short-Term Memory (LSTM) network to extract temporal evolution features of traffic. This forms a spatio-temporal feature fusion module. Subsequently, a Proximal Policy Optimisation (PPO) reinforcement learning algorithm is introduced, using prediction error and traffic fluctuation intensity as reward signals to adjust feature fusion weights and prediction parameters. Simulation experiments using the Abilene and GEANT public datasets demonstrate that the GNN-DRL method achieves reductions of 42.3%, 38.7%, and 45.1% in MAE, RMSE, and MAPE, respectively, compared to traditional ARIMA models. and 18.6%, 15.2%, and 21.4% respectively compared to a standalone GAT model. By deeply integrating spatio-temporal features, the proposed method effectively enhances the accuracy and robustness of traffic forecasting in complex network environments, offering a novel technical pathway for network resource management.},
  publisher = {IEEE},
  isbn = {979-8-3315-8024-7},
  keywords = {network traffic forecasting;graph neural networks;deep reinforcement learning;spatio-temporal feature fusion;proximal policy optimisation;adaptive forecasting},
}

@article{ontrafficpredictionwithknowled2025,
  author = {Y. Qian; T. Qiu; C. Ma; Y. Ni; L. Yuan; X. Zhou; J. Li},
  title = {{On} {Traffic} {Prediction} {With} {Knowledge-Driven} {SpatialâTemporal} {Graph} {Convolutional} {Network} {Aided} by {Selected} {Attention} {Mechanism}},
  journal = {IEEE Transactions on Machine Learning in Communications and Networking},
  year = {2025},
  volume = {3},
  pages = {369--380},
  doi = {10.1109/TMLCN.2025.3545777},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10904899},
  abstract = {Intelligent transportation systems grapple with the formidable task of precisely forecasting real-time traffic conditions, where the traffic dynamics exhibit intricacies arising from spatial and temporal dependencies. The urban road network presents a complex web of interconnected roads, where the state of traffic on one road can influence the conditions of others. Moreover, the prediction of traffic conditions necessitates the consideration of diverse temporal factors. Notably, the proximity of a time point to the present moment wields a more substantial impact on subsequent states. In this paper, we propose the knowledge-driven graph convolutional network (KGCN) aided by the gated recurrent unit with a selected attention mechanism (GSAM) to predict traffic flow. In particular, KGCN is employed to capture the correlation of the external knowledge factors for the road and the spatial dependencies, and the gated recurrent unit (GRU) is used to cope with temporal dependence. Furthermore, to improve traffic prediction accuracy, we propose the GRU combined with a selected attention mechanism with Gumble-Max to predict traffic at the temporal dimension, where a selector is chosen to dynamically assign the feature in various time intervals with different weights. Experimental results with real-life data show the proposed KGCN with GSAM can achieve high accuracy in traffic prediction. Compared to the traditional traffic prediction method, the proposed KGCN with GSAM can achieve higher efficacy and robustness when capturing global dynamic temporal dependencies, external knowledge factor correlations, and spatial correlations.},
  publisher = {IEEE},
  issn = {2831-316X},
  keywords = {Traffic forecasting;knowledge graph;graph convolutional networks;attention mechanisms;gated recurrent units},
}

@article{jointstnetjointpretrainingfors2025,
  author = {D. Cai; K. Chen; Z. Lin; D. Li; T. Zhou; M. -F. Leung},
  title = {{JointSTNet:} {Joint} {Pre-Training} for {Spatial-Temporal} {Traffic} {Forecasting}},
  journal = {IEEE Transactions on Consumer Electronics},
  year = {2025},
  volume = {71},
  number = {2},
  pages = {6239--6252},
  doi = {10.1109/TCE.2024.3476129},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10707329},
  abstract = {In recent years, there has been rapid development in autonomous vehicle techniques due to the increasing demands in traffic management and travel planning. Accurate spatiotemporal traffic forecasting is crucial for autonomous vehicles. However, most existing methods are task-specific and tailored for specific cities, making them hard to apply for more downstream applications. These methods fail to accurately simulate the common variation of traffic states at different locations based on their spatial distance and time interval. Compared with most existing spatiotemporal prediction baselines, this paper proposes a joint pre-training framework, named JointSTNet, to further enhance the traffic spatiotemporal prediction accuracy while reducing model complexity for traffic forecasting tasks. Firstly, unlike treating traffic spatiotemporal data on roads as independent patterns, the spatial graph capsule module constructs inter-class traffic patterns based on shared dynamics within the dynamic graph structure. Additionally, the temporal encoding gated module proposed in our work expands the temporal receptive field along the time axis. Finally, we maximize reconstruction losses to handle incomplete connections within data involving intra-cluster and inter-cluster regional semantic relationships that can be enhanced through pre-training. Experimental results on four benchmarking datasets from the real world demonstrate that JointSTNet outperforms various types of state-of-the-art baselines.},
  publisher = {IEEE},
  issn = {1558-4127},
  keywords = {Intelligent transportation systems;autonomous vehicles;traffic forecasting;federated learning;graph pre-training},
}

@article{tmgcnattatrafficpredictionmode2025,
  author = {S. Sadhu; D. Mallick; A. Namtirtha; A. Dutta},
  title = {{TMGCN-ATT:} {A} {Traffic} {Prediction} {Model} with {Multi-Hop} {GCN} and {Self-Attention} {Mechanisms}},
  journal = {2025 17th International Conference on COMmunication Systems and NETworks (COMSNETS)},
  year = {2025},
  pages = {950--954},
  doi = {10.1109/COMSNETS63942.2025.10885556},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10885556},
  abstract = {Accurate real-time traffic forecasting is essential for intelligent traffic systems and urban planning but remains challenging due to the complexity of road networks and dynamic, time-dependent changes. To address this, we propose TMGCN-ATT, a novel model that combines Multi-Hop Graph Convolutional Networks (MGCN) to capture spatial dependencies and Gated Recurrent Units (GRU) with a self-attention mechanism to model temporal dynamics in traffic data. The multi-hop GCN aggregates information from distant nodes, capturing higher-order spatial relationships, which the GRU then processes with self-attention to learn temporal patterns. The performance of the model is evaluated using four metrics: accuracy, root mean squared error (RMSE), mean absolute error (MAE), and the coefficient of determination (R2). Experimental results demonstrate that TMGCN-ATT consistently surpasses baseline models such as SVR, GRU, GCN, and TGCN across two urban traffic datasets, Los-Loop and SZ-Taxi. In traffic forecasting tasks, TMGCN-ATT achieves an average accuracy of 83.65% and an MAE of 2.5 across the two datasets.},
  publisher = {IEEE},
  isbn = {979-8-3315-3119-5},
  issn = {2155-2509},
  keywords = {Spatio Temporal Network;Multi-hop Graph Convolution Network;Self-Attention Mechanism;Traffic Forecasting},
}

@article{predictionofmultivariatespatia2025,
  author = {C. An; Z. Lu; Y. Ma; W. Zhao; X. Chen},
  title = {{Prediction} of {Multivariate} {Spatial-Temporal} {Series} {Data} {Based} on {Adaptive} {Spatial-Temporal} {Information}},
