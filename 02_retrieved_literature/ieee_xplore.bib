@article{silmasubjectiveintentbasedlowl2025,
  author = {W. Qu; J. Wang; J. Du; Y. Zhu; J. Yu; R. Xia; S. Cao; X. Wu; D. Luo},
  title = {{SILM:} {A} {Subjective} {Intent} {Based} {Low-Latency} {Framework} for {Multiple} {Traffic} {Participants} {Joint} {Trajectory} {Prediction}},
  journal = {2025 IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS)},
  year = {2025},
  pages = {20333--20340},
  doi = {10.1109/IROS60139.2025.11246264},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11246264},
  abstract = {Trajectory prediction is a fundamental technology for advanced autonomous driving systems and represents one of the most challenging problems in the field of cognitive intelligence. Accurately predicting the future trajectories of each traffic participant is a prerequisite for building high safety and high reliability decision-making, planning, and control capabilities in autonomous driving. However, existing methods often focus solely on the motion of other traffic participants without considering the underlying intent behind that motion, which increases the uncertainty in trajectory prediction. Autonomous vehicles operate in real-time environments, meaning that trajectory prediction algorithms must be able to process data and generate predictions in real-time. While many existing methods achieve high accuracy, they often struggle to effectively handle heterogeneous traffic scenarios. In this paper, we propose a Subjective Intent-based Low-latency framework for Multiple traffic participants joint trajectory prediction. Our method explicitly incorporates the subjective intent of traffic participants based on their key points, and predicts the future trajectories jointly without map, which ensures promising performance while significantly reducing the prediction latency. Additionally, we introduce a novel dataset designed specifically for trajectory prediction. Related code and dataset will be available soon.},
  publisher = {IEEE},
  isbn = {979-8-3315-4393-8},
  issn = {2153-0866},
}

@article{convolutionallongshorttermmemo2025,
  author = {V. Biradar; R. Tewari; S. Thallal; D. Vasavi; S. S},
  title = {{Convolutional} {Long} {Short-Term} {Memory} and {Event-Aware} {Based} {Multilayer} {Perceptron} for {Urban} {Traffic} {Prediction}},
  journal = {2025 Third International Conference on Networks, Multimedia and Information Technology (NMITCON)},
  year = {2025},
  pages = {1--6},
  doi = {10.1109/NMITCON65824.2025.11188380},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11188380},
  abstract = {Currently, urban traffic prediction plays a crucial role in intelligent transportation systems, where accurate forecasting supports congestion management and dynamic routing. However, the existing domain-adaptable continuous meta-learning (DAC-ML) cannot explicitly handle exogenous events that are crucial for accurate urban dynamics predictions during sudden disruptions. Hence, this research proposes a Convolutional Long Short-Term Memory (ConvLSTM) with an event-aware Multilayer Perceptron (EAMLP) framework for integrating real-time event signals into the prediction pipeline. Initially, the input data were collected from the Shenzhen traffic dataset, which provides multi-featured traffic metrics across a city-wide grid. Preprocessing involves sliding window segmentation with fixed-length rolling window framing, and grid-based tensor construction with spatial grid tensorization to maintain the spatial structure of the data in a grid format for convolutional modeling. Next, feature extraction was performed using ConvLSTM to capture spatiotemporal dependencies from traffic sequences and a simple EAMLP module to encode exogenous inputs. Finally, these representations were fused and passed into an MLP Global Regressor (MGR) to predict citylevel traffic outcomes. The proposed ConvLSTM-EAMLP attained better results in terms of mean absolute error (2.50), root mean square error (3.28), and mean absolute percentage error (3.97 %) than the existing Deep ML with Traffic Revitalization Index (DML-TRI) model.},
  publisher = {IEEE},
  isbn = {979-8-3315-1308-5},
  keywords = {convolutional long short-term memory;fixedlength rolling window framing;global regressor;multilayer perceptron;spatial grid tensorization},
}

@article{crossmodalityandequityawaregra2025,
  author = {X. Yang; S. He; K. G. Shin; M. Tabatabaie; J. Dai},
  title = {{Cross-Modality} and {Equity-Aware} {Graph} {Pooling} {Fusion:} {A} {Bike} {Mobility} {Prediction} {Study}},
  journal = {IEEE Transactions on Big Data},
  year = {2025},
  volume = {11},
