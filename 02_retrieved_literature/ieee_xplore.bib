@article{weagananefficientweatherawareg2026,
  author = {Y. Wang; C. Wan; Y. Luo},
  title = {{WeaGAN++:} {An} {Efficient} {Weather-Aware} {Graph} {Attention} {Network} for {Traffic} {Prediction}},
