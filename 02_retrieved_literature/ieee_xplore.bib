@article{spatiotemporalgraphneuralnetwo2025,
  author = {P. K. Patidar; N. Pal; M. Patidar; N. C. Gediya; A. Dubey; S. Rajput},
  title = {{Spatio-Temporal} {Graph} {Neural} {Network} for {Real-Time} {Network} {Traffic} {Prediction} and {Adaptive} {Resource} {Allocation} in {6G} {Networks}},
  journal = {2025 IEEE International Conference on Advances in Computing Research On Science Engineering and Technology (ACROSET)},
  year = {2025},
  pages = {1--5},
  doi = {10.1109/ACROSET66531.2025.11280846},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11280846},
  abstract = {The development of wireless technologies to 6G systems comes with unprecedented requirements for latency and reliability, as well as handling enormous, dynamic, and diverse traffic patterns. Moreover, network topologies in modern networks are increasingly complex and evolving, which makes traditional methods of traffic prediction and resource allocation obsolete. This paper presents a new Spatio-Temporal Graph Neural Network (ST-GNN) for adaptive resource allocation and real-time network traffic prediction in 6G networks. By considering the network as a dynamic graph, our approach captures the spatial correlations among network nodes in addition to their traffic over time. An Intelligent Resource Management module that adjusts the bandwidth and computing resources in real-time based on traffic prediction integrates with the ST-GNN, dynamically optimizing the allocation to improve QoS and counter congestion. With real-world traffic datasets, extensive experiments confirm the superiority of our model against traditional machine learning and deep learning models with respect to prediction accuracy, latency, and overall network efficiency. The results move next-generation wireless systems toward intelligent, proactive, and scalable network management.},
  publisher = {IEEE},
  isbn = {978-1-6654-5810-8},
  keywords = {6G Networks;Spatio-Temporal Graph Neural Network;Network Traffic Prediction;Adaptive Resource Allocation;Real-Time Network Management;QoS Optimization},
}

@article{urbanroadtrafficpredictionwith2025,
  author = {Y. Ba; S. Ji; S. Pan; S. He; Y. Ji; D. Guo},
  title = {{Urban} {Road} {Traffic} {Prediction} {With} {Dynamic} {Spatial-Temporal} {Graph} {Convolutional} {Network} {Based} on {Attention} {Mechanism}},
  journal = {IEEE Sensors Journal},
  year = {2025},
  volume = {25},
  number = {14},
  pages = {27187--27199},
  doi = {10.1109/JSEN.2025.3577034},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11031099},
  abstract = {As intelligent transportation systems continue to develop, the real-time and accurate traffic prediction in urban road networks becomes increasingly critical. Urban road network topology frequently changes due to traffic light control. To capture the dynamic spatial correlations among urban roads, this article introduces a traffic forecasting method utilizing a dynamic spatial-temporal graph convolutional network (D-TGCN) model integrated with an attention mechanism. The method incorporates the traffic BERT model to enhance the static adjacency matrix in traditional graph convolutional neural networks (CNNs) by leveraging the attention mechanism, thereby capturing the implicit correlation between the dynamic variations in the urban road network and traffic flow. First, the road network is transformed into dynamic graph sequences, which traffic BERT uses to generate the final dynamic correlation matrix. Subsequently, the graph convolutional network (GCN) is employed alongside the dynamic correlation matrix to capture dynamic spatial dependencies, while temporal dependencies are modeled using a gated recurrent unit (GRU). LOS-loop and SZ-taxi are the two real-world traffic datasets that were used to test and validate the enhanced model. Results from the experiments show that the D-TGCN model outperformed the temporal graph convolutional network (T-GCN) model by 11.08%, 12.23%, 13.05%, and 13.71% in prediction tasks spanning 15, 20, 30, 45, and 60 min. These results show that the D-TGCN model gives considerable benefits for long-term forecasting and delivers improved prediction accuracy.},
  publisher = {IEEE},
  issn = {1558-1748},
  keywords = {Dynamic association;graph convolutional network (GCN);spatial-temporal features;traffic prediction},
}

@article{hybridspatiotemporalgraphconvo2025,
  author = {H. F. Al-Selwi; A. A. Aziz; F. S. B. Abas; M. Y. Alias; S. B. Jamian; N. A. A. Aziz},
  title = {{Hybrid} {Spatiotemporal} {Graph} {Convolutional} {Network} {Enhanced} with {GRU} for {Traffic} {Forecasting}},
  journal = {2025 Multimedia University Engineering Conference (MECON)},
  year = {2025},
  pages = {1--6},
  doi = {10.1109/MECON67253.2025.11276954},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11276954},
  abstract = {Vehicular traffic flow prediction is a critical component of Intelligent Transportation Systems (ITS), playing a major role in alleviating congestion and optimizing traffic management. Additionally, accurate traffic forecasts are essential for efficient resource allocation in vehicular communication networks. Recent advancements in deep learning have enabled the use of Graph Neural Networks (GNNs) for traffic prediction, effectively capturing the complex spatiotemporal dependencies in traffic flow. However, existing models still face challenges in achieving higher accuracy and efficiency. In this study, we propose a Hybrid Spatiotemporal Graph Convolutional Network with GRU to enhance traffic flow prediction. The integration of Gated Recurrent Units (GRU) improves temporal feature extraction, refining the model's ability to capture dynamic traffic patterns over time. The proposed model is evaluated on multiple real-world traffic datasets to assess its predictive performance and computational efficiency. Experimental results show that our model achieves an average improvement of 6% over baseline models. Comparative analysis further highlights its superior performance, making it a valuable contribution to ITS development and traffic prediction research.},
  publisher = {IEEE},
  isbn = {979-8-3315-5549-8},
  keywords = {Traffic Prediction;Deep Learning;Graph Neural network;Machine learning;Connected Vehicles},
}

@article{spatiotemporalgraphconvolution2025,
  author = {Q. Cao; X. Ji},
  title = {{Spatio-temporal} graph convolutional network for urban traffic flow prediction study},
  journal = {2025 2nd International Seminar on Artificial Intelligence, Computer Technology and Control Engineering (ACTCE)},
  year = {2025},
  pages = {209--212},
  doi = {10.1109/ACTCE66599.2025.00045},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11447178},
  abstract = {Urban traffic problem is a much-needed improvement of the contemporary rapid economic development, the increase in the number of motor vehicles causes urban traffic congestion, which affects the quality of urban life. Traffic flow is a kind of spatio-temporal data including time dimension and space dimension, which has the characteristics of periodicity, spatio-temporal dependence, and stochasticity. Adopting intelligent techniques to predict traffic flow is an important means to improve traffic congestion, and it is crucial to develop urban short-term traffic flow prediction means based on the periodicity of the spatio-temporal data of traffic flow in order to improve the accuracy of traffic flow prediction. The gated time convolution module can be used to accurately capture the time dependence, the attention map convolution module can be used to accurately capture the spatial dependence of traffic flow, and the dynamic and static dual-channel architecture can be used to integrate the external influences of traffic flow, and to integrate external data such as the weather and other external data to assist in the model analysis.},
  publisher = {IEEE},
  isbn = {979-8-3315-3788-3},
  keywords = {Spatio-temporal Convolutional Networks;Short-term Traffic;Flow Prediction},
}

@article{predictionofarrivalaircrafttim2025,
  author = {E. Ozcelik; E. Germen; F. A. Cetek},
  title = {{Prediction} of {Arrival} {Aircraft} {Time} {Spent} in {TMA} with {Graph} {Neural} {Network}},
  journal = {2025 Integrated Communications, Navigation and Surveillance Conference (ICNS)},
  year = {2025},
  pages = {1--7},
  doi = {10.1109/ICNS65417.2025.10976757},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10976757},
  abstract = {Accurately predicting the time aircraft spend within Terminal Maneuvering Areas (TMA) is crucial for optimizing air traffic management, minimizing delays, and improving operational efficiency. This study introduces two Graph Neural Network (GNN) modelsâGraph Convolutional Network (GCN) and Graph Attention Network (GAT)âto forecast aircraft TMA duration based on historical Automatic Dependent Surveillance-Broadcast (ADS-B) data collected from Istanbul TMA. The models leverage spatial-temporal patterns and inter-aircraft relationships to generate predictions. The GAT model employs an attention mechanism to assign varying importance to different nodes, dynamically capturing complex relationships within the TMA. In contrast, the GCN model applies uniform weighting to node connections, offering computational efficiency but limited adaptability to dynamic air traffic conditions. Results demonstrate that the GNN-based approach is effective for TMA duration prediction due to its ability to adapt to traffic density variations. This work underscores the potential of GNN-based approaches in air traffic management applications, facilitating better-informed decision-making processes for traffic controllers and operational planners.},
  publisher = {IEEE},
  isbn = {979-8-3315-3473-8},
  issn = {2155-4951},
  keywords = {Air Traffic Management (TMA);Flight Duration Prediction;Graph Attention Network (GAT);Graph Convolutional Network (GCN);Terminal Maneuvering Area (TMA)},
}

@article{dastgcndynamicattentionbasedsp2025,
  author = {P. Liu},
  title = {{DASTGCN:} {Dynamic} {Attention} {Based} {Spatio-Temporal} {Graph} {Convolutional} {Network} for {Traffic} {Forecasting}},
  journal = {2025 5th International Conference on Artificial Intelligence and Industrial Technology Applications (AIITA)},
  year = {2025},
  pages = {1778--1782},
  doi = {10.1109/AIITA65135.2025.11048028},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11048028},
  abstract = {Traffic flow prediction plays a very important role in transportation, and accurate traffic flow prediction can bring great convenience to transportation. There are two main limitations in the existing traffic flow prediction models: First, most models do not separate the dynamic and periodic spatio-temporal features, resulting in models that do not fully exploit the spatiotemporal features of traffic flow. Second, most models perform poorly in extracting temporal features, and it is difficult to aggregate node information for longer time steps. Therefore, this paper proposes a new Dynamic Attention Based Spatio-Temporal Graph Convolutional Network(DASTGCN). We design a spatio-temporal dynamic attention module and a multi-scale gated convolution to solve the above problem. Experiments on two real datasets show that our DASTGCN model performs better than other models.},
  publisher = {IEEE},
  isbn = {979-8-3315-0976-7},
  keywords = {traffic forecasting;deep learning;attention mechanism;graph convolution},
}

@article{researchonairspaceroutetraffic2025,
  author = {M. Zhang; Z. Wang; Y. Chen},
  title = {{Research} on airspace route traffic flow prediction algorithm based on improved spatio-temporal feature fusion},
  journal = {2025 IEEE 7th International Conference on Civil Aviation Safety and Information Technology (ICCASIT)},
  year = {2025},
  pages = {569--574},
  doi = {10.1109/ICCASIT66611.2025.11348854},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11348854},
  abstract = {This paper presents a route traffic flow prediction model incorporating spatio-temporal feature fusion and an attention mechanism (GCN-BILSTM-Attention) for traffic flow prediction in airspace route networks, with the goal of enhancing the accuracy of such predictions. The graph convolutional network (GCN) serves to extract topological structure features between actual route nodes. The bidirectional long short-term memory neural network (BiLSTM) is employed to capture matrix features related to forward and backward correlations in route traffic time series. The attention mechanism is utilized to further explore correlation features of time series within the spatial domain. Using historical traffic data from partial route networks in the northwest region as a case study, the results demonstrate that the integrated prediction model achieves favorable performance in route network traffic flow prediction, characterized by high accuracy and robustness. This provides strong support for the implementation of accurate airspace route traffic flow prediction.},
  publisher = {IEEE},
  isbn = {979-8-3315-0374-1},
  keywords = {airspace route;traffic flow prediction;spatio-temporal feature fusion;GCN-BILSTM-Attention},
}

@article{stgcnmaaspatiotemporalgraphcon2026,
  author = {W. Wang; K. Jiang},
  title = {{STGCN-MA:} {A} {Spatio-Temporal} {Graph} {Convolutional} {Network} with {Mamba} {Attention} for {Cellular} {Traffic} {Prediction}},
  journal = {2026 8th International Conference on Natural Language Processing (ICNLP)},
  year = {2026},
  pages = {693--697},
  doi = {10.1109/ICNLP69856.2026.11527870},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11527870},
  abstract = {In the era of intelligent and heterogeneous wireless communication, accurate traffic prediction is crucial for efficient network management. However, due to the complex spatiotemporal correlations in cellular data, existing methods often have limitations in efficiently capturing both characteristics simultaneously. To address these issues, this paper proposes a spatiotemporal graph convolutional network based on Mamba attention (STGCN-MA), which is a novel prediction framework using an encoder decoder architecture. STGCN-MA integrates the advantages of the selective state space model in Mamba to achieve efficient computation and long-range dependency modeling. The encoder consists of two core modules, a Bi Mamba module that utilizes the linear computational complexity of Mamba to capture long-term temporal dependencies. And a novel Spatial Mamba Attention Graph Convolutional Network (MA-GCN) module that integrates Graph Convolutional Network (GCN) with Mamba based attention mechanism to effectively model dynamic and non local spatial correlations. Experiments on the real Telecom Italia Milan dataset show that the performance of STGCN-MA is significantly better than baseline models including long short-term memory (LSTM), Graph Wavenet, Timesnet, and Adaptive Graph Convolutional Recurrent Network (AGCRN), verifying the excellent accuracy and efficiency of this model in cellular traffic prediction.},
  publisher = {IEEE},
  isbn = {979-8-3315-8226-5},
  keywords = {Spatial-Temporal modeling;Cellular traffic prediction;Mamba;Graph neural network},
}

@article{spatiotemporalgraphneuralnetwo2026,
  author = {K. Jyoshna; R. K. Peddi; P. N. S; D. M; S. Punitha},
  title = {{Spatio-Temporal} {Graph} {Neural} {Network} with {Global} {Spatio-Temporal} {Network} for the {Traffic} {Flow} {Prediction}},
  journal = {2026 2nd International Conference on Intelligent Systems and Computational Networks (ICISCN)},
  year = {2026},
  pages = {1--6},
  doi = {10.1109/ICISCN67954.2026.11566462},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11566462},
  abstract = {To prevent the congestion of traffic in the urban areas is become crucial in now a day, because rapid growth of vehicles affect the quality of the urban life style. Traffic flow prediction (TFP) is the solution to overcome the problems in the transportation system. The deep learning (DL) models are used to develop the prediction of the traffic flow but the models are unable overcome the spatial and temporal dependencies. To address this problem, combination of Spatio-Temporal Graph Neural Network (ST-GNN) and Global Spatio-Temporal Network (GSTN) is proposed for prediction of the traffic flow. The GSTN is used to extract the spatio-temporal information from the data and fed into the ST-GNN. ST-GNN is used to learn the extracted spatio and temporal information's from the GSTN for the prediction of traffic flow. The proposed model utilizes two benchmark datasets, which achieved the high performance on PEMS04 and PEMS Bay respectively compared to the baseline models.},
  publisher = {IEEE},
  isbn = {979-8-3315-8871-7},
  keywords = {deep learning;edges;global spatio-temporal network;multi-scale temporal and enhance spatial transformer;nodes;spatio-temporal graph neural network;sensor},
}

@article{trafficflowpredictionmodelbase2026,
  author = {X. Xiong; J. Wang; Z. Huang},
  title = {{Traffic} {Flow} {Prediction} {Model} {Based} on {Encoder-Decoder} {Attention} {Graph} {Convolutional} {Network}},
  journal = {2026 2nd International Conference on Artificial Intelligence and Computer Network (ICAICN)},
  year = {2026},
  pages = {107--111},
  doi = {10.23919/ICAICNCPS00028.2026.00028},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11626251},
  abstract = {Traffic flow prediction poses a significant challenge within transportation systems, this paper proposes a novel traffic flow prediction model, namely the Encoder-Decoder Attention Graph Convolutional Network (EDAGCN). Firstly, the model employs a Delayed Multi-Component (DMC) module to extract periodic delay characteristics from historical traffic flow data, effectively tackling the issue of periodic time delays in traffic sequences. Then, a multi-head spatial-temporal attention mechanism is integrated into the encoder-decoder framework to adeptly capture spatial-temporal dependencies. Experimental evaluations conducted on traffic datasets demonstrate that the EDAGCN model surpasses other benchmark models in terms of prediction accuracy.},
  publisher = {Additional Conference Content},
  isbn = {978-1-971299-01-3},
  keywords = {traffic flow prediction;graph convolutional network;encoder-decoder;spatial-temporal dependencies},
}

@article{networktrafficpredictionbasedo2025,
  author = {L. Bo; L. Zheng; K. Wei; X. Li},
  title = {{Network} {Traffic} {Prediction} {Based} on {Graph} {Neural} {Network} and {Anomaly} {Detection}},
  journal = {2025 3rd International Conference on Intelligent Communication and Networking (ICN)},
  year = {2025},
  pages = {70--73},
  doi = {10.1109/ICN68016.2025.11384077},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11384077},
  abstract = {With the continuous expansion of network scale and the increasing complexity of traffic patterns, traditional network traffic prediction and anomaly detection methods are difficult to effectively capture the spatial dependencies in network topology. In this paper, a graph neural network (GNN)-based network traffic prediction and anomaly detection framework is proposed, which models the network topology into a graph structure and uses the spatiotemporal graph convolutional network (ST-GCN) to capture the temporal evolution and spatial propagation characteristics of network traffic at the same time. Experimental results show that the proposed method is better than the traditional method in terms of traffic prediction accuracy and anomaly detection performance, with a 23.7% reduction in predictive MAE and an anomaly detection F1-score of 94.3%.},
  publisher = {IEEE},
  isbn = {979-8-3315-5778-2},
  keywords = {graph neural network;network traffic forecasting;anomaly detection;spatiotemporal graph convolution;Network topology modeling},
}

@article{robusttrafficforecastingwithdi2026,
  author = {T. Wang; R. Luo; D. Shi; H. Deng; S. Zhao},
  title = {{Robust} {Traffic} {Forecasting} {With} {Disentangled} {Spatiotemporal} {Graph} {Neural} {Networks}},
  journal = {IEEE Transactions on Neural Networks and Learning Systems},
  year = {2026},
  volume = {37},
  number = {6},
  pages = {2549--2562},
  doi = {10.1109/TNNLS.2025.3635636},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11297813},
  abstract = {Traffic prediction is a cornerstone of intelligent transportation systems (ITSs). The effectiveness of existing spatiotemporal graph neural networks (STGNNs) heavily relies on the independent identically distributed (i.i.d.) assumption of traffic data, which is frequently violated in practice because of distribution shifts owing to exogenous factors. While learning features that remain stable across all environments is promising for modeling robust frameworks, the fundamental challenge involves the decomposition of invariant features from the dynamic nature of spatiotemporal dependencies. In this article, we propose the disentangled spatiotemporal (DIST) graph neural networks, a novel framework for robust traffic forecasting considering distribution shifts. In DIST, latent invariant variables are explicitly decoupled from dynamically evolving spatiotemporal dependencies, enabling the learning of topology-agnostic representations resilient to distribution shifts. Specifically, we formulate a causality-driven learning objective that guides the separation of invariant variables from various exogenous factors. We then propose a spatiotemporal graph modeling module that can adaptively capture spatiotemporal dependencies in evolving traffic systems. Furthermore, we present a graph perturbation module to simulate topology variations during training, thereby encouraging the model to identify perturbation-sensitive dependencies and infer invariant and variant features for prediction and intervention tasks. The prediction risk and its variance on multiple interventional distributions are minimized in our learning strategy, allowing the model to identify invariant features, thus improving its robustness. The results of comprehensive real-world experiments demonstrate the superiority of our approach. The source code is available: https://github.com/tingwang25/DIST},
  publisher = {IEEE},
  issn = {2162-2388},
  keywords = {Disentangled representation;invariant learning;spatiotemporal graph neural networks (STGNNs);traffic prediction},
}

@article{staegcnaspatiotemporaladaptive2025,
  author = {C. Yuan; X. Li; Y. He; H. Zhang; J. Liu},
  title = {{STAE-GCN:} {A} {Spatio-Temporal} {Adaptive} {Embedding} {Graph} {Convolutional} {Network} for {Multistep} {Traffic} {Forecasting}},
  journal = {2025 18th International Congress on Image and Signal Processing, BioMedical Engineering and Informatics (CISP-BMEI)},
  year = {2025},
  pages = {1--6},
  doi = {10.1109/CISP-BMEI68103.2025.11259329},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11259329},
  abstract = {Spatiotemporal prediction plays a critical role in traffic forecasting, environmental monitoring, and social network analysis. However, existing methods still face challenges in modeling complex spatiotemporal dependencies. Conventional temporal models struggle to capture long-term dependencies, and traditional GNNs fail to dynamically adapt to changing spa-tial relationships. Additionally, many approaches lack sufficient multi-level feature fusion, limiting their ability to extract deep spatiotemporal representations. To address these issues, we pro-pose STAE-GCN, a novel Spatio- Temporal Adaptive Embedding Graph Convolutional Network. STAE-GCN enhances temporal modeling through even-odd sequence decomposition instead of dilated convolution and improves feature representation via spatiotemporal adaptive embedding. It further integrates multi-layer GCNs to learn spatial features across depths and employs learnable fusion to enable richer spatiotemporal interaction. Final predictions are made by aggregating all outputs followed by ReLU activation and an MLP. Extensive experiments on real-world datasets show that STAE-GCN outperforms state-of-the-art methods, particularly in long-term forecasting tasks, demonstrating improved robustness and generalization. This work offers a new perspective on effective spatiotemporal data modeling.},
  publisher = {IEEE},
  isbn = {979-8-3315-7736-0},
  keywords = {STAE-GCN;Spatiotemporal forecasting;graph neural network;adaptive embedding},
}

@article{aidriventrafficcongestionpredi2026,
  author = {G. N. Karthik Rajan; S. Kabilan; K. Nithya},
  title = {{AI-Driven} {Traffic} {Congestion} {Prediction} and {Adaptive} {Signal} {Control} {Using} {SpatialâTemporal} {Graph} {Neural} {Networks}},
  journal = {2026 International Conference on Data Science, Agents and Artificial Intelligence (ICDSAAI)},
  year = {2026},
  volume = {1},
  pages = {1--6},
  doi = {10.1109/ICDSAAI69492.2026.11505063},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11505063},
  abstract = {Traffic congestion forecast and adaptive signal control have been a significant problem in modern intelligent transportation systems due to the high rate of urbanisation and road congestion. The current paper presents an AI-based approach that integrates Spatial-Temporal Graph Neural Networks (ST-GNN) with reinforcement-learning-managed adaptive signal control to improve traffic management performance. The road network is modelled as a graph to capture spatial correlations among interconnected intersections, and temporal information is derived from past and present traffic data. The model is compared against benchmark datasets, such as METR-LA, PeMSD7, and PeMS-Bay, and validated in the SUMO traffic simulation environment. The experimental findings demonstrate that the ST-GNN model achieves superior predictive performance, with Mean Absolute Error (MAE) and Root Mean Squared Error (RMSE) of 2.31 and 4.08, respectively, outperforming traditional models such as ARIMA, Random Forest, and LSTM. Further, the adaptive signal control module reduces the average time vehicles wait by 32%, the queue length by 27%, and the intersection throughput by 18% compared to fixed-time control strategies. The findings show that the suggested framework offers an effective, scalable and practical solution to real-time urban traffic congestion management.},
  publisher = {IEEE},
  isbn = {979-8-3195-3097-4},
  keywords = {Traffic Congestion;Prediction;Adaptive Signal Control;Spatial-Temporal Graph Neural Networks;Intelligent Transportation Systems;Reinforcement Learning;Traffic Flow Optimisation},
}

@article{stganetspatiotemporalgraphatte2026,
  author = {K. K. C. Deepthi; S. R. Kotnani; P. P. Karri; V. Vemulapalli; D. Dhaniyala},
  title = {{STGA-Net:} {Spatio-Temporal} {Graph} {Attention} {Network} for {Traffic} {Flow} {Forecasting} on {Indian} {Urban} {Roads}},
  journal = {2026 World Conference on Computational Science and Technology (WcCST)},
  year = {2026},
  pages = {513--518},
  doi = {10.1109/WcCST67302.2026.11495676},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11495676},
  abstract = {This paper presents STGA-Net (Spatio-Temporal Graph Attention Network), a deep learning framework designed for accurate short-term traffic flow prediction in complex Indian urban environments. Standard models such as ARIMA, CNN, and LSTM often fail to effectively represent dynamic spatial dependencies among interconnected road segments. The proposed model employs Graph Attention Networks (GAT) for adaptive spatial learning and Long Short-Term Memory (LSTM) units for modeling temporal sequences to address this issue. One big thing that makes this work is the use of correlation-based adaptive adjacency learning, which lets the model figure out how road segments are related to each other in real time, not just on static road maps. Embeddings of day-of-week and other time-based features can also help find traffic patterns that happen over and over again.The model was tested on a real-world traffic dataset from Bangalore and showed stable convergence and better predictive performance. The results of the experiment show that STGA-Net has a Mean Absolute Error (MAE) of 0.6536 and a Root Mean Squared Error (RMSE) of 0.8544, which means that it can reliably make short-term predictions. The model also got a ($R^\{2\}$) score of 0.2390, which shows that it can capture important changes in space and time. These results show that STGA-Net works well for smart city and intelligent traffic management.},
  publisher = {IEEE},
  isbn = {979-8-3315-9966-9},
  keywords = {Traffic Flow Forecasting;Spatio-Temporal Graph Attention Network (STGA-Net);Graph Neural Networks;Adaptive Adjacency Learning;Temporal Feature Embedding;Deep Learning;Urban Traffic Prediction;Intelligent Transportation Systems (ITS);Bangalore Traffic Dataset},
}

@article{temporalidentityinteractiondyn2025,
  author = {S. Yang; Q. Wu; M. Li; Y. Sun},
  title = {{Temporal} {Identity} {Interaction} {Dynamic} {Graph} {Convolutional} {Network} for {Traffic} {Forecasting}},
  journal = {IEEE Internet of Things Journal},
  year = {2025},
  volume = {12},
  number = {11},
  pages = {15057--15072},
  doi = {10.1109/JIOT.2025.3529761},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10840243},
  abstract = {Accurate traffic forecasting is one of the key applications within Internet of Things (IoT)-based intelligent transportation systems (ITS), playing a vital role in enhancing traffic quality, optimizing public transportation, and planning infrastructure. However, existing spatial-temporal methods encounter two primary limitations: 1) they have difficulty differentiating samples over time and often ignore dependencies among road network nodes at different time scales and 2) they are limited in capturing dynamic spatial correlations with predefined and adaptive graphs. To overcome these limitations, we introduce a novel temporal identity interaction dynamic graph convolutional network (TIIDGCN) for traffic forecasting. The central concept involves assigning temporal identity features to raw data and extracting distinctive, representative spatial-temporal features through multiscale interactive learning. Specifically, we design a multiscale interactive model incorporating both spatial and temporal components. This network aims to explore spatial-temporal patterns at various scales from macro to micro, facilitating their mutual enhancement through positive feedback mechanisms. For the spatial component, we design a new dynamic graph learning method to depict the changing dependencies among nodes. We conduct comprehensive experiments using four real-world traffic datasets (PeMS04/07/08 and NYCTaxi Drop-off/Pick-up). Specifically, TIIDGCN achieves a 16.46% reduction in mean absolute error compared to the Spatial-Temporal Graph Attention Gated Recurrent Transformer Network model on the PeMS08 dataset.},
  publisher = {IEEE},
  issn = {2327-4662},
  keywords = {Graph convolutional network (GCN);multiscale interaction;traffic forecasting},
}

@article{trafficflowforecastingwithspat2025,
  author = {X. Fan; J. He},
  title = {{Traffic} {Flow} {Forecasting} with {Spatiotemporal} {Attention} and {Dynamic} {Graphs}},
  journal = {2025 7th International Conference on Data-driven Optimization of Complex Systems (DOCS)},
  year = {2025},
  pages = {607--611},
  doi = {10.1109/DOCS67533.2025.11200679},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11200679},
