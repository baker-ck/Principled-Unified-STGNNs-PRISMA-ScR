}

@article{breakingchickeneggcrosscitybat2025,
  author = {W. Cheng; H. Lu; C. Xiang; D. Liu; T. Xiang},
  title = {{Breaking} {âChicken-Eggâ:} {Cross-city} {Battery} {Swap} {Demand} {Prediction} via {Knowledge-guided} {Diffusion}},
