  abstract = {This article presents a multiagent framework for optimal scheduling of multiarea hydrogen-integrated power and traffic (HPT) networks. The framework utilizes twin-delayed deep deterministic policy gradient (TD3) reinforcement learning enhanced by group-relative policy optimization (GRPO). The proposed multiarea GRPO TD3 (MGRPO-TD3) incorporates a Bayesian-tuned hybrid forecasting method based on a graph transformer network to capture spatialâtemporal patterns and accurately predict traffic flows and hydrogen vehicle demands. Nonlinear physical and operational constraints are embedded. The multicritic, group-relative design improves robustness to disturbances, forecasting errors, and facility outages, while agent grouping reduces the state dimensionality and computational cost for large systems. On a Calgary-inspired three-area HPT network, the forecaster reduces traffic-flow mean absolute percentage error by up to 21.3% compared with graph and graph-transformer benchmarks. For the same network, the MGRPO-TD3 increases daily profit by about 25.6% relative to a multiagent proximal policy optimization baseline. The approach also delivers robust performance in realistic contingency scenarios: when a hydrogen charging station is out of service, profit loss is limited to 1.2%, compared with 14.5%â41.7% for competing methods. In addition, scalability is confirmed under expanded traffic and power conditions with a larger number of agents.},
  publisher = {IEEE},
  issn = {1937-9234},
  keywords = {Deep reinforcement learning (DRL) algorithm;graph transformer network (GTN);hydrogen hub;MGRPO-TD3;power network;traffic system},
