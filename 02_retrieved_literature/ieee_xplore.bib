  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11479159},
  abstract = {In today's world, Intelligent Transport Systems (ITS) employ advanced Data Analytics and Machine Learning (ML) to enhance road safety. Advanced Driver Assistance Systems (ADAS) are introduced to improve driver safety and reduce human errors butthe existing ML and DL solutions struggle to capture the temporal and spatial patterns in the data. Accurate classification of driving behavior is essential for improving ITS and Advanced Driver Assistance Systems (ADAS) but still baseline and aggregated ML and Deep Learning (DL)systems struggle to capture temporal and spatial patterns in the data. Hybrid GNN-LSTM model, combining Graph Neural Networks (GNN)with Long Short-Term Memory (LSTM) to extract spatial relationships along with temporal learning using GNN. The proposed hybrid model is trained using dataset sourced from Kaggle, which contains $\mathbf\{1 0, 0 0 0\}$ instances across $\mathbf\{1 5\}$ features with 4 classes such as Accelerate, Brake, Lane Correct and Maintain Speed. The experimentation indicates that conventional and ensemble ML and DL modelsexhibit overfitting with many misclassifications. Among all the models, LSTM showed better accuracy with temporal learning, while GNNindicated overfitting. The proposed hybrid model achieved superior performance with accuracy of 0.98, with least misclassifications. This study could benefit autonomous vehicle developers, ADAS and ITS researchers in enhancing driving behavior classification.},
  publisher = {IEEE},
  isbn = {979-8-3195-4321-9},
  keywords = {Intelligent Transportation Systems;Temporal Learning;Spatial Relationships;Autonomous Vehicles},
}

@article{agrouprelativedrlstrategyforop2026,
  author = {M. Jadidbonab; H. Abdeltawab; Y. A. -R. I. Mohamed},
  title = {{A} {Group-Relative} {DRL} {Strategy} for {Optimizing} {Multiarea} {Hydrogen-Integrated} {Power} and {Traffic} {Networks}},
