  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11527857},
  abstract = {Traffic flow prediction is a critical task within intelligent transportation systems (ITS). However, the highly nonlinear, dynamically evolving, and strongly spatio-temporal coupled nature of traffic states poses significant challenges for constructing models that are both accurate and robust. Notably, existing approaches often rely on a single static topology or computationally expensive dynamic graph reconstruction for spatial modeling, while lacking mechanisms to jointly capture local temporal trends and global dependencies in spatio-temporal representations. To address these limitations, we propose STIEFormer, an enhanced Transformer model designed for deep spatio-temporal interaction and multi-view fusion. The model leverages a Dynamic SpatioTemporal Propagation Cross-Attention (DSTP-CA) mechanism, which employs lightweight 1 D convolutions to capture local spatio-temporal trends and dynamically models propagation patterns across time and nodes, achieving a deep integration of local trends and global dependencies. Furthermore, a CrossView Fusion Module (CVFM) constructs dynamic semantic graphs to uncover long-range latent similarities and integrates them with static geographic topologies to produce multi-view, consistent node representations, thereby enhancing feature expressiveness and model robustness. Experimental results on the real-world PEMS04 and PEMS08 traffic datasets demonstrate that STIEFormer consistently outperforms existing state-of-theart methods across multiple evaluation metrics, confirming the effectiveness and superiority of the proposed framework.},
  publisher = {IEEE},
  isbn = {979-8-3315-8226-5},
  keywords = {Traffic flow prediction;dynamic semantic graph;Transformer},
}

