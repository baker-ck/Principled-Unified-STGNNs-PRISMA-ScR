}

@article{frequencyenhanceddynamicgraphc2025,
  author = {L. Wang; J. Zhuang; S. Ma; H. Lin},
  title = {{Frequency} {Enhanced} {Dynamic} {Graph} {Convolutional} {Networks} for {Traffic} {Flow} {Forecasting}},
  journal = {IEEE Access},
  year = {2025},
