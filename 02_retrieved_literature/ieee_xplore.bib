@article{realtimerobuststateestimationf2025,
  author = {S. Li; W. Li; L. Chen; H. Jiang},
  title = {{Real-time} {Robust} {State} {Estimation} for {Large-scale} {Low-observability} {Power-transportation} {System} {Based} on {Meta} {Physics-informed} {Graph} {TimesNet}},
  journal = {2025 IEEE Power \& Energy Society General Meeting (PESGM)},
  year = {2025},
  pages = {1--1},
  doi = {10.1109/PESGM52009.2025.11225455},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11225455},
  abstract = {The rapid growth rate (91.6%/year) and widespread integration of Electric Vehicle Charging Stations (EVCSs) introduce substantial challenges to the Power Distribution System (PDS). Highly fluctuating and large-scale charging loads can potentially instigate system instability, imbalance, and even grid failure. To ensure the safe and stable operation of the PDS, real-time monitoring of its status is essential. However, accurately perceiving the PDS is challenged by the dynamic characteristics of the PDS topology, especially in large-scale PDSs. The key to analyzing these dynamic characteristics in PDS topology is to decouple their spatio-temporal heterogeneity. Therefore, incorporating the spatio-temporal heterogeneity of the PDS topology into the Distribution System State Estimation (DSSE) model is crucial for accurate predictions.To better simulate the impact of widespread integration of EVCSs, we first incorporate the Urban Transportation System (UTS) into the PDS to construct a Power-Transportation System (PTS) that closely approximates a real regional PDS. Concretely, to convert traffic flow data into charging demand for EVCSs, a Traffic Flow Conversion Model (TFCM) based on Latin Hypercube Sampling (LHS) and Monte Carlo simulation is devised. This model enables the estimation of the charging load based on the observed traffic patterns. Then, we fuse power data and traffic flow data from two similar regions. The main factors we analyze to determine these combinations include climate conditions, economic development, and regional scale, as these factors are strongly correlated with regional power consumption and EV charging patterns.In this study, a novel model named Meta Physics-informed Graph TimesNet (MPGTN) is proposed, aiming to decouple the spatio-temporal heterogeneity of PDS states under low-observability and enable robust state estimation by leveraging relatively complete pseudo-measurements. This model effectively learns the dynamic topology of the PDS and captures the spatio-temporal correlations of the PTS state. It combines Graph Convolutional Networks and TimesNet as the foundational modules for building an encoder-decoder framework. Additionally, to capture the spatio-temporal heterogeneity of the PTS state, we insert a meta physics-informed graph bank into the encoder-decoder framework. Subsequently, power flow calculations are performed on the predicted power to reduce error accumulation.Considering factors such as climate conditions, and regional scale, we fuse the IEEE 8500-node test feeder and the UTD19 traffic system through EVCSs to build a new large-scale PTS.Our model decouples and analyzes the temporal and spatial heterogeneity of the PTS states using the instantaneous frequency domain and the meta physics-informed graph bank, respectively. Extensive numerical simulations across various situations validate the effectiveness and robustness of our proposed model for PTSs. Performance comparisons with other deep learning methods demonstrate the superior performance of our model.},
  publisher = {IEEE},
  isbn = {979-8-3315-0995-8},
  issn = {1944-9933},
}

@article{amodeldatadualdrivenresourceal2025,
  author = {T. Yu; S. Wang; S. Zhang; X. Chen; Z. Xu; X. Wang; J. Li; J. Liu; S. Zhang},
  title = {{A} {Model-Data} {Dual-Driven} {Resource} {Allocation} {Scheme} for {IREE} {Oriented} {6G} {Networks}},
  journal = {IEEE Internet of Things Journal},
  year = {2025},
