  title = {{Bridging} {Trajectory-Aware} {Evolutionary} {Graph} {Learning} and {Large} {Language} {Models} for {Enhancing} {Navigability} in {Social} {Internet} of {Things}},
  journal = {IEEE Internet of Things Journal},
  year = {2025},
  volume = {12},
