  abstract = {Logistics Management Information Systems (LMIS) increasingly require closed-loop intelligence to handle stochastic order arrivals, traffic variability, and operational constraints. This paper proposes a digital-twin-driven LMIS (DT-LMIS) that couples perception, prediction, and constrained decision-making in a unified pipeline. First, an eventsynchronized Digital Twin (DT) maintains a consistent state of depots, stations, vehicles, and orders via rule-based bookkeeping with a learned residual to compensate for stochastic delays and micro-congestion. Second, a spatiotemporal Transformer forecasts multi-horizon demand, workload, and ETA-related signals to enable anticipatory control. Third, a temporal graph learning module models timeevolving interactions (assignment, proximity, handover) and produces relational risk representations for delay and congestion. Finally, dispatching is formulated as a constrained Markov decision process and optimized using a primalâdual constrained reinforcement learning scheme with feasibility projection to satisfy capacity, time-window, and throughput constraints. Simulation-based experiments show that DT-LMIS consistently reduces multi-horizon forecasting MAE and end-toend operational cost, while lowering constraint-violation rates compared with spatio-temporal baselines and ablated variants.},
  publisher = {IEEE},
  isbn = {979-8-3315-5909-0},
  keywords = {logistics management information system (LMIS);digital twin (DT);spatio-temporal transformer;dynamic graph neural network ($G N N$);constraint-aware deep reinforcement learning (DRL);dynamic vehicle routing problem (VRP)},
}

