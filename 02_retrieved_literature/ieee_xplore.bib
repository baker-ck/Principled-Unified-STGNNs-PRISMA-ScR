@article{pedgtenhancingpedestrianintent2025,
  author = {M. N. Riaz; M. Wielgosz; C. Xie; A. M. LÃ³pez},
  title = {{PedGT:} {Enhancing} {Pedestrian} {Intention} {Prediction} {Using} a {Skeleton-Based} {Graph-Transformer}},
