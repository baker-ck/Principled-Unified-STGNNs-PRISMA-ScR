  doi = {10.1109/BigData66926.2025.11401861},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11401861},
  abstract = {Double-entry bookkeeping data (DBD) are a type of big data inherent to organizations that systematically record daily transactions. These data are characterized by two components: temporal information, pertaining to the time series of accounts, and spatial information, which refers to the connections between accounts. However, methods for handling this spatiotemporal information and leveraging it for forecasting are not well-established. This study addressed this issue through the practical application of 31-day-ahead cashflow forecasting, a crucial task for cash management. A spatiotemporal graph convolutional network (STGCN) was employed to learn from spatiotemporal information within DBD and evaluate its forecasting accuracy over a 365-day period. Experiments with actual DBD from seven clinics revealed that for six of them, the STGCN achieved a low average forecasting error (mean absolute percentage error = 8.0%) compared with other methods. However, for a single clinic, the model produced a substantial forecasting error of > 400%. Although additional analyses were conducted assuming that structural changes owing to large-scale debt or inadequate learning periods were the cause, these factors could not be confirmed. Consequently, we recommend the practical application of a univariate long short-term memory model, which exhibited stable performance with an average error of 8.9 % across all seven clinics. Future work should investigate the accounting characteristics that influence forecasting accuracy using DBD from more organizations. To ensure reproducibility with this hard-toobtain data, our experiments also incorporated a synthetic DBD dataset (https://commons.sk.tsukuba.ac.jp/data_en) published by us. The results, combined with the proposed framework, provide a foundational basis for subsequent research in this field.},
  publisher = {IEEE},
  isbn = {979-8-3315-9447-3},
  issn = {2573-2978},
  keywords = {journal entry;trial-balance sheet;cross-reference;graph convolutional network;synthetic data},
}

@article{transferlearningwithspatialtem2026,
  author = {X. Yu; Y. Bao; W. Jiang; Q. Shi},
  title = {{Transfer} {Learning} {With} {SpatialâTemporal} {Synchronous} {Graph} {Sample} and {Aggregation} for {Traffic} {Prediction}},
  journal = {IEEE Internet of Things Journal},
  year = {2026},
  volume = {13},
  number = {9},
  pages = {18090--18106},
  doi = {10.1109/JIOT.2025.3628859},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11224834},
  abstract = {Accurate traffic prediction is crucial for intelligent transportation systems (ITS) and urban mobility optimization. Despite substantial progress in prior research, existing methods face limitations in capturing detailed spatialâtemporal synchronous features and delivering precise predictions in data-deficient regions. To address these challenges, this study introduces transfer learning with spatialâtemporal synchronous graph sample and aggregation (TLSTS-GraphSAGE), a novel model designed to enhance predictive accuracy in cross-region traffic forecasting. Specifically, TLSTS-GraphSAGE constructs spatialâtemporal synchronous graphs (STSGs) to learn intricate spatial and temporal dependencies. Then, a generative adversarial network (GAN)-based transfer learning mechanism is employed to facilitate prediction in the data-deficient target region by utilizing data from the source region. This mechanism integrates a parameter-shared spatialâtemporal synchronous GraphSAGE generator enhanced by attention coefficients for improved feature aggregation and a Wasserstein distance-based similarity discriminator for effective domain alignment. These components enable robust and transferable spatialâtemporal representations, ultimately producing accurate forecasts via the prediction layer. Beyond predictive accuracy, the proposed framework also supports intent-driven networking in smart transportation by enabling traffic-aware decision-making and adaptive resource coordination across regions. Extensive experiments are conducted on six cross-region prediction tasks derived from three real-world datasets. Results show that TLSTS-GraphSAGE consistently outperforms state-of-the-art baselines, achieving average improvements of 4.64%, 3.48%, and 5.06% in mean absolute error (MAE), mean absolute percentage error (MAPE), and root-mean-squared error (RMSE), respectively. These results highlight its potential to address the challenges of heterogeneous and data-limited scenarios while contributing to intelligent and adaptive network management in transportation systems (ITSs).},
  publisher = {IEEE},
  issn = {2327-4662},
  keywords = {Graph sample and aggregation;spatial âtemporal synchronous;traffic prediction;transfer learning},
}

@article{thetrafficflowpredictionbasedo2025,
  author = {T. Zhou; J. Liu; Y. Tian; X. Yang; Q. Zhang; M. Ou},
  title = {{The} {Traffic} {Flow} {Prediction} {Based} on {GR-KAT}},
  journal = {2025 IEEE 5th International Conference on Control Theory and Applications (ICoCTA)},
  year = {2025},
  pages = {1--8},
  doi = {10.1109/ICoCTA66834.2025.11337793},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11337793},
  abstract = {In order to solve the problems of insufficient accuracy, excessive number of model parameters and low computational efficiency of traditional Transformer model in traffic flow prediction task, an improved spatiotemporal Transformer model based on grouped rational KAN (GR-KAN) (GR-KAT) was proposed. By designing a GR-KAN layer activated by grouping rational functions, a dynamic parameter sharing strategy and a spatio-temporal attention mechanism can be designed based on the characteristics of traffic scenarios, replacing the MLP layer in the traditional model and achieving higher accuracy prediction. Experiments on the PEMS04 actual dataset show that compared with the suboptimal model, the average error value of the model is reduced by 10.13%, the number of training parameters is reduced by 41.65%, and the contribution of key road sections is interpretable. The GR-KAT model can not only improve the accuracy of traffic flow prediction, but also bring significant advantages in terms of resource utilization and model interpretability, so as to more effectively cope with the complex traffic flow prediction challenges in the near signal area.},
  publisher = {IEEE},
  isbn = {979-8-3315-1529-4},
  keywords = {transformer-KAN;traffic flow prediction;attention mechanism;traffic optimization;intelligent transportation system},
}

@article{dagcandecoupledadaptivegraphco2025,
  author = {Q. Yuan; J. Wang; Y. Han; Z. Liu; W. Liu},
  title = {{DAGCAN:} {Decoupled} {Adaptive} {Graph} {Convolution} {Attention} {Network} for {Traffic} {Forecasting}},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  year = {2025},
  volume = {26},
  number = {3},
  pages = {3513--3526},
  doi = {10.1109/TITS.2025.3531665},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=10874891},
  abstract = {It is necessary to establish a spatio-temporal correlation model in the traffic data to predict the state of the transportation system. Existing research has focused on traditional graph neural networks, which use predefined graphs and have shared parameters. But intuitive predefined graphs introduce biases into prediction tasks and the fine-grained spatio-temporal information can not be obtained by the parameter sharing model. In this paper, we consider it is crucial to learn node-specific parameters and adaptive graphs with complete edge information. To show this, we design a model based on graph structure that decouples nodes and edges into two modules. Each module extracts temporal and spatial features simultaneously. The adaptive node optimization module is used to learn the specific parameter patterns of all nodes, and the adaptive edge optimization module aims to mine the interdependencies among different nodes. Then we propose a Decoupled Adaptive Graph Convolution Attention Network for Traffic Forecasting (DAGCAN), which relies on the above two modules to dynamically capture the fine-grained spatio-temporal relationships in traffic data. Experimental results on four public transportation datasets, demonstrate that our model can further improve the accuracy of traffic prediction.},
  publisher = {IEEE},
  issn = {1558-0016},
  keywords = {Traffic forecasting;GNN;attention mechanism},
}

@article{enhancingtrafficpredictionusin2025,
  author = {K. Deng; X. Zhang; J. Yan; J. Li},
  title = {{Enhancing} {Traffic} {Prediction} {Using} {Spatio-Temporal} {Convolutional} {Network} with {Multi-Periodic} {Input} and {Attention-based} {Scoring}},
  journal = {2025 International Joint Conference on Neural Networks (IJCNN)},
  year = {2025},
  pages = {1--8},
  doi = {10.1109/IJCNN64981.2025.11228707},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11228707},
  abstract = {Highly accurate traffic flow prediction is an important portion of intelligent transport systems. However, current approaches often rely on a single neural network or a temporal attention mechanism to capture temporal features, failing to fully exploit the multidimensional nature of temporal information. This paper proposes a traffic prediction method using spatio-temporal convolutional network with multi-periodic input and attention-based scoring (MITACG). It divides traffic flow data into three temporal dimensions: the proximity, daily periodicity and weekly periodicity matrices are extracted from the high-dimensional multi-node historical traffic flow data; in addition, a specially structured temporal attention mechanism is constructed, which quantifies the impact of different historical moments on target nodes after the GRU, thus improving the utility of temporal information. Extensive experiments on two real-world traffic datasets show that our method outperforms the baselines in MAE, MRSE and MAPE, verifing its accuracy and reliability.},
  publisher = {IEEE},
  isbn = {979-8-3315-1042-8},
  issn = {2161-4407},
  keywords = {Mutlidimensional temporal features;Spatial convolution;Attention mechanism;Traffic flow prediction},
}

@article{attentiongraphneuralcontrolled2025,
  author = {C. Yao; W. Zhou},
  title = {{Attention} {Graph} {Neural} {Controlled} {Differential} {Equations} {Approach} for {Traffic} {Flow} {Forecasting}},
  journal = {2025 IEEE 6th International Conference on Pattern Recognition and Machine Learning (PRML)},
  year = {2025},
  pages = {402--410},
  doi = {10.1109/PRML66062.2025.11159776},
  url = {https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11159776},
  abstract = {With the development of intelligent transportation systems, traffic flow prediction on complex traffic networks has become increasingly important, particularly in urban management and traffic planning, where it holds significant practical value. Existing traffic flow prediction methods primarily rely on stacking discrete modules to enhance prediction accuracy. However, the discontinuous hidden state trajectories between discrete modules may result in increased numerical errors and insufficient precision in capturing dynamic changes. Neural controlled differential equations (NCDEs), which can continuously adjust hidden state trajectories based on control signals, effectively address these issues. For this, we propose an Attention Graph Neural Controlled Differential Equations model (AG-NCDE). Specifically, the model first employs an attention controlled differential equation to model continuous-time dependencies. Then, it integrates high-dimensional spatiotemporal features through continuous dynamic spatiotemporal embeddings to construct a dynamic spatiotemporal graph. Finally, the spatial features are propagated using a graph controlled differential equation. The proposed AG-NCDE model is evaluated through comparative experiments on four public datasets: PEMS03, PEMS04, PEMS07, and PEMS08. The results demonstrate that the model exceeds most baseline models across three different metrics in terms of overall prediction performance. Additionally, it exhibits superior results in handling missing data.},
  publisher = {IEEE},
  isbn = {979-8-3503-9258-6},
  keywords = {traffic flow forecasting;spatio-temporal embedding;neural controlled differential equations;graph convolution network},
}

@article{spatiotemporalawaremodelbasedo2025,
  author = {Y. Sheng},
  title = {{Spatio-Temporal} {Aware} {Model} {Based} on {Multi-Scale} {Information} {Aggregation}},
  journal = {2025 IEEE 6th International Seminar on Artificial Intelligence, Networking and Information Technology (AINIT)},
  year = {2025},
  pages = {1--5},
