month = jan,
articleno = {10},
numpages = {20},
keywords = {Multimodal Machine Learning(MML), Natural Language Processing(NLP), Deep Learning(DL), Fusion Techniques, Cross-Modal}
}

@inproceedings{10.1145/3773365.3773623,
