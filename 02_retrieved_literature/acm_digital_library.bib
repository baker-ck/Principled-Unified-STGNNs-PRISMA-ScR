doi = {10.1145/3765325.3765328},
abstract = {This paper integrates hybrid deep learning and federated learning to propose an interpretable multi-modal knowledge graph (KG) education recommendation system. Using a single representation of textual, behavioral, and temporal data and an LSTM-Transformer architecture, our method achieves 85.6% prediction accuracy while providing 98.7% privacy protection through differential federated learning. The experimental results show real-time processing of 10,000+ kg nodes with &lt;200ms latency and a 68% improvement in instructor judgment efficiency.},
booktitle = {Proceedings of the 2025 3rd International Conference on Educational Knowledge and Informatization},
pages = {7–13},
numpages = {7},
keywords = {Educational recommendation, Federated learning, Interpretable AI, Multi-modal knowledge graph},
