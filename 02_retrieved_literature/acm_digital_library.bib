doi = {10.1145/3786484.3786494},
abstract = {Target tracking technology serves as a crucial driver for enhancing the intelligence of agricultural harvesting robots. This paper systematically reviews deep learning-based target tracking algorithms—categorized into multi-target and single-target tracking—and their applications in agricultural scenarios. We specifically analyze key technical challenges including target occlusion, background interference, and computational constraints, while summarizing cutting-edge solutions. Finally, addressing the practical needs of agricultural robotics, we identify future research directions emphasizing lightweight models, multi-modal data fusion, and self-supervised learning approaches.},
booktitle = {Proceedings of the 2025 International Conference on Artificial Intelligence and Sustainable Development},
pages = {59–63},
numpages = {5},
keywords = {Target tracking, agricultural harvesting robots, deep learning, multi-modal data fusion},
