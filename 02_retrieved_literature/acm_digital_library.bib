@inproceedings{10.1145/3746278.3759383,
author = {Zeng, Xianglong and Jin, Xin and Du, Chenfeng and Wang, Duhe},
title = {PAGD: Pose-Aesthetic Guided Dual-Stage Framework for Pose Recommendation and Beautification},
year = {2025},
isbn = {9798400720604},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3746278.3759383},
doi = {10.1145/3746278.3759383},
abstract = {During the photo-taking process, ordinary users often struggle to find suitable poses, resulting in rigid or aesthetically unappealing images. This issue is particularly prominent in social media, portrait photography, and related fields. Existing methods still exhibit significant limitations: (1) The lack of an efficient attribute-aware pose recommendation fails to adequately account for both user attributes (e.g., gender, age, clothing style) and pose aesthetics principles, thereby limiting the precise selection of optimal poses; (2) During pose transfer, the generated results suffer from deficiencies in fidelity and completeness, particularly in critical details such as background consistency and facial features, which compromises their practical applicability and reference value. To address these challenges, we propose a ''Pose Aesthetics-Guided Dual-Stage Framework'', which jointly optimizes pose recommendation and pose generation to enhance the user experience. In the first stage, we develop a multi-dimensional pose aesthetics scoring model based on Graph Convolutional Networks (GCNs). By integrating user attributes with aesthetics scores annotated by professional photographers, we design an attribute-aware pose recommendation algorithm to accurately retrieve candidate poses from a high-quality pose database. In the second stage, we introduce a detail-sensitive diffusion-based pose transfer model, which adapts the recommended pose to the target user's image. To address background inconsistencies caused by pose transformation, we incorporate a CLIP-VAE-based background completion mechanism to fill missing regions while utilizing a Face Encoder to ensure facial realism and identity consistency. Experimental results demonstrate that our proposed framework achieves superior recommendation accuracy and generation quality on real-world user datasets, significantly outperforming existing methods across multiple evaluation metrics. This study provides a novel solution for attribute-aware pose recommendation and beautification, offering an effective way to enhance the user's photography experience while advancing research in pose aesthetics and generative models.},
booktitle = {Proceedings of the 3rd International Workshop on Multimedia Content Generation and Evaluation: New Methods and Practice},
pages = {63–71},
numpages = {9},
keywords = {attribute-aware pose recommendation, pose beautification, pose aesthetics, diffusion models, graph convolutional networks},
location = {Ireland},
series = {McGE '25}
}

