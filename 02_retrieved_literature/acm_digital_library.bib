series = {ICBTDS '25}
}

@inproceedings{10.1145/3800227.3800334,
author = {Niu, Wenzhe and Yuan, Jian and Zhou, Ziyan},
title = {Research on Value Assessment Methods Integrating Deep Learning},
year = {2026},
isbn = {9798400718724},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3800227.3800334},
doi = {10.1145/3800227.3800334},
abstract = {With the increasing complexity of economic environments and diversification of asset types, traditional value assessment methods face numerous challenges. Deep learning, as a powerful data-driven technology, has emerged as a key tool in value assessment due to its ability to model complex nonlinear relationships. This paper presents a comprehensive review of deep learning-based value assessment methods, covering BP neural networks, recurrent neural networks, convolutional neural networks, attention mechanisms, and multi-model fusion techniques. It thoroughly discusses their applications across financial assets, physical assets, and intangible assets. Using the transportation sector's comprehensive value assessment as a case study, the paper illustrates the potential of deep learning in evaluating non-traditional asset types. Furthermore, the review analyzes current challenges such as data quality, model interpretability, and industry acceptance, and outlines future directions including multimodal fusion, adaptive learning, and lightweight models. This work provides a systematic reference and insights for researchers and practitioners applying deep learning in the value assessment domain.},
booktitle = {Proceedings of the 2025 5th International Conference on Big Data, Artificial Intelligence and Risk Management},
pages = {719–726},
numpages = {8},
keywords = {Deep Learning, Neural Network, Value Assessment},
location = {
},
series = {ICBAR '25}
}

@inproceedings{10.1145/3748522.3779919,
author = {Xing, Xiaolin and Moro, Matteo and Odone, Francesca},
title = {Evaluating the Accuracy of Monocular 3D Pose Estimation for Gait Analysis},
year = {2026},
isbn = {9798400722943},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3748522.3779919},
doi = {10.1145/3748522.3779919},
abstract = {Human gait analysis is a fundamental tool in clinical and rehabilitation contexts, providing insights into neuromotor disorders and functional impairments. While markerless motion capture techniques have advanced considerably with artificial intelligence, the use of monocular video-based approaches for biomechanically informed gait analysis remains underexplored. This study presents preliminary results aimed at evaluating the potential of monocular 3D human pose estimation models for extracting clinically relevant gait features. Specifically, we apply the monocular 3D version of RTMPose and BlazePose to gait sequences and extract joint angle trajectories in the sagittal plane for the hip, knee, and ankle. These estimates are extracted using biomechanical modeling tools (i.e., OpenSim) and compared against results obtained by a multi-view 3D pose estimation pipeline. A comparative analysis of kinematic gait features reveals that, although monocular models can capture general gait dynamics, discrepancies remain when compared to multi-view approaches. These pilot findings offer early insights into the strengths and limitations of monocular pose estimation for gait analysis and highlight the need for further validation before real-life adoption.},
booktitle = {Proceedings of the 41st ACM/SIGAPP Symposium on Applied Computing},
pages = {184–191},
numpages = {8},
keywords = {monocular 3D human pose estimation, markerless gait analysis, joint kinematics, human motion analysis},
location = {Grand Hotel Palace, Thessaloniki, Greece},
series = {SAC '26}
}

@article{10.1145/3749545,
author = {Yang, Tongyun and Regmi, Bishwas and Du, Lingyu and Bulling, Andreas and Zhang, Xucong and Lan, Guohao},
title = {Through the Eyes of Emotion: A Multi-faceted Eye Tracking Dataset for Emotion Recognition in Virtual Reality},
year = {2025},
issue_date = {September 2025},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {9},
number = {3},
url = {https://doi.org/10.1145/3749545},
doi = {10.1145/3749545},
abstract = {Virtual Reality (VR) is transforming cognitive and psychological research by enabling immersive simulations that elicit authentic emotional responses. The high demand for VR-based emotion recognition is also evident in fields such as mental healthcare, education, and entertainment, where understanding users' emotional states can enhance user experience and system effectiveness. However, the lack of comprehensive datasets hinders progress in VR-based emotion recognition. In this paper, we present a comprehensive, multi-faceted eye-tracking dataset collected from 26 participants using 28 emotional video stimuli rendered in a custom virtual environment. Our dataset is the first to incorporate high-frame-rate periocular videos, capturing subtle motions, such as micro-expressions and eyebrow shifts, which are critical for emotion analysis. Additionally, it includes high-frequency eye-tracking data, offering gaze direction and pupil dynamics at four times the frequency of existing datasets. Our dataset is also unique in providing emotion annotations according to Ekman's emotion model and, as such, offering experiments impossible using existing datasets. Our benchmark evaluations show that fusing the multi-faceted eye-tracking signals in our dataset significantly improves emotion recognition accuracy. As such, our work has the potential to significantly accelerate and enable entirely new research on emotion-aware VR applications.},
journal = {Proc. ACM Interact. Mob. Wearable Ubiquitous Technol.},
month = sep,
articleno = {143},
numpages = {41},
keywords = {Dataset, Emotion Recognition, Eye Tracking, Virtual Reality}
}

@inproceedings{10.1145/3696410.3714629,
author = {Hao, Xixuan and Chen, Wei and Zou, Xingchen and Liang, Yuxuan},
title = {Nature Makes No Leaps: Building Continuous Location Embeddings with Satellite Imagery from the Web},
year = {2025},
isbn = {9798400712746},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3696410.3714629},
doi = {10.1145/3696410.3714629},
abstract = {Building location embedding from web-sourced satellite imagery has emerged as an enduring research focus in web mining. However, most existing methods are inherently constrained by their reliance on discrete, sparse sampling strategies, failing to capture the essential spatial continuity of geographic spaces. Moreover, the presence of confounding factors in satellite images can distort the perception of actual objects, leading to semantic discontinuity in the embeddings. In this work, we propose SatCLE, a novel framework for &lt;u&gt;C&lt;/u&gt;ontinuous &lt;u&gt;L&lt;/u&gt;ocation &lt;u&gt;E&lt;/u&gt;mbeddings leveraging &lt;u&gt;Sat&lt;/u&gt;ellite imagery. Specifically, to address the out-of-sample query challenge of spatial continuity, we propose a geospatial refinement strategy comprising stochastic perturbation continuity expansion and graph propagation fusion, which transforms discrete geospatial coordinates into a continuous space. To mitigate the effects of confounders on semantic continuity, we introduce causal refinement, integrating causal theory to localize and eliminate spurious correlations arising from the environmental context. Through extensive experiments, SatCLE shows state-of-the-art performance, exhibiting superior spatial coherence and semantic fidelity across diverse geospatial tasks. The source code is available at https://github.com/CityMind-Lab/SatCLE.},
booktitle = {Proceedings of the ACM on Web Conference 2025},
pages = {2799–2812},
numpages = {14},
keywords = {continuity, location embedding, satellite imagery, web mining},
location = {Sydney NSW, Australia},
series = {WWW '25}
}

@article{10.1145/3786600,
author = {Yu, Shuo and Wang, Yingbo and Li, Ruolin and Liu, Guchun and Shen, Yanming and Ji, Shaoxiong and Li, Bowen and Han, Fengling and Zhang, Xiuzhen and Xia, Feng},
title = {Graph2text or Graph2token: A Perspective of Large Language Models for Graph Learning},
year = {2026},
issue_date = {March 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {44},
number = {3},
issn = {1046-8188},
url = {https://doi.org/10.1145/3786600},
doi = {10.1145/3786600},
abstract = {Graphs are prevalent in numerous real-world applications. Previous methods directly model graph structures and achieve significant success. However, these methods encounter bottlenecks due to the inherent irregularity of graphs. An innovative solution is converting graphs into textual representations, thereby harnessing the powerful capabilities of Large Language Models (LLMs) to process and comprehend graphs. In this article, we present a comprehensive review of methodologies for applying LLMs to graphs, termed LLM4graph. The core of LLM4graph lies in transforming graphs into texts for LLMs to understand and analyze. Thus, we propose a novel taxonomy of LLM4graph methods from the view of the transformation. Specifically, existing methods can be divided into two paradigms: Graph2text and Graph2token, which transform graphs into texts or tokens as the input of LLMs, respectively. We point out four challenges during the transformation to systematically present existing methods from a problem-oriented perspective. For practical concerns, we provide a guideline for researchers on selecting appropriate models and LLMs for different graphs and hardware constraints. To empirically evaluate our taxonomy and different technical choices, we conduct experiments with representative methods in Graph2text and Graph2token. We also identify five future research directions for LLM4graph.},
journal = {ACM Trans. Inf. Syst.},
month = feb,
articleno = {57},
numpages = {49},
keywords = {Graph data, Large language model, Graph to text, Graph to token, Graph learning}
}

@inproceedings{10.1145/3800227.3800324,
author = {Guo, Tianli and Lu, Rui and Zhang, Tao},
title = {AI in Criminal Investigation: A Review},
year = {2026},
isbn = {9798400718724},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3800227.3800324},
doi = {10.1145/3800227.3800324},
abstract = {With the rapid development of information technology, artificial intelligence (AI) has become a transformative force in criminal case investigation. This review systematically synthesizes the application of AI in criminal investigation, focusing on its technical foundations, practical applications, core challenges, and development prospects. The core technical underpinnings include machine learning, deep learning, natural language processing, and computer vision, which enable intelligent analysis of case-related information by simulating human cognitive processes. In practical scenarios, AI empowers clue mining through massive information screening, enhances evidence analysis consistency, improves suspect tracking accuracy and speed, and supports case reasoning and trend prediction. Key challenges involve technical bottlenecks in complex scenarios, sensitive data security risks, privacy-related ethical dilemmas, and inadequate legal regulations. Corresponding solutions and development directions are proposed to fully leverage AI's potential, providing a theoretical and practical reference for optimizing criminal investigation efficiency and quality.},
booktitle = {Proceedings of the 2025 5th International Conference on Big Data, Artificial Intelligence and Risk Management},
pages = {656–663},
numpages = {8},
keywords = {Artificial intelligence, criminal cases, criminal investigation, law, machine learning, scenarios},
location = {
},
series = {ICBAR '25}
}

@inproceedings{10.1145/3774904.3792536,
author = {Liu, Zhaowei and Liu, Chang and Yang, Dong and Yan, Weiqing and Song, Yongchao and Jiang, Anzuo},
title = {Collaborative Subgraph Learning based Spectrum Sensing under Partial Observations},
year = {2026},
isbn = {9798400723070},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3774904.3792536},
doi = {10.1145/3774904.3792536},
abstract = {Data-driven spectrum sensing is a key technology for addressing complex challenges in Cognitive Radio Networks (CRNs). Traditional methods are typically designed for simple single-band scenarios and perform poorly in practical wideband applications. In real-world systems, a single Secondary User (SU) is often restricted by energy, time, and hardware capabilities during real-time sensing. Consequently, only local and fragmented frequency information can be obtained. This partial sensing leads to a severe lack of training data. Additionally, the lack of historical records for emerging frequency bands, combined with data incompleteness due to resource constraints, creates training bottlenecks for data-driven models and limits the reliability of sensing. To address these challenges, this paper proposes a novel framework based on Collaborative Subgraph Learning and Hyperbolic Graph Neural Networks (GNNs). This approach enables Secondary Users to perform collaborative sensing through distributed subgraph learning. By utilizing GNNs to extract features and model multi-band correlations, a new distributed GNNs architecture is designed to efficiently detect wideband spectrum occupancy, even with partial observations. Within this framework, all frequency bands in the wideband spectrum pool are treated as a unified graph, while the bands observed by each SU form a subgraph. Subsequently, the complete spectrum graph is constructed through the joint training and aggregation of these subgraphs. By integrating hyperbolic geometry into GNNs, this method better captures the hierarchical structure of spectrum patterns, providing a more accurate and efficient sensing model. Experimental results demonstrate that, compared to the second-best HCNNs model, the proposed framework improves sensing accuracy by 3.8% on average across various test environments, while reducing key resource consumption by 18.4% on average.},
booktitle = {Proceedings of the ACM Web Conference 2026},
pages = {1321–1332},
numpages = {12},
keywords = {spectrum sensing, cognitive radio networks, collaborative subgraph learning, graph neural networks, spectrum occupancy detection},
location = {United Arab Emirates},
series = {WWW '26}
}

@inproceedings{10.1145/3690624.3709209,
author = {Xu, Ronghui and Cheng, Hanyin and Guo, Chenjuan and Gao, Hongfan and Hu, Jilin and Yang, Sean Bin and Yang, Bin},
title = {MM-Path: Multi-modal, Multi-granularity Path Representation Learning},
year = {2025},
isbn = {9798400712456},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3690624.3709209},
doi = {10.1145/3690624.3709209},
abstract = {Developing effective path representations has become increasingly essential across various fields within intelligent transportation. Although pre-trained path representation learning models have shown improved performance, they predominantly focus on the topological structures from single modality data, i.e., road networks, overlooking the geometric and contextual features associated with path-related images, e.g., remote sensing images. Similar to human understanding, integrating information from multiple modalities can provide a more comprehensive view, enhancing both representation accuracy and generalization. However, variations in information granularity impede the semantic alignment of road network-based paths (road paths) and image-based paths (image paths), while the heterogeneity of multi-modal data poses substantial challenges for effective fusion and utilization. In this paper, we propose a novel Multi-modal, Multi-granularity Path Representation Learning Framework (MM-Path), which can learn a generic path representation by integrating modalities from both road paths and image paths. To enhance the alignment of multi-modal data, we develop a multi-granularity alignment strategy that systematically associates nodes, road sub-paths, and road paths with their corresponding image patches, ensuring the synchronization of both detailed local information and broader global contexts. To address the heterogeneity of multi-modal data effectively, we introduce a graph-based cross-modal residual fusion component designed to comprehensively fuse information across different modalities and granularities. Finally, we conduct extensive experiments on two large-scale real-world datasets under two downstream tasks, validating the effectiveness of the proposed MM-Path.},
booktitle = {Proceedings of the 31st ACM SIGKDD Conference on Knowledge Discovery and Data Mining V.1},
pages = {1703–1714},
numpages = {12},
keywords = {multi-modal learning, path representation learning, self-supervised learning},
location = {Toronto ON, Canada},
series = {KDD '25}
}

@inproceedings{10.1145/3772318.3793208,
author = {Hu, Shiang and Zha, Zhiwen and Jia, Dongdong and Hu, Yifan and Liu, Guojun and Lin, Yuhan and Shen, Chao and Lv, Zhao},
title = {A Shared Look: Detecting Deepfakes with Inter-Subject Neural Synchrony},
year = {2026},
isbn = {9798400722783},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3772318.3793208},
doi = {10.1145/3772318.3793208},
abstract = {The rapid evolution of generative AI presents a significant challenge for Deepfake detection. While most research focuses on face-swapping, the emerging threat of "image-to-video" (I2V) forgeries is harder to detect and poses a greater risk. Traditional computer vision detectors rely on transient digital artifacts, which often lack interpretability and robustness against the new generation techniques. This study introduces a neuro-cognitive method, using dyadic electroencephalogram (EEG) to decode the human perception of authenticity. We recorded inter-brain synchrony via EEG hyperscanning from 15 participant pairs as they viewed a balanced set of authentic and AI-generated videos. Results showed that these shared neural response can classify video authenticity with an accuracy of up to 89.23% using our proposed Hyper-FusionNet. In addition, the biomarkers exhibited distinct patterns for different emotional valences, highlighting their versatility. These findings highlight the potential of inter-brain synchrony for detecting emerging deepfakes, offering a new perspective for enhancing user trust and digital literacy.},
booktitle = {Proceedings of the 2026 CHI Conference on Human Factors in Computing Systems},
articleno = {1572},
numpages = {19},
keywords = {Deepfake Detection, EEG, Hyperscanning, Inter-brain Synchronization, Hyper-FusionNet},
location = {
},
series = {CHI '26}
}

@inproceedings{10.1145/3788149.3788221,
author = {Zhang, Boning and Luo, Xinyi and Wu, Chengzhi and Zhao, Qiuduo},
title = {Enhancing Generalization in Deepfake Detection via Frequency and Gradient Representation Fusion},
year = {2026},
isbn = {9798400719622},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3788149.3788221},
doi = {10.1145/3788149.3788221},
abstract = {In recent years, the rapid development of deepfake image generation technology has been associated with an increase in criminal activities, underscoring the urgent requirement for effective deepfake detection methods. While many researchers have carried out related studies, most current deepfake detection models have limited generalization ability. These models usually perform well only on "seen" datasets, yet their accuracy decreases notably when applied to data from other sources. Thus, enhancing the generalization of such models has emerged as a key research direction. To tackle this challenge, this paper proposes a new approach that integrates two models—Frequency Space Learning Network (FreqNet) and Learning on Gradients (LGrad)—through parallel weighted fusion. The strategy that we propose can successfully combine the strengths of gradient-based discriminative features and feature enhancement in the frequency domain. This way, the resulting consolidated model not only preserves a strong sensitivity to generative artifacts but further promotes a strong generalization ability with a robust learning of the space in the frequency domain. A considerable number of experiments conducted on 13 GANs illustrate that the strategy has strong efficacy and can obtain a high generalization accuracy for varying datasets. This study investigates a promising direction for generalizable and robust deepfake detectors.},
booktitle = {Proceedings of the 2025 9th International Conference on Computer Science and Artificial Intelligence},
pages = {374–382},
numpages = {9},
keywords = {Deepfake Detection, Frequency-domain, Generalization, Gradient Maps, Model Fusion},
location = {
},
series = {CSAI '25}
}

@inproceedings{10.1145/3774521.3774529,
author = {Sathiyamoorthy, Dillip and Guha, Prithwijit},
title = {VAD-FedHSM: Video Anomaly Detection in Federated Learning Framework with Local Hard Sample Mining},
year = {2026},
isbn = {9798400719301},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3774521.3774529},
doi = {10.1145/3774521.3774529},
abstract = {Video anomaly detection (VAD) in large-scale real-world surveillance remains challenging. This is due to limited annotations, class imbalance, hard-to-distinguish abnormal events, privacy-sensitive data distributions across multiple sites, and hardware limitations at distributed camera locations. Existing weakly-supervised methods often rely on centralized training with weak labels, ignoring the challenges of hard samples, distributed deployments, privacy, and edge resource constraints. This limits their robustness and real-world applicability. We hypothesize that explicitly focusing on hard-to-classify samples during training, while preserving privacy through federated learning, can significantly improve VAD performance under edge resource constraints. Consequently, we propose a novel iterative framework that integrates Hard Sample Mining (HSM) with Federated Learning (FL). Each client incrementally refines its model by identifying and training on difficult samples during local training. Clients share only model updates to collaboratively improve global performance. Our approach introduces dual-level optimization: (a) client-side hard sample mining to focus learning on ambiguous samples, and (b) global model fusion to leverage knowledge across diverse clients. Furthermore, we simulate realistic non-i.i.d client data partitions based on scene and event distributions from the UCF-Crime dataset. Extensive experiments demonstrate that our method consistently outperforms baseline models and multiple federated variants, achieving superior results in terms of ROC-AUC metrics on the UCF-Crime dataset. The implementation details and source code for VAD-FedHSM are publicly available at .},
booktitle = {Proceedings of the Sixteen Indian Conference on Computer Vision, Graphics and Image Processing},
articleno = {7},
numpages = {10},
keywords = {Video Anomaly Detection, Federated Learning, Hard Sample Mining, Weak Supervision, UCF-Crime},
location = {
},
series = {ICVGIP '25}
}

@article{10.14778/3801059.3801073,
author = {Huang, Wenjie and Wang, Rui and Cao, Jing and Zheng, Tongya and Wang, Xinyu and Song, Mingli and Wu, Sai and Chen, Chun},
title = {FlareDTDG: Harnessing Temporal Recency for Scalable Discrete-Time Dynamic Graph Training},
year = {2026},
issue_date = {March 2026},
publisher = {VLDB Endowment},
volume = {19},
number = {7},
issn = {2150-8097},
url = {https://doi.org/10.14778/3801059.3801073},
doi = {10.14778/3801059.3801073},
abstract = {Discrete-time dynamic graphs (DTDGs), modeled as snapshot sequences, are widely used to capture temporal evolution in relational systems. Scaling DTDG training remains challenging: full-batch methods incur prohibitive memory and communication costs, while sampling or offloading often sacrifices accuracy or efficiency. A major limitation of existing frameworks is that they treat all snapshots equally, ignoring the temporal recency effect, where recent snapshots are typically far more predictive than older ones. We introduce FlareDTDG, a distributed framework that exploits temporal recency for efficient and scalable training. Its core is hybrid batching with temporal decay, which applies full-batch processing to recent snapshots, while progressively coarsely sampling older ones to form hybrid batches. We also integrate two co-designed optimizations: fast graph reconstruction via shrinking to eliminate cross-snapshot remapping, and adaptive comm-comp overlap scheduling to reduce synchronization overhead. Experiments show FlareDTDG achieves 1.4–2.5 times faster training and 10–85% lower GPU memory usage than full-batch baselines, while preserving accuracy. It also scales to graphs with 100M nodes per snapshot, where existing systems fail due to memory limits or degraded performance.},
journal = {Proc. VLDB Endow.},
month = jul,
pages = {1614–1627},
numpages = {14}
}

@article{10.1145/3789682,
author = {Hu, Qingyong and Zhou, Yuxuan and Wang, Jinjian and Gong, Yanbin and Zhang, Yizhen and Sun, Jingnan and Yao, Jian and Shao, Qijia and Qiu, Lili and Zhang, Qian and Li, Guihua},
title = {The EasyCog Dataset: Towards Easier Cognitive Assessment with Passive Video Watching},
year = {2026},
issue_date = {March 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {10},
number = {1},
url = {https://doi.org/10.1145/3789682},
doi = {10.1145/3789682},
abstract = {As the global population ages, the prevalence of cognitive impairment continues to rise, highlighting the urgent need for accessible and low-burden cognitive assessment. Current assessments based on clinical scales are often hindered by subjectivity, significant user burden, and practice effects, limiting their applicability. We observe that passive visual stimuli can engage multiple cognitive domains while minimizing the need for active participation. Considering the lack of related datasets, we establish EasyCog, the first large-scale multimodal dataset for low-burden cognitive assessments. EasyCog collects synchronized forehead/ear EEG and contactless eye tracking data while participants passively view a short, cognitively structured video followed by an eyes-closed rest. The dataset includes 101 participants spanning healthy controls and patients with PD, AD, and VaD, with clinician-administered MoCA/MMSE scores collected in daily settings. We provide detailed collection procedures, quality validation, implementation, and benchmark baselines. Results indicate assessment feasibility while highlighting generalization challenges. By integrating passive visual stimuli with affordable sensing, EasyCog provides a foundation for future research in accessible and scalable cognitive monitoring in both clinical and community settings.},
journal = {Proc. ACM Interact. Mob. Wearable Ubiquitous Technol.},
month = mar,
articleno = {4},
numpages = {28},
keywords = {Datasets, Cognitive Assessment, Human Electrical Signal}
}

@inproceedings{10.1145/3690624.3709173,
author = {Li, Zhihao and Song, Haoze and Xiao, Di and Lai, Zhilu and Wang, Wei},
title = {Harnessing Scale and Physics: A Multi-Graph Neural Operator Framework for PDEs on Arbitrary Geometries},
year = {2025},
isbn = {9798400712456},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3690624.3709173},
doi = {10.1145/3690624.3709173},
abstract = {Partial Differential Equations (PDEs) underpin many scientific phenomena, yet traditional computational approaches often struggle with complex, nonlinear systems and irregular geometries. This paper introduces the AMG method, a Multi-Graph neural operator approach designed for efficiently solving PDEs on Arbitrary geometries. AMG leverages advanced graph-based techniques and dynamic attention mechanisms within a novel GraphFormer architecture, enabling precise management of diverse spatial domains and complex data interdependencies. By constructing multi-scale graphs to handle variable feature frequencies and a physics graph to encapsulate inherent physical properties, AMG significantly outperforms previous methods, which are typically limited to uniform grids. We present a comprehensive evaluation of AMG across six benchmarks, demonstrating its consistent superiority over existing state-of-the-art models. Our findings highlight the transformative potential of tailored graph neural operators in surmounting the challenges faced by conventional PDE solvers. Our code and datasets are available on https://github.com/lizhihao2022/AMG.},
booktitle = {Proceedings of the 31st ACM SIGKDD Conference on Knowledge Discovery and Data Mining V.1},
pages = {729–740},
numpages = {12},
keywords = {geometric learning, neural operator, partial differential equations},
location = {Toronto ON, Canada},
series = {KDD '25}
}

@article{10.14778/3742728.3742749,
author = {Zhang, Wentao and Wang, Jingyuan and Yang, Yifan and U, Leong Hou},
title = {VecCity: A Taxonomy-Guided Library for Map Entity Representation Learning},
year = {2025},
issue_date = {April 2025},
publisher = {VLDB Endowment},
volume = {18},
number = {8},
issn = {2150-8097},
url = {https://doi.org/10.14778/3742728.3742749},
doi = {10.14778/3742728.3742749},
abstract = {Electronic maps consist of diverse entities, such as points of interest (POIs), road segments, and land parcels, playing a vital role in applications like ITS and LBS. Map entity representation learning (MapRL) generates versatile and reusable data representations, providing essential tools for efficiently managing and utilizing map entity data. Despite the progress in MapRL, two key challenges constrain further development. First, existing research is fragmented, with models classified by the type of map entity, limiting the reusability of techniques across different tasks. Second, the lack of unified benchmarks makes systematic evaluation and comparison of models difficult. To address these challenges, we propose a novel taxonomy for MapRL that organizes models based on functional modules—such as encoders, pre-training tasks, and downstream tasks—rather than by entity type. Building on this taxonomy, we present a taxonomy-driven library, VecCity, which offers easy-to-use interfaces for encoding, pre-training, fine-tuning, and evaluation. The library integrates datasets from nine cities and reproduces 21 mainstream MapRL models, establishing the first standardized benchmarks for the field. VecCity also allows users to modify and extend models through modular components, facilitating seamless experimentation. Our comprehensive experiments cover multiple types of map entities and evaluate 21 VecCity pre-built models across various downstream tasks. Experimental results demonstrate the effectiveness of VecCity in streamlining model development and provide insights into the impact of various components on performance. By promoting modular design and reusability, VecCity offers a unified framework to advance research and innovation in MapRL. The code is available at https://github.com/Bigscity-VecCity/VecCity.},
journal = {Proc. VLDB Endow.},
month = apr,
pages = {2575–2588},
numpages = {14}
}

@inproceedings{10.1145/3807211.3807212,
author = {Chen, Minli and Ren, Dongyan},
title = {Research on Trajectory Optimization for Autonomous Driving Based on Deep Recurrent Neural Networks},
year = {2026},
isbn = {9798400722165},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3807211.3807212},
doi = {10.1145/3807211.3807212},
abstract = {Autonomous driving in complex scenarios is fundamentally challenged by environmental perception uncertainty and the inherent gradient explosion and vanishing problems in traditional Recurrent Neural Networks (RNNs). To overcome these hurdles, this study introduces a trajectory optimization method centered on a deeply integrated recurrent neural network architecture.This method establishes an end-to-end control system that takes into account both prediction accuracy and computational feasibility. The system uses a network combining RNN ( Recurrent Neural Network ) and LSTM ( Long Short-Term Memory ).In this framework, the RNN distills local temporal features, which are then processed by the LSTM to derive a holistic trajectory representation, effectively capturing long-term dependencies within the feature sequence and dynamically focus on key information. Experimental validation on the nuScenes dataset demonstrates that our system markedly enhances both trajectory prediction accuracy and adaptability in extreme scenarios, presenting a highly efficient, integrated perception-decision solution for Level 4 autonomous driving.It also clarifies further optimization directions for high-dynamic interactions and sensor degradation scenarios.},
booktitle = {Proceedings of the 2026 3rd International Conference on Autonomous Driving and Intelligent Sensing Technology},
pages = {1–8},
numpages = {8},
keywords = {Deep recurrent neural network, end-to-end control system, network combining RNN and LSTM},
location = {
},
series = {ADIST '26}
}

@inproceedings{10.1145/3766918.3766955,
author = {Li, Bing},
title = {Online Transaction Fraud Detection Using Multimodal Feature Engineering and Optimized LightGBM},
year = {2025},
isbn = {9798400716027},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3766918.3766955},
doi = {10.1145/3766918.3766955},
abstract = {Online transaction fraud detection faces significant challenges, such as severe class imbalance, feature heterogeneity, and the necessity for real-time inference. In this study, we introduce a hybrid framework that combines multimodal feature engineering with an enhanced LightGBM model. Key contributions include a cyclic spatiotemporal encoding scheme to capture temporal fraud patterns, a regex-driven device fingerprint parser with knowledge graph-based risk profiling, and a dynamic class weighting mechanism specifically designed for evolving fraud trends. Experiments on the IEEE-CIS benchmark show that our framework achieves an AUC of 0.968—surpassing strong baselines by 12.6%—while ensuring low inference latency (3 ms) and an exceptionally low false positive rate (0.7%). Our results provide robust evidence for the framework's effectiveness in real-world, large-scale online fraud detection scenarios.},
booktitle = {Proceedings of the 2025 International Conference on Generative Artificial Intelligence for Business},
pages = {226–231},
numpages = {6},
keywords = {Class imbalance, Device fingerprint, LightGBM, Multimodal feature engineering, Online transaction fraud},
location = {
},
series = {GAIB '25}
}

@inproceedings{10.1145/3762249.3762266,
author = {Shi, Xianao},
title = {AI-enabled Coal Supply Chain Financial Credit Assessment and Loan Optimization Based on Multi-source Data Fusion},
year = {2025},
isbn = {9798400713491},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3762249.3762266},
doi = {10.1145/3762249.3762266},
abstract = {In response to the problem of incomplete credit assessment caused by multi-source data silos in the current coal supply chain finance field, this study proposes an AI-enabled credit assessment and loan optimization system under multi-source data fusion. By constructing a four-dimensional data fusion layer (production-end sensor data, logistics GPS trajectory, transaction electronic invoice, and external price/policy data), using knowledge graphs to model the supply chain topology network, and using federated learning to achieve cross-enterprise data privacy protection. A hybrid AI evaluation model is designed, integrating LightGBM/XGBoost to process structured data and GNN to extract supply chain guarantee relationship characteristics, and combined with SHAP interpretable analysis to reveal that inventory turnover rate and price fluctuation sensitivity are core risk factors. The innovative introduction of reinforcement learning dynamic credit algorithm allows the credit limit to be adjusted in real time with coal price fluctuations, and the deployment of blockchain smart contracts enables automatic loan release after goods delivery. Empirical evidence shows that the system has increased the credit assessment F1 value to 91.2%, reduced the bad debt rate to 1.18%, and shortened the loan decision-making time to 2.1 hours, providing a new paradigm of data collaborative governance and intelligent decision-making for coal supply chain financial risk management.},
booktitle = {Proceedings of the 2025 2nd International Conference on Digital Economy, Blockchain and Artificial Intelligence},
pages = {96–100},
numpages = {5},
keywords = {Coal Supply Chain, Financial Credit Assessment, LightGBM+CGBoost, Loan Optimization, Multivariate Fusion Data},
location = {
},
series = {DEBAI '25}
}

@inproceedings{10.1145/3786484.3786494,
author = {Liu, Changwen},
title = {Advancing Computer Vision through Target Tracking in Agricultural Harvesting Robots},
