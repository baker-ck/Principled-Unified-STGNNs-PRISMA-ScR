series = {ICAISM '25}
}

@article{10.1145/3712278,
author = {Thukral, Megha and Dhekane, Sourish Gunesh and Hiremath, Shruthi K. and Haresamudram, Harish and Ploetz, Thomas},
title = {Layout-Agnostic Human Activity Recognition in Smart Homes through Textual Descriptions Of Sensor Triggers (TDOST)},
year = {2025},
issue_date = {March 2025},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {9},
number = {1},
url = {https://doi.org/10.1145/3712278},
doi = {10.1145/3712278},
abstract = {Human activity recognition (HAR) using ambient sensors in smart homes has numerous applications for human healthcare and wellness. However, building general-purpose HAR models that can be deployed to new smart home environments requires a significant amount of annotated sensor data and training overhead. Most smart homes vary significantly in their layouts, i.e., floor plans and the specifics of sensors embedded, resulting in low generalizability of HAR models trained for specific homes. We address this limitation by introducing a novel, layout-agnostic modeling approach for HAR systems in smart homes that utilizes the transferrable representational capacity of natural language descriptions of raw sensor data. To this end, we generate Textual Descriptions Of Sensor Triggers (TDOST) that encapsulate the surrounding trigger conditions and provide cues for underlying activities to the activity recognition models. Leveraging textual embeddings, rather than raw sensor data, we create activity recognition systems that predict standard activities across homes without (re-)training or adaptation to target homes. Through an extensive evaluation, we demonstrate the effectiveness of TDOST-based models in unseen smart homes through experiments on benchmark Orange4Home and CASAS datasets. Furthermore, we conduct a detailed analysis of how the individual components of our approach affect downstream activity recognition performance.},
journal = {Proc. ACM Interact. Mob. Wearable Ubiquitous Technol.},
month = mar,
articleno = {19},
numpages = {38},
keywords = {human activity recognition, smart homes}
}

@inproceedings{10.1145/3743093.3770974,
author = {Lou, Zhenhui and Zhang, Xia and Li, Fengjie and Ye, Jiangtao and Jiang, Xiaoping and Cheng, Zhenbo},
title = {SAAB: Enhancing Action Segmentation via Spatial Attention Pooling and Action-Background Classifier},
year = {2025},
isbn = {9798400720055},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3743093.3770974},
doi = {10.1145/3743093.3770974},
abstract = {Action segmentation aims to assign accurate action labels to each frame in a video, and plays an important role in behavior understanding, video surveillance, and human-computer interaction. However, existing methods mainly focus on modeling temporal dependencies while paying little attention to spatial information within frames. This limitation leads to insufficient representation of key regions that are crucial for recognizing complex hand movements or human-object interactions. In addition, the transitions between action and background frames are often ambiguous, which further reduces segmentation accuracy. To address these challenges, we propose SAAB, a new action segmentation framework that combines Spatial Attention Pooling and an Action-Background Classifier. The spatial attention pooling module performs weighted fusion of features from different spatial regions to enhance intra-frame structural awareness. At the same time, the action-background classifier explicitly separates action frames from background frames, improving the reliability of frame-level predictions. Extensive experiments on multiple benchmark datasets show that SAAB clearly improves segmentation performance and can be easily integrated into various existing segmentation models, demonstrating its effectiveness and generality.},
booktitle = {Proceedings of the 7th ACM International Conference on Multimedia in Asia},
articleno = {30},
numpages = {7},
keywords = {Action segmentation, Spatial attention pooling, Prediction probability refinement},
location = {
},
series = {MMAsia '25}
}

@inproceedings{10.1145/3764727.3764761,
author = {Lin, Riqi and Zhu, Jingxin and Qiu, Guozhan and Ren, Jiuchun},
title = {Basketball Video Analysis Based on YOLO and Transformer Framework},
year = {2025},
isbn = {9798400714955},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3764727.3764761},
doi = {10.1145/3764727.3764761},
abstract = {In recent years, the combination of deep learning and computer vision has made intelligent motion analysis a reality, enabling people to automatically and accurately detect the behavior of athletes in various situations. In such a complex and changeable basketball game, to correctly evaluate the performance of athletes, formulate appropriate strategies according to the game situation, and conduct front-court analysis of the game and other target reports, all require corresponding technologies that can achieve accurate action recognition. However, traditional analysis mainly relies on manual observation or wearing sensors, which is difficult to avoid errors, inefficient, and not universal in the real world. This paper proposes a method for identifying actions in basketball videos, which combines the real-time performance of YOLOv11 object detection with the complexity of Transformer-based architecture. First, YOLOv11 is used to obtain high-quality visual features and regions of interest (ROIs), and then an enhanced Transformer equipped with fuzzy logic layers is used to capture long-term temporal connections and contextual clues from video sequences, thereby achieving accurate action classification. In order to maintain the robust performance of the model under input noise and/or various dynamic conditions, median filtering is used as an initial preprocessing step. The proposed method significantly outperforms established architectures such as traditional CNN, 3D CNN, and CNN-LSTM. This is particularly evident in challenging scenarios involving occlusions, fast transitions, and subtle pose changes. Extensive experiments on SpaceJam and Basketball-51 datasets demonstrate that our method not only improves recognition accuracy and generalization, but also highlights the great potential of self-attention mechanism in the field of sports video analysis. By focusing on key representative frames, the model achieves impressive efficiency and interpretability, pointing to a bright future for automated sports analysis and intelligent decision-making systems.},
booktitle = {Proceedings of the 2025 International Conference on Artificial Intelligence and Digital Finance},
pages = {201–209},
numpages = {9},
keywords = {Basketball Action Recognition, Real-time Object Detection, Sports Video Analysis, Transformer Network, YOLOv11},
location = {
},
series = {AIDF '25}
}

@inproceedings{10.1145/3736426.3736447,
author = {Xu, Liming},
title = {Transformation and Innovation in Computer Science Services Driven by Data Sharing},
year = {2025},
isbn = {9798400714238},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3736426.3736447},
doi = {10.1145/3736426.3736447},
abstract = {Global communication made by the new technology revolution transformed the interaction of knowledge among disciplines in a new way and thus created two new opportunities and challenges for knowledge computing service systems. Present bottlenecks mainly consist of the following issues: One is massive data increase, which takes advantage of the exponential growth of computing power and reduces the opportunities for scholar to access data and two is lagging or absent standard rules, which hinders scholarly data distribution and circulation between scholars.This study adopts an application-oriented framework consisting of case analysis, validation and solution extraction to address improvement opportunities for computational services of data sharing systems. Fragmented cross-disciplinary data communication standardization, ownership confusion, rigid management mode and lack of a flexible service design are observed to be the major operational obstacles of data sharing systems.The comparison of state-of-art implementation in teaching, learning, science, and technology reveals significant sharing paradigms and opportunities for innovation through discussing platform-based resolution possibilities leading to multidimensional optimization proposals in technical, service and regulation.},
booktitle = {Proceedings of the 2025 International Conference on Digital Management and Information Technology},
pages = {120–125},
numpages = {6},
keywords = {Case Study, Computer Science Services, Data Sharing, Digital Transformation},
location = {
},
series = {DMIT '25}
}

@article{10.1145/3723008,
author = {Meng, Wenhui and Xie, Jiayi and Yi, Jing and Zhu, Yaochen and Chen, Zhenzhong},
title = {Disentangling User Interest and Geographical Context for POI Recommendations},
year = {2025},
issue_date = {June 2025},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {16},
number = {3},
issn = {2157-6904},
url = {https://doi.org/10.1145/3723008},
doi = {10.1145/3723008},
abstract = {POI recommendation plays an important role in many applications, such as mobility prediction and location-based advertisements. Existing POI recommendation methods mainly capture the observed patterns in user visits for recommendations, without a comprehensive consideration of the underlying reasons behind the visits. Therefore, different causes of a visit, i.e., users’ interest and geographical context, are entangled. When the underlying causes change (e.g., when a user moves to a new place), the robustness of the recommendations cannot be guaranteed. To address the above challenges, we propose DUIG, a novel user interest and geographical influences disentanglement framework for POI recommendations. We first design a personalized disentanglement strategy to divide check-ins through geographical influence. Specifically, the colliding effect of causality is leveraged to the divide cause-specific check-ins, such that user interest and geographical influence can be properly disentangled in user and POI embeddings. Through this mechanism, even if the underlying reasons that affect a user’s preference change, intervention can be conducted upon the causes to make recommendations generalized to the new scenario. In addition, a geographical-aware negative sampling strategy is proposed to utilize hard negatives to regularize the embedding and disentanglement in the latent space, where a larger sampling probability is introduced for negative samples containing more geographic information. Extensive experiments on two real-world POI recommendation datasets demonstrate the superior performance of DUIG.},
journal = {ACM Trans. Intell. Syst. Technol.},
month = may,
articleno = {64},
numpages = {19},
keywords = {POI recommendation, disentangled representation learning, personalized recommendation}
}

@inproceedings{10.1145/3723936.3723950,
author = {Wang, Zhichen},
title = {Research on Traditional Martial Arts Action Recognition Algorithm Based on OpenPose},
year = {2025},
isbn = {9798400712234},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3723936.3723950},
doi = {10.1145/3723936.3723950},
abstract = {This study puts forth a traditional martial arts action recognition algorithm using OpenPose with the intention of enhancing the accuracy and analysis of traditional martial arts movements. Through the analysis of the principles of OpenPose, we developed a systematic recognition framework, in which we applied data preprocessing algorithms, extracted features, and modeled martial arts postures. In combination with the optimization algorithms, this approach increased the precision and fastness of recognition. The experiment results showed that this proposed algorithm was very efficient and could recognize certain movements in martial arts more accurately. The research concludes that the suggested method can be utilized to support martial arts education, movement monitoring, and training, and it offers a novel method for the digital transmission of traditional culture.},
booktitle = {Proceedings of the 2024 International Conference on Sports Technology and Performance Analysis},
pages = {86–91},
numpages = {6},
keywords = {Action Recognition, Algorithm Optimization, OpenPose, Posture Modeling, Traditional Martial Arts},
location = {
},
series = {ICSTPA '24}
}

@inproceedings{10.1145/3703323.3703324,
author = {Myalil Antony, Delton and Shaik, Imtiyazuddin and Vivek, B S and M A, Rajan and Gubbi, Jayavardhana and Lodha, Sachin},
title = {Decentralized Inter-Hospital Motor Imagery Detection using Robust Multiparty Model Aggregation},
year = {2025},
isbn = {9798400711244},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3703323.3703324},
doi = {10.1145/3703323.3703324},
abstract = {Complex deep learning problems in domains like medicine require large volumes of high quality supervised training data obtained using a multi-institutional collaborative effort. However, regulations in healthcare enforce stringent data privacy requirements and legal restrictions that penalize the transmission of data (or metadata, models, identities) to servers that lie outside its jurisdictional boundary. To achieve global model training without mobilizing training data, or model weights/gradients, we propose a serverless collaborative model training approach called DECS. To illustrate our research, we take the inter-hospital Motor Imagery (MI) detection use-case. We start by introducing the MI detection problem and its need for collaborative model training. Then, we identify a set of ideal non-functional requirements and explore how direct applications of existing private learning methods fail to meet them. Finally, we develop a compliant solution that performs serverless collaborative model training that is also resilient to active adversaries. Here, multiple local MI models from different hospitals are aggregated into a global model, without transmitting the data, models, or even gradients. We compare our accuracies, in presence of malicious clients, and observe that they are on par, and conclude by discussing the trade-offs incurred in private learning.},
booktitle = {Proceedings of the 8th International Conference on Data Science and Management of Data (12th ACM IKDD CODS and 30th COMAD)},
pages = {1–9},
numpages = {9},
keywords = {Federated learning, Multiparty Computation, Motor Imagery Detection, EEG Classification},
location = {
},
series = {CODS-COMAD '24}
}

@inproceedings{10.1145/3786554.3786571,
author = {Jiang, Fangyuan},
title = {Design of Intelligent Platform for Home-based Elderly Care Services Based on Artificial Intelligence},
year = {2026},
isbn = {9798400722233},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3786554.3786571},
doi = {10.1145/3786554.3786571},
abstract = {With the acceleration of population aging and the development of intelligent technologies, smart home-based elderly care services have become an important approach to addressing elderly care challenges. Through constructing an intelligent platform for home-based elderly care services based on artificial intelligence, which integrates technologies such as Internet of Things sensing, big data analysis, and cloud computing, multi-dimensional intelligent services for the elderly's physiological health, daily life, and safety protection have been realized. Experimental verification demonstrates that the platform shows excellent service effectiveness in physiological indicator monitoring, abnormal behavior recognition, and emergency event handling, significantly improving the intelligence level and service quality of home-based elderly care, providing a feasible solution to solve the challenges of home-based elderly care.},
booktitle = {Proceedings of the 2025 International Conference on AI-Driven Business Transformation and Data Science Innovation},
pages = {106–110},
numpages = {5},
keywords = {Artificial Intelligence, Health Monitoring, Home-based Elderly Care, Intelligent Platform, Internet of Things},
location = {
