@inproceedings{10.1145/3795154.3795262,
author = {Li, Yuan},
title = {A Survey on Architectures and Algorithms of Wide-Area Distributed Intelligent Systems: Challenges, Methods, and Prospects},
year = {2026},
isbn = {9798400719981},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3795154.3795262},
doi = {10.1145/3795154.3795262},
abstract = {Wide-area distributed intelligent systems have emerged as a critical paradigm for large-scale, complex applications such as smart grids, disaster response, and wide-area environmental monitoring. In these scenarios, systems are required to operate under highly dynamic, uncertain, and often adversarial conditions, including natural hazards, cyberattacks, and component failures. Traditional centralized architectures struggle to meet the stringent requirements of scalability, robustness, real-time decision-making, and resilience, motivating the shift toward distributed and intelligent system designs that emphasize autonomy, cooperation, and adaptability. This paper presents a comprehensive survey of the architectures and algorithms for wide-area distributed intelligent systems. We first review the evolution of distributed intelligent system architectures and establish a systematic classification of key technologies from the perspectives of modules, components, and functionalities. A unified requirement model for adversarial environments is then discussed, followed by representative application scenarios. At the algorithmic level, the survey focuses on distributed intelligent decision-making techniques, with an in-depth review of multi-agent reinforcement learning, federated learning, and graph neural networks, highlighting their principles, strengths, and limitations in wide-area deployments. By synthesizing architectural and algorithmic perspectives, this survey clarifies the fundamental advantages and challenges of wide-area distributed intelligent systems and identifies critical research gaps. The insights provided in this paper aim to support the design of more resilient, scalable, and intelligent large-scale systems, and to guide future research directions toward robust distributed intelligence in complex real-world environments.},
booktitle = {Proceedings of the 2025 6th International Conference on Computer Science and Management Technology},
pages = {661–667},
numpages = {7},
keywords = {Distributed System Architecture, Multi-Agent Algorithms, Real-Time Decision Making},
location = {
},
series = {ICCSMT '25}
}

@inproceedings{10.1145/3748825.3748857,
author = {Yang, Yating and Qian, Ma and Di Nardo, Mario and Huang, Zhonghuan},
title = {Deep Learning-Based Music Emotion Recognition Framework for Intelligent Vocal Pedagogy},
year = {2025},
isbn = {9798400714337},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3748825.3748857},
doi = {10.1145/3748825.3748857},
abstract = {With the rapid development of artificial intelligence, deep learning technology, especially the introduction of the Transformer architecture, has brought new paradigms to the field of music sentiment analysis, which further promotes the development of intelligent vocal education systems. In traditional vocal teaching, the evaluation of students' emotional expression often relies on the subjective experience of teachers, while deep learning models can quantify students' emotional expression level through audio features and lyric text analysis, thereby providing objective evaluation indicators. However, current music sentiment analysis systems suffer from low accuracy in sentiment classification. In response to this issue, this study optimized the Transformer architecture based on the Moss Growth Optimization (MGO) algorithm. The MGO-Transformer architecture is used to analyze students' emotional expressions, thereby improving their proficiency in vocal courses. In addition, we have designed some improved strategies to enhance the performance of the MGO algorithm. The results showed that the performance of the improved MGO (IMGO) was improved by 9.26% compared to MGO.},
booktitle = {Proceedings of the 2025 2nd International Conference on Digital Society and Artificial Intelligence},
pages = {191–196},
numpages = {6},
keywords = {Deep learning, Moss Growth Optimization, Music sentiment analysis, Quality education, Transformer architecture},
